package pages

// LoginPageProps for the shared login page (used by both customer and vendor)
type LoginPageProps struct {
	Title        string // "Customer Login" or "Vendor Login"
	BasePath     string // Base path for redirects
	AuthURL      string // OIDC authorization URL
	ProviderName string // e.g., "Google", "Okta", "SSO" (optional, shows icon if set)
	Error        string // Error message to display

	// Switch link to alternate login page
	SwitchURL  string // URL to other login page
	SwitchText string // e.g., "Looking for vendor login?"
}

// LoginPage renders the shared login page matching dashboard-ui design
templ LoginPage(props LoginPageProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.Title }</title>
			<link href="/static/css/customer.css" rel="stylesheet"/>
			@darkModeScript()
			@fontLinks()
		</head>
		<body class="bg-cool-grey-50 dark:bg-dark-grey-950">
			<!-- Preview Banner -->
			<div id="preview-banner" class="bg-violet-600 text-white px-4 py-3 text-sm hidden">
				<div class="max-w-7xl mx-auto flex items-center justify-between">
					<p>This application is currently in preview. Features may change and some functionality may be incomplete.</p>
					<button onclick="closePreviewBanner()" class="ml-4 text-white/80 hover:text-white flex-shrink-0">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>
			</div>
			@sharedLoginPreviewBannerScript()
			<div class="flex h-screen w-full">
				<!-- Left Side - Content -->
				<div class="flex flex-col gap-10 justify-center w-full lg:w-[840px] bg-cool-grey-50 dark:bg-dark-grey-950 px-8 md:px-20 py-16">
					<!-- Card -->
					<div class="bg-white dark:bg-dark-grey-800 border border-cool-grey-500/25 dark:border-dark-grey-500 rounded-lg shadow-sm px-8 md:px-[70px] py-12 md:py-16 w-full flex flex-col gap-8">
						<!-- Logo -->
						<a href="https://nuon.co" class="w-fit">
							<span class="sr-only">Nuon</span>
							@nuonLogoLight()
							@nuonLogoDark()
						</a>
						<!-- Heading and Subtitle -->
						<div class="flex flex-col gap-6">
							<h1 class="text-[34px] leading-10 tracking-[-0.8px] font-strong text-cool-grey-900 dark:text-white">
								{ props.Title }
							</h1>
							<p class="text-lg leading-[27px] tracking-[-0.2px] text-cool-grey-600 dark:text-white/70">
								Manage your customer's install experience.
							</p>
						</div>
						<!-- Error message -->
						if props.Error != "" {
							<div class="p-4 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-300 rounded-lg">
								{ props.Error }
							</div>
						}
						<!-- Sign Up Button (Primary) -->
						<a
							href={ templ.SafeURL(props.AuthURL) }
							class="w-full inline-flex items-center justify-center text-sm h-9 px-3 py-1 leading-[21px] font-strong tracking-tight border border-transparent rounded-md bg-primary-600 hover:bg-primary-700 text-white transition-colors"
						>
							Sign up
						</a>
						<!-- Divider -->
						<hr class="border-cool-grey-300 dark:border-dark-grey-500"/>
						<!-- Already have account section -->
						<h2 class="text-2xl leading-[30px] tracking-[-0.8px] font-strong text-cool-grey-900 dark:text-white">
							Already have an account?
						</h2>
						<!-- Sign In Button (Secondary) -->
						<a
							href={ templ.SafeURL(props.AuthURL) }
							class="w-full inline-flex items-center justify-center text-sm h-9 px-3 py-1 leading-[21px] font-strong tracking-tight border rounded-md bg-white dark:bg-dark-grey-700 text-primary-600 dark:text-primary-400 hover:bg-cool-grey-50 dark:hover:bg-dark-grey-500 transition-colors"
						>
							Sign in
						</a>
						<!-- Switch link to other login page -->
						if props.SwitchURL != "" && props.SwitchText != "" {
							<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 text-center">
								<a href={ templ.SafeURL(props.SwitchURL) } class="text-primary-600 hover:text-primary-700 dark:text-primary-400 hover:underline">
									{ props.SwitchText }
								</a>
							</p>
						}
					</div>
					<!-- Learn More Link -->
					<a
						href="https://docs.nuon.co"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-1.5 text-sm h-9 px-3 py-1 leading-[21px] font-strong tracking-tight text-primary-600 dark:text-primary-500 border border-transparent rounded-md hover:bg-black/5 dark:hover:bg-white/5 transition-colors w-fit"
					>
						Learn more about how Nuon works
						@arrowUpRightIcon()
					</a>
				</div>
				<!-- Right Side - Branded Background -->
				<div class="hidden lg:flex relative flex-1 overflow-hidden">
					<img
						src="/static/images/oss-hero.png"
						alt="Nuon branded background"
						class="absolute inset-0 w-full h-full object-cover"
					/>
				</div>
			</div>
		</body>
	</html>
}

templ darkModeScript() {
	<script>
		(function() {
			if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
				document.documentElement.classList.add('dark');
			}
			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
				document.documentElement.classList.toggle('dark', e.matches);
			});
		})();
	</script>
}

templ fontLinks() {
	<link rel="preconnect" href="https://fonts.googleapis.com"/>
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
}

