				fill="#1B242C"
			/>
			<path
				d="M67.3837 16.7756V22.4111H64.9515V17.349C64.9515 15.8659 64.2594 15.2332 63.073 15.2332C61.8272 15.2332 60.9374 15.9648 60.9374 17.9422V22.4111H58.5249V13.2756H60.9176V14.6597H60.9572C61.5701 13.6117 62.5984 12.9789 63.943 12.9789C65.9204 12.9789 67.3837 14.0863 67.3837 16.7756Z"
				fill="#1B242C"
			/>
		</g>
		<defs>
			<linearGradient
				id="logo-light-gradient"
				x1="-1.26608e-07"
				y1="25.0883"
				x2="10.9568"
				y2="-0.844511"
				gradientUnits="userSpaceOnUse"
			>
				<stop stop-color="#F72585"/>
				<stop offset="0.53" stop-color="#3A00FF"/>
				<stop offset="1" stop-color="#4CC9F0"/>
			</linearGradient>
		</defs>
	</svg>
}

