package partials

// TitleBarProps for the entity title bar
type TitleBarProps struct {
	EntityTitle   string
	EntityID      string
	EntityActions []EntityAction
}

// EntityAction for title bar action links
type EntityAction struct {
	Text     string
	URL      string
	External bool
}

// TitleBar renders the entity title bar with name, ID, and action links
templ TitleBar(props TitleBarProps) {
	if props.EntityTitle != "" {
		<div class="stratus-title-bar">
			<div class="stratus-title-bar-left">
				<h1 class="stratus-entity-name">{ props.EntityTitle }</h1>
				if props.EntityID != "" {
					<div class="stratus-entity-id">
						<span class="font-mono text-xs text-cool-grey-500 dark:text-cool-grey-400">{ props.EntityID }</span>
						<button
							type="button"
							onclick={ templ.ComponentScript{Call: "copyEntityID('" + props.EntityID + "')"} }
							class="stratus-copy-button"
							aria-label="Copy ID"
						>
							@copyIcon()
						</button>
						<span id="copyConfirmation" class="stratus-copy-confirmation hidden">Copied!</span>
					</div>
				}
			</div>
			if len(props.EntityActions) > 0 {
				<div class="stratus-title-bar-right">
					for _, action := range props.EntityActions {
						if action.External {
							<a
								href={ templ.SafeURL(action.URL) }
								class="stratus-title-bar-action"
								target="_blank"
								rel="noopener noreferrer"
							>
								<span>{ action.Text }</span>
								@titleBarExternalLinkIcon()
							</a>
						} else {
							<a href={ templ.SafeURL(action.URL) } class="stratus-title-bar-action">
								<span>{ action.Text }</span>
							</a>
						}
					}
				</div>
			}
		</div>
		@titleBarScript()
	}
}

templ titleBarScript() {
	<script>
		function copyEntityID(id) {
			navigator.clipboard.writeText(id).then(function() {
				const confirmation = document.getElementById('copyConfirmation');
				if (confirmation) {
					confirmation.classList.remove('hidden');
					setTimeout(function() {
						confirmation.classList.add('hidden');
					}, 2000);
				}
			}).catch(function(err) {
				console.error('Failed to copy:', err);
			});
		}
	</script>
}

templ copyIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" class="w-3.5 h-3.5">
		<path d="M216,32H88a8,8,0,0,0-8,8V80H40a8,8,0,0,0-8,8V216a8,8,0,0,0,8,8H168a8,8,0,0,0,8-8V176h40a8,8,0,0,0,8-8V40A8,8,0,0,0,216,32ZM160,208H48V96H160Zm48-48H176V88a8,8,0,0,0-8-8H96V48H208Z"></path>
	</svg>
}

templ titleBarExternalLinkIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" class="w-4 h-4">
		<path d="M224,104a8,8,0,0,1-16,0V59.32l-66.33,66.34a8,8,0,0,1-11.32-11.32L196.68,48H152a8,8,0,0,1,0-16h64a8,8,0,0,1,8,8Zm-40,24a8,8,0,0,0-8,8v72H48V80h72a8,8,0,0,0,0-16H48A16,16,0,0,0,32,80V208a16,16,0,0,0,16,16H176a16,16,0,0,0,16-16V136A8,8,0,0,0,184,128Z"></path>
	</svg>
}
