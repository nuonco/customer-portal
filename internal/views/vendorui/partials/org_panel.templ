package partials

import (
	"fmt"
	"time"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
)

// OrgPanelProps for the org settings panel
type OrgPanelProps struct {
	Org             *models.NuonOrg
	Members         []models.OrgMember
	Invitations     []models.OrgInvitation
	BasePath        string
	CurrentUser     *models.User
	CustomerBaseURL string
}

// OrgPanel renders the org settings slide-in panel
templ OrgPanel(props OrgPanelProps) {
	<div id="org-panel" class="stratus-panel panel-hidden" data-base-path={ props.BasePath } data-customer-base-url={ props.CustomerBaseURL }>
		<!-- Overlay - click to close -->
		<div class="stratus-panel-overlay" onclick="closeOrgPanel()"></div>
		<!-- Panel Container -->
		<div class="stratus-panel-container" style="max-width: 36rem;">
			<!-- Header -->
			<div class="stratus-panel-header">
				<div class="stratus-panel-title">
					@orgPanelIcon()
					<span>Organization Settings</span>
				</div>
				<div class="flex items-center gap-2">
					<!-- Expand/Collapse button -->
					<button type="button" onclick="toggleOrgPanelSize()" class="stratus-panel-action" id="orgPanelExpandBtn" title="Expand to full screen">
						@orgPanelExpandIcon()
						@orgPanelCollapseIcon()
					</button>
					<!-- Close button -->
					<button type="button" onclick="closeOrgPanel()" class="stratus-panel-action" title="Close panel">
						@orgPanelArrowRightIcon()
					</button>
				</div>
			</div>
			<!-- Content -->
			<div class="stratus-panel-content">
				<!-- Organization Details Section -->
				<div class="mb-8">
					<h4 class="text-sm font-semibold text-cool-grey-900 dark:text-white mb-4 flex items-center gap-2">
						@orgPanelSettingsIcon()
						Organization Details
					</h4>
					<form id="orgNameForm" class="space-y-4">
						<div>
							<label for="orgName" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-2">
								Organization Name
							</label>
							<input
								type="text"
								id="orgName"
								name="name"
								value={ props.Org.Name }
								placeholder="Enter organization name"
								class="w-full px-3 py-2 text-sm border border-cool-grey-300 dark:border-dark-grey-500 rounded-md bg-white dark:bg-dark-grey-800 text-cool-grey-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 placeholder-cool-grey-400 dark:placeholder-cool-grey-500"
							/>
						</div>
						<div class="flex justify-end">
							<button
								type="submit"
								id="orgNameSaveBtn"
								class="px-4 py-2 text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-md transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
							>
								<span id="orgNameSaveBtnText">Save Name</span>
							</button>
						</div>
					</form>
				</div>
				<!-- Team Members Section -->
				<div class="mb-8">
					<h4 class="text-sm font-semibold text-cool-grey-900 dark:text-white mb-4 flex items-center gap-2">
						@orgPanelUsersIcon()
						Team Members
						<span class="text-cool-grey-500 dark:text-cool-grey-400 font-normal">({ fmt.Sprintf("%d", len(props.Members)) })</span>
					</h4>
					<div class="space-y-2">
						for _, member := range props.Members {
							<div class="flex items-center justify-between p-3 bg-cool-grey-50 dark:bg-dark-grey-800 rounded-lg">
								<div class="flex items-center gap-3">
									<div class="w-8 h-8 rounded-full bg-primary-100 dark:bg-primary-900 flex items-center justify-center text-primary-700 dark:text-primary-300 text-sm font-medium">
										{ getMemberInitials(member.User.Name, member.User.Email) }
									</div>
									<div>
										<p class="text-sm font-medium text-cool-grey-900 dark:text-white">
											{ member.User.Name }
											if member.UserID == props.CurrentUser.ID {
												<span class="text-cool-grey-500 dark:text-cool-grey-400 font-normal">(you)</span>
											}
										</p>
										<p class="text-xs text-cool-grey-500 dark:text-cool-grey-400">{ member.User.Email }</p>
									</div>
								</div>
								if member.UserID != props.CurrentUser.ID {
									<button
										type="button"
										onclick="removeMember(this)"
										data-user-id={ member.UserID }
										data-user-name={ member.User.Name }
										class="p-1.5 text-cool-grey-400 hover:text-red-600 dark:hover:text-red-400 transition-colors"
										title="Remove member"
									>
										@orgPanelTrashIcon()
									</button>
								}
							</div>
						}
						if len(props.Members) == 0 {
							<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400 text-center py-4">
								No team members yet.
							</p>
						}
					</div>
				</div>
				<!-- Invitations Section -->
				<div class="mb-8">
					<h4 class="text-sm font-semibold text-cool-grey-900 dark:text-white mb-4 flex items-center gap-2">
						@orgPanelLinkIcon()
						Invitation Links
						<span class="text-cool-grey-500 dark:text-cool-grey-400 font-normal">({ fmt.Sprintf("%d", len(props.Invitations)) })</span>
					</h4>
					<div class="space-y-2 mb-4">
						for _, invite := range props.Invitations {
							<div class="p-3 bg-cool-grey-50 dark:bg-dark-grey-800 rounded-lg">
								<div class="flex items-center justify-between mb-2">
									<div class="flex items-center gap-2">
										if invite.Email != "" {
											<span class="text-sm font-medium text-cool-grey-900 dark:text-white">{ invite.Email }</span>
										} else {
											<span class="text-sm font-medium text-cool-grey-900 dark:text-white">Open Link</span>
										}
									</div>
									<div class="flex items-center gap-1">
										<button
											type="button"
											onclick="copyInviteLink(this)"
											data-token={ invite.Token }
											class="p-1.5 text-cool-grey-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
											title="Copy invitation link"
										>
											@orgPanelCopyIcon()
										</button>
										<button
											type="button"
											onclick="deleteInvitation(this)"
											data-invite-id={ invite.ID }
											class="p-1.5 text-cool-grey-400 hover:text-red-600 dark:hover:text-red-400 transition-colors"
											title="Delete invitation"
										>
											@orgPanelTrashIcon()
										</button>
									</div>
								</div>
								<div class="flex items-center gap-3 text-xs text-cool-grey-500 dark:text-cool-grey-400">
									if invite.ExpiresAt != nil {
										<span>Expires: { formatExpiration(*invite.ExpiresAt) }</span>
									} else {
										<span>No expiration</span>
									}
									<span>|</span>
									if invite.MaxUses > 0 {
										<span>Uses: { fmt.Sprintf("%d/%d", invite.UsedCount, invite.MaxUses) }</span>
									} else {
										<span>Uses: { fmt.Sprintf("%d", invite.UsedCount) } (unlimited)</span>
									}
								</div>
							</div>
						}
						if len(props.Invitations) == 0 {
							<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400 text-center py-4">
								No active invitation links.
							</p>
						}
					</div>
					<!-- Generate Invitation Form -->
					<div class="border-t border-cool-grey-200 dark:border-dark-grey-600 pt-4">
						<h5 class="text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-3">Generate New Invitation</h5>
						<form id="generateInviteForm" class="space-y-3">
							<div>
								<label for="inviteEmail" class="block text-xs font-medium text-cool-grey-600 dark:text-cool-grey-400 mb-1">
									Email (optional)
								</label>
								<input
									type="email"
									id="inviteEmail"
									name="email"
									placeholder="user@example.com"
									class="w-full px-3 py-2 text-sm border border-cool-grey-300 dark:border-dark-grey-500 rounded-md bg-white dark:bg-dark-grey-800 text-cool-grey-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 placeholder-cool-grey-400 dark:placeholder-cool-grey-500"
								/>
								<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">
									Leave empty to create a shareable link.
								</p>
							</div>
							<div class="grid grid-cols-2 gap-3">
								<div>
									<label for="inviteExpires" class="block text-xs font-medium text-cool-grey-600 dark:text-cool-grey-400 mb-1">
										Expires In
									</label>
									<select
										id="inviteExpires"
										name="expires"
										class="w-full px-3 py-2 text-sm border border-cool-grey-300 dark:border-dark-grey-500 rounded-md bg-white dark:bg-dark-grey-800 text-cool-grey-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
									>
										<option value="">Never</option>
										<option value="1">1 day</option>
										<option value="7">7 days</option>
										<option value="30">30 days</option>
									</select>
								</div>
								<div>
									<label for="inviteMaxUses" class="block text-xs font-medium text-cool-grey-600 dark:text-cool-grey-400 mb-1">
										Max Uses
									</label>
									<select
										id="inviteMaxUses"
										name="max_uses"
										class="w-full px-3 py-2 text-sm border border-cool-grey-300 dark:border-dark-grey-500 rounded-md bg-white dark:bg-dark-grey-800 text-cool-grey-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
									>
										<option value="0">Unlimited</option>
										<option value="1">1 use</option>
										<option value="5">5 uses</option>
										<option value="10">10 uses</option>
									</select>
								</div>
							</div>
							<div class="flex justify-end pt-2">
								<button
									type="submit"
									id="generateInviteBtn"
									class="px-4 py-2 text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-md transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
								>
									<span id="generateInviteBtnText">Generate Link</span>
								</button>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
	@orgPanelScript()
}

func getMemberInitials(name, email string) string {
	if name != "" {
		runes := []rune(name)
		if len(runes) >= 2 {
			// Try to get first letter of first and last word
			words := splitWords(name)
			if len(words) >= 2 {
				return string([]rune(words[0])[0:1]) + string([]rune(words[len(words)-1])[0:1])
			}
			return string(runes[0:2])
		}
		return string(runes[0:1])
	}
	if email != "" {
		runes := []rune(email)
		if len(runes) >= 2 {
			return string(runes[0:2])
		}
		return string(runes[0:1])
	}
	return "?"
}

func splitWords(s string) []string {
	var words []string
	word := ""
	for _, r := range s {
		if r == ' ' || r == '-' || r == '_' {
			if word != "" {
				words = append(words, word)
				word = ""
			}
		} else {
			word += string(r)
		}
	}
	if word != "" {
		words = append(words, word)
	}
	return words
}

func formatExpiration(t time.Time) string {
	now := time.Now()
	if t.Before(now) {
		return "Expired"
	}
	diff := t.Sub(now)
	if diff < 24*time.Hour {
		return fmt.Sprintf("%.0f hours", diff.Hours())
	}
	days := int(diff.Hours() / 24)
	if days == 1 {
		return "1 day"
	}
	return fmt.Sprintf("%d days", days)
}

templ orgPanelScript() {
	<script>
		(function() {
			const basePath = document.getElementById('org-panel').dataset.basePath;
			const customerBaseURL = document.getElementById('org-panel').dataset.customerBaseUrl;

			function openOrgPanel() {
				const panel = document.getElementById('org-panel');
				panel.classList.remove('panel-hidden');
				panel.classList.add('panel-visible');
				document.body.classList.add('overflow-hidden');
				const userDropdown = document.getElementById('userDropdown');
				if (userDropdown) userDropdown.classList.add('hidden');
			}

			function closeOrgPanel() {
				const panel = document.getElementById('org-panel');
				panel.classList.remove('panel-visible', 'panel-full');
				panel.classList.add('panel-hidden');
				document.body.classList.remove('overflow-hidden');
				document.getElementById('orgPanelExpandIcon')?.classList.remove('hidden');
				document.getElementById('orgPanelCollapseIcon')?.classList.add('hidden');
				document.getElementById('orgPanelExpandBtn')?.setAttribute('title', 'Expand to full screen');
				setTimeout(function() {
					document.getElementById('settings-panel-container').innerHTML = '';
				}, 300);
			}

			function toggleOrgPanelSize() {
				const panel = document.getElementById('org-panel');
				const container = panel.querySelector('.stratus-panel-container');
				const expandIcon = document.getElementById('orgPanelExpandIcon');
				const collapseIcon = document.getElementById('orgPanelCollapseIcon');
				const expandBtn = document.getElementById('orgPanelExpandBtn');

				if (panel.classList.contains('panel-full')) {
					panel.classList.remove('panel-full');
					container.style.maxWidth = '36rem';
					expandIcon.classList.remove('hidden');
					collapseIcon.classList.add('hidden');
					expandBtn.setAttribute('title', 'Expand to full screen');
				} else {
					panel.classList.add('panel-full');
					container.style.maxWidth = 'none';
					expandIcon.classList.add('hidden');
					collapseIcon.classList.remove('hidden');
					expandBtn.setAttribute('title', 'Resize to default size');
				}
			}

			async function removeMember(btn) {
				const userId = btn.dataset.userId;
				const userName = btn.dataset.userName;
				if (!confirm(`Remove ${userName} from this organization?`)) {
					return;
				}

				try {
					const response = await fetch(basePath + '/org/members/' + userId, {
						method: 'DELETE',
						headers: {
							'Content-Type': 'application/json'
						}
					});

					if (response.ok) {
						showToast('Member removed successfully', 'success');
						// Reload the panel
						htmx.ajax('GET', basePath + '/org/settings/panel', {target: '#settings-panel-container', swap: 'innerHTML'});
					} else {
						const data = await response.json();
						showToast(data.error || 'Failed to remove member', 'error');
					}
				} catch (error) {
					showToast('Network error. Please try again.', 'error');
				}
			}

			async function copyInviteLink(btn) {
				const token = btn.dataset.token;
				const url = window.location.origin + '/admin/invite?token=' + token;
				try {
					await navigator.clipboard.writeText(url);
					showToast('Invitation link copied to clipboard', 'success');
				} catch (err) {
					// Fallback for older browsers
					const input = document.createElement('input');
					input.value = url;
					document.body.appendChild(input);
					input.select();
					document.execCommand('copy');
					document.body.removeChild(input);
					showToast('Invitation link copied to clipboard', 'success');
				}
			}

			async function deleteInvitation(btn) {
				const inviteId = btn.dataset.inviteId;
				if (!confirm('Delete this invitation link? Anyone with this link will no longer be able to join.')) {
					return;
				}

				try {
					const response = await fetch(basePath + '/org/invitations/' + inviteId, {
						method: 'DELETE',
						headers: {
							'Content-Type': 'application/json'
						}
					});

					if (response.ok) {
						showToast('Invitation deleted', 'success');
						// Reload the panel
						htmx.ajax('GET', basePath + '/org/settings/panel', {target: '#settings-panel-container', swap: 'innerHTML'});
					} else {
						const data = await response.json();
						showToast(data.error || 'Failed to delete invitation', 'error');
					}
				} catch (error) {
					showToast('Network error. Please try again.', 'error');
				}
			}

			window.openOrgPanel = openOrgPanel;
			window.closeOrgPanel = closeOrgPanel;
			window.toggleOrgPanelSize = toggleOrgPanelSize;
			window.removeMember = removeMember;
			window.copyInviteLink = copyInviteLink;
			window.deleteInvitation = deleteInvitation;

			document.addEventListener('keydown', function(e) {
				if (e.key === 'Escape') {
					const panel = document.getElementById('org-panel');
					if (panel && panel.classList.contains('panel-visible')) {
						closeOrgPanel();
					}
				}
			});

			// Organization name form submission
			document.getElementById('orgNameForm').addEventListener('submit', async function(e) {
				e.preventDefault();

				const saveBtn = document.getElementById('orgNameSaveBtn');
				const saveBtnText = document.getElementById('orgNameSaveBtnText');
				const nameInput = document.getElementById('orgName');

				saveBtn.disabled = true;
				saveBtnText.textContent = 'Saving...';

				try {
					const response = await fetch(basePath + '/org', {
						method: 'PUT',
						headers: {
							'Content-Type': 'application/json'
						},
						body: JSON.stringify({
							name: nameInput.value
						})
					});

					const data = await response.json();

					if (response.ok) {
						showToast('Organization name updated', 'success');
						// Update the organization name in the topbar
						const orgNameEl = document.querySelector('[data-org-name]');
						if (orgNameEl) {
							orgNameEl.textContent = nameInput.value;
						}
					} else {
						showToast(data.error || 'Failed to update organization', 'error');
					}
				} catch (error) {
					showToast('Network error. Please try again.', 'error');
				} finally {
					saveBtn.disabled = false;
					saveBtnText.textContent = 'Save Name';
				}
			});

			// Generate invitation form submission
			document.getElementById('generateInviteForm').addEventListener('submit', async function(e) {
				e.preventDefault();

				const btn = document.getElementById('generateInviteBtn');
				const btnText = document.getElementById('generateInviteBtnText');

				btn.disabled = true;
				btnText.textContent = 'Generating...';

				const email = document.getElementById('inviteEmail').value;
				const expiresDays = document.getElementById('inviteExpires').value;
				const maxUses = parseInt(document.getElementById('inviteMaxUses').value) || 0;

				let expiresAt = null;
				if (expiresDays) {
					const date = new Date();
					date.setDate(date.getDate() + parseInt(expiresDays));
					expiresAt = date.toISOString();
				}

				try {
					const response = await fetch(basePath + '/org/invitations', {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json'
						},
						body: JSON.stringify({
							email: email,
							expires_at: expiresAt,
							max_uses: maxUses
						})
					});

					const data = await response.json();

					if (response.ok) {
						showToast('Invitation link created', 'success');
						// Copy to clipboard automatically
						const url = window.location.origin + '/admin/invite?token=' + data.token;
						try {
							await navigator.clipboard.writeText(url);
							showToast('Link copied to clipboard', 'success');
						} catch (err) {
							// Ignore clipboard errors
						}
						// Reset form and reload panel
						document.getElementById('generateInviteForm').reset();
						htmx.ajax('GET', basePath + '/org/settings/panel', {target: '#settings-panel-container', swap: 'innerHTML'});
					} else {
						showToast(data.error || 'Failed to create invitation', 'error');
					}
				} catch (error) {
					showToast('Network error. Please try again.', 'error');
				} finally {
					btn.disabled = false;
					btnText.textContent = 'Generate Link';
				}
			});

			openOrgPanel();
		})();
	</script>
}

// Icons for the org panel
templ orgPanelIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor">
		<path d="M216,56H40A16,16,0,0,0,24,72V200a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V72A16,16,0,0,0,216,56ZM40,72H216V88H40ZM216,200H40V104H216v96Zm-80-64a8,8,0,0,1-8,8H64a8,8,0,0,1,0-16h64A8,8,0,0,1,136,136Zm56,0a8,8,0,0,1-8,8H168a8,8,0,0,1,0-16h16A8,8,0,0,1,192,136Z"></path>
	</svg>
}

templ orgPanelExpandIcon() {
	<svg id="orgPanelExpandIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor">
		<path d="M216,48V88a8,8,0,0,1-16,0V56H168a8,8,0,0,1,0-16h40A8,8,0,0,1,216,48ZM88,200H56V168a8,8,0,0,0-16,0v40a8,8,0,0,0,8,8H88a8,8,0,0,0,0-16Zm120-40a8,8,0,0,0-8,8v32H168a8,8,0,0,0,0,16h40a8,8,0,0,0,8-8V168A8,8,0,0,0,208,160ZM88,40H48a8,8,0,0,0-8,8V88a8,8,0,0,0,16,0V56H88a8,8,0,0,0,0-16Z"></path>
	</svg>
}

templ orgPanelCollapseIcon() {
	<svg id="orgPanelCollapseIcon" class="hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor">
		<path d="M152,96V48a8,8,0,0,1,16,0V88h40a8,8,0,0,1,0,16H160A8,8,0,0,1,152,96ZM96,152H48a8,8,0,0,0,0,16H88v40a8,8,0,0,0,16,0V160A8,8,0,0,0,96,152Zm112,0H160a8,8,0,0,0-8,8v48a8,8,0,0,0,16,0V168h40a8,8,0,0,0,0-16ZM96,40a8,8,0,0,0-8,8V88H48a8,8,0,0,0,0,16H96a8,8,0,0,0,8-8V48A8,8,0,0,0,96,40Z"></path>
	</svg>
}

templ orgPanelArrowRightIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor">
		<path d="M189.66,122.34a8,8,0,0,1,0,11.32l-72,72a8,8,0,0,1-11.32-11.32L164.69,136H32a8,8,0,0,1,0-16H164.69L106.34,61.66a8,8,0,0,1,11.32-11.32ZM216,32a8,8,0,0,0-8,8V216a8,8,0,0,0,16,0V40A8,8,0,0,0,216,32Z"></path>
	</svg>
}

