package partials

import (
	"github.com/powertoolsdev/mono/exp/installer/app/internal/models"
)

// SidebarProps for the sidebar navigation
type SidebarProps struct {
	ActivePage string
	CurrentOrg *models.NuonOrg
	Orgs       []models.NuonOrg
	BasePath   string
	LogoBase64 string
}

// Sidebar renders the vendor sidebar navigation
templ Sidebar(props SidebarProps) {
	<aside class="stratus-sidebar" id="main-sidebar">
		<!-- Sidebar Header with Nuon Logo -->
		<header class="stratus-sidebar-header">
			<a href={ templ.SafeURL(props.BasePath + "/orgs") } class="stratus-logo-link">
				@nuonLogoLight()
				@nuonLogoDark()
			</a>
		</header>
		<!-- Sidebar Content -->
		<div class="stratus-sidebar-content">
			<!-- Org Switcher Dropdown -->
			<div class="relative" id="org-switcher">
				<button type="button" onclick="toggleOrgDropdown()" class="stratus-org-switcher">
					if props.CurrentOrg != nil {
						<span class="stratus-org-avatar">{ safeSlice(props.CurrentOrg.Name, 0, 2) }</span>
						<div class="sidebar-text flex-1 min-w-0 flex flex-col text-left">
							<span class="text-xs font-semibold truncate text-cool-grey-900 dark:text-white">{ props.CurrentOrg.Name }</span>
							<span class="stratus-status text-cool-grey-950 dark:text-white">
								<span class="stratus-status-dot success"></span>
								<span>Active</span>
							</span>
						</div>
					} else {
						<span class="stratus-org-avatar">
							@buildingIcon()
						</span>
						<span class="sidebar-text truncate flex-1 text-left text-cool-grey-500">Select Organization</span>
					}
					@caretUpDownIcon()
				</button>
				<div id="org-dropdown" class="stratus-org-dropdown hidden">
					if len(props.Orgs) > 0 {
						if len(props.Orgs) > 6 {
							<input type="text" placeholder="Search orgs..." class="stratus-search-input" oninput="filterOrgs(this.value)"/>
						}
						<div id="org-list" class="py-1">
							for _, org := range props.Orgs {
								<a
									href={ templ.SafeURL(props.BasePath + "/orgs/" + org.ID + "/links") }
									class={ "stratus-org-item", templ.KV("active", props.CurrentOrg != nil && props.CurrentOrg.ID == org.ID) }
								>
									<span class="stratus-org-avatar-sm">{ safeSlice(org.Name, 0, 2) }</span>
									<span class="truncate">{ org.Name }</span>
								</a>
							}
						</div>
					}
					<div class="border-t border-cool-grey-200">
						<button type="button" onclick="openConnectOrgModal()" class="stratus-org-item text-primary-600 w-full">
							@plusIcon()
							<span>Connect Organization</span>
						</button>
					</div>
				</div>
			</div>
			<!-- Main Navigation -->
			<nav class="stratus-sidebar-nav">
				if props.CurrentOrg != nil {
					<a
						href={ templ.SafeURL(props.BasePath + "/orgs/" + props.CurrentOrg.ID + "/apps") }
						class={ "stratus-sidebar-link", templ.KV("active", props.ActivePage == "apps") }
					>
						@cubeIcon()
						<span class="sidebar-text">Apps</span>
					</a>
					<a
						href={ templ.SafeURL(props.BasePath + "/orgs/" + props.CurrentOrg.ID + "/links") }
						class={ "stratus-sidebar-link", templ.KV("active", props.ActivePage == "links") }
					>
						@linkIcon()
						<span class="sidebar-text">Links</span>
					</a>
				} else {
					<span class="stratus-sidebar-link stratus-sidebar-link-disabled" title="Select an organization first">
						@cubeIcon()
						<span class="sidebar-text">Apps</span>
					</span>
					<span class="stratus-sidebar-link stratus-sidebar-link-disabled" title="Select an organization first">
						@linkIcon()
						<span class="sidebar-text">Links</span>
					</span>
				}
			</nav>
			<hr class="stratus-sidebar-divider"/>
			<!-- Resources Section -->
			<div class="stratus-sidebar-section">
				<div class="stratus-sidebar-label">Resources</div>
				<nav class="stratus-sidebar-nav">
					<a href="https://docs.nuon.co" target="_blank" rel="noopener noreferrer" class="stratus-sidebar-link">
						@bookIcon()
						<span class="sidebar-text">Documentation</span>
						@externalLinkSmallIcon()
					</a>
				</nav>
			</div>
		</div>
	</aside>
	@sidebarScript()
}

func safeSlice(s string, start, end int) string {
	runes := []rune(s)
	if len(runes) < end {
		end = len(runes)
	}
	if start > end {
		return ""
	}
	return string(runes[start:end])
}

templ sidebarScript() {
	<script>
		function toggleOrgDropdown() {
			const dropdown = document.getElementById('org-dropdown');
			dropdown.classList.toggle('hidden');
		}

		// Close dropdown when clicking outside
		document.addEventListener('click', function(e) {
			const switcher = document.getElementById('org-switcher');
			if (switcher && !switcher.contains(e.target)) {
				document.getElementById('org-dropdown').classList.add('hidden');
			}
		});

		function filterOrgs(query) {
			const items = document.querySelectorAll('#org-list .stratus-org-item');
			items.forEach(item => {
				const name = item.textContent.toLowerCase();
				item.style.display = name.includes(query.toLowerCase()) ? '' : 'none';
			});
		}
	</script>
}

