package partials

import "fmt"

// AppSubnavProps for the app sub-navigation sidebar
type AppSubnavProps struct {
	OrgID         string
	AppID         string
	ActiveSubPage string
	BasePath      string
}

// AppSubnav renders the app sub-navigation sidebar
templ AppSubnav(props AppSubnavProps) {
	<div class="stratus-subnav" id="page-sidebar">
		<div class="p-4">
			<nav class="space-y-1">
				<a
					href={ templ.SafeURL(fmt.Sprintf("%s/orgs/%s/apps/%s/health-checks", props.BasePath, props.OrgID, props.AppID)) }
					class={ "stratus-subnav-link", templ.KV("active", props.ActiveSubPage == "health-checks") }
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor">
						<path d="M178,32c-20.65,0-38.73,8.88-50,23.89C116.73,40.88,98.65,32,78,32A62.07,62.07,0,0,0,16,94c0,70,103.79,126.66,108.21,129a8,8,0,0,0,7.58,0C136.21,220.66,240,164,240,94A62.07,62.07,0,0,0,178,32ZM128,206.8C109.74,196.16,32,147.69,32,94A46.06,46.06,0,0,1,78,48c19.45,0,35.78,10.36,42.6,27a8,8,0,0,0,14.8,0c6.82-16.67,23.15-27,42.6-27a46.06,46.06,0,0,1,46,46C224,147.61,146.24,196.15,128,206.8Z"></path>
					</svg>
					<span class="subnav-text">Health Checks</span>
				</a>
			</nav>
		</div>
		<div
			class="stratus-subnav-handle"
			onmousedown="handleDragStart(event)"
			onmousemove="handleDragMove(event)"
			onmouseup="handleDragEnd()"
		>
			<div class="stratus-tooltip-container">
				<button onclick="togglePageSidebar()" class="stratus-subnav-handle-button" aria-label="Toggle page sidebar">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor">
						<path d="M112,48V208a8,8,0,0,1-16,0V136H43.31l18.35,18.34a8,8,0,0,1-11.32,11.32l-32-32a8,8,0,0,1,0-11.32l32-32a8,8,0,0,1,11.32,11.32L43.31,120H96V48a8,8,0,0,1,16,0Zm125.66,74.34-32-32a8,8,0,0,0-11.32,11.32L212.69,120H160V48a8,8,0,0,0-16,0V208a8,8,0,0,0,16,0V136h52.69l-18.35,18.34a8,8,0,0,0,11.32,11.32l32-32A8,8,0,0,0,237.66,122.34Z"></path>
					</svg>
				</button>
				<div class="stratus-tooltip stratus-tooltip-left">
					<span>Toggle panel</span>
					<div class="flex gap-0.5 ml-2">
						<kbd class="stratus-kbd-sm">Alt</kbd>
						<kbd class="stratus-kbd-sm">Shift</kbd>
						<kbd class="stratus-kbd-sm">S</kbd>
					</div>
				</div>
			</div>
		</div>
	</div>
}
