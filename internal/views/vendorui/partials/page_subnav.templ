	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor">
		<path d="M200,168a48.05,48.05,0,0,1-48,48H136v16a8,8,0,0,1-16,0V216H104a48.05,48.05,0,0,1-48-48,8,8,0,0,1,16,0,32,32,0,0,0,32,32h48a32,32,0,0,0,0-64H104a48,48,0,0,1,0-96h16V24a8,8,0,0,1,16,0V40h16a48.05,48.05,0,0,1,48,48,8,8,0,0,1-16,0,32,32,0,0,0-32-32H104a32,32,0,0,0,0,64h48A48.05,48.05,0,0,1,200,168Z"></path>
	</svg>
}

