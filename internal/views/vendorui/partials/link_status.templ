package partials

import (
	"fmt"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
)

// LinkStatusProps for the HTMX polling link status partial
type LinkStatusProps struct {
	Link         *models.InstallLink
	InstallURL   string
	PrimaryColor string
	BasePath     string
}

// LinkStatus renders link status with HTMX polling for real-time updates
templ LinkStatus(props LinkStatusProps) {
	<div
		id="link-status"
		hx-get={ fmt.Sprintf("%s/orgs/%s/links/%s/status", props.BasePath, props.Link.OrgID, props.Link.ID) }
		hx-trigger="every 5s"
		hx-swap="outerHTML"
		data-link-used={ fmt.Sprintf("%t", props.Link.Used) }
	>
		<!-- Installation Status - shown when link is used -->
		if props.Link.Used {
			<div class="mb-4 p-4 bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-800 rounded-lg">
				<h3 class="text-lg font-semibold text-green-800 dark:text-green-300">
					Installation Status
				</h3>
				<p class="text-green-700 dark:text-green-300 font-medium">
					This install has been claimed by a customer.
				</p>
				if props.Link.Install != nil {
					<p class="text-sm text-green-600 dark:text-green-400 mt-1">
						Install ID: { props.Link.Install.NuonInstallID }
					</p>
					if props.Link.Install.User.ID != "" {
						<p class="text-sm text-green-600 dark:text-green-400 mt-1">
							Customer:{ " " }
							<a
								href={ templ.SafeURL(fmt.Sprintf("%s/orgs/%s/customers/%s", props.BasePath, props.Link.OrgID, props.Link.Install.User.ID)) }
								class="font-medium text-green-700 dark:text-green-300 underline hover:text-green-800 dark:hover:text-green-200"
							>
								if props.Link.Install.User.Name != "" {
									{ props.Link.Install.User.Name }
								} else {
									{ props.Link.Install.User.Email }
								}
							</a>
						</p>
					}
					<div class="flex flex-wrap gap-2 mt-3">
						<a
							href={ templ.SafeURL(fmt.Sprintf("/installs/%s", props.Link.Install.ID)) }
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center px-4 py-2 text-sm rounded-md font-medium text-white bg-green-600 hover:bg-green-700"
						>
							View in Customer Dashboard
							@externalLinkIcon()
						</a>
						<a
							href={ templ.SafeURL(fmt.Sprintf("https://app.nuon.co/%s/installs/%s", props.Link.NuonOrg.NuonOrgID, props.Link.Install.NuonInstallID)) }
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center px-4 py-2 text-sm rounded-md font-medium text-green-700 dark:text-green-300 bg-green-100 dark:bg-green-900/50 hover:bg-green-200 dark:hover:bg-green-900/70 border border-green-300 dark:border-green-700"
						>
							View in Dashboard
							@externalLinkIcon()
						</a>
					</div>
				}
			</div>
		}
		<!-- Status Badge -->
		<div class="mb-4">
			<h3 class="text-lg font-semibold text-cool-grey-700 dark:text-cool-grey-300">
				Status
			</h3>
			@linkStatusBadge(props.Link.Used)
		</div>
		<!-- Install URL - shown when link is available -->
		if !props.Link.Used {
			<div>
				<h3 class="text-lg font-semibold text-cool-grey-700 dark:text-cool-grey-300 mb-2">
					Install URL
				</h3>
				<div class="bg-cool-grey-100 dark:bg-dark-grey-800 p-4 rounded-md">
					<p class="font-mono text-sm break-all" id="installUrl">{ props.InstallURL }</p>
					<div class="mt-2">
						<button
							type="button"
							onclick="copyToClipboard()"
							class={ "inline-flex items-center justify-center px-4 py-2 text-sm rounded-md font-medium text-white", copyButtonClass(props.PrimaryColor) }
						>
							Copy Install Link
						</button>
					</div>
				</div>
				<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mt-2">
					Share this install link with your customers to allow them to install your application.
				</p>
			</div>
		} else {
			<div>
				<p class="text-cool-grey-600 dark:text-cool-grey-400">
					This install link has been accepted by a customer.
				</p>
			</div>
		}
	</div>
}

// linkStatusBadge renders the appropriate status badge
templ linkStatusBadge(used bool) {
	if used {
		<span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-green-100 dark:bg-green-900/40 text-green-800 dark:text-green-300 border border-green-200 dark:border-green-800">
			@checkIcon()
			accepted
		</span>
	} else {
		<span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-yellow-100 dark:bg-yellow-900/40 text-yellow-800 dark:text-yellow-300 border border-yellow-200 dark:border-yellow-800">
			@clockIcon()
			pending
		</span>
	}
}

func copyButtonClass(primaryColor string) string {
	if primaryColor != "" {
		return "bg-theme-primary hover:bg-theme-primary-hover"
	}
	return "bg-primary-600 hover:bg-primary-700"
}

templ externalLinkIcon() {
	<svg class="ml-1.5 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
	</svg>
}

templ checkIcon() {
	<svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
		<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
	</svg>
}

templ clockIcon() {
	<svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
		<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
	</svg>
}
