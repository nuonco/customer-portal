package partials

import (
	"strings"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
)

// TopbarProps for the topbar with breadcrumbs
type TopbarProps struct {
	Breadcrumbs []Breadcrumb
	User        *models.User
	BasePath    string
	CurrentOrg  *models.NuonOrg
	Orgs        []models.NuonOrg
	IsSuperuser bool
}

// Breadcrumb for navigation trail
type Breadcrumb struct {
	Text   string
	Path   string
	Active bool
}

// Topbar renders the topbar with breadcrumbs and user dropdown
templ Topbar(props TopbarProps) {
	<header class="stratus-topbar">
		<!-- Left side: Toggle + Breadcrumbs -->
		<div class="flex items-center">
			<!-- Sidebar Toggle Button with Tooltip -->
			<div class="stratus-tooltip-container mr-3">
				<button onclick="toggleMainSidebar()" class="stratus-sidebar-toggle" aria-label="Toggle sidebar">
					@sidebarToggleIcon()
				</button>
				<div class="stratus-tooltip stratus-tooltip-bottom">
					<span>Toggle sidebar</span>
					<div class="flex gap-0.5 ml-2">
						<kbd class="stratus-kbd-sm">Alt</kbd>
						<kbd class="stratus-kbd-sm">S</kbd>
					</div>
				</div>
			</div>
			<!-- Breadcrumb Navigation -->
			<nav aria-label="Breadcrumb" class="stratus-breadcrumb">
				for i, crumb := range props.Breadcrumbs {
					if i > 0 {
						@caretRightIcon()
					}
					if crumb.Active {
						<span class="stratus-breadcrumb-current">{ crumb.Text }</span>
					} else {
						<a href={ templ.SafeURL(crumb.Path) } class="stratus-breadcrumb-link">{ crumb.Text }</a>
					}
				}
			</nav>
		</div>
		<!-- User Profile Dropdown -->
		if props.User != nil {
			<div class="relative" id="userMenuContainer">
				<button type="button" onclick="toggleUserMenu()" class="stratus-profile-button" id="userMenuButton">
					<!-- Avatar -->
					<div class="stratus-profile-avatar">
						{ getInitial(props.User.Email) }
					</div>
					<!-- User info -->
					<div class="stratus-profile-text">
						if props.User.Name != "" {
							<span class="stratus-profile-name">{ props.User.Name }</span>
							<span class="stratus-profile-email">{ props.User.Email }</span>
						} else {
							<span class="stratus-profile-name">{ props.User.Email }</span>
						}
					</div>
					@caretDownIcon()
				</button>
				<!-- Dropdown Menu -->
				<div id="userDropdown" class="stratus-profile-menu hidden">
					<!-- Profile Settings Button -->
					<button
						type="button"
						hx-get={ props.BasePath + "/profile/panel" }
						hx-target="#settings-panel-container"
						hx-trigger="click"
						hx-swap="innerHTML"
						class="stratus-menu-item-dashboard"
					>
						<span>Profile</span>
						@userIcon()
					</button>
					<!-- Keyboard Shortcuts Button -->
					<button type="button" onclick="openKeyboardShortcutsModal()" class="stratus-menu-item-dashboard">
						<span>Keyboard shortcuts</span>
						@keyboardIcon()
					</button>
					if props.IsSuperuser {
						<!-- Superuser Button -->
						<button
							type="button"
							hx-get={ props.BasePath + "/superuser/panel" }
							hx-target="#settings-panel-container"
							hx-trigger="click"
							hx-swap="innerHTML"
							class="stratus-menu-item-dashboard"
						>
							<span>Superuser</span>
							@superuserMenuIcon()
						</button>
					}
					<hr class="stratus-menu-divider"/>
					<!-- Logout Button -->
					<button type="button" onclick="logout()" class="stratus-menu-item-dashboard logout">
						<span>Log out</span>
						@signOutIcon()
					</button>
				</div>
			</div>
		}
	</header>
	@topbarScript()
}

func getInitial(email string) string {
	if email == "" {
		return "U"
	}
	return strings.ToUpper(string(email[0]))
}

templ topbarScript() {
	<script>
		function toggleUserMenu() {
			const dropdown = document.getElementById('userDropdown');
			dropdown.classList.toggle('hidden');
		}

		// Close dropdown when clicking outside
		document.addEventListener('click', function(event) {
			const container = document.getElementById('userMenuContainer');
			const dropdown = document.getElementById('userDropdown');
			if (container && dropdown && !container.contains(event.target)) {
				dropdown.classList.add('hidden');
			}
		});
	</script>
}

templ sidebarToggleIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor">
		<path d="M216,40H40A16,16,0,0,0,24,56V200a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A16,16,0,0,0,216,40ZM40,56H80V200H40ZM216,200H96V56H216V200Z"></path>
	</svg>
}

templ caretRightIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" class="w-4 h-4 stratus-breadcrumb-separator">
		<path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z"></path>
	</svg>
}

templ caretDownIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" class="w-4 h-4 text-cool-grey-400 dark:text-cool-grey-500 flex-shrink-0">
		<path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"></path>
	</svg>
}

