package partials

import (
	"strings"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
)

// TopbarProps for the topbar with breadcrumbs
type TopbarProps struct {
	Breadcrumbs      []Breadcrumb
	User             *models.User
	BasePath         string
	CurrentWorkspace *models.Workspace
	Workspaces       []models.Workspace
}

// Breadcrumb for navigation trail
type Breadcrumb struct {
	Text   string
	Path   string
	Active bool
}

// Topbar renders the topbar with breadcrumbs and user dropdown
templ Topbar(props TopbarProps) {
	<header class="stratus-topbar">
		<!-- Left side: Toggle + Breadcrumbs -->
		<div class="flex items-center">
			<!-- Sidebar Toggle Button with Tooltip -->
			<div class="stratus-tooltip-container mr-3">
				<button onclick="toggleMainSidebar()" class="stratus-sidebar-toggle" aria-label="Toggle sidebar">
					@sidebarToggleIcon()
				</button>
				<div class="stratus-tooltip stratus-tooltip-bottom">
					<span>Toggle sidebar</span>
					<div class="flex gap-0.5 ml-2">
						<kbd class="stratus-kbd-sm">Alt</kbd>
						<kbd class="stratus-kbd-sm">S</kbd>
					</div>
				</div>
			</div>
			<!-- Breadcrumb Navigation -->
			<nav aria-label="Breadcrumb" class="stratus-breadcrumb">
				for i, crumb := range props.Breadcrumbs {
					if i > 0 {
						@caretRightIcon()
					}
					if crumb.Active {
						<span class="stratus-breadcrumb-current">{ crumb.Text }</span>
					} else {
						<a href={ templ.SafeURL(crumb.Path) } class="stratus-breadcrumb-link">{ crumb.Text }</a>
					}
				}
			</nav>
		</div>
		<!-- User Profile Dropdown -->
		if props.User != nil {
			<div class="relative" id="userMenuContainer">
				<button type="button" onclick="toggleUserMenu()" class="stratus-profile-button" id="userMenuButton">
					<!-- Avatar -->
					<div class="stratus-profile-avatar">
						{ getInitial(props.User.Email) }
					</div>
					<!-- User info -->
					<div class="stratus-profile-text">
						if props.User.Name != "" {
							<span class="stratus-profile-name">{ props.User.Name }</span>
							<span class="stratus-profile-email">{ props.User.Email }</span>
						} else {
							<span class="stratus-profile-name">{ props.User.Email }</span>
						}
					</div>
					@caretDownIcon()
				</button>
				<!-- Dropdown Menu -->
				<div id="userDropdown" class="stratus-profile-menu hidden">
					<!-- Workspace Section -->
					<div class="stratus-menu-label">Workspace</div>
					if props.CurrentWorkspace != nil {
						<!-- Current Workspace Display -->
						<div class="px-3 py-2 text-sm text-cool-grey-900 dark:text-white font-medium flex items-center gap-2">
							<span class="w-6 h-6 rounded bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center text-xs font-semibold text-primary-700 dark:text-primary-300">
								{ getWorkspaceInitials(props.CurrentWorkspace.Name) }
							</span>
							<span class="truncate">{ props.CurrentWorkspace.Name }</span>
						</div>
						<!-- Workspace Switcher (if multiple workspaces) -->
						if len(props.Workspaces) > 1 {
							<div class="px-3 py-1">
								<div class="text-xs text-cool-grey-500 dark:text-cool-grey-400 mb-1">Switch workspace</div>
								<div class="max-h-32 overflow-y-auto space-y-0.5">
									for _, ws := range props.Workspaces {
										if ws.ID != props.CurrentWorkspace.ID {
											<button
												type="button"
												onclick={ templ.ComponentScript{Call: "switchWorkspace('" + ws.ID + "')"} }
												class="w-full text-left px-2 py-1.5 text-sm rounded hover:bg-cool-grey-100 dark:hover:bg-dark-grey-700 flex items-center gap-2"
											>
												<span class="w-5 h-5 rounded bg-cool-grey-200 dark:bg-dark-grey-600 flex items-center justify-center text-xs font-medium">
													{ getWorkspaceInitials(ws.Name) }
												</span>
												<span class="truncate">{ ws.Name }</span>
											</button>
										}
									}
								</div>
							</div>
						}
					}
					<!-- Create Workspace Button -->
					<button type="button" onclick="openCreateWorkspaceModal()" class="stratus-menu-item-dashboard">
						<span>Create workspace</span>
						@plusCircleIcon()
					</button>
					<!-- Workspace Settings Button -->
					<button
						type="button"
						hx-get={ props.BasePath + "/workspace/settings/panel" }
						hx-target="#settings-panel-container"
						hx-trigger="click"
						hx-swap="innerHTML"
						class="stratus-menu-item-dashboard"
					>
						<span>Workspace settings</span>
						@workspaceIcon()
					</button>
					<hr class="stratus-menu-divider"/>
					<!-- Section Label -->
					<div class="stratus-menu-label">Org settings</div>
					<!-- Theme Settings Button - lazy loads panel content via HTMX -->
					<button
						type="button"
						hx-get={ props.BasePath + "/settings/panel" }
						hx-target="#settings-panel-container"
						hx-trigger="click"
						hx-swap="innerHTML"
						class="stratus-menu-item-dashboard"
					>
						<span>Theme settings</span>
						@paletteIcon()
					</button>
					<!-- Custom Theme Button - lazy loads panel content via HTMX -->
					<button
						type="button"
						hx-get={ props.BasePath + "/settings/customization/panel" }
						hx-target="#settings-panel-container"
						hx-trigger="click"
						hx-swap="innerHTML"
						class="stratus-menu-item-dashboard"
					>
						<span>Custom theme</span>
						@codeIcon()
					</button>
					<!-- Customer Auth Settings Button - lazy loads panel content via HTMX -->
					<button
						type="button"
						hx-get={ props.BasePath + "/settings/customer-auth/panel" }
						hx-target="#settings-panel-container"
						hx-trigger="click"
						hx-swap="innerHTML"
						class="stratus-menu-item-dashboard"
					>
						<span>Customer auth</span>
						@usersMenuIcon()
					</button>
					<hr class="stratus-menu-divider"/>
					<!-- Account Section Label -->
					<div class="stratus-menu-label">Account</div>
					<!-- Profile Settings Button -->
					<button
						type="button"
						hx-get={ props.BasePath + "/profile/panel" }
						hx-target="#settings-panel-container"
						hx-trigger="click"
						hx-swap="innerHTML"
						class="stratus-menu-item-dashboard"
					>
						<span>Profile</span>
						@userIcon()
					</button>
					<!-- Keyboard Shortcuts Button -->
					<button type="button" onclick="openKeyboardShortcutsModal()" class="stratus-menu-item-dashboard">
						<span>Keyboard shortcuts</span>
						@keyboardIcon()
					</button>
					<hr class="stratus-menu-divider"/>
					<!-- Logout Button -->
					<button type="button" onclick="logout()" class="stratus-menu-item-dashboard logout">
						<span>Log out</span>
						@signOutIcon()
					</button>
				</div>
			</div>
		}
	</header>
	@topbarScript()
}

func getInitial(email string) string {
	if email == "" {
		return "U"
	}
	return strings.ToUpper(string(email[0]))
}

func getWorkspaceInitials(name string) string {
	if name == "" {
		return "W"
	}
	words := strings.Fields(name)
	if len(words) >= 2 {
		return strings.ToUpper(string(words[0][0])) + strings.ToUpper(string(words[1][0]))
	}
	runes := []rune(name)
	if len(runes) >= 2 {
		return strings.ToUpper(string(runes[0:2]))
	}
	return strings.ToUpper(string(runes[0]))
}

templ topbarScript() {
	<script>
		function toggleUserMenu() {
			const dropdown = document.getElementById('userDropdown');
			dropdown.classList.toggle('hidden');
		}

		// Close dropdown when clicking outside
		document.addEventListener('click', function(event) {
			const container = document.getElementById('userMenuContainer');
			const dropdown = document.getElementById('userDropdown');
			if (container && dropdown && !container.contains(event.target)) {
				dropdown.classList.add('hidden');
			}
		});

		// Switch workspace
		async function switchWorkspace(workspaceId) {
			try {
				const response = await fetch('/admin/workspace/switch', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json'
					},
					credentials: 'same-origin',
					body: JSON.stringify({ workspace_id: workspaceId })
				});

				if (response.ok) {
					const data = await response.json();
					window.location.href = data.redirect_to || '/admin/orgs';
				} else {
					const error = await response.json();
					if (typeof showToast === 'function') {
						showToast(error.error || 'Failed to switch workspace', 'error');
					} else {
						alert(error.error || 'Failed to switch workspace');
					}
				}
			} catch (err) {
				if (typeof showToast === 'function') {
					showToast('Network error. Please try again.', 'error');
				} else {
					alert('Network error. Please try again.');
				}
			}
		}
	</script>
}

