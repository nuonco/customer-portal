package partials

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
)

type SuperuserPanelProps struct {
	User     *models.User
	BasePath string
}

templ SuperuserPanel(props SuperuserPanelProps) {
	<div id="superuser-panel" class="stratus-panel panel-hidden" data-base-path={ props.BasePath }>
		<!-- Overlay -->
		<div class="stratus-panel-overlay" onclick="closeSuperuserPanel()"></div>
		<!-- Panel Container -->
		<div class="stratus-panel-container" style="max-width: 32rem;">
			<!-- Header -->
			<div class="stratus-panel-header">
				<div class="stratus-panel-title">
					@superuserShieldIcon()
					<span>Superuser</span>
				</div>
				<div class="flex items-center gap-2">
					<button type="button" onclick="toggleSuperuserPanelSize()" class="stratus-panel-action" id="superuserPanelExpandBtn" title="Expand to full screen">
						@superuserExpandIcon()
						@superuserCollapseIcon()
					</button>
					<button type="button" onclick="closeSuperuserPanel()" class="stratus-panel-action" title="Close panel">
						@superuserArrowRightIcon()
					</button>
				</div>
			</div>
			<!-- Content -->
			<div class="stratus-panel-content">
				<p class="text-cool-grey-600 dark:text-cool-grey-400 mb-4">
					Search and manage organizations.
				</p>
				<!-- Search -->
				<div class="mb-4">
					<input
						type="text"
						name="q"
						placeholder="Search by name, subdomain, or org ID..."
						hx-get={ props.BasePath + "/superuser/orgs/search" }
						hx-trigger="keyup changed delay:300ms"
						hx-target="#superuser-search-results"
						hx-swap="innerHTML"
						class="w-full px-3 py-2 text-sm border border-cool-grey-300 dark:border-dark-grey-500 rounded-md bg-white dark:bg-dark-grey-800 text-cool-grey-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 placeholder-cool-grey-400 dark:placeholder-cool-grey-500"
					/>
				</div>
				<!-- Search Results -->
				<div id="superuser-search-results"></div>
				<!-- Org Detail -->
				<div id="superuser-org-detail"></div>
			</div>
		</div>
	</div>
	@superuserPanelScript()
}

templ superuserPanelScript() {
	<script>
		(function() {
			function openSuperuserPanel() {
				const panel = document.getElementById('superuser-panel');
				panel.classList.remove('panel-hidden');
				panel.classList.add('panel-visible');
				document.body.classList.add('overflow-hidden');
				const userDropdown = document.getElementById('userDropdown');
				if (userDropdown) userDropdown.classList.add('hidden');
			}

			function closeSuperuserPanel() {
				const panel = document.getElementById('superuser-panel');
				panel.classList.remove('panel-visible', 'panel-full');
				panel.classList.add('panel-hidden');
				document.body.classList.remove('overflow-hidden');
				document.getElementById('superuserExpandIcon')?.classList.remove('hidden');
				document.getElementById('superuserCollapseIcon')?.classList.add('hidden');
				document.getElementById('superuserPanelExpandBtn')?.setAttribute('title', 'Expand to full screen');
				setTimeout(function() {
					document.getElementById('settings-panel-container').innerHTML = '';
				}, 300);
			}

			function toggleSuperuserPanelSize() {
				const panel = document.getElementById('superuser-panel');
				const container = panel.querySelector('.stratus-panel-container');
				const expandIcon = document.getElementById('superuserExpandIcon');
				const collapseIcon = document.getElementById('superuserCollapseIcon');
				const expandBtn = document.getElementById('superuserPanelExpandBtn');

				if (panel.classList.contains('panel-full')) {
					panel.classList.remove('panel-full');
					container.style.maxWidth = '32rem';
					expandIcon.classList.remove('hidden');
					collapseIcon.classList.add('hidden');
					expandBtn.setAttribute('title', 'Expand to full screen');
				} else {
					panel.classList.add('panel-full');
					container.style.maxWidth = 'none';
					expandIcon.classList.add('hidden');
					collapseIcon.classList.remove('hidden');
					expandBtn.setAttribute('title', 'Resize to default size');
				}
			}

			window.openSuperuserPanel = openSuperuserPanel;
			window.closeSuperuserPanel = closeSuperuserPanel;
			window.toggleSuperuserPanelSize = toggleSuperuserPanelSize;

			document.addEventListener('keydown', function(e) {
				if (e.key === 'Escape') {
					const panel = document.getElementById('superuser-panel');
					if (panel && panel.classList.contains('panel-visible')) {
						closeSuperuserPanel();
					}
				}
			});

			openSuperuserPanel();
		})();
	</script>
}

templ superuserShieldIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor">
		<path d="M208,40H48A16,16,0,0,0,32,56v58.77c0,89.61,75.82,119.34,91,124.39a15.53,15.53,0,0,0,10,0c15.2-5.05,91-34.78,91-124.39V56A16,16,0,0,0,208,40Zm0,74.79c0,78.42-66.35,104.62-80,109.18-13.53-4.51-80-30.69-80-109.18V56H208ZM82.34,141.66a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35a8,8,0,0,1,11.32,11.32l-56,56a8,8,0,0,1-11.32,0Z"></path>
	</svg>
}

