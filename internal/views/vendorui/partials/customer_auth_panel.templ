package partials

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
)

// CustomerAuthPanelProps for the customer auth settings panel
type CustomerAuthPanelProps struct {
	Config   *models.CustomerAuthConfig
	BasePath string
}

// CustomerAuthPanel renders the customer auth settings slide-in panel
templ CustomerAuthPanel(props CustomerAuthPanelProps) {
	<div
		id="customer-auth-panel"
		class="stratus-panel panel-hidden"
		data-base-path={ props.BasePath }
		data-enabled={ authBoolToString(props.Config.Enabled) }
		data-has-secret={ authBoolToString(props.Config.HasClientSecret()) }
	>
		<!-- Overlay - click to close -->
		<div class="stratus-panel-overlay" onclick="closeCustomerAuthPanel()"></div>
		<!-- Panel Container -->
		<div class="stratus-panel-container">
			<!-- Header -->
			<div class="stratus-panel-header">
				<div class="stratus-panel-title">
					@authUsersIcon()
					<span>Customer Auth</span>
				</div>
				<div class="flex items-center gap-2">
					<!-- Expand/Collapse button -->
					<button type="button" onclick="toggleCustomerAuthPanelSize()" class="stratus-panel-action" id="customerAuthPanelExpandBtn" title="Expand to full screen">
						@authExpandIcon()
						@authCollapseIcon()
					</button>
					<!-- Close button -->
					<button type="button" onclick="closeCustomerAuthPanel()" class="stratus-panel-action" title="Close panel">
						@authArrowRightIcon()
					</button>
				</div>
			</div>
			<!-- Scrollable Content -->
			<div class="stratus-panel-content">
				<p class="text-cool-grey-600 dark:text-cool-grey-400 mb-6">
					Configure how your customers authenticate when accepting install links.
				</p>
				<div class="space-y-6">
					<!-- Enable Toggle -->
					@authEnableToggle(props.Config)
					<!-- OIDC Configuration -->
					@authOidcConfig(props.Config)
					<!-- Info Section -->
					@authInfoSection()
					<!-- Save Button -->
					<div class="flex space-x-3">
						<button type="button" id="customerAuthSaveBtn" onclick="saveCustomerAuthSettings()" class="flex-1 inline-flex items-center justify-center px-5 py-2.5 text-sm rounded-md font-medium text-white bg-primary-600 hover:bg-primary-700">
							Save Changes
						</button>
					</div>
					<!-- Status Messages -->
					<div id="customerAuthSuccessMessage" class="hidden p-3 bg-green-100 border border-green-400 text-green-700 rounded-lg text-sm">
						Settings saved successfully!
					</div>
					<div id="customerAuthErrorMessage" class="hidden p-3 bg-red-100 border border-red-400 text-red-700 rounded-lg text-sm"></div>
				</div>
			</div>
		</div>
	</div>
	@customerAuthPanelScript()
}

func authBoolToString(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

templ authEnableToggle(config *models.CustomerAuthConfig) {
	<div class="bg-cool-grey-50 dark:bg-dark-grey-800 p-5 rounded-lg border border-cool-grey-200 dark:border-dark-grey-600">
		<div class="flex items-center justify-between">
			<div>
				<h3 class="text-base font-semibold text-cool-grey-800 dark:text-white">OIDC Authentication</h3>
				<p class="text-xs text-cool-grey-600 dark:text-cool-grey-400 mt-1">
					Enable SSO for customers using an OIDC provider
				</p>
			</div>
			<label class="relative inline-flex items-center cursor-pointer">
				<input
					type="checkbox"
					id="panelOidcEnabled"
					class="sr-only peer"
					if config.Enabled {
						checked
					}
				/>
				<div class="w-11 h-6 bg-cool-grey-300 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary-300 dark:peer-focus:ring-primary-800 rounded-full peer dark:bg-dark-grey-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-cool-grey-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-dark-grey-600 peer-checked:bg-primary-600"></div>
			</label>
		</div>
		<div id="panelEnabledStatus" class="mt-3">
			if config.Enabled {
				<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400">
					<svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
					</svg>
					OIDC Enabled
				</span>
			} else {
				<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-cool-grey-100 text-cool-grey-800 dark:bg-dark-grey-700 dark:text-cool-grey-300">
					Email/password authentication
				</span>
			}
		</div>
	</div>
}

templ authOidcConfig(config *models.CustomerAuthConfig) {
	<div class="bg-cool-grey-50 dark:bg-dark-grey-800 p-5 rounded-lg border border-cool-grey-200 dark:border-dark-grey-600">
		<h3 class="text-base font-semibold mb-4 text-cool-grey-800 dark:text-white">OIDC Configuration</h3>
		<div class="space-y-4">
			<!-- Provider Name -->
			<div>
				<label for="panelProviderName" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">
					Provider
				</label>
				<select
					id="panelProviderName"
					class="w-full px-3 py-2 text-sm border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-700 dark:text-white rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600"
				>
					<option value="" if config.ProviderName == "" { selected }>Select a provider...</option>
					<option value="Google" if config.ProviderName == "Google" { selected }>Google</option>
					<option value="Okta" if config.ProviderName == "Okta" { selected }>Okta</option>
					<option value="Auth0" if config.ProviderName == "Auth0" { selected }>Auth0</option>
					<option value="Azure AD" if config.ProviderName == "Azure AD" { selected }>Azure AD</option>
					<option value="Custom" if config.ProviderName == "Custom" { selected }>Custom OIDC</option>
				</select>
			</div>
			<!-- Issuer URL -->
			<div>
				<label for="panelIssuerUrl" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">
					Issuer URL <span class="text-red-500">*</span>
				</label>
				<input
					type="url"
					id="panelIssuerUrl"
					value={ config.IssuerURL }
					placeholder="https://accounts.google.com"
					class="w-full px-3 py-2 text-sm border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-700 dark:text-white rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600"
				/>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">
					The OIDC discovery endpoint URL
				</p>
			</div>
			<!-- Client ID -->
			<div>
				<label for="panelClientId" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">
					Client ID <span class="text-red-500">*</span>
				</label>
				<input
					type="text"
					id="panelClientId"
					value={ config.ClientID }
					placeholder="your-client-id"
					class="w-full px-3 py-2 text-sm border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-700 dark:text-white rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600"
				/>
			</div>
			<!-- Client Secret -->
			<div>
				<label for="panelClientSecret" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">
					Client Secret <span class="text-red-500">*</span>
				</label>
				<div class="relative">
					<input
						type="password"
						id="panelClientSecret"
						placeholder={ getAuthSecretPlaceholder(config.HasClientSecret()) }
						class="w-full px-3 py-2 text-sm border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-700 dark:text-white rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600 pr-10"
					/>
					<button
						type="button"
						onclick="togglePanelSecretVisibility()"
						class="absolute inset-y-0 right-0 pr-3 flex items-center text-cool-grey-400 hover:text-cool-grey-600"
					>
						<svg id="panelEyeIcon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
						</svg>
					</button>
				</div>
				if config.HasClientSecret() {
					<p class="mt-1 text-xs text-green-600 dark:text-green-400">
						<svg class="w-3 h-3 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
						</svg>
						Secret configured. Leave blank to keep existing.
					</p>
				}
			</div>
			<!-- Scopes -->
			<div>
				<label for="panelScopes" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">
					Scopes
				</label>
				<input
					type="text"
					id="panelScopes"
					value={ getAuthScopesValue(config.Scopes) }
					placeholder="openid,profile,email"
					class="w-full px-3 py-2 text-sm border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-700 dark:text-white rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600"
				/>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">
					Comma-separated OAuth scopes
				</p>
			</div>
			<!-- Test Connection Button -->
			<div class="pt-4 border-t border-cool-grey-200 dark:border-dark-grey-600">
				<button
					type="button"
					id="panelTestConnectionBtn"
					onclick="testPanelConnection()"
					class="inline-flex items-center px-4 py-2 text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 bg-white dark:bg-dark-grey-700 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md hover:bg-cool-grey-50 dark:hover:bg-dark-grey-600"
				>
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
					Test Connection
				</button>
				<div id="panelTestResult" class="mt-3 hidden"></div>
			</div>
		</div>
	</div>
}

func getAuthSecretPlaceholder(hasSecret bool) string {
	if hasSecret {
		return "••••••••••••••••"
	}
	return "Enter client secret"
}

func getAuthScopesValue(scopes string) string {
	if scopes == "" {
		return "openid,profile,email"
	}
	return scopes
}

templ authInfoSection() {
	<div class="bg-blue-50 dark:bg-blue-900/20 p-4 rounded-lg border border-blue-200 dark:border-blue-800">
		<div class="flex">
			<svg class="w-5 h-5 text-blue-500 dark:text-blue-400 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
			</svg>
			<div>
				<h4 class="text-sm font-medium text-blue-800 dark:text-blue-300">Fallback Mode</h4>
				<p class="mt-1 text-xs text-blue-700 dark:text-blue-400">
					When OIDC is disabled, customers use email/password.
				</p>
			</div>
		</div>
	</div>
}

templ customerAuthPanelScript() {
	<script>
		(function() {
			const panel = document.getElementById('customer-auth-panel');
			const basePath = panel.dataset.basePath;

			function openCustomerAuthPanel() {
				panel.classList.remove('panel-hidden');
				panel.classList.add('panel-visible');
				document.body.classList.add('overflow-hidden');
				const userDropdown = document.getElementById('userDropdown');
				if (userDropdown) userDropdown.classList.add('hidden');
			}

			function closeCustomerAuthPanel() {
				panel.classList.remove('panel-visible', 'panel-full');
				panel.classList.add('panel-hidden');
				document.body.classList.remove('overflow-hidden');
				document.getElementById('authExpandIcon')?.classList.remove('hidden');
				document.getElementById('authCollapseIcon')?.classList.add('hidden');
				document.getElementById('customerAuthPanelExpandBtn')?.setAttribute('title', 'Expand to full screen');
				setTimeout(function() {
					document.getElementById('settings-panel-container').innerHTML = '';
				}, 300);
			}

			function toggleCustomerAuthPanelSize() {
				const container = panel.querySelector('.stratus-panel-container');
				const expandIcon = document.getElementById('authExpandIcon');
				const collapseIcon = document.getElementById('authCollapseIcon');
				const expandBtn = document.getElementById('customerAuthPanelExpandBtn');

				if (panel.classList.contains('panel-full')) {
					panel.classList.remove('panel-full');
					expandIcon.classList.remove('hidden');
					collapseIcon.classList.add('hidden');
					expandBtn.setAttribute('title', 'Expand to full screen');
				} else {
					panel.classList.add('panel-full');
					expandIcon.classList.add('hidden');
					collapseIcon.classList.remove('hidden');
					expandBtn.setAttribute('title', 'Resize to default size');
				}
			}

			window.openCustomerAuthPanel = openCustomerAuthPanel;
			window.closeCustomerAuthPanel = closeCustomerAuthPanel;
			window.toggleCustomerAuthPanelSize = toggleCustomerAuthPanelSize;

			// Toggle enable status display
			document.getElementById('panelOidcEnabled')?.addEventListener('change', function(e) {
				const statusDiv = document.getElementById('panelEnabledStatus');
				if (e.target.checked) {
					statusDiv.innerHTML = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400"><svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>OIDC Enabled</span>';
				} else {
					statusDiv.innerHTML = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-cool-grey-100 text-cool-grey-800 dark:bg-dark-grey-700 dark:text-cool-grey-300">Email/password authentication</span>';
				}
			});

			// Toggle secret visibility
			window.togglePanelSecretVisibility = function() {
				const input = document.getElementById('panelClientSecret');
				const icon = document.getElementById('panelEyeIcon');
				if (input.type === 'password') {
					input.type = 'text';
					icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>';
				} else {
					input.type = 'password';
					icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>';
				}
			};

			function getPanelFormData() {
				return {
					enabled: document.getElementById('panelOidcEnabled').checked,
					provider_name: document.getElementById('panelProviderName').value,
					issuer_url: document.getElementById('panelIssuerUrl').value,
					client_id: document.getElementById('panelClientId').value,
					client_secret: document.getElementById('panelClientSecret').value,
					scopes: document.getElementById('panelScopes').value
				};
			}

			// Test connection
			window.testPanelConnection = async function() {
				const btn = document.getElementById('panelTestConnectionBtn');
				const resultDiv = document.getElementById('panelTestResult');

				btn.disabled = true;
				btn.innerHTML = '<svg class="animate-spin w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>Testing...';

				const formData = getPanelFormData();

				try {
					// Save settings first
					const saveResponse = await fetch(basePath + '/settings/customer-auth', {
						method: 'PUT',
						headers: { 'Content-Type': 'application/json' },
						credentials: 'same-origin',
						body: JSON.stringify(formData)
					});

					if (!saveResponse.ok) {
						throw new Error('Failed to save settings');
					}

					// Then test the connection
					const response = await fetch(basePath + '/settings/customer-auth/test', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						credentials: 'same-origin'
					});

					const data = await response.json();

					resultDiv.classList.remove('hidden');
					if (response.ok) {
						resultDiv.innerHTML = '<div class="p-2 bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-800 text-green-700 dark:text-green-300 rounded-md text-xs">Connection successful!</div>';
					} else {
						resultDiv.innerHTML = '<div class="p-2 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-300 rounded-md text-xs">Failed: ' + (data.error || 'Unknown error') + '</div>';
					}
				} catch (error) {
					resultDiv.classList.remove('hidden');
					resultDiv.innerHTML = '<div class="p-2 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-300 rounded-md text-xs">Error: ' + error.message + '</div>';
				}

				btn.disabled = false;
				btn.innerHTML = '<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>Test Connection';
			};

			// Save settings
			window.saveCustomerAuthSettings = async function() {
				const saveButton = document.getElementById('customerAuthSaveBtn');
				const successMessage = document.getElementById('customerAuthSuccessMessage');
				const errorMessage = document.getElementById('customerAuthErrorMessage');

				saveButton.textContent = 'Saving...';
				saveButton.disabled = true;
				successMessage.classList.add('hidden');
				errorMessage.classList.add('hidden');

				const formData = getPanelFormData();

				try {
					const response = await fetch(basePath + '/settings/customer-auth', {
						method: 'PUT',
						headers: { 'Content-Type': 'application/json' },
						credentials: 'same-origin',
						body: JSON.stringify(formData)
					});

					const data = await response.json();

					if (response.ok) {
						successMessage.classList.remove('hidden');
						showToast('Customer auth settings saved!', 'success');
						setTimeout(function() {
							successMessage.classList.add('hidden');
							closeCustomerAuthPanel();
						}, 1500);
					} else {
						errorMessage.textContent = data.error || 'Failed to save settings';
						errorMessage.classList.remove('hidden');
					}
				} catch (error) {
					errorMessage.textContent = 'Network error. Please try again.';
					errorMessage.classList.remove('hidden');
				}

				saveButton.textContent = 'Save Changes';
				saveButton.disabled = false;
			};

			// Escape key to close
			document.addEventListener('keydown', function(e) {
				if (e.key === 'Escape') {
					if (panel && panel.classList.contains('panel-visible')) {
						closeCustomerAuthPanel();
					}
				}
			});

			openCustomerAuthPanel();
		})();
	</script>
}

templ authUsersIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor">
		<path d="M117.25,157.92a60,60,0,1,0-66.5,0A95.83,95.83,0,0,0,3.53,195.63a8,8,0,1,0,13.4,8.74,80,80,0,0,1,134.14,0,8,8,0,0,0,13.4-8.74A95.83,95.83,0,0,0,117.25,157.92ZM40,108a44,44,0,1,1,44,44A44.05,44.05,0,0,1,40,108Zm210.14,98.7a8,8,0,0,1-11.07-2.33A79.83,79.83,0,0,0,172,168a8,8,0,0,1,0-16,44,44,0,1,0-16.34-84.87,8,8,0,1,1-5.94-14.85,60,60,0,0,1,55.53,105.64,95.83,95.83,0,0,1,47.22,37.71A8,8,0,0,1,250.14,206.7Z"></path>
	</svg>
}

templ authExpandIcon() {
	<svg id="authExpandIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor">
		<path d="M216,48V88a8,8,0,0,1-16,0V56H168a8,8,0,0,1,0-16h40A8,8,0,0,1,216,48ZM88,200H56V168a8,8,0,0,0-16,0v40a8,8,0,0,0,8,8H88a8,8,0,0,0,0-16Zm120-40a8,8,0,0,0-8,8v32H168a8,8,0,0,0,0,16h40a8,8,0,0,0,8-8V168A8,8,0,0,0,208,160ZM88,40H48a8,8,0,0,0-8,8V88a8,8,0,0,0,16,0V56H88a8,8,0,0,0,0-16Z"></path>
	</svg>
}

templ authCollapseIcon() {
	<svg id="authCollapseIcon" class="hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor">
