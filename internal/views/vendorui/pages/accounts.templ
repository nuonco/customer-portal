package pages

import (
	"fmt"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui/components"
)

// AccountWithCounts represents a customer account with member and install counts
type AccountWithCounts struct {
	ID           string
	Name         string
	MemberCount  int64
	InstallCount int64
	CreatedAt    string
}

// AccountsPageProps for the accounts list page
type AccountsPageProps struct {
	vendorui.LayoutProps
	Org         models.NuonOrg
	Accounts    []AccountWithCounts
	SearchQuery string
}

// AccountsPage renders the customer accounts list page
templ AccountsPage(props AccountsPageProps) {
	@vendorui.Layout(props.LayoutProps) {
		<div class="flex flex-1 overflow-hidden">
			@components.CustomerSubnav(components.CustomerSubnavProps{
				OrgID:         props.Org.ID,
				ActiveSubPage: "accounts",
				BasePath:      props.BasePath,
			})
		<div class="stratus-page-content overflow-auto">
			<div class="stratus-page-header">
				<div class="stratus-heading-group">
					<h1 class="stratus-page-title">Accounts</h1>
					<p class="stratus-page-subtitle">View customer company accounts and their members.</p>
				</div>
			</div>
			<div class="stratus-page-section">
				if len(props.Accounts) > 0 || props.SearchQuery != "" {
					<div class="mb-4">
						<input
							type="text"
							name="q"
							value={ props.SearchQuery }
							placeholder="Search by account name..."
							class="w-full px-4 py-2 border border-cool-grey-300 dark:border-dark-grey-600 rounded-lg bg-white dark:bg-dark-grey-900 text-cool-grey-900 dark:text-white placeholder-cool-grey-500 dark:placeholder-cool-grey-400 focus:outline-none focus:ring-2 focus:ring-primary-500 dark:focus:ring-primary-400 focus:border-transparent"
							hx-get={ fmt.Sprintf("%s/orgs/%s/accounts", props.BasePath, props.Org.ID) }
							hx-trigger="keyup changed delay:300ms"
							hx-target="#accounts-table-body"
						/>
					</div>
					<div class="bg-white dark:bg-dark-grey-900 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500 overflow-hidden">
						<table class="min-w-full divide-y divide-cool-grey-200 dark:divide-dark-grey-700">
							<thead class="bg-cool-grey-50 dark:bg-dark-grey-800">
								<tr>
									<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
										Account
									</th>
									<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
										Members
									</th>
									<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
										Installs
									</th>
									<th scope="col" class="relative px-6 py-3">
										<span class="sr-only">Actions</span>
									</th>
								</tr>
							</thead>
							<tbody id="accounts-table-body" class="bg-white dark:bg-dark-grey-900 divide-y divide-cool-grey-200 dark:divide-dark-grey-700">
								if len(props.Accounts) > 0 {
									for _, account := range props.Accounts {
										@accountTableRow(account, props.Org.ID, props.BasePath)
									}
								} else {
									<tr>
										<td colspan="4" class="px-6 py-8 text-center">
											<p class="text-cool-grey-500 dark:text-cool-grey-400">
												No accounts found matching "{ props.SearchQuery }"
											</p>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				} else {
					@emptyAccountsState()
				}
			</div>
		</div>
		</div>
	}
}

// AccountsTableBody renders the table body with account rows (for HTMX)
templ AccountsTableBody(accounts []AccountWithCounts, orgID, basePath, searchQuery string) {
	if len(accounts) > 0 {
		for _, account := range accounts {
			@accountTableRow(account, orgID, basePath)
		}
	} else {
		<tr>
			<td colspan="4" class="px-6 py-8 text-center">
				<p class="text-cool-grey-500 dark:text-cool-grey-400">
					No accounts found matching "{ searchQuery }"
				</p>
			</td>
		</tr>
	}
}

templ accountTableRow(account AccountWithCounts, orgID, basePath string) {
	<tr
		class="hover:bg-cool-grey-50 dark:hover:bg-dark-grey-800 cursor-pointer"
		onclick={ templ.ComponentScript{Call: fmt.Sprintf("window.location.href='%s/orgs/%s/accounts/%s'", basePath, orgID, account.ID)} }
	>
		<td class="px-6 py-4 whitespace-nowrap">
			<div class="flex items-center">
				<div class="flex-shrink-0 h-10 w-10 rounded-full bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
					<span class="text-sm font-medium text-primary-700 dark:text-primary-300">
						{ getInitials(account.Name) }
					</span>
				</div>
				<div class="ml-4">
					<div class="text-sm font-medium text-cool-grey-900 dark:text-white">{ account.Name }</div>
					<div class="text-sm text-cool-grey-500 dark:text-cool-grey-400">{ account.ID }</div>
				</div>
			</div>
		</td>
		<td class="px-6 py-4 whitespace-nowrap">
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-cool-grey-100 dark:bg-cool-grey-700 text-cool-grey-800 dark:text-cool-grey-300">
				{ fmt.Sprintf("%d", account.MemberCount) }
			</span>
		</td>
		<td class="px-6 py-4 whitespace-nowrap">
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-cool-grey-100 dark:bg-cool-grey-700 text-cool-grey-800 dark:text-cool-grey-300">
				{ fmt.Sprintf("%d", account.InstallCount) }
			</span>
		</td>
		<td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
			<a
				href={ templ.SafeURL(fmt.Sprintf("%s/orgs/%s/accounts/%s", basePath, orgID, account.ID)) }
				class="text-primary-600 dark:text-primary-400 hover:text-primary-900 dark:hover:text-primary-300"
			>
				View Details &rarr;
			</a>
		</td>
	</tr>
}

templ emptyAccountsState() {
	<div class="bg-white dark:bg-dark-grey-900 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500 p-12 text-center">
		<div class="mx-auto flex items-center justify-center h-16 w-16 mb-4 rounded-full bg-cool-grey-100 dark:bg-dark-grey-700">
			@accountsEmptyIcon()
		</div>
		<h3 class="text-xl font-medium text-cool-grey-900 dark:text-white mb-2">No Accounts Yet</h3>
		<p class="text-cool-grey-500 dark:text-cool-grey-400 max-w-sm mx-auto">
			Customer accounts will appear here when customers set up their company accounts in the portal.
		</p>
	</div>
}

templ accountsEmptyIcon() {
	<svg class="h-5 w-5 text-cool-grey-500 dark:text-cool-grey-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
		<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 0-.008 9.75m-2.992-13.5V21"></path>
	</svg>
}
