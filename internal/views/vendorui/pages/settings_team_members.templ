package pages

import (
	"fmt"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui/components"
)

// TeamPageProps for the combined team page
type TeamPageProps struct {
	vendorui.LayoutProps
	Org         *models.NuonOrg
	Members     []models.OrgMember
	Invitations []models.OrgInvitation
}

// TeamPage renders the combined team members and invites page with tabs
templ TeamPage(props TeamPageProps) {
	@vendorui.Layout(props.LayoutProps) {
		<div class="stratus-page-content overflow-auto">
			<div class="stratus-page-header">
				<div class="stratus-heading-group">
					<h1 class="stratus-page-title">Team</h1>
					<p class="stratus-page-subtitle">Manage who has access to your organization.</p>
				</div>
				<div class="flex items-center gap-2">
					<button
						type="button"
						onclick="openModal('inviteModal')"
						class="px-4 py-2 text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-md transition-colors"
					>
						Add members
					</button>
				</div>
			</div>
			<!-- Members -->
			<div class="stratus-page-section">
				<h3 class="text-base font-semibold text-cool-grey-900 dark:text-white mb-4">Members ({ fmt.Sprintf("%d", len(props.Members)) })</h3>
				@teamMembersList(props.Members, props.LayoutProps.User)
			</div>
			<!-- Invited -->
			<div class="stratus-page-section mt-8">
				<h3 class="text-base font-semibold text-cool-grey-900 dark:text-white mb-4">Invited ({ fmt.Sprintf("%d", countPendingInvites(props.Invitations)) })</h3>
				@invitationsList(props.Invitations)
			</div>
		</div>
		<!-- Invite Modal -->
		@components.Modal(components.ModalProps{
			ID:       "inviteModal",
			Title:    "Add members",
			MaxWidth: "max-w-md",
			OnClose:  "closeModal('inviteModal')",
		}) {
			<div class="px-6 py-6">
				<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400 mb-4">Enter email addresses, separated by commas.</p>
				<form id="inviteForm" onsubmit="return window.handleInviteSubmit(event)">
					<textarea
						id="inviteEmails"
						name="emails"
						rows="3"
						placeholder="e.g. alice@co.com, bob@co.com"
						class="w-full px-3 py-2 text-sm border border-cool-grey-300 dark:border-dark-grey-500 rounded-md bg-white dark:bg-dark-grey-800 text-cool-grey-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 placeholder-cool-grey-400 dark:placeholder-cool-grey-500 resize-none"
					></textarea>
					@components.ModalFooter() {
						@components.ModalButtonSecondary("Cancel", "closeModal('inviteModal')")
						@components.ModalButtonPrimary("Add members", templ.Attributes{"type": "submit", "id": "inviteSubmitBtn"})
					}
				</form>
			</div>
		}
		<!-- Config data for JavaScript -->
		<div
			id="team-config"
			class="hidden"
			data-base-path={ props.BasePath }
			data-org-id={ props.Org.ID }
		></div>
		@teamPageScript()
	}
}

templ teamMembersList(members []models.OrgMember, currentUser *models.User) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<div class="space-y-2">
			for _, member := range members {
				<div class="flex items-center justify-between p-3 bg-cool-grey-50 dark:bg-dark-grey-800 rounded-lg">
					<div class="flex items-center gap-3">
						<div class="w-8 h-8 rounded-full bg-primary-100 dark:bg-primary-900 flex items-center justify-center text-primary-700 dark:text-primary-300 text-sm font-medium">
							{ getMemberInitials(member.User.Name, member.User.Email) }
						</div>
						<div>
							<p class="text-sm font-medium text-cool-grey-900 dark:text-white">
								{ member.User.Name }
								if currentUser != nil && member.UserID == currentUser.ID {
									<span class="text-cool-grey-500 dark:text-cool-grey-400 font-normal">(you)</span>
								}
							</p>
							<p class="text-xs text-cool-grey-500 dark:text-cool-grey-400">{ member.User.Email }</p>
						</div>
					</div>
					if currentUser != nil && member.UserID != currentUser.ID {
						<button
							type="button"
							onclick="removeMember(this)"
							data-user-id={ member.UserID }
							data-user-name={ member.User.Name }
							class="p-1.5 text-cool-grey-400 hover:text-red-600 dark:hover:text-red-400 transition-colors"
							title="Remove member"
						>
							@teamTrashIcon()
						</button>
					}
				</div>
			}
			if len(members) == 0 {
				<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400 text-center py-4">
					No team members yet.
				</p>
			}
		</div>
	</div>
}

templ invitationsList(invitations []models.OrgInvitation) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<div class="space-y-2">
			for _, invite := range invitations {
				<div class="p-3 bg-cool-grey-50 dark:bg-dark-grey-800 rounded-lg">
					<div class="flex items-center justify-between">
						<div class="flex items-center gap-2">
							<span class="text-sm font-medium text-cool-grey-900 dark:text-white">{ invite.Email }</span>
							if invite.AcceptedAt != nil {
								<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400">Joined</span>
							} else {
								<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400">Pending</span>
							}
						</div>
						if invite.AcceptedAt == nil {
							<button
								type="button"
								onclick="deleteInvitation(this)"
								data-invite-id={ invite.ID }
								class="p-1.5 text-cool-grey-400 hover:text-red-600 dark:hover:text-red-400 transition-colors"
								title="Revoke invitation"
							>
								@teamTrashIcon()
							</button>
						}
					</div>
				</div>
			}
			if len(invitations) == 0 {
				<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400 text-center py-4">
					No pending invitations.
				</p>
			}
		</div>
	</div>
}

func countPendingInvites(invitations []models.OrgInvitation) int {
	count := 0
	for _, inv := range invitations {
		if inv.AcceptedAt == nil {
			count++
		}
	}
	return count
}

func getMemberInitials(name, email string) string {
	if name != "" {
		runes := []rune(name)
		if len(runes) >= 2 {
			words := splitMemberWords(name)
			if len(words) >= 2 {
				return string([]rune(words[0])[0:1]) + string([]rune(words[len(words)-1])[0:1])
			}
			return string(runes[0:2])
		}
		return string(runes[0:1])
	}
	if email != "" {
		runes := []rune(email)
		if len(runes) >= 2 {
			return string(runes[0:2])
		}
		return string(runes[0:1])
	}
	return "?"
}

func splitMemberWords(s string) []string {
	var words []string
	word := ""
	for _, r := range s {
		if r == ' ' || r == '-' || r == '_' {
			if word != "" {
				words = append(words, word)
				word = ""
			}
		} else {
			word += string(r)
		}
	}
	if word != "" {
		words = append(words, word)
	}
	return words
}

templ teamPageScript() {
	<script>
		(function() {
			var config = document.getElementById('team-config');
			var basePath = config.dataset.basePath;
			var orgId = config.dataset.orgId;

			// Remove member
			window.removeMember = async function(btn) {
				var userId = btn.dataset.userId;
				var userName = btn.dataset.userName;
				if (!confirm('Remove ' + userName + ' from this organization?')) {
					return;
				}

				try {
					var response = await fetch(basePath + '/orgs/' + orgId + '/members/' + userId, {
						method: 'DELETE',
						headers: { 'Content-Type': 'application/json' }
					});

					if (response.ok) {
						showToast('Member removed successfully', 'success');
						location.reload();
					} else {
						var data = await response.json();
						showToast(data.error || 'Failed to remove member', 'error');
					}
				} catch (error) {
					showToast('Network error. Please try again.', 'error');
				}
			};

			// Delete invitation
			window.deleteInvitation = async function(btn) {
				var inviteId = btn.dataset.inviteId;
				if (!confirm('Revoke this invitation?')) {
					return;
				}

				try {
					var response = await fetch(basePath + '/orgs/' + orgId + '/invitations/' + inviteId, {
						method: 'DELETE',
						headers: { 'Content-Type': 'application/json' }
					});

					if (response.ok) {
						showToast('Invitation revoked', 'success');
						location.reload();
					} else {
						var data = await response.json();
						showToast(data.error || 'Failed to revoke invitation', 'error');
					}
				} catch (error) {
					showToast('Network error. Please try again.', 'error');
				}
			};

			// Invite form submission (called via onsubmit attribute)
			window.handleInviteSubmit = async function(e) {
				e.preventDefault();

				var btn = document.getElementById('inviteSubmitBtn');
				btn.disabled = true;
				btn.textContent = 'Adding...';

				var raw = document.getElementById('inviteEmails').value;
				var emails = raw.split(',').map(function(s) { return s.trim(); }).filter(function(s) { return s.length > 0; });

				if (emails.length === 0) {
					showToast('Please enter at least one email address.', 'error');
					btn.disabled = false;
					btn.textContent = 'Add members';
					return;
				}

				var succeeded = 0;
				var failed = 0;

				for (var i = 0; i < emails.length; i++) {
					try {
						var response = await fetch(basePath + '/orgs/' + orgId + '/invitations', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ email: emails[i] })
						});

						if (response.ok) {
							succeeded++;
						} else {
							failed++;
						}
					} catch (error) {
						failed++;
					}
				}

				if (succeeded > 0) {
					showToast(succeeded + ' member(s) invited successfully', 'success');
				}
				if (failed > 0) {
					showToast(failed + ' invitation(s) failed', 'error');
				}

				closeModal('inviteModal', function() {
					document.getElementById('inviteEmails').value = '';
					btn.disabled = false;
					btn.textContent = 'Add members';
					if (succeeded > 0) {
						location.reload();
					}
				});
			};
		})();
	</script>
}

templ teamTrashIcon() {
	<svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor">
		<path d="M216,48H176V40a24,24,0,0,0-24-24H104A24,24,0,0,0,80,40v8H40a8,8,0,0,0,0,16h8V208a16,16,0,0,0,16,16H192a16,16,0,0,0,16-16V64h8a8,8,0,0,0,0-16ZM96,40a8,8,0,0,1,8-8h48a8,8,0,0,1,8,8v8H96Zm96,168H64V64H192ZM112,104v64a8,8,0,0,1-16,0V104a8,8,0,0,1,16,0Zm48,0v64a8,8,0,0,1-16,0V104a8,8,0,0,1,16,0Z"></path>
	</svg>
}
