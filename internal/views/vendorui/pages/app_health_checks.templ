package pages

import (
	"fmt"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui/partials"
)

// ActionForHealthCheck represents an action that can be configured as a health check
type ActionForHealthCheck struct {
	ID                string
	AppActionConfigID string
	Name              string
	Description       string
}

// AppHealthChecksPageProps for the app health checks page
type AppHealthChecksPageProps struct {
	vendorui.LayoutProps
	Org          models.NuonOrg
	App          AppInfo
	Actions      []ActionForHealthCheck
	SelectedIDs  map[string]bool
}

// AppInfo holds basic app information
type AppInfo struct {
	ID   string
	Name string
}

// AppHealthChecksPage renders the app health checks configuration page
templ AppHealthChecksPage(props AppHealthChecksPageProps) {
	@vendorui.Layout(props.LayoutProps) {
		<div class="flex h-full overflow-hidden">
			@partials.AppSubnav(partials.AppSubnavProps{
				OrgID:         props.Org.ID,
				AppID:         props.App.ID,
				ActiveSubPage: "health-checks",
				BasePath:      props.BasePath,
			})
			<div class="stratus-page-content overflow-auto">
				<div class="px-4 pt-4 md:px-6 md:pt-6">
					<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400">
						Select which actions to run as health checks for all installs of this app.
						These will be automatically applied when creating new install links.
					</p>
				</div>
				if len(props.Actions) > 0 {
					@healthCheckForm(props)
				} else {
					@emptyActionsState()
				}
			</div>
		</div>
		<!-- Config data for JavaScript -->
		<div
			id="health-checks-config"
			class="hidden"
			data-base-path={ props.BasePath }
			data-org-id={ props.Org.ID }
			data-app-id={ props.App.ID }
		></div>
		@appHealthChecksScript()
	}
}

templ healthCheckForm(props AppHealthChecksPageProps) {
	<section class="stratus-page-section">
		<form id="healthCheckForm" class="flex flex-col gap-4 md:gap-6">
			<div class="stratus-card overflow-hidden !p-0">
				<div class="divide-y divide-cool-grey-200 dark:divide-dark-grey-700">
					for _, action := range props.Actions {
						@healthCheckActionItem(action, props.SelectedIDs, props.PrimaryColor != "")
					}
				</div>
			</div>
			<div class="flex items-center justify-between">
				<div id="statusMessage" class="text-sm"></div>
				<button
					type="submit"
					class={ "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 disabled:opacity-50 disabled:cursor-not-allowed",
						templ.KV("bg-theme-primary hover:bg-theme-primary-hover", props.PrimaryColor != ""),
						templ.KV("bg-primary-600 hover:bg-primary-700", props.PrimaryColor == "") }
				>
					@saveSpinner()
					Save Changes
				</button>
			</div>
		</form>
	</section>
}

templ healthCheckActionItem(action ActionForHealthCheck, selectedIDs map[string]bool, hasThemeColor bool) {
	<label class="flex items-start p-4 hover:bg-cool-grey-50 dark:hover:bg-dark-grey-800 cursor-pointer transition-colors">
		<div class="flex items-center h-5">
			<input
				type="checkbox"
				name="health_check_ids"
				value={ fmt.Sprintf("%s:%s", action.AppActionConfigID, action.ID) }
				if selectedIDs[fmt.Sprintf("%s:%s", action.AppActionConfigID, action.ID)] {
					checked
				}
				class="h-4 w-4 text-primary-600 dark:text-primary-500 focus:ring-primary-500 border-cool-grey-300 dark:border-dark-grey-500 rounded dark:bg-dark-grey-700"
			/>
		</div>
		<div class="ml-3 flex-1">
			<span class="text-sm font-medium text-cool-grey-900 dark:text-white">
				{ action.Name }
			</span>
			<div class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">
				Config: { action.AppActionConfigID } | Workflow: { action.ID }
			</div>
		</div>
	</label>
}

templ saveSpinner() {
	<svg id="saveSpinner" class="hidden animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
		<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
		<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
	</svg>
}

templ emptyActionsState() {
	<section class="stratus-page-section">
		<div class="stratus-card overflow-hidden !p-0">
			<table class="min-w-full">
				<thead class="bg-cool-grey-50 dark:bg-dark-grey-800 border-b border-cool-grey-200 dark:border-dark-grey-700">
					<tr>
						<th class="px-4 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
							Action
						</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td class="py-16 text-center">
							<div class="flex justify-center mb-6">
								@emptyTableIllustration()
							</div>
							<h3 class="text-lg font-semibold text-cool-grey-900 dark:text-white mb-2">No actions yet</h3>
							<p class="text-cool-grey-500 dark:text-cool-grey-400 mb-4">
								Save time by configuring your actions.<br/>
								Check out our resources.
							</p>
							<a
								href="https://docs.nuon.co/concepts/actions"
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:underline font-medium"
							>
								Learn more
								<svg class="ml-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
								</svg>
							</a>
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</section>
}

templ emptyTableIllustration() {
	<svg width="154" height="94" viewBox="0 0 154 94" fill="none" xmlns="http://www.w3.org/2000/svg" style="opacity: 0.9;">
		<rect x="2" y="1" width="150" height="90" rx="10" fill="#F6F0FF"></rect>
		<rect x="2.5" y="1.5" width="149" height="89" rx="9.5" stroke="#C4B5D9" stroke-opacity="0.5"></rect>
		<line x1="2" y1="22" x2="152" y2="22" stroke="#E5E7EB" stroke-width="0.5"></line>
		<line x1="2" y1="46" x2="152" y2="46" stroke="#A855F7" stroke-opacity="0.6"></line>
		<line x1="2" y1="70" x2="152" y2="70" stroke="#E5E7EB" stroke-width="0.5"></line>
		<circle cx="44" cy="46" r="12" fill="#EDE9FE"></circle>
		<path d="M41 41L50 46L41 51V41Z" fill="#8B5CF6"></path>
		<circle cx="77" cy="46" r="8" fill="#EDE9FE"></circle>
		<circle cx="77" cy="46" r="5" stroke="#9CA3AF" stroke-width="1.5" fill="none"></circle>
		<path d="M77 44V46.5L78.5 48" stroke="#9CA3AF" stroke-width="1.5" stroke-linecap="round"></path>
		<circle cx="110" cy="46" r="12" fill="#EDE9FE"></circle>
		<rect x="105" y="42" width="6" height="1.5" rx="0.75" fill="#9CA3AF"></rect>
		<rect x="105" y="45.5" width="6" height="1.5" rx="0.75" fill="#9CA3AF"></rect>
		<rect x="105" y="49" width="6" height="1.5" rx="0.75" fill="#9CA3AF"></rect>
		<path d="M113 42.5L114.5 44L117 41" stroke="#9CA3AF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
	</svg>
}

templ appHealthChecksScript() {
	<script>
		(function() {
			var config = document.getElementById('health-checks-config');
			var basePath = config.dataset.basePath;
			var orgID = config.dataset.orgId;
			var appID = config.dataset.appId;

			function getCookie(name) {
				var value = '; ' + document.cookie;
				var parts = value.split('; ' + name + '=');
				if (parts.length === 2) return parts.pop().split(';').shift();
				return null;
			}

			function showStatus(message, isError) {
				var statusEl = document.getElementById('statusMessage');
				statusEl.textContent = message;
				statusEl.className = 'text-sm ' + (isError ? 'text-red-600 dark:text-red-400' : 'text-green-600 dark:text-green-400');

				setTimeout(function() {
					statusEl.textContent = '';
				}, 3000);
			}

			function setLoading(loading) {
				var spinner = document.getElementById('saveSpinner');
				var form = document.getElementById('healthCheckForm');
				var submitBtn = form.querySelector('button[type="submit"]');

				if (loading) {
					spinner.classList.remove('hidden');
					submitBtn.disabled = true;
				} else {
					spinner.classList.add('hidden');
					submitBtn.disabled = false;
				}
			}

			var form = document.getElementById('healthCheckForm');
			if (form) {
				form.addEventListener('submit', async function(e) {
					e.preventDefault();

					var checkboxes = document.querySelectorAll('input[name="health_check_ids"]:checked');
					var selectedIDs = Array.from(checkboxes).map(function(cb) { return cb.value; });

					setLoading(true);

					try {
						var response = await fetch(basePath + '/orgs/' + orgID + '/apps/' + appID + '/health-checks', {
							method: 'PUT',
							headers: {
								'Content-Type': 'application/json'
							},
							credentials: 'same-origin',
							body: JSON.stringify({
								health_check_action_ids: selectedIDs
							})
						});

						var data = await response.json();

						if (response.ok) {
							showStatus('Health checks saved successfully', false);
						} else {
							showStatus(data.error || 'Failed to save health checks', true);
						}
					} catch (error) {
						showStatus('Network error. Please try again.', true);
					} finally {
						setLoading(false);
					}
				});
			}
		})();
	</script>
}
