package pages

import (
	"fmt"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui"
)

// AppWithHealthCheckStatus represents an app in the apps list
type AppWithHealthCheckStatus struct {
	ID              string
	Name            string
	Platform        string
	LogoLightBase64 string // base64 data URI for light mode logo
	LogoDarkBase64  string // base64 data URI for dark mode logo
}

// AppsPageProps for the apps list page
type AppsPageProps struct {
	vendorui.LayoutProps
	Org             models.NuonOrg
	Apps            []AppWithHealthCheckStatus
	PublishedAppIDs map[string]bool // Set of app IDs that are currently published
}

// AppsPage renders the apps list page
templ AppsPage(props AppsPageProps) {
	@vendorui.Layout(props.LayoutProps) {
		<div class="stratus-page-content overflow-auto">
			<div class="stratus-page-header">
				<div class="stratus-heading-group">
					<h1 class="stratus-page-title">Apps</h1>
					<p class="stratus-page-subtitle">Configure and publish apps for your customer portal.</p>
				</div>
			</div>
			<div class="stratus-page-section">
				if len(props.Apps) > 0 {
					<div class="bg-white dark:bg-dark-grey-900 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500 overflow-hidden">
						<table class="min-w-full divide-y divide-cool-grey-200 dark:divide-dark-grey-700">
							<thead class="bg-cool-grey-50 dark:bg-dark-grey-800">
								<tr>
									<th scope="col" class="w-8 px-2 py-3"></th>
									<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
										Logo
									</th>
									<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
										Name
									</th>
									<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
										Platform
									</th>
									<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
										Published
									</th>
								</tr>
							</thead>
							<tbody id="publishedAppsContainer" class="bg-white dark:bg-dark-grey-900 divide-y divide-cool-grey-200 dark:divide-dark-grey-700">
								for _, app := range props.Apps {
									@appTableRow(app, props.Org.ID, props.BasePath, props.PublishedAppIDs[app.ID])
								}
							</tbody>
						</table>
					</div>
					<div class="mt-4 flex justify-end">
						<button
							id="saveOrderBtn"
							onclick={ saveAppOrder(props.BasePath, props.Org.ID) }
							disabled
							class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 disabled:opacity-50 disabled:cursor-not-allowed"
						>
							<span id="saveOrderText">Save Configuration</span>
							<svg id="saveOrderSpinner" class="hidden ml-2 h-4 w-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
								<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
								<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
							</svg>
						</button>
					</div>
					@appsScript(props.BasePath, props.Org.ID)
				} else {
					@emptyAppsState()
				}
			</div>
		</div>
	}
}

templ appTableRow(app AppWithHealthCheckStatus, orgID, basePath string, isPublished bool) {
	<tr class="hover:bg-cool-grey-50 dark:hover:bg-dark-grey-800 sortable-app" data-app-id={ app.ID }>
		<td class="px-2 py-4 app-drag-handle cursor-grab active:cursor-grabbing">
			<svg class="h-3 w-3 text-cool-grey-400 dark:text-cool-grey-500 mx-auto" viewBox="0 0 24 24" fill="currentColor">
				<circle cx="9" cy="6" r="1.5"></circle>
				<circle cx="15" cy="6" r="1.5"></circle>
				<circle cx="9" cy="12" r="1.5"></circle>
				<circle cx="15" cy="12" r="1.5"></circle>
				<circle cx="9" cy="18" r="1.5"></circle>
				<circle cx="15" cy="18" r="1.5"></circle>
			</svg>
		</td>
		<td class="px-6 py-4 whitespace-nowrap">
			if app.LogoLightBase64 != "" {
				<img src={ app.LogoLightBase64 } class="w-8 h-8 rounded object-contain flex-shrink-0 dark:hidden" alt=""/>
				if app.LogoDarkBase64 != "" {
					<img src={ app.LogoDarkBase64 } class="w-8 h-8 rounded object-contain flex-shrink-0 hidden dark:block" alt=""/>
				}
			} else if app.LogoDarkBase64 != "" {
				<img src={ app.LogoDarkBase64 } class="w-8 h-8 rounded object-contain flex-shrink-0" alt=""/>
			} else {
				<span class="text-cool-grey-400 dark:text-cool-grey-600">—</span>
			}
		</td>
		<td class="px-6 py-4 whitespace-nowrap">
			<a
				href={ templ.SafeURL(fmt.Sprintf("%s/orgs/%s/apps/%s/inputs", basePath, orgID, app.ID)) }
				class="group"
			>
				<div class="text-sm font-medium text-cool-grey-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400">{ app.Name }</div>
				<div class="text-sm text-cool-grey-500 dark:text-cool-grey-400">{ app.ID }</div>
			</a>
		</td>
		<td class="px-6 py-4 whitespace-nowrap">
			@platformBadge(app.Platform)
		</td>
		<td class="px-6 py-4 whitespace-nowrap">
			@publishToggle(isPublished, basePath, orgID, app.ID)
		</td>
	</tr>
}

templ appsScript(basePath, orgID string) {
	<style>
		.sortable-ghost {
			opacity: 0.5;
		}
		.sortable-chosen {
			background-color: rgb(243 232 255);
			box-shadow: 0 0 0 2px rgb(168 85 247);
		}
		.dark .sortable-chosen {
			background-color: rgb(88 28 135 / 0.3);
		}
	</style>
	<script src="/static/js/sortable.min.js"></script>
	<script>
		(function() {
			var initialSnapshot = '';

			function getAppOrder() {
				var ids = [];
				document.querySelectorAll('.sortable-app').forEach(function(row) {
					ids.push(row.dataset.appId);
				});
				return ids;
			}

			function getSnapshot() {
				var published = {};
				document.querySelectorAll('.sortable-app').forEach(function(row) {
					var btn = row.querySelector('[role="switch"]');
					published[row.dataset.appId] = btn ? btn.getAttribute('aria-checked') === 'true' : false;
				});
				return JSON.stringify({ order: getAppOrder(), published: published });
			}

			function updateSaveBtn() {
				document.getElementById('saveOrderBtn').disabled = (getSnapshot() === initialSnapshot);
			}

			window.togglePublishLocal = function(btn) {
				var current = btn.getAttribute('aria-checked') === 'true';
				var next = !current;
				btn.setAttribute('aria-checked', String(next));
				if (next) {
					btn.classList.remove('bg-cool-grey-200', 'dark:bg-dark-grey-600');
					btn.classList.add('bg-primary-600');
				} else {
					btn.classList.remove('bg-primary-600');
					btn.classList.add('bg-cool-grey-200', 'dark:bg-dark-grey-600');
				}
				var indicator = btn.querySelector('[aria-hidden="true"]');
				if (indicator) {
					if (next) {
						indicator.classList.remove('translate-x-0');
						indicator.classList.add('translate-x-5');
					} else {
						indicator.classList.remove('translate-x-5');
						indicator.classList.add('translate-x-0');
					}
				}
				updateSaveBtn();
			};


			function initSortable() {
				var container = document.getElementById('publishedAppsContainer');
				if (container && typeof Sortable !== 'undefined') {
					initialSnapshot = getSnapshot();
					new Sortable(container, {
						animation: 150,
						handle: '.app-drag-handle',
						draggable: '.sortable-app',
						ghostClass: 'sortable-ghost',
						chosenClass: 'sortable-chosen',
						onEnd: function() {
							updateSaveBtn();
						}
					});
				}
			}

			window.saveAppOrder = function(basePath, orgID) {
				var btn = document.getElementById('saveOrderBtn');
				var text = document.getElementById('saveOrderText');
				var spinner = document.getElementById('saveOrderSpinner');
				btn.disabled = true;
				text.textContent = 'Saving...';
				spinner.classList.remove('hidden');

				var appIDs = getAppOrder();
				var publishedAppIDs = [];
				document.querySelectorAll('.sortable-app').forEach(function(row) {
					var toggle = row.querySelector('[role="switch"]');
					if (toggle && toggle.getAttribute('aria-checked') === 'true') {
						publishedAppIDs.push(row.dataset.appId);
					}
				});

				fetch(basePath + '/orgs/' + orgID + '/apps/order', {
					method: 'PUT',
					headers: {'Content-Type': 'application/json'},
					body: JSON.stringify({app_ids: appIDs, published_app_ids: publishedAppIDs})
				}).then(function(r) {
					text.textContent = 'Save Configuration';
					spinner.classList.add('hidden');
					if (!r.ok) {
						btn.disabled = false;
						alert('Failed to save configuration');
					} else {
						initialSnapshot = getSnapshot();
						btn.disabled = true;
					}
				}).catch(function() {
					btn.disabled = false;
					text.textContent = 'Save Configuration';
					spinner.classList.add('hidden');
					alert('Failed to save configuration');
				});
			};

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', function() { initSortable(); });
			} else {
				initSortable();
			}
		})();
	</script>
}

script saveAppOrder(basePath, orgID string) {
	window.saveAppOrder(basePath, orgID);
}

// publishToggle renders an on/off toggle for publishing an app to the customer catalog
templ publishToggle(isPublished bool, basePath, orgID, appID string) {
	<button
		type="button"
		role="switch"
		aria-checked={ fmt.Sprintf("%t", isPublished) }
		onclick="togglePublishLocal(this)"
		class={ "relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2",
			templ.KV("bg-primary-600", isPublished),
			templ.KV("bg-cool-grey-200 dark:bg-dark-grey-600", !isPublished) }
	>
		<span class="sr-only">
			if isPublished {
				Remove from catalog
			} else {
				Add to catalog
			}
		</span>
		<span
			aria-hidden="true"
			class={ "pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out",
				templ.KV("translate-x-5", isPublished),
				templ.KV("translate-x-0", !isPublished) }
		></span>
	</button>
}

templ platformBadge(platform string) {
	switch platform {
		case "aws":
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 dark:bg-orange-900/30 text-orange-800 dark:text-orange-300">
				@awsIcon()
				AWS
			</span>
		case "azure":
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300">
				@azureIcon()
				Azure
			</span>
		default:
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-cool-grey-100 dark:bg-cool-grey-700 text-cool-grey-800 dark:text-cool-grey-300">
				{ platform }
			</span>
	}
}

templ emptyAppsState() {
	<div class="bg-white dark:bg-dark-grey-900 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500 p-12 text-center">
		<div class="mx-auto flex items-center justify-center h-16 w-16 mb-4 rounded-full bg-cool-grey-100 dark:bg-dark-grey-700">
			@cubeIcon()
		</div>
		<h3 class="text-xl font-medium text-cool-grey-900 dark:text-white mb-2">No Apps Found</h3>
		<p class="text-cool-grey-500 dark:text-cool-grey-400 max-w-sm mx-auto">
			No apps are configured in this Nuon organization. Use the Nuon CLI to sync your apps configuration.
		</p>
	</div>
}

templ cubeIcon() {
	<svg class="h-5 w-5 text-cool-grey-500 dark:text-cool-grey-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
		<path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"></path>
	</svg>
}

