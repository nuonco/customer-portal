	</svg>
}

templ azureIcon() {
	<svg class="mr-1.5 h-3 w-3" viewBox="0 0 24 24" fill="currentColor">
		<path d="M5.483 21.3H24L14.025 4.013l-3.038 8.347 5.836 6.938L5.483 21.3zM13.23 2.7L6.105 8.677 0 19.253h5.505l7.725-16.553z"></path>
	</svg>
}
