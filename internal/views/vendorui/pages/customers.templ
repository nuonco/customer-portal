package pages

import (
	"fmt"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui"
)

// CustomerWithInstallCount represents a customer with their install count
type CustomerWithInstallCount struct {
	ID           string
	Name         string
	Email        string
	InstallCount int64
}

// CustomersPageProps for the customers list page
type CustomersPageProps struct {
	vendorui.LayoutProps
	Org         models.NuonOrg
	Customers   []CustomerWithInstallCount
	SearchQuery string
}

// CustomersPage renders the customers list page
templ CustomersPage(props CustomersPageProps) {
	@vendorui.Layout(props.LayoutProps) {
		<div class="stratus-page-content overflow-auto">
			<div class="stratus-page-header">
				<div class="stratus-heading-group">
					<h1 class="stratus-page-title">Accounts</h1>
					<p class="stratus-page-subtitle">View all accounts that have installed your applications.</p>
				</div>
			</div>
			<div class="stratus-page-section">
				if len(props.Customers) > 0 || props.SearchQuery != "" {
					<div class="mb-4">
						<input
							type="text"
							name="q"
							value={ props.SearchQuery }
							placeholder="Search by name or email..."
							class="w-full px-4 py-2 border border-cool-grey-300 dark:border-dark-grey-600 rounded-lg bg-white dark:bg-dark-grey-900 text-cool-grey-900 dark:text-white placeholder-cool-grey-500 dark:placeholder-cool-grey-400 focus:outline-none focus:ring-2 focus:ring-primary-500 dark:focus:ring-primary-400 focus:border-transparent"
							hx-get={ fmt.Sprintf("%s/orgs/%s/customers", props.BasePath, props.Org.ID) }
							hx-trigger="keyup changed delay:300ms"
							hx-target="#customers-table-body"
						/>
					</div>
					<div class="bg-white dark:bg-dark-grey-900 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500 overflow-hidden">
						<table class="min-w-full divide-y divide-cool-grey-200 dark:divide-dark-grey-700">
							<thead class="bg-cool-grey-50 dark:bg-dark-grey-800">
								<tr>
									<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
										Account
									</th>
									<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
										Email
									</th>
									<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
										Installs
									</th>
								</tr>
							</thead>
							<tbody id="customers-table-body" class="bg-white dark:bg-dark-grey-900 divide-y divide-cool-grey-200 dark:divide-dark-grey-700">
								if len(props.Customers) > 0 {
									for _, customer := range props.Customers {
										@customerTableRow(customer, props.Org.ID, props.BasePath)
									}
								} else {
									<tr>
										<td colspan="3" class="px-6 py-8 text-center">
											<p class="text-cool-grey-500 dark:text-cool-grey-400">
												No customers found matching "{ props.SearchQuery }"
											</p>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				} else {
					@emptyCustomersState()
				}
			</div>
		</div>
	}
}

// CustomersTableBody renders the table body with customer rows (for HTMX)
templ CustomersTableBody(customers []CustomerWithInstallCount, orgID, basePath, searchQuery string) {
	if len(customers) > 0 {
		for _, customer := range customers {
			@customerTableRow(customer, orgID, basePath)
		}
	} else {
		<tr>
			<td colspan="3" class="px-6 py-8 text-center">
				<p class="text-cool-grey-500 dark:text-cool-grey-400">
					No customers found matching "{ searchQuery }"
				</p>
			</td>
		</tr>
	}
}

templ customerTableRow(customer CustomerWithInstallCount, orgID, basePath string) {
	<tr class="hover:bg-cool-grey-50 dark:hover:bg-dark-grey-800">
		<td class="px-6 py-4 whitespace-nowrap">
			<div class="flex items-center">
				<div class="flex-shrink-0 h-10 w-10 rounded-full bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
					<span class="text-sm font-medium text-primary-700 dark:text-primary-300">
						{ getInitials(customer.Name) }
					</span>
				</div>
				<div class="ml-4">
					<div class="text-sm font-medium text-cool-grey-900 dark:text-white">{ customer.Name }</div>
					<div class="text-sm text-cool-grey-500 dark:text-cool-grey-400">{ customer.ID }</div>
				</div>
			</div>
		</td>
		<td class="px-6 py-4 whitespace-nowrap">
			<div class="text-sm text-cool-grey-900 dark:text-white">{ customer.Email }</div>
		</td>
		<td class="px-6 py-4 whitespace-nowrap">
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-cool-grey-100 dark:bg-cool-grey-700 text-cool-grey-800 dark:text-cool-grey-300">
				{ fmt.Sprintf("%d", customer.InstallCount) }
			</span>
		</td>
	</tr>
}

templ emptyCustomersState() {
	<div class="bg-white dark:bg-dark-grey-900 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500 p-12 text-center">
		<div class="mx-auto flex items-center justify-center h-16 w-16 mb-4 rounded-full bg-cool-grey-100 dark:bg-dark-grey-700">
			@usersIcon()
		</div>
		<h3 class="text-xl font-medium text-cool-grey-900 dark:text-white mb-2">No Accounts Yet</h3>
		<p class="text-cool-grey-500 dark:text-cool-grey-400 max-w-sm mx-auto">
			No accounts have installed your applications yet. Share your install links to get started.
		</p>
	</div>
}

templ usersIcon() {
	<svg class="h-5 w-5 text-cool-grey-500 dark:text-cool-grey-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
		<path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"></path>
	</svg>
}

func getInitials(name string) string {
	if len(name) == 0 {
		return "?"
	}
	runes := []rune(name)
	if len(runes) == 1 {
		return string(runes[0:1])
	}
	// Find first two letters or first letter of first two words
	initials := ""
	words := 0
	for i, r := range runes {
		if i == 0 || (i > 0 && runes[i-1] == ' ') {
			initials += string(r)
			words++
			if words >= 2 {
				break
			}
		}
	}
	if initials == "" {
		return string(runes[0:1])
	}
	return initials
}
