package pages

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui/components"
)

// DNSSettingsPageProps for the DNS settings page
type DNSSettingsPageProps struct {
	vendorui.LayoutProps
	Org        *models.NuonOrg
	BaseDomain string // e.g., "portal.nuon.co" or "localhost:8080"
	Scheme     string // "https://" or "http://"
}

// DNSSettingsPage renders the DNS settings page
templ DNSSettingsPage(props DNSSettingsPageProps) {
	@vendorui.Layout(props.LayoutProps) {
		<div class="flex flex-1 overflow-hidden">
			@components.PortalSubnav(components.PortalSubnavProps{
				OrgID:         props.CurrentOrg.ID,
				ActiveSubPage: "dns",
				BasePath:      props.BasePath,
			})
			<div class="stratus-page-content overflow-auto">
				<div class="stratus-page-header">
					<div class="stratus-heading-group">
						<h1 class="stratus-page-title">DNS Settings</h1>
						<p class="stratus-page-subtitle">Configure the subdomain for your customer portal. Customers will access their portal at this URL.</p>
					</div>
				</div>
				<div class="stratus-page-section">
					<div class="space-y-6">
						@dnsCurrentURLSection(props)
						@dnsSubdomainSection(props)
						@dnsSaveSection(props.PrimaryColor)
					</div>
				</div>
				<!-- Config data for JavaScript -->
				<div
					id="dns-settings-config"
					class="hidden"
					data-base-path={ props.BasePath }
					data-org-id={ props.CurrentOrg.ID }
					data-base-domain={ props.BaseDomain }
					data-current-subdomain={ props.Org.Subdomain }
					data-scheme={ props.Scheme }
				></div>
				@dnsSettingsScript()
			</div>
		</div>
	}
}

templ dnsCurrentURLSection(props DNSSettingsPageProps) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<div class="flex items-center justify-between mb-4">
			<div class="flex items-center gap-2">
				@globeIcon()
				<h3 class="text-lg font-semibold text-cool-grey-800 dark:text-white">Customer Portal URL</h3>
			</div>
		</div>
		<div class="flex items-center gap-3">
			<div class="flex-1 p-3 bg-cool-grey-50 dark:bg-dark-grey-800 rounded-lg font-mono text-sm text-cool-grey-900 dark:text-white overflow-x-auto">
				<span id="previewURL">{ props.Scheme }{ props.Org.Subdomain }.{ props.BaseDomain }</span>
			</div>
			<button
				type="button"
				onclick="copyURL()"
				class="p-2 text-cool-grey-500 hover:text-primary-600 dark:hover:text-primary-400 transition-colors rounded-md hover:bg-cool-grey-100 dark:hover:bg-dark-grey-700"
				title="Copy URL"
			>
				@copyIcon()
			</button>
		</div>
		<p class="mt-2 text-xs text-cool-grey-500 dark:text-cool-grey-400">
			This is the URL where your customers will access their portal to manage installations.
		</p>
	</div>
}

templ dnsSubdomainSection(props DNSSettingsPageProps) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Subdomain</h3>
		<div class="space-y-4">
			<div>
				<label for="subdomain" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">
					Subdomain
				</label>
				<div class="flex items-center">
					<span class="px-3 py-2 bg-cool-grey-100 dark:bg-dark-grey-700 border border-r-0 border-cool-grey-300 dark:border-dark-grey-500 text-cool-grey-600 dark:text-cool-grey-400 rounded-l-md">
						{ props.Scheme }
					</span>
					<input
						type="text"
						id="subdomain"
						value={ props.Org.Subdomain }
						placeholder="your-company"
						class="flex-1 px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-800 dark:text-white focus:ring-2 focus:ring-primary-400 focus:border-primary-600"
						oninput="onSubdomainInput()"
					/>
					<span class="px-3 py-2 bg-cool-grey-100 dark:bg-dark-grey-700 border border-l-0 border-cool-grey-300 dark:border-dark-grey-500 text-cool-grey-600 dark:text-cool-grey-400 rounded-r-md">
						.{ props.BaseDomain }
					</span>
				</div>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">
					Lowercase letters, numbers, and dashes only. Must start with a letter and be at least 2 characters.
				</p>
			</div>
			<!-- Availability Check -->
			<div id="availabilityStatus" class="hidden"></div>
		</div>
	</div>
}

templ dnsSaveSection(primaryColor string) {
	<div class="flex flex-col space-y-3">
		<button
			type="button"
			id="saveButton"
			onclick="saveDNSSettings()"
			class={ "w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 text-base rounded-md font-medium text-white",
				templ.KV("bg-theme-primary hover:bg-theme-primary-hover", primaryColor != ""),
				templ.KV("bg-primary-600 hover:bg-primary-700", primaryColor == "") }
			if primaryColor != "" {
				style={ "background-color: " + primaryColor }
			}
		>
			Save Changes
		</button>
		<div id="successMessage" class="hidden p-4 bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-800 text-green-700 dark:text-green-300 rounded-lg">
			<div class="flex items-center">
				<svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
					<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
				</svg>
				Settings saved successfully!
			</div>
		</div>
		<div id="errorMessage" class="hidden p-4 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-300 rounded-lg"></div>
	</div>
}

templ globeIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" class="w-5 h-5 text-cool-grey-500 dark:text-cool-grey-400">
		<path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24ZM101.63,168h52.74C149,186.34,140,202.87,128,215.89,116,202.87,107,186.34,101.63,168ZM98,152a145.72,145.72,0,0,1,0-48h60a145.72,145.72,0,0,1,0,48ZM40,128a87.61,87.61,0,0,1,3.33-24H81.79a161.79,161.79,0,0,0,0,48H43.33A87.61,87.61,0,0,1,40,128Zm114.37-40H101.63C107,69.66,116,53.13,128,40.11,140,53.13,149,69.66,154.37,88Zm19.84,16h38.46a88.15,88.15,0,0,1,0,48H174.21a161.79,161.79,0,0,0,0-48Zm32.16-16H170.94a142.39,142.39,0,0,0-20.26-45A88.37,88.37,0,0,1,206.37,88ZM105.32,43A142.39,142.39,0,0,0,85.06,88H49.63A88.37,88.37,0,0,1,105.32,43ZM49.63,168H85.06a142.39,142.39,0,0,0,20.26,45A88.37,88.37,0,0,1,49.63,168Zm101.05,45a142.39,142.39,0,0,0,20.26-45h35.43A88.37,88.37,0,0,1,150.68,213Z"></path>
	</svg>
}

templ copyIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" class="w-5 h-5">
		<path d="M216,32H88a8,8,0,0,0-8,8V80H40a8,8,0,0,0-8,8V216a8,8,0,0,0,8,8H168a8,8,0,0,0,8-8V176h40a8,8,0,0,0,8-8V40A8,8,0,0,0,216,32ZM160,208H48V96H160Zm48-48H176V88a8,8,0,0,0-8-8H96V48H208Z"></path>
	</svg>
}

templ dnsSettingsScript() {
	<script>
		(function() {
			var config = document.getElementById('dns-settings-config');
			var basePath = config.dataset.basePath;
			var orgId = config.dataset.orgId;
			var baseDomain = config.dataset.baseDomain;
			var currentSubdomain = config.dataset.currentSubdomain;
			var scheme = config.dataset.scheme;
			var checkTimeout = null;

			// Copy URL to clipboard
			window.copyURL = function() {
				var url = document.getElementById('previewURL').textContent;
				navigator.clipboard.writeText(url).then(function() {
					// Show brief feedback
					var btn = event.target.closest('button');
					var originalTitle = btn.title;
					btn.title = 'Copied!';
					setTimeout(function() { btn.title = originalTitle; }, 2000);
				});
			};

			// Handle subdomain input
			window.onSubdomainInput = function() {
				var input = document.getElementById('subdomain');
				var value = input.value.toLowerCase().replace(/[^a-z0-9-]/g, '');
				input.value = value;

				// Update preview
				var preview = document.getElementById('previewURL');
				preview.textContent = scheme + (value || 'your-company') + '.' + baseDomain;

				// Debounce availability check
				clearTimeout(checkTimeout);
				if (value && value !== currentSubdomain) {
					checkTimeout = setTimeout(function() {
						checkAvailability(value);
					}, 500);
				} else {
					hideAvailability();
				}
			};

			function hideAvailability() {
				document.getElementById('availabilityStatus').classList.add('hidden');
			}

			async function checkAvailability(subdomain) {
				var statusDiv = document.getElementById('availabilityStatus');

				// Show loading state
				statusDiv.classList.remove('hidden');
				statusDiv.innerHTML = '<div class="flex items-center text-cool-grey-500 dark:text-cool-grey-400"><svg class="animate-spin w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>Checking availability...</div>';

				try {
					var response = await fetch(basePath + '/orgs/' + orgId + '/settings/dns/check?subdomain=' + encodeURIComponent(subdomain), {
						credentials: 'same-origin'
					});
					var data = await response.json();

					if (data.available) {
						statusDiv.innerHTML = '<div class="flex items-center text-green-600 dark:text-green-400"><svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>This subdomain is available</div>';
					} else {
						var reason = data.reason || 'This subdomain is not available';
						statusDiv.innerHTML = '<div class="flex items-center text-red-600 dark:text-red-400"><svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg>' + reason + '</div>';
					}
				} catch (error) {
					statusDiv.innerHTML = '<div class="flex items-center text-red-600 dark:text-red-400"><svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg>Error checking availability</div>';
				}
			}

			// Save settings
			window.saveDNSSettings = async function() {
				var saveButton = document.getElementById('saveButton');
				var successMessage = document.getElementById('successMessage');
				var errorMessage = document.getElementById('errorMessage');
				var subdomain = document.getElementById('subdomain').value;

				saveButton.textContent = 'Saving...';
				saveButton.disabled = true;
				successMessage.classList.add('hidden');
				errorMessage.classList.add('hidden');

				try {
					var response = await fetch(basePath + '/orgs/' + orgId + '/settings/dns', {
						method: 'PUT',
						headers: { 'Content-Type': 'application/json' },
						credentials: 'same-origin',
						body: JSON.stringify({ subdomain: subdomain })
					});

					var data = await response.json();

					if (response.ok) {
						successMessage.classList.remove('hidden');
						currentSubdomain = subdomain;
						hideAvailability();
						setTimeout(function() { successMessage.classList.add('hidden'); }, 3000);
					} else {
						errorMessage.innerHTML = '<div class="flex items-center"><svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg>' + (data.error || 'Failed to save settings') + '</div>';
						errorMessage.classList.remove('hidden');
					}
				} catch (error) {
					errorMessage.innerHTML = '<div class="flex items-center"><svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg>Network error. Please try again.</div>';
					errorMessage.classList.remove('hidden');
				}

				saveButton.textContent = 'Save Changes';
				saveButton.disabled = false;
			};
		})();
	</script>
}
