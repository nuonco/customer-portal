							<td class="px-3 py-2.5 preview-body-font font-medium" style="color: var(--preview-primary);">my-staging</td>
							<td class="px-3 py-2.5 preview-text-body preview-body-font">Acme App</td>
							<td class="px-3 py-2.5"><span class="px-1.5 py-0.5 text-[10px] rounded font-medium bg-orange-100 text-orange-800">AWS</span></td>
							<td class="px-3 py-2.5 preview-text-muted preview-body-font">eu-west-1</td>
