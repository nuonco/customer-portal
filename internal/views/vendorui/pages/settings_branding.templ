					<img class="h-6 w-auto max-w-24 object-contain hidden preview-logo-dark" src="" alt="Logo"/>
				</div>
				<span class="text-sm preview-text-muted preview-body-font">Logout</span>
			</div>
		</header>
		<!-- Main Content -->
		<main class="mx-auto px-6 pt-2 w-full max-w-4xl">
			<h1 class="text-xl font-semibold preview-text-heading preview-heading-font mb-4">My Installs</h1>
