package pages

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui/components"
)

// BrandingSettingsPageProps for the branding settings page
type BrandingSettingsPageProps struct {
	vendorui.LayoutProps
	Theme *models.AppTheme
}

// BrandingSettingsPage renders the branding settings page
templ BrandingSettingsPage(props BrandingSettingsPageProps) {
	@vendorui.Layout(props.LayoutProps) {
		<div class="flex flex-1 overflow-hidden">
			@components.PortalSubnav(components.PortalSubnavProps{
				OrgID:         props.CurrentOrg.ID,
				ActiveSubPage: "branding",
				BasePath:      props.BasePath,
			})
			<div class="stratus-page-content overflow-auto">
				<div class="stratus-page-header">
					<div class="stratus-heading-group">
						<h1 class="stratus-page-title">Branding</h1>
						<p class="stratus-page-subtitle">Customize the appearance of the customer portal.</p>
					</div>
				</div>
				<div class="stratus-page-section">
					<div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-6 items-start">
						<!-- Left Column: Settings -->
						<div class="space-y-6">
							@installerSettingsModeToggle()
							<div id="lightModeSettings" class="space-y-6">
								@installerPageBrandingSectionLight(props.Theme)
								@installerPageColorsSectionLight(props.Theme)
							</div>
							<div id="darkModeSettings" class="hidden space-y-6">
								@installerPageBrandingSectionDark(props.Theme)
								@installerPageColorsSectionDark(props.Theme)
							</div>
							@installerPageTypographySection(props.Theme)
							@installerPageSupportSection(props.Theme)
							<!-- Save Button -->
							<div class="flex flex-col space-y-3">
								<button type="button" id="installerSaveButton" onclick="saveInstallerSettings()" class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 text-base rounded-md font-medium text-white bg-primary-600 hover:bg-primary-700">
									Save Changes
								</button>
								<!-- Status Messages -->
								<div id="installerSuccessMessage" class="hidden p-4 bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-800 text-green-700 dark:text-green-300 rounded-lg">
									Settings saved successfully!
								</div>
								<div id="installerErrorMessage" class="hidden p-4 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-300 rounded-lg"></div>
							</div>
						</div>
						<!-- Right Column: Preview (sticky) -->
						<div>
							@components.PreviewContainer(components.PreviewContainerProps{
								Title:          "Preview",
								Description:    "This is what your customers will see.",
								InitialMode:    "light",
								InitialSize:    "desktop",
								PrimaryColor:   getBrandingPrimaryColor(props.Theme.PrimaryColor),
								SecondaryColor: getBrandingSecondaryColor(props.Theme.SecondaryColor),
							}) {
								@brandingPreviewContent(props.Theme)
							}
						</div>
					</div>
				</div>
				<!-- Config data for JavaScript -->
				<div
					id="installer-settings-config"
					class="hidden"
					data-base-path={ props.BasePath }
					data-logo-light-base64={ props.Theme.LogoLightBase64 }
					data-logo-dark-base64={ props.Theme.LogoDarkBase64 }
					data-heading-font={ props.Theme.HeadingFont }
					data-body-font={ props.Theme.BodyFont }
					data-primary-color={ props.Theme.PrimaryColor }
					data-secondary-color={ props.Theme.SecondaryColor }
					data-primary-color-dark={ props.Theme.PrimaryColorDark }
					data-secondary-color-dark={ props.Theme.SecondaryColorDark }
				></div>
				@installerPageScript()
			</div>
		</div>
	}
}

templ brandingPreviewContent(theme *models.AppTheme) {
	<div class="preview-page-bg h-full pb-6">
		<!-- Header -->
		<header class="w-full max-w-4xl mx-auto px-6 pb-4 pt-6">
			<div class="flex items-center justify-between">
				<div class="flex items-center gap-3">
					if theme.LogoLightBase64 != "" {
						<img id="installerPreviewLogoLight" src={ theme.LogoLightBase64 } alt="Logo" class="h-6 w-auto max-w-24 object-contain preview-logo-light"/>
					} else {
						<img id="installerPreviewLogoLight" src="" alt="Logo" class="h-6 w-auto max-w-24 object-contain hidden preview-logo-light"/>
					}
					if theme.LogoDarkBase64 != "" {
						<img id="installerPreviewLogoDark" src={ theme.LogoDarkBase64 } alt="Logo" class="h-6 w-auto max-w-24 object-contain hidden preview-logo-dark"/>
					} else {
						<img id="installerPreviewLogoDark" src="" alt="Logo" class="h-6 w-auto max-w-24 object-contain hidden preview-logo-dark"/>
					}
					<span id="installerPreviewEmail" class="text-sm preview-text-muted" style={ getBrandingFontStyle(theme.BodyFont) }>user@example.com</span>
				</div>
				<span class="text-sm preview-text-muted" style={ getBrandingFontStyle(theme.BodyFont) }>Logout</span>
			</div>
		</header>
		<!-- Main Content -->
		<main class="mx-auto px-6 pt-4 w-full max-w-4xl">
			<!-- Back Link -->
			<div class="mb-4">
				<a id="installerPreviewBackLink" href="#" class="text-sm hover:underline" style={ "color: var(--preview-secondary); " + getBrandingFontStyle(theme.BodyFont) }>
					← Back to My Installs
				</a>
			</div>
			<!-- Main Card -->
			<div class="preview-card p-5 shadow-md rounded-lg">
				<div class="flex gap-6">
					<!-- Left: Install Details -->
					<div class="flex-1">
						<h3 id="installerPreviewDetailsTitle" class="text-base font-medium preview-text-heading mb-2" style={ getBrandingFontStyle(theme.HeadingFont) }>Install Details</h3>
						<div class="space-y-1.5 text-sm">
							<div>
								<span class="font-medium preview-text-muted">App:</span>
								<span id="installerPreviewAppName" class="ml-1 preview-text-body" style={ getBrandingFontStyle(theme.BodyFont) }>Acme App</span>
							</div>
							<div>
								<span class="font-medium preview-text-muted">Region:</span>
								<span class="ml-1 preview-text-body" style={ getBrandingFontStyle(theme.BodyFont) }>us-west-2</span>
							</div>
							<div>
								<span class="font-medium preview-text-muted">Created:</span>
								<span class="ml-1 preview-text-body" style={ getBrandingFontStyle(theme.BodyFont) }>Jan 15, 2025</span>
							</div>
						</div>
					</div>
					<!-- Right: Health Status -->
					<div class="flex-1">
						<h3 class="text-base font-medium preview-text-heading mb-2" style={ getBrandingFontStyle(theme.HeadingFont) }>Health Status</h3>
						<div class="flex items-center gap-2">
							<div class="w-2.5 h-2.5 rounded-full bg-green-500"></div>
							<span class="text-sm preview-text-body" style={ getBrandingFontStyle(theme.BodyFont) }>1 check passing</span>
						</div>
					</div>
				</div>
			</div>
			<!-- Latest Update Section -->
			<div class="mt-5">
				<h3 id="installerPreviewUpdateTitle" class="text-base preview-text-heading mb-3" style={ getBrandingFontStyle(theme.HeadingFont) }>Latest Update</h3>
				<!-- Workflow Card -->
				<div class="preview-card p-5 shadow-md rounded-lg">
					<div class="flex justify-between items-start">
						<div class="flex-grow">
							<div class="flex items-center space-x-2 mb-1">
								<h4 id="installerPreviewWorkflowName" class="text-lg preview-text-body" style={ getBrandingFontStyle(theme.HeadingFont) }>Deploy</h4>
								<span class="px-2 py-0.5 text-xs font-medium rounded-full bg-blue-100 text-blue-800">In Progress</span>
							</div>
							<p class="text-xs preview-text-muted" style={ getBrandingFontStyle(theme.BodyFont) }>Started: 2:30 PM</p>
						</div>
						<div class="flex space-x-2">
							<button
								id="installerPreviewApproveBtn"
								class="text-white px-3 py-1.5 text-xs rounded-lg"
								style="background-color: var(--preview-primary);"
							>
								Approve
							</button>
							<button
								class="text-white px-3 py-1.5 text-xs rounded-lg"
								style="background-color: var(--preview-secondary);"
							>
								Cancel
							</button>
						</div>
					</div>
					<!-- Status message -->
					<div class="mt-3 p-3 preview-status-bg preview-status-border rounded-lg">
						<div class="flex items-center space-x-2">
							<div class="animate-spin rounded-full h-3 w-3 border-b-2 border-primary-600"></div>
							<p class="text-xs preview-text-body" style={ getBrandingFontStyle(theme.BodyFont) }>
								<strong>In Progress:</strong> This update is currently running.
							</p>
						</div>
					</div>
				</div>
				<!-- View History Button -->
				<div class="mt-3 text-center">
					<button
						id="installerPreviewHistoryBtn"
						class="text-white px-4 py-2 text-sm rounded-lg"
						style="background-color: var(--preview-primary);"
					>
						View Update History
					</button>
				</div>
			</div>
		</main>
		<!-- Footer -->
		<footer class="w-full max-w-4xl mx-auto px-6 pt-8 pb-4 mt-auto">
			<div
				id="installerPreviewFooter"
				class={ "text-center text-sm preview-text-muted", templ.KV("hidden", theme.SupportContact == "") }
				style={ getBrandingFontStyle(theme.BodyFont) }
			>
				Need help? Contact <a id="installerPreviewSupportLink" href="#" class="hover:underline" style="color: var(--preview-secondary);">support</a>
			</div>
		</footer>
	</div>
}

templ installerSettingsModeToggle() {
	<div class="flex items-center space-x-1 bg-cool-grey-100 dark:bg-dark-grey-700 rounded-lg p-1">
		<button
			type="button"
			id="settingsLightModeBtn"
			onclick="setSettingsMode('light')"
			class="flex-1 px-3 py-1.5 text-sm font-medium rounded-md transition-colors bg-white dark:bg-dark-grey-600 text-cool-grey-800 dark:text-white shadow-sm"
		>
			Light Mode
		</button>
		<button
			type="button"
			id="settingsDarkModeBtn"
			onclick="setSettingsMode('dark')"
			class="flex-1 px-3 py-1.5 text-sm font-medium rounded-md transition-colors text-cool-grey-600 dark:text-cool-grey-400 hover:bg-cool-grey-200 dark:hover:bg-dark-grey-600"
		>
			Dark Mode
		</button>
	</div>
}

templ installerPageBrandingSectionLight(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Logo</h3>
		<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-4">
			This logo will be displayed when the customer portal is in light mode.
		</p>
		<div class="flex items-center space-x-4">
			<div class="flex-shrink-0 w-32 h-32 bg-white border-2 border-cool-grey-300 rounded flex items-center justify-center p-2">
				if theme.LogoLightBase64 != "" {
					<img id="installerLogoLightPreview" src={ theme.LogoLightBase64 } alt="Light logo preview" class="max-w-full max-h-full object-contain"/>
				} else {
					<img id="installerLogoLightPreview" src="" alt="Light logo preview" class="max-w-full max-h-full object-contain hidden"/>
				}
				<div id="installerLogoLightPlaceholder" class={ "text-cool-grey-400 text-xs text-center", templ.KV("hidden", theme.LogoLightBase64 != "") }>
					<span>No logo</span>
				</div>
			</div>
			<div class="flex-1">
				<input
					type="file"
					id="installerLogoLightUpload"
					accept="image/png,image/jpeg,image/svg+xml,image/gif"
					class="block w-full text-sm text-cool-grey-500 dark:text-cool-grey-400 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-sm file:font-medium file:bg-primary-50 dark:file:bg-primary-900 file:text-primary-700 dark:file:text-primary-300 hover:file:bg-primary-100 dark:hover:file:bg-primary-800"
				/>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Best for white or light backgrounds. PNG, JPG, SVG, or GIF. Max 500KB.</p>
				<button type="button" id="installerRemoveLogoLight" onclick="installerRemoveLogoLight()" class={ "mt-2 text-xs text-red-600 hover:text-red-800", templ.KV("hidden", theme.LogoLightBase64 == "") }>
					Remove logo
				</button>
			</div>
		</div>
	</div>
}

templ installerPageBrandingSectionDark(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Dark Mode Logo</h3>
		<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-4">
			This logo will be displayed when the customer portal is in dark mode. If not provided, the light mode logo will be used.
		</p>
		<div class="flex items-center space-x-4">
			<div class="flex-shrink-0 w-32 h-32 bg-dark-grey-900 border-2 border-dark-grey-700 rounded flex items-center justify-center p-2">
				if theme.LogoDarkBase64 != "" {
					<img id="installerLogoDarkPreview" src={ theme.LogoDarkBase64 } alt="Dark logo preview" class="max-w-full max-h-full object-contain"/>
				} else {
					<img id="installerLogoDarkPreview" src="" alt="Dark logo preview" class="max-w-full max-h-full object-contain hidden"/>
				}
				<div id="installerLogoDarkPlaceholder" class={ "text-cool-grey-500 text-xs text-center", templ.KV("hidden", theme.LogoDarkBase64 != "") }>
					<span>No logo</span><br/>
					<span class="text-[10px]">(will use light logo)</span>
				</div>
			</div>
			<div class="flex-1">
				<input
					type="file"
					id="installerLogoDarkUpload"
					accept="image/png,image/jpeg,image/svg+xml,image/gif"
					class="block w-full text-sm text-cool-grey-500 dark:text-cool-grey-400 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-sm file:font-medium file:bg-primary-50 dark:file:bg-primary-900 file:text-primary-700 dark:file:text-primary-300 hover:file:bg-primary-100 dark:hover:file:bg-primary-800"
				/>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Best for dark backgrounds. PNG, JPG, SVG, or GIF. Max 500KB.</p>
				<button type="button" id="installerRemoveLogoDark" onclick="installerRemoveLogoDark()" class={ "mt-2 text-xs text-red-600 hover:text-red-800", templ.KV("hidden", theme.LogoDarkBase64 == "") }>
					Remove logo
				</button>
			</div>
		</div>
	</div>
}

templ installerPageColorsSectionLight(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Colors</h3>
		<!-- Primary Color -->
		<div class="mb-5">
			<label for="installerPrimaryColorLight" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">Primary Color</label>
			<div class="flex items-center space-x-3">
				<input
					type="color"
					id="installerPrimaryColorLight"
					value={ getBrandingPrimaryColor(theme.PrimaryColor) }
					class="h-10 w-14 rounded border border-cool-grey-300 dark:border-dark-grey-500 cursor-pointer"
				/>
				<input
					type="text"
					id="installerPrimaryColorLightText"
					value={ getBrandingPrimaryColor(theme.PrimaryColor) }
					class="flex-1 px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md uppercase focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white"
					placeholder="#8040BF"
					pattern="^#[0-9A-Fa-f]{6}$"
				/>
			</div>
			<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Used for navigation bar and primary buttons.</p>
		</div>
		<!-- Secondary Color -->
		<div>
			<label for="installerSecondaryColorLight" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">Secondary Color</label>
			<div class="flex items-center space-x-3">
				<input
					type="color"
					id="installerSecondaryColorLight"
					value={ getBrandingSecondaryColor(theme.SecondaryColor) }
					class="h-10 w-14 rounded border border-cool-grey-300 dark:border-dark-grey-500 cursor-pointer"
				/>
				<input
					type="text"
					id="installerSecondaryColorLightText"
					value={ getBrandingSecondaryColor(theme.SecondaryColor) }
					class="flex-1 px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md uppercase focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white"
					placeholder="#8040BF"
					pattern="^#[0-9A-Fa-f]{6}$"
				/>
			</div>
			<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Used for links, accents, and secondary elements.</p>
		</div>
	</div>
}

templ installerPageColorsSectionDark(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Dark Mode Colors</h3>
		<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-4">
			If not set, colors will fall back to the light mode colors.
		</p>
		<!-- Primary Color Dark -->
		<div class="mb-5">
			<label for="installerPrimaryColorDark" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">Primary Color</label>
			<div class="flex items-center space-x-3">
				<input
					type="color"
					id="installerPrimaryColorDark"
					value={ getBrandingDarkColor(theme.PrimaryColorDark, theme.PrimaryColor) }
					class="h-10 w-14 rounded border border-cool-grey-300 dark:border-dark-grey-500 cursor-pointer"
				/>
				<input
					type="text"
					id="installerPrimaryColorDarkText"
					value={ getBrandingDarkColorText(theme.PrimaryColorDark) }
					class="flex-1 px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md uppercase focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white"
					placeholder="(uses light mode)"
					pattern="^#[0-9A-Fa-f]{6}$"
				/>
			</div>
			<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Used for navigation bar and primary buttons in dark mode.</p>
		</div>
		<!-- Secondary Color Dark -->
		<div>
			<label for="installerSecondaryColorDark" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">Secondary Color</label>
			<div class="flex items-center space-x-3">
				<input
					type="color"
					id="installerSecondaryColorDark"
					value={ getBrandingDarkColor(theme.SecondaryColorDark, theme.SecondaryColor) }
					class="h-10 w-14 rounded border border-cool-grey-300 dark:border-dark-grey-500 cursor-pointer"
				/>
				<input
					type="text"
					id="installerSecondaryColorDarkText"
					value={ getBrandingDarkColorText(theme.SecondaryColorDark) }
					class="flex-1 px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md uppercase focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white"
					placeholder="(uses light mode)"
					pattern="^#[0-9A-Fa-f]{6}$"
				/>
			</div>
			<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Used for links, accents, and secondary elements in dark mode.</p>
		</div>
	</div>
}

templ installerPageTypographySection(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Typography</h3>
		<div class="space-y-4">
			<!-- Heading Font -->
			<div>
				<label class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-2">Heading Font</label>
				<select id="installerHeadingFont" class="block w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white">
					<option value="">System Default</option>
					<optgroup label="Modern Sans-Serif">
						<option value="Inter" selected?={ theme.HeadingFont == "Inter" }>Inter</option>
						<option value="DM Sans" selected?={ theme.HeadingFont == "DM Sans" }>DM Sans</option>
						<option value="Plus Jakarta Sans" selected?={ theme.HeadingFont == "Plus Jakarta Sans" }>Plus Jakarta Sans</option>
						<option value="Outfit" selected?={ theme.HeadingFont == "Outfit" }>Outfit</option>
						<option value="Figtree" selected?={ theme.HeadingFont == "Figtree" }>Figtree</option>
						<option value="Manrope" selected?={ theme.HeadingFont == "Manrope" }>Manrope</option>
					</optgroup>
					<optgroup label="Classic Sans-Serif">
						<option value="Roboto" selected?={ theme.HeadingFont == "Roboto" }>Roboto</option>
						<option value="Open Sans" selected?={ theme.HeadingFont == "Open Sans" }>Open Sans</option>
						<option value="Lato" selected?={ theme.HeadingFont == "Lato" }>Lato</option>
						<option value="Montserrat" selected?={ theme.HeadingFont == "Montserrat" }>Montserrat</option>
					</optgroup>
					<optgroup label="Friendly & Rounded">
						<option value="Poppins" selected?={ theme.HeadingFont == "Poppins" }>Poppins</option>
						<option value="Nunito" selected?={ theme.HeadingFont == "Nunito" }>Nunito</option>
						<option value="Quicksand" selected?={ theme.HeadingFont == "Quicksand" }>Quicksand</option>
					</optgroup>
				</select>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Used for titles and headings.</p>
			</div>
			<!-- Body Font -->
			<div>
				<label class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-2">Body Font</label>
				<select id="installerBodyFont" class="block w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white">
					<option value="">System Default</option>
					<optgroup label="Modern Sans-Serif">
						<option value="Inter" selected?={ theme.BodyFont == "Inter" }>Inter</option>
						<option value="DM Sans" selected?={ theme.BodyFont == "DM Sans" }>DM Sans</option>
						<option value="Plus Jakarta Sans" selected?={ theme.BodyFont == "Plus Jakarta Sans" }>Plus Jakarta Sans</option>
						<option value="Outfit" selected?={ theme.BodyFont == "Outfit" }>Outfit</option>
						<option value="Figtree" selected?={ theme.BodyFont == "Figtree" }>Figtree</option>
						<option value="Manrope" selected?={ theme.BodyFont == "Manrope" }>Manrope</option>
					</optgroup>
					<optgroup label="Classic Sans-Serif">
						<option value="Roboto" selected?={ theme.BodyFont == "Roboto" }>Roboto</option>
						<option value="Open Sans" selected?={ theme.BodyFont == "Open Sans" }>Open Sans</option>
						<option value="Lato" selected?={ theme.BodyFont == "Lato" }>Lato</option>
						<option value="Montserrat" selected?={ theme.BodyFont == "Montserrat" }>Montserrat</option>
					</optgroup>
					<optgroup label="Friendly & Rounded">
						<option value="Poppins" selected?={ theme.BodyFont == "Poppins" }>Poppins</option>
						<option value="Nunito" selected?={ theme.BodyFont == "Nunito" }>Nunito</option>
						<option value="Quicksand" selected?={ theme.BodyFont == "Quicksand" }>Quicksand</option>
					</optgroup>
				</select>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Used for paragraphs and body text.</p>
			</div>
		</div>
	</div>
}

templ installerPageSupportSection(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Support</h3>
		<div>
			<label for="installerSupportContact" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">Support Contact</label>
			<input
				type="text"
				id="installerSupportContact"
				value={ theme.SupportContact }
				placeholder="support@yourcompany.com or https://support.yourcompany.com"
				class="block w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white dark:placeholder-cool-grey-500"
			/>
			<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Email address or URL shown to customers for help.</p>
		</div>
	</div>
}

func getBrandingPrimaryColor(color string) string {
	if color == "" {
		return "#8040BF"
	}
	return color
}

func getBrandingSecondaryColor(color string) string {
	if color == "" {
		return "#8040BF"
	}
	return color
}

// getBrandingDarkColor returns the dark color for the color picker (needs a valid color value).
// Falls back to the light mode color for the color picker display.
func getBrandingDarkColor(darkColor, lightColor string) string {
	if darkColor != "" {
		return darkColor
	}
	if lightColor != "" {
		return lightColor
	}
	return "#8040BF"
}

// getBrandingDarkColorText returns the dark color for the text input.
// Returns empty string if not set (to show placeholder).
func getBrandingDarkColorText(color string) string {
	return color
}

func getBrandingFontStyle(font string) string {
	if font == "" {
		return ""
	}
	return "font-family: '" + font + "', ui-sans-serif, system-ui, sans-serif;"
}

templ installerPageScript() {
	<script>
		(function() {
			var config = document.getElementById('installer-settings-config');
			var basePath = config.dataset.basePath;
			window._installerLogoBase64 = config.dataset.logoBase64 || '';
			window._installerLoadedFonts = window._installerLoadedFonts || new Set();

			function loadGoogleFont(fontFamily) {
				if (!fontFamily || window._installerLoadedFonts.has(fontFamily)) return;
				var link = document.createElement("link");
				link.rel = "stylesheet";
				link.href = "https://fonts.googleapis.com/css2?family=" + encodeURIComponent(fontFamily) + ":wght@400;500;600;700&display=swap";
				document.head.appendChild(link);
				window._installerLoadedFonts.add(fontFamily);
			}

			window.setSettingsMode = function(mode, skipPreviewSync) {
				var lightSettings = document.getElementById('lightModeSettings');
				var darkSettings = document.getElementById('darkModeSettings');
				var settingsLightBtn = document.getElementById('settingsLightModeBtn');
				var settingsDarkBtn = document.getElementById('settingsDarkModeBtn');

				if (mode === 'light') {
					lightSettings.classList.remove('hidden');
					darkSettings.classList.add('hidden');
					settingsLightBtn.classList.add('bg-white', 'dark:bg-dark-grey-600', 'text-cool-grey-800', 'dark:text-white', 'shadow-sm');
					settingsLightBtn.classList.remove('text-cool-grey-600', 'dark:text-cool-grey-400', 'hover:bg-cool-grey-200', 'dark:hover:bg-dark-grey-600');
					settingsDarkBtn.classList.remove('bg-white', 'dark:bg-dark-grey-600', 'text-cool-grey-800', 'dark:text-white', 'shadow-sm');
					settingsDarkBtn.classList.add('text-cool-grey-600', 'dark:text-cool-grey-400', 'hover:bg-cool-grey-200', 'dark:hover:bg-dark-grey-600');
				} else {
					lightSettings.classList.add('hidden');
					darkSettings.classList.remove('hidden');
					settingsDarkBtn.classList.add('bg-white', 'dark:bg-dark-grey-600', 'text-cool-grey-800', 'dark:text-white', 'shadow-sm');
					settingsDarkBtn.classList.remove('text-cool-grey-600', 'dark:text-cool-grey-400', 'hover:bg-cool-grey-200', 'dark:hover:bg-dark-grey-600');
					settingsLightBtn.classList.remove('bg-white', 'dark:bg-dark-grey-600', 'text-cool-grey-800', 'dark:text-white', 'shadow-sm');
					settingsLightBtn.classList.add('text-cool-grey-600', 'dark:text-cool-grey-400', 'hover:bg-cool-grey-200', 'dark:hover:bg-dark-grey-600');
				}

				// Sync preview mode (unless called from setPreviewMode to avoid loop)
				if (!skipPreviewSync) {
					setPreviewMode(mode, true);
				}
			};

			// Hook into preview mode changes to sync settings panel
			window.onPreviewModeChange = function(mode) {
				setSettingsMode(mode, true);
			};

			window.updatePreview = function() {
				var isDarkMode = window._previewMode === 'dark';
				var primaryColor, secondaryColor;

				// Get colors based on current preview mode
				if (isDarkMode) {
					// Dark mode: use dark colors, fall back to light colors
					var darkPrimary = document.getElementById("installerPrimaryColorDarkText").value;
					var darkSecondary = document.getElementById("installerSecondaryColorDarkText").value;
					var lightPrimary = document.getElementById("installerPrimaryColorLight").value;
					var lightSecondary = document.getElementById("installerSecondaryColorLight").value;

					primaryColor = darkPrimary || lightPrimary;
					secondaryColor = darkSecondary || lightSecondary;
				} else {
					// Light mode: use light colors
					primaryColor = document.getElementById("installerPrimaryColorLight").value;
					secondaryColor = document.getElementById("installerSecondaryColorLight").value;
				}

				var supportContact = document.getElementById("installerSupportContact").value;
				var headingFont = document.getElementById("installerHeadingFont").value;
				var bodyFont = document.getElementById("installerBodyFont").value;

				// Update CSS variables on preview container
				var container = document.getElementById("previewContainer");
				container.style.setProperty('--preview-primary', primaryColor);
				container.style.setProperty('--preview-secondary', secondaryColor);

				// Update logo visibility based on mode
				var previewLogoLight = document.getElementById("installerPreviewLogoLight");
				var previewLogoDark = document.getElementById("installerPreviewLogoDark");

				// Get current logo values
				var lightLogoSrc = window._installerLogoLightBase64 || config.dataset.logoLightBase64 || '';
				var darkLogoSrc = window._installerLogoDarkBase64 || config.dataset.logoDarkBase64 || '';

				// Handle "REMOVE" marker
				if (lightLogoSrc === 'REMOVE') lightLogoSrc = '';
				if (darkLogoSrc === 'REMOVE') darkLogoSrc = '';

				// Update light logo
				if (lightLogoSrc) {
					previewLogoLight.src = lightLogoSrc;
					previewLogoLight.classList.remove('hidden');
				} else {
					previewLogoLight.classList.add('hidden');
				}

				// Update dark logo
				if (darkLogoSrc) {
					previewLogoDark.src = darkLogoSrc;
					previewLogoDark.classList.remove('hidden');
				} else if (lightLogoSrc) {
					// Fall back to light logo for dark mode if no dark logo
					previewLogoDark.src = lightLogoSrc;
					previewLogoDark.classList.remove('hidden');
				} else {
					previewLogoDark.classList.add('hidden');
				}

				// Update secondary color links
				var backLink = document.getElementById("installerPreviewBackLink");
				var supportLink = document.getElementById("installerPreviewSupportLink");
				if (backLink) backLink.style.color = secondaryColor;
				if (supportLink) supportLink.style.color = secondaryColor;

				// Update primary color buttons
				var approveBtn = document.getElementById("installerPreviewApproveBtn");
				var historyBtn = document.getElementById("installerPreviewHistoryBtn");
				if (approveBtn) approveBtn.style.backgroundColor = primaryColor;
				if (historyBtn) historyBtn.style.backgroundColor = primaryColor;

				// Update footer visibility
				var previewFooter = document.getElementById("installerPreviewFooter");
				if (previewFooter) {
					previewFooter.classList.toggle("hidden", !supportContact);
				}

				// Update heading fonts
				var headingFontStyle = headingFont
					? "'" + headingFont + "', ui-sans-serif, system-ui, sans-serif"
					: "ui-sans-serif, system-ui, sans-serif";
				var headingElements = [
					'installerPreviewDetailsTitle',
					'installerPreviewUpdateTitle',
					'installerPreviewWorkflowName'
				];
				headingElements.forEach(function(id) {
					var el = document.getElementById(id);
					if (el) el.style.fontFamily = headingFontStyle;
				});

				// Update body fonts
				var bodyFontStyle = bodyFont
					? "'" + bodyFont + "', ui-sans-serif, system-ui, sans-serif"
					: "ui-sans-serif, system-ui, sans-serif";
				var bodyElements = [
					'installerPreviewEmail',
					'installerPreviewBackLink',
					'installerPreviewAppName'
				];
				bodyElements.forEach(function(id) {
					var el = document.getElementById(id);
					if (el) el.style.fontFamily = bodyFontStyle;
				});

				// Update footer font
				if (previewFooter) {
					previewFooter.style.fontFamily = bodyFontStyle;
				}
			}

			window.installerRemoveLogoLight = function() {
				window._installerLogoLightBase64 = "REMOVE";
				document.getElementById("installerLogoLightPreview").classList.add("hidden");
				document.getElementById("installerLogoLightPlaceholder").classList.remove("hidden");
				document.getElementById("installerLogoLightUpload").value = "";
				document.getElementById("installerRemoveLogoLight").classList.add("hidden");
				updatePreview();
			};

			window.installerRemoveLogoDark = function() {
				window._installerLogoDarkBase64 = "REMOVE";
				document.getElementById("installerLogoDarkPreview").classList.add("hidden");
				document.getElementById("installerLogoDarkPlaceholder").classList.remove("hidden");
				document.getElementById("installerLogoDarkUpload").value = "";
				document.getElementById("installerRemoveLogoDark").classList.add("hidden");
				updatePreview();
			};

			window.saveInstallerSettings = async function() {
				var saveButton = document.getElementById("installerSaveButton");
				var successMessage = document.getElementById("installerSuccessMessage");
				var errorMessage = document.getElementById("installerErrorMessage");

				saveButton.textContent = "Saving...";
				saveButton.disabled = true;
				successMessage.classList.add("hidden");
				errorMessage.classList.add("hidden");

				var formData = {
					primary_color: document.getElementById("installerPrimaryColorLight").value,
					secondary_color: document.getElementById("installerSecondaryColorLight").value,
					primary_color_dark: document.getElementById("installerPrimaryColorDarkText").value || "",
					secondary_color_dark: document.getElementById("installerSecondaryColorDarkText").value || "",
					support_contact: document.getElementById("installerSupportContact").value,
					heading_font: document.getElementById("installerHeadingFont").value,
					body_font: document.getElementById("installerBodyFont").value
				};

				// Handle light mode logo
				var originalLogoLight = config.dataset.logoLightBase64 || '';
				if (window._installerLogoLightBase64 && window._installerLogoLightBase64 !== originalLogoLight) {
					formData.logo_light_base64 = window._installerLogoLightBase64;
				}

				// Handle dark mode logo
				var originalLogoDark = config.dataset.logoDarkBase64 || '';
				if (window._installerLogoDarkBase64 && window._installerLogoDarkBase64 !== originalLogoDark) {
					formData.logo_dark_base64 = window._installerLogoDarkBase64;
				}

				try {
					var response = await fetch(basePath + "/settings", {
						method: "PUT",
						headers: {
							"Content-Type": "application/json"
						},
						credentials: "same-origin",
						body: JSON.stringify(formData)
					});

					var data = await response.json();

					if (response.ok) {
						successMessage.classList.remove("hidden");
						showToast("Installer settings saved!", "success");
						setTimeout(function() {
							successMessage.classList.add("hidden");
							window.location.reload();
						}, 1500);
					} else {
						errorMessage.textContent = data.error || "Failed to save settings";
						errorMessage.classList.remove("hidden");
					}
				} catch (error) {
					errorMessage.textContent = "Network error. Please try again.";
					errorMessage.classList.remove("hidden");
				}

				saveButton.textContent = "Save Changes";
				saveButton.disabled = false;
			};

			// Event listeners for light mode color inputs
			document.getElementById("installerPrimaryColorLight")?.addEventListener("input", function(e) {
				document.getElementById("installerPrimaryColorLightText").value = e.target.value.toUpperCase();
				updatePreview();
			});

			document.getElementById("installerPrimaryColorLightText")?.addEventListener("input", function(e) {
				var value = e.target.value;
				if (/^#[0-9A-Fa-f]{6}$/.test(value)) {
					document.getElementById("installerPrimaryColorLight").value = value;
					updatePreview();
				}
			});

			document.getElementById("installerSecondaryColorLight")?.addEventListener("input", function(e) {
				document.getElementById("installerSecondaryColorLightText").value = e.target.value.toUpperCase();
				updatePreview();
			});

			document.getElementById("installerSecondaryColorLightText")?.addEventListener("input", function(e) {
				var value = e.target.value;
				if (/^#[0-9A-Fa-f]{6}$/.test(value)) {
					document.getElementById("installerSecondaryColorLight").value = value;
					updatePreview();
				}
			});

			// Event listeners for dark mode color inputs
			document.getElementById("installerPrimaryColorDark")?.addEventListener("input", function(e) {
				var textInput = document.getElementById("installerPrimaryColorDarkText");
				textInput.value = e.target.value.toUpperCase();
				updatePreview();
			});

			document.getElementById("installerPrimaryColorDarkText")?.addEventListener("input", function(e) {
				var value = e.target.value;
				var lightColor = document.getElementById("installerPrimaryColorLight").value || '#8040BF';
				if (value === '') {
					// Reset color picker to light mode fallback when cleared
					document.getElementById("installerPrimaryColorDark").value = lightColor;
					updatePreview();
				} else if (/^#[0-9A-Fa-f]{6}$/.test(value)) {
					document.getElementById("installerPrimaryColorDark").value = value;
					updatePreview();
				}
			});

			document.getElementById("installerSecondaryColorDark")?.addEventListener("input", function(e) {
				var textInput = document.getElementById("installerSecondaryColorDarkText");
				textInput.value = e.target.value.toUpperCase();
				updatePreview();
			});

			document.getElementById("installerSecondaryColorDarkText")?.addEventListener("input", function(e) {
				var value = e.target.value;
				var lightColor = document.getElementById("installerSecondaryColorLight").value || '#8040BF';
				if (value === '') {
					// Reset color picker to light mode fallback when cleared
					document.getElementById("installerSecondaryColorDark").value = lightColor;
					updatePreview();
				} else if (/^#[0-9A-Fa-f]{6}$/.test(value)) {
					document.getElementById("installerSecondaryColorDark").value = value;
					updatePreview();
				}
			});

			document.getElementById("installerSupportContact")?.addEventListener("input", updatePreview);

			document.getElementById("installerHeadingFont")?.addEventListener("change", function(e) {
				loadGoogleFont(e.target.value);
				updatePreview();
			});

			document.getElementById("installerBodyFont")?.addEventListener("change", function(e) {
				loadGoogleFont(e.target.value);
				updatePreview();
			});

			// Load initial fonts
			var headingFont = config.dataset.headingFont;
			var bodyFont = config.dataset.bodyFont;
			if (headingFont) loadGoogleFont(headingFont);
			if (bodyFont) loadGoogleFont(bodyFont);

			// Initial preview update
			updatePreview();

			// Light mode logo upload handler
			document.getElementById("installerLogoLightUpload")?.addEventListener("change", async function(e) {
				var file = e.target.files[0];
				if (!file) return;

				if (file.size > 500 * 1024) {
					showToast("Logo file must be under 500KB", "error");
					e.target.value = "";
					return;
				}

				var validTypes = ["image/png", "image/jpeg", "image/svg+xml", "image/gif"];
				if (!validTypes.includes(file.type)) {
					showToast("Please upload a PNG, JPG, SVG, or GIF image", "error");
					e.target.value = "";
					return;
				}

				var reader = new FileReader();
				reader.onload = function() {
					window._installerLogoLightBase64 = reader.result;
					var preview = document.getElementById("installerLogoLightPreview");
					var placeholder = document.getElementById("installerLogoLightPlaceholder");
					var removeBtn = document.getElementById("installerRemoveLogoLight");

					preview.src = window._installerLogoLightBase64;
					preview.classList.remove("hidden");
					placeholder.classList.add("hidden");
					removeBtn.classList.remove("hidden");
					updatePreview();
				};
				reader.readAsDataURL(file);
			});

			// Dark mode logo upload handler
			document.getElementById("installerLogoDarkUpload")?.addEventListener("change", async function(e) {
				var file = e.target.files[0];
				if (!file) return;

				if (file.size > 500 * 1024) {
					showToast("Logo file must be under 500KB", "error");
					e.target.value = "";
					return;
				}

				var validTypes = ["image/png", "image/jpeg", "image/svg+xml", "image/gif"];
				if (!validTypes.includes(file.type)) {
					showToast("Please upload a PNG, JPG, SVG, or GIF image", "error");
					e.target.value = "";
					return;
				}

				var reader = new FileReader();
				reader.onload = function() {
					window._installerLogoDarkBase64 = reader.result;
					var preview = document.getElementById("installerLogoDarkPreview");
					var placeholder = document.getElementById("installerLogoDarkPlaceholder");
					var removeBtn = document.getElementById("installerRemoveLogoDark");

					preview.src = window._installerLogoDarkBase64;
					preview.classList.remove("hidden");
					placeholder.classList.add("hidden");
					removeBtn.classList.remove("hidden");
					updatePreview();
				};
				reader.readAsDataURL(file);
			});
		})();
	</script>
}
