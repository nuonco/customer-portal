							<td class="px-4 py-3 preview-text-muted preview-body-font">us-east-1</td>
						</tr>
						<tr class="border-t preview-status-border">
							<td class="px-4 py-3 preview-text-body preview-body-font font-medium" style="color: var(--preview-primary);">my-staging</td>
							<td class="px-4 py-3 preview-text-body preview-body-font">Acme App</td>
							<td class="px-4 py-3"><span class="px-2 py-0.5 text-xs rounded-full bg-green-100 text-green-800">Healthy</span></td>
							<td class="px-4 py-3 preview-text-muted preview-body-font">eu-west-1</td>
