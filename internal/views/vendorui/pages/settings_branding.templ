func getBrandingPrimaryColor(color string) string {
	if color == "" {
		return "#8040BF"
	}
	return color
}

// getBrandingDarkColor returns the dark color for the color picker (needs a valid color value).
// Falls back to the light mode color for the color picker display.
func getBrandingDarkColor(darkColor, lightColor string) string {
	if darkColor != "" {
		return darkColor
	}
	if lightColor != "" {
		return lightColor
	}
	return "#8040BF"
}

// getBrandingDarkColorText returns the dark color for the text input.
// Returns empty string if not set (to show placeholder).
func getBrandingDarkColorText(color string) string {
	return color
}

func getBrandingWhiteColor(color string) string {
	if color == "" {
		return "#ffffff"
	}
	return color
}

func getBrandingBlackColor(color string) string {
	if color == "" {
		return "#121212"
	}
	return color
}

func getBrandingBlackColorLight(color string) string {
	if color == "" {
		return "#121212"
	}
	return color
}

func getBrandingBlackColorDark(darkColor, lightColor string) string {
	if darkColor != "" {
		return darkColor
	}
	return getBrandingBlackColor(lightColor)
}

func getBrandingFontStyle(font string) string {
	if font == "" {
		return ""
	}
	return "font-family: '" + font + "', ui-sans-serif, system-ui, sans-serif;"
}

func boolToDataAttr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

templ installerPageScript() {
	<script>
		(function() {
			var config = document.getElementById('installer-settings-config');
			var basePath = config.dataset.basePath;
			var orgId = config.dataset.orgId;
			window._installerLogoBase64 = config.dataset.logoBase64 || '';
			window._installerLoadedFonts = window._installerLoadedFonts || new Set();

			function loadGoogleFont(fontFamily) {
				if (!fontFamily || window._installerLoadedFonts.has(fontFamily)) return;
				var link = document.createElement("link");
				link.rel = "stylesheet";
				link.href = "https://fonts.googleapis.com/css2?family=" + encodeURIComponent(fontFamily) + ":wght@400;500;600;700&display=swap";
				document.head.appendChild(link);
				window._installerLoadedFonts.add(fontFamily);
			}

			window.updateThemeModeUI = function() {
				var labels = document.querySelectorAll('label:has(input[name="themeMode"])');
				var checked = document.querySelector('input[name="themeMode"]:checked');
				labels.forEach(function(label) {
					var input = label.querySelector('input[name="themeMode"]');
					var active = input === checked;
					if (active) {
						label.classList.add('bg-white', 'dark:bg-dark-grey-600', 'text-cool-grey-800', 'dark:text-white', 'shadow-sm', 'rounded-md');
						label.classList.remove('text-cool-grey-600', 'dark:text-cool-grey-400');
					} else {
						label.classList.remove('bg-white', 'dark:bg-dark-grey-600', 'text-cool-grey-800', 'dark:text-white', 'shadow-sm', 'rounded-md');
						label.classList.add('text-cool-grey-600', 'dark:text-cool-grey-400');
					}
				});
			};

			window.setSettingsMode = function(mode, skipPreviewSync) {
				var globalSettings = document.getElementById('globalSettings');
				var lightSettings = document.getElementById('lightModeSettings');
				var darkSettings = document.getElementById('darkModeSettings');
				var settingsGlobalBtn = document.getElementById('settingsGlobalBtn');
				var settingsLightBtn = document.getElementById('settingsLightModeBtn');
				var settingsDarkBtn = document.getElementById('settingsDarkModeBtn');

				var activeClass = ['bg-white', 'dark:bg-dark-grey-600', 'text-cool-grey-800', 'dark:text-white', 'shadow-sm'];
				var inactiveClass = ['text-cool-grey-600', 'dark:text-cool-grey-400', 'hover:bg-cool-grey-200', 'dark:hover:bg-dark-grey-600'];

				// Hide all panels, deactivate all buttons
				[globalSettings, lightSettings, darkSettings].forEach(function(el) { el.classList.add('hidden'); });
				[settingsGlobalBtn, settingsLightBtn, settingsDarkBtn].forEach(function(btn) {
					activeClass.forEach(function(c) { btn.classList.remove(c); });
					inactiveClass.forEach(function(c) { btn.classList.add(c); });
				});

				// Show the selected panel and activate its button
				var contentEl, activeBtn;
				if (mode === 'light') {
					contentEl = lightSettings; activeBtn = settingsLightBtn;
				} else if (mode === 'dark') {
					contentEl = darkSettings; activeBtn = settingsDarkBtn;
				} else {
					contentEl = globalSettings; activeBtn = settingsGlobalBtn;
				}
				contentEl.classList.remove('hidden');
				activeClass.forEach(function(c) { activeBtn.classList.add(c); });
				inactiveClass.forEach(function(c) { activeBtn.classList.remove(c); });

				// Sync preview mode for light/dark tabs only
				if (!skipPreviewSync && (mode === 'light' || mode === 'dark')) {
					setPreviewMode(mode, true);
				}
			};

			// Hook into preview mode changes to sync settings panel
			// Only switch away from Global tab if currently on light/dark tab
			window.onPreviewModeChange = function(mode) {
				var globalSettings = document.getElementById('globalSettings');
				if (!globalSettings.classList.contains('hidden')) return;
				setSettingsMode(mode, true);
			};

			window.onPreviewPageChange = function(page) {
				document.querySelectorAll('.preview-page-section').forEach(function(el) {
					el.classList.add('hidden');
				});
				var el = document.getElementById('preview-page-' + page);
				if (el) el.classList.remove('hidden');
				updatePreview();
			};

			window.updatePreview = function() {
				var isDarkMode = window._previewMode === 'dark';
				var primaryColor;

				// Get colors based on current preview mode
				if (isDarkMode) {
					// Dark mode: use dark color, fall back to light color
					var darkPrimary = document.getElementById("installerPrimaryColorDarkText").value;
					var lightPrimary = document.getElementById("installerPrimaryColorLight").value;

					primaryColor = darkPrimary || lightPrimary;
				} else {
					// Light mode: use light color
					primaryColor = document.getElementById("installerPrimaryColorLight").value;
				}

				var headingFont = document.getElementById("installerHeadingFont").value;
				var bodyFont = document.getElementById("installerBodyFont").value;

				// Update CSS variables on preview container
				var container = document.getElementById("previewContainer");
				container.style.setProperty('--preview-primary', primaryColor);

				// Update white/black background colors
				var whiteColor = document.getElementById("installerWhiteColor")?.value || '#f8fafc';
				var blackColor = document.getElementById("installerBlackColorDark")?.value || '#121212';
				container.style.setProperty('--preview-white', whiteColor);
				container.style.setProperty('--preview-black', blackColor);

				// Get current logo values
				var lightLogoSrc = window._installerLogoLightBase64 || config.dataset.logoLightBase64 || '';
				var darkLogoSrc = window._installerLogoDarkBase64 || config.dataset.logoDarkBase64 || '';

				// Handle "REMOVE" marker
				if (lightLogoSrc === 'REMOVE') lightLogoSrc = '';
				if (darkLogoSrc === 'REMOVE') darkLogoSrc = '';

				// Update all light logos across all pages (class-based)
				document.querySelectorAll('#previewContainer .preview-logo-light').forEach(function(el) {
					if (lightLogoSrc) {
						el.src = lightLogoSrc;
						el.style.display = '';
					} else {
						el.src = '';
						el.style.display = 'none';
					}
				});

				// Update all dark logos across all pages (class-based, fall back to light logo)
				var darkSrc = darkLogoSrc || lightLogoSrc;
				document.querySelectorAll('#previewContainer .preview-logo-dark').forEach(function(el) {
					if (darkSrc) {
						el.src = darkSrc;
						el.style.display = '';
					} else {
						el.src = '';
						el.style.display = 'none';
					}
				});

				// Update header title in all preview pages
				var headerTitleInput = document.getElementById("installerHeaderTitle");
				var headerTitleHidden = document.getElementById("installerHeaderTitleHidden");
				var headerTitleText = '';
				if (headerTitleHidden && !headerTitleHidden.checked) {
					headerTitleText = (headerTitleInput && headerTitleInput.value) || headerTitleInput.placeholder || '';
				}
				document.querySelectorAll('#previewContainer .preview-header-title').forEach(function(el) {
					el.textContent = headerTitleText;
					if (headerTitleText) {
						el.classList.remove('hidden');
					} else {
						el.classList.add('hidden');
					}
				});

				// Hide logo+title row when no logo and no title (matches real header.templ conditional)
				var hasLogoOrTitle = !!lightLogoSrc || !!darkLogoSrc || !!headerTitleText;
				document.querySelectorAll('#previewContainer .preview-logo-title-row').forEach(function(el) {
					if (hasLogoOrTitle) {
						el.classList.remove('hidden');
					} else {
						el.classList.add('hidden');
					}
				});

				// Update link colors (install detail page)
				var backLink = document.getElementById("installerPreviewBackLink");
				if (backLink) backLink.style.color = primaryColor;

				// Update primary color buttons (install detail page)
				var approveBtn = document.getElementById("installerPreviewApproveBtn");
				var historyBtn = document.getElementById("installerPreviewHistoryBtn");
				if (approveBtn) approveBtn.style.backgroundColor = primaryColor;
				if (historyBtn) historyBtn.style.backgroundColor = primaryColor;

				// Use custom font if uploaded, otherwise use Google Font selection
				var headingFontStyle;
				var customHeadingFont = window._installerHeadingFontBase64;
				if (customHeadingFont && customHeadingFont !== 'REMOVE') {
					headingFontStyle = "'CustomHeadingPreview', ui-sans-serif, system-ui, sans-serif";
				} else if (headingFont) {
					headingFontStyle = "'" + headingFont + "', ui-sans-serif, system-ui, sans-serif";
				} else {
					headingFontStyle = "ui-sans-serif, system-ui, sans-serif";
				}
				document.querySelectorAll('#previewContainer .preview-heading-font').forEach(function(el) {
					el.style.fontFamily = headingFontStyle;
				});

				// Update body fonts across all pages (class-based)
				var bodyFontStyle;
				var customBodyFont = window._installerBodyFontBase64;
				if (customBodyFont && customBodyFont !== 'REMOVE') {
					bodyFontStyle = "'CustomBodyPreview', ui-sans-serif, system-ui, sans-serif";
				} else if (bodyFont) {
					bodyFontStyle = "'" + bodyFont + "', ui-sans-serif, system-ui, sans-serif";
				} else {
					bodyFontStyle = "ui-sans-serif, system-ui, sans-serif";
				}
				document.querySelectorAll('#previewContainer .preview-body-font').forEach(function(el) {
					el.style.fontFamily = bodyFontStyle;
				});

			}

			window.installerRemoveLogoLight = function() {
				window._installerLogoLightBase64 = "REMOVE";
				document.getElementById("installerLogoLightPreview").classList.add("hidden");
				document.getElementById("installerLogoLightPlaceholder").classList.remove("hidden");
				document.getElementById("installerLogoLightUpload").value = "";
				document.getElementById("installerRemoveLogoLight").disabled = true;
				document.getElementById("installerLogoLightHelpText").textContent = "PNG, JPG, SVG, or GIF. Max 500KB.";
				updatePreview();
				checkForChanges();
			};

			window.installerRemoveLogoDark = function() {
				window._installerLogoDarkBase64 = "REMOVE";
				document.getElementById("installerLogoDarkPreview").classList.add("hidden");
				document.getElementById("installerLogoDarkPlaceholder").classList.remove("hidden");
				document.getElementById("installerLogoDarkUpload").value = "";
				document.getElementById("installerRemoveLogoDark").disabled = true;
				document.getElementById("installerLogoDarkHelpText").textContent = "PNG, JPG, SVG, or GIF. Max 500KB.";
				updatePreview();
				checkForChanges();
			};

			window.installerRemoveFavicon = function() {
				window._installerFaviconBase64 = "REMOVE";
				document.getElementById("installerFaviconPreview").classList.add("hidden");
				document.getElementById("installerFaviconPlaceholder").classList.remove("hidden");
				document.getElementById("installerFaviconUpload").value = "";
				document.getElementById("installerRemoveFavicon").disabled = true;
				document.getElementById("installerFaviconHelpText").textContent = "ICO, PNG, or SVG. Max 100KB.";
				checkForChanges();
			};

			window.installerRemoveHeadingFont = function() {
				window._installerHeadingFontBase64 = "REMOVE";
				document.getElementById("installerHeadingFontCard").classList.add("hidden");
				document.getElementById("installerHeadingFontUpload").classList.remove("hidden");
				document.getElementById("installerHeadingFontUpload").value = "";
				updatePreview();
			};

			window.installerRemoveBodyFont = function() {
				window._installerBodyFontBase64 = "REMOVE";
				document.getElementById("installerBodyFontCard").classList.add("hidden");
				document.getElementById("installerBodyFontUpload").classList.remove("hidden");
				document.getElementById("installerBodyFontUpload").value = "";
				updatePreview();
			};

			window.installerChangeHeadingFont = function() {
				document.getElementById("installerHeadingFontCard").classList.add("hidden");
				document.getElementById("installerHeadingFontUpload").classList.remove("hidden");
			};

			window.installerChangeBodyFont = function() {
				document.getElementById("installerBodyFontCard").classList.add("hidden");
				document.getElementById("installerBodyFontUpload").classList.remove("hidden");
			};

			window.saveInstallerSettings = async function() {
				var saveButton = document.getElementById("installerSaveButton");
				var successMessage = document.getElementById("installerSuccessMessage");
				var errorMessage = document.getElementById("installerErrorMessage");

				saveButton.textContent = "Saving...";
				saveButton.disabled = true;
				successMessage.classList.add("hidden");
				errorMessage.classList.add("hidden");

				var formData = {
					primary_color: document.getElementById("installerPrimaryColorLight").value,
					primary_color_dark: document.getElementById("installerPrimaryColorDarkText").value || "",
					white_color: document.getElementById("installerWhiteColorText").value || "",
					black_color: document.getElementById("installerBlackColorDarkText").value || "",
					white_color_dark: document.getElementById("installerWhiteColorDarkText").value || "",
					black_color_light: document.getElementById("installerBlackColorLightText").value || "",
					heading_font: document.getElementById("installerHeadingFont").value,
					body_font: document.getElementById("installerBodyFont").value,
					theme_mode: document.querySelector('input[name="themeMode"]:checked')?.value || 'auto',
					custom_css: document.getElementById("installerCustomCSS").value,
					header_title: document.getElementById("installerHeaderTitle").value,
					header_title_hidden: document.getElementById("installerHeaderTitleHidden").checked
				};

				// Handle light mode logo
				var originalLogoLight = config.dataset.logoLightBase64 || '';
				if (window._installerLogoLightBase64 && window._installerLogoLightBase64 !== originalLogoLight) {
					formData.logo_light_base64 = window._installerLogoLightBase64;
				}

				// Handle dark mode logo
				var originalLogoDark = config.dataset.logoDarkBase64 || '';
				if (window._installerLogoDarkBase64 && window._installerLogoDarkBase64 !== originalLogoDark) {
					formData.logo_dark_base64 = window._installerLogoDarkBase64;
				}

				// Handle favicon
				var originalFavicon = config.dataset.faviconBase64 || '';
				if (window._installerFaviconBase64 && window._installerFaviconBase64 !== originalFavicon) {
					formData.favicon_base64 = window._installerFaviconBase64;
				}

				// Handle heading font custom upload
				var originalHeadingFontBase64 = config.dataset.headingFontBase64 || '';
				if (window._installerHeadingFontBase64 && window._installerHeadingFontBase64 !== originalHeadingFontBase64) {
					formData.heading_font_base64 = window._installerHeadingFontBase64;
					formData.heading_font_name = window._installerHeadingFontName || '';
				}

				// Handle body font custom upload
				var originalBodyFontBase64 = config.dataset.bodyFontBase64 || '';
				if (window._installerBodyFontBase64 && window._installerBodyFontBase64 !== originalBodyFontBase64) {
					formData.body_font_base64 = window._installerBodyFontBase64;
					formData.body_font_name = window._installerBodyFontName || '';
				}

				try {
					var response = await fetch(basePath + "/orgs/" + orgId + "/settings", {
						method: "PUT",
						headers: {
							"Content-Type": "application/json"
						},
						credentials: "same-origin",
						body: JSON.stringify(formData)
					});

					var data = await response.json();

					if (response.ok) {
						showToast("Installer settings saved!", "success");
						// Update stored config so next save only sends new changes
						Object.keys(formData).forEach(function(key) {
							var attrName = 'data-' + key.replace(/_/g, '-');
							config.setAttribute(attrName, formData[key]);
						});
						// Sync file upload globals into config dataset
						config.dataset.logoLightBase64 = window._installerLogoLightBase64 || '';
						config.dataset.logoDarkBase64 = window._installerLogoDarkBase64 || '';
						config.dataset.faviconBase64 = window._installerFaviconBase64 || '';
						config.dataset.headingFontBase64 = window._installerHeadingFontBase64 || '';
						config.dataset.bodyFontBase64 = window._installerBodyFontBase64 || '';
					} else {
						errorMessage.textContent = data.error || "Failed to save settings";
						errorMessage.classList.remove("hidden");
					}
				} catch (error) {
					errorMessage.textContent = "Network error. Please try again.";
					errorMessage.classList.remove("hidden");
				}

				saveButton.textContent = "Save";
				checkForChanges();
			};

			function checkForChanges() {
				var saveButton = document.getElementById("installerSaveButton");
				var current = {
					primary_color: document.getElementById("installerPrimaryColorLight").value,
					primary_color_dark: document.getElementById("installerPrimaryColorDarkText").value || "",
					white_color: document.getElementById("installerWhiteColorText").value || "",
					black_color: document.getElementById("installerBlackColorDarkText").value || "",
					white_color_dark: document.getElementById("installerWhiteColorDarkText").value || "",
					black_color_light: document.getElementById("installerBlackColorLightText").value || "",
					heading_font: document.getElementById("installerHeadingFont").value,
					body_font: document.getElementById("installerBodyFont").value,
					theme_mode: document.querySelector('input[name="themeMode"]:checked')?.value || 'auto',
					custom_css: document.getElementById("installerCustomCSS").value,
					header_title: document.getElementById("installerHeaderTitle").value,
					header_title_hidden: document.getElementById("installerHeaderTitleHidden").checked ? "true" : "false"
				};
				var saved = {
					primary_color: config.dataset.primaryColor || "",
					primary_color_dark: config.dataset.primaryColorDark || "",
					white_color: config.dataset.whiteColor || "",
					black_color: config.dataset.blackColor || "",
					white_color_dark: config.dataset.whiteColorDark || "",
					black_color_light: config.dataset.blackColorLight || "",
					heading_font: config.dataset.headingFont || "",
					body_font: config.dataset.bodyFont || "",
					theme_mode: config.dataset.themeMode || "auto",
					custom_css: config.dataset.customCss || "",
					header_title: config.dataset.headerTitle || "",
					header_title_hidden: config.dataset.headerTitleHidden || "false"
				};
				var hasChanges = Object.keys(current).some(function(k) { return current[k] !== saved[k]; });
				// Check file uploads
				if (!hasChanges) {
					var logoLight = window._installerLogoLightBase64 || '';
					var logoDark = window._installerLogoDarkBase64 || '';
					var favicon = window._installerFaviconBase64 || '';
					var headingFontB64 = window._installerHeadingFontBase64 || '';
					var bodyFontB64 = window._installerBodyFontBase64 || '';
					if (logoLight !== (config.dataset.logoLightBase64 || '')) hasChanges = true;
					if (logoDark !== (config.dataset.logoDarkBase64 || '')) hasChanges = true;
					if (favicon !== (config.dataset.faviconBase64 || '')) hasChanges = true;
					if (headingFontB64 !== (config.dataset.headingFontBase64 || '')) hasChanges = true;
					if (bodyFontB64 !== (config.dataset.bodyFontBase64 || '')) hasChanges = true;
				}
				saveButton.disabled = !hasChanges;
			}

			// Color picker → text sync (used via oninput on color picker elements)
			window.handleColorPickerInput = function(pickerId, textId) {
				document.getElementById(textId).value = document.getElementById(pickerId).value.toUpperCase();
				updatePreview();
				checkForChanges();
			};

			// Text → color picker sync (used via oninput on text input elements)
			window.handleColorTextInput = function(textId, pickerId, fallbackExpr) {
				var value = document.getElementById(textId).value;
				if (value === '' && fallbackExpr !== undefined) {
					document.getElementById(pickerId).value = typeof fallbackExpr === 'function' ? fallbackExpr() : fallbackExpr;
					updatePreview();
				} else if (/^#[0-9A-Fa-f]{6}$/.test(value)) {
					document.getElementById(pickerId).value = value;
					updatePreview();
				}
				checkForChanges();
			};

			// Font select change (used via onchange on font select elements)
			window.handleFontSelectChange = function(selectEl) {
				loadGoogleFont(selectEl.value);
				updatePreview();
				checkForChanges();
			};

			// Simple change detection (used via oninput/onchange on various elements)
			window.brandingCheckForChanges = function() {
				checkForChanges();
			};

			// Update preview + change detection
			window.brandingPreviewAndCheck = function() {
				updatePreview();
				checkForChanges();
			};

			// Load initial fonts
			var headingFont = config.dataset.headingFont;
			var bodyFont = config.dataset.bodyFont;
			if (headingFont) loadGoogleFont(headingFont);
			if (bodyFont) loadGoogleFont(bodyFont);

			// Load initial white/black color values from config
			var savedWhiteColor = config.dataset.whiteColor;
			var savedBlackColor = config.dataset.blackColor;
			if (savedWhiteColor) {
				var whiteInput = document.getElementById("installerWhiteColor");
				var whiteText = document.getElementById("installerWhiteColorText");
				if (whiteInput) whiteInput.value = savedWhiteColor;
				if (whiteText) whiteText.value = savedWhiteColor.toUpperCase();
			}
			if (savedBlackColor) {
				var blackInput = document.getElementById("installerBlackColorDark");
				var blackText = document.getElementById("installerBlackColorDarkText");
				if (blackInput) blackInput.value = savedBlackColor;
				if (blackText) blackText.value = savedBlackColor.toUpperCase();
			}

			var savedWhiteColorDark = config.dataset.whiteColorDark;
			var savedBlackColorLight = config.dataset.blackColorLight;
			if (savedWhiteColorDark) {
				var whiteDarkInput = document.getElementById("installerWhiteColorDark");
				var whiteDarkText = document.getElementById("installerWhiteColorDarkText");
				if (whiteDarkInput) whiteDarkInput.value = savedWhiteColorDark;
				if (whiteDarkText) whiteDarkText.value = savedWhiteColorDark.toUpperCase();
			}
			if (savedBlackColorLight) {
				var blackLightInput = document.getElementById("installerBlackColorLight");
				var blackLightText = document.getElementById("installerBlackColorLightText");
				if (blackLightInput) blackLightInput.value = savedBlackColorLight;
				if (blackLightText) blackLightText.value = savedBlackColorLight.toUpperCase();
			}

			// Initialize custom fonts from saved config
			var savedHeadingFontBase64 = config.dataset.headingFontBase64;
			var savedBodyFontBase64 = config.dataset.bodyFontBase64;
			var savedHeadingFontName = config.dataset.headingFontName || '';
			window._installerHeadingFontName = savedHeadingFontName;
			var savedBodyFontName = config.dataset.bodyFontName || '';
			window._installerBodyFontName = savedBodyFontName;
			if (savedHeadingFontBase64) {
				window._installerHeadingFontBase64 = savedHeadingFontBase64;
				var style = document.createElement('style');
				style.id = 'customHeadingFontPreview';
				style.textContent = "@font-face { font-family: 'CustomHeadingPreview'; src: url('" + savedHeadingFontBase64 + "'); }";
				document.head.appendChild(style);
			}
			if (savedBodyFontBase64) {
				window._installerBodyFontBase64 = savedBodyFontBase64;
				var style = document.createElement('style');
				style.id = 'customBodyFontPreview';
				style.textContent = "@font-face { font-family: 'CustomBodyPreview'; src: url('" + savedBodyFontBase64 + "'); }";
				document.head.appendChild(style);
			}

			// Initial preview update
			updatePreview();

			// Logo light upload — wraps shared handler and updates help text with filename
			window.handleLogoLightUpload = function(input) {
				var file = input.files[0];
				var fileName = file ? file.name : '';
				handleBrandingImageUpload(input, '_installerLogoLightBase64', 'installerLogoLightPreview', 'installerLogoLightPlaceholder', 'installerRemoveLogoLight', 500, ['image/png','image/jpeg','image/svg+xml','image/gif'], 'Logo file', true);
				if (input.files[0] && fileName) {
					document.getElementById('installerLogoLightHelpText').textContent = fileName;
				}
			};

			// Logo dark upload — wraps shared handler and updates help text with filename
			window.handleLogoDarkUpload = function(input) {
				var file = input.files[0];
				var fileName = file ? file.name : '';
				handleBrandingImageUpload(input, '_installerLogoDarkBase64', 'installerLogoDarkPreview', 'installerLogoDarkPlaceholder', 'installerRemoveLogoDark', 500, ['image/png','image/jpeg','image/svg+xml','image/gif'], 'Logo file', true);
				if (input.files[0] && fileName) {
					document.getElementById('installerLogoDarkHelpText').textContent = fileName;
				}
			};

			// Favicon upload — wraps shared handler and updates help text with filename
			window.handleFaviconUpload = function(input) {
				var file = input.files[0];
				var fileName = file ? file.name : '';
				handleBrandingImageUpload(input, '_installerFaviconBase64', 'installerFaviconPreview', 'installerFaviconPlaceholder', 'installerRemoveFavicon', 100, ['image/x-icon','image/png','image/svg+xml'], 'Favicon file', false);
				// If validation failed, input.value was cleared — check before updating text
				if (input.files[0] && fileName) {
					document.getElementById('installerFaviconHelpText').textContent = fileName;
				}
			};

			// Image upload handler (used via onchange on file inputs)
			window.handleBrandingImageUpload = function(input, globalVar, previewId, placeholderId, removeBtnId, maxKB, validTypes, errorMsg, withPreview) {
				var file = input.files[0];
				if (!file) return;
				if (file.size > maxKB * 1024) {
					showToast(errorMsg + " must be under " + maxKB + "KB", "error");
					input.value = "";
					return;
				}
				if (!validTypes.includes(file.type)) {
					showToast("Invalid file type", "error");
					input.value = "";
					return;
				}
				var reader = new FileReader();
				reader.onload = function() {
					window[globalVar] = reader.result;
					document.getElementById(previewId).src = reader.result;
					document.getElementById(previewId).classList.remove("hidden");
					document.getElementById(placeholderId).classList.add("hidden");
					document.getElementById(removeBtnId).disabled = false;
					if (withPreview) updatePreview();
					checkForChanges();
				};
				reader.readAsDataURL(file);
			};

			// Font upload handler (used via onchange on font file inputs)
			window.handleBrandingFontUpload = function(input, globalVarBase64, globalVarName, styleId, fontFamily, labelId, cardId) {
				var file = input.files[0];
				if (!file) return;
				if (file.size > 280 * 1024) {
					showToast("Font file must be under 280KB", "error");
					input.value = "";
					return;
				}
				var validTypes = ["font/woff2", "font/woff", "application/font-woff2", "application/font-woff", "application/octet-stream"];
				var validExt = file.name.endsWith('.woff2') || file.name.endsWith('.woff');
				if (!validTypes.includes(file.type) && !validExt) {
					showToast("Please upload a WOFF2 or WOFF font file", "error");
					input.value = "";
					return;
				}
				var reader = new FileReader();
				reader.onload = function() {
					window[globalVarBase64] = reader.result;
					window[globalVarName] = file.name;
					var existing = document.getElementById(styleId);
					if (existing) existing.remove();
					var style = document.createElement('style');
					style.id = styleId;
					style.textContent = "@font-face { font-family: '" + fontFamily + "'; src: url('" + reader.result + "'); }";
					document.head.appendChild(style);
					document.getElementById(labelId).textContent = file.name;
					document.getElementById(cardId).classList.remove("hidden");
					input.classList.add("hidden");
					updatePreview();
					checkForChanges();
				};
				reader.readAsDataURL(file);
			};
		})();
	</script>
}
