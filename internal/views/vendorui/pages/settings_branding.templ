package pages

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui/components"
)

// BrandingSettingsPageProps for the branding settings page
type BrandingSettingsPageProps struct {
	vendorui.LayoutProps
	Theme *models.AppTheme
}

// BrandingSettingsPage renders the branding settings page
templ BrandingSettingsPage(props BrandingSettingsPageProps) {
	@vendorui.Layout(props.LayoutProps) {
		<div class="flex flex-1 overflow-hidden">
			@components.PortalSubnav(components.PortalSubnavProps{
				OrgID:         props.CurrentOrg.ID,
				ActiveSubPage: "branding",
				BasePath:      props.BasePath,
			})
			<div class="stratus-page-content overflow-auto">
				<div class="stratus-page-header">
					<div class="stratus-heading-group">
						<h1 class="stratus-page-title">Branding</h1>
						<p class="stratus-page-subtitle">Customize the appearance of the customer portal.</p>
					</div>
				</div>
				<div class="stratus-page-section">
					<div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-6 items-start">
						<!-- Left Column: Settings -->
						<div class="space-y-6">
							@installerSettingsModeToggle()
							<div id="globalSettings" class="space-y-6">
								@installerPageHeaderTitleSection(props.Theme, props.CurrentOrg.Name)
								@installerPageFaviconSection(props.Theme)
								@installerPageColorSchemeSection(props.Theme)
								@installerPageTypographySection(props.Theme)
								@installerPageCustomCSSSection(props.Theme)
							</div>
							<div id="lightModeSettings" class="hidden space-y-6">
								@installerPageBrandingSectionLight(props.Theme)
								@installerPageColorsSectionLight(props.Theme)
							</div>
							<div id="darkModeSettings" class="hidden space-y-6">
								@installerPageBrandingSectionDark(props.Theme)
								@installerPageColorsSectionDark(props.Theme)
							</div>
							<!-- Save Button -->
							<div class="flex flex-col space-y-3">
								<button type="button" id="installerSaveButton" onclick="saveInstallerSettings()" class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 text-base rounded-md font-medium text-white bg-primary-600 hover:bg-primary-700">
									Save Changes
								</button>
								<!-- Status Messages -->
								<div id="installerSuccessMessage" class="hidden p-4 bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-800 text-green-700 dark:text-green-300 rounded-lg">
									Settings saved successfully!
								</div>
								<div id="installerErrorMessage" class="hidden p-4 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-300 rounded-lg"></div>
							</div>
						</div>
						<!-- Right Column: Preview (sticky) -->
						<div>
							@components.PreviewContainer(components.PreviewContainerProps{
								Title:          "Preview",
								Description:    "This is what your customers will see.",
								InitialMode:    "light",
								InitialSize:    "desktop",
								PrimaryColor:   getBrandingPrimaryColor(props.Theme.PrimaryColor),
								SecondaryColor: getBrandingSecondaryColor(props.Theme.SecondaryColor),
								WhiteColor:     getBrandingWhiteColor(props.Theme.WhiteColor),
								BlackColor:     getBrandingBlackColor(props.Theme.BlackColor),
								PageOptions: []components.PreviewPageOption{
									{Value: "install-detail",   Label: "Install Detail"},
									{Value: "installs-list",    Label: "Installs List"},
									{Value: "install-creation", Label: "Install Creation"},
									{Value: "app-catalog",      Label: "App Catalog"},
									{Value: "login",            Label: "Login Screen"},
								},
							}) {
								<div id="preview-page-install-detail" class="preview-page-section">
									@brandingPreviewInstallDetail(props.Theme)
								</div>
								<div id="preview-page-installs-list" class="preview-page-section hidden">
									@brandingPreviewInstallsList(props.Theme)
								</div>
								<div id="preview-page-install-creation" class="preview-page-section hidden">
									@brandingPreviewInstallCreation(props.Theme)
								</div>
								<div id="preview-page-app-catalog" class="preview-page-section hidden">
									@brandingPreviewApps(props.Theme)
								</div>
								<div id="preview-page-login" class="preview-page-section hidden">
									@brandingPreviewLogin(props.Theme)
								</div>
							}
						</div>
					</div>
				</div>
				<!-- Config data for JavaScript -->
				<div
					id="installer-settings-config"
					class="hidden"
					data-base-path={ props.BasePath }
					data-org-id={ props.CurrentOrg.ID }
					data-logo-light-base64={ props.Theme.LogoLightBase64 }
					data-logo-dark-base64={ props.Theme.LogoDarkBase64 }
					data-favicon-base64={ props.Theme.FaviconBase64 }
					data-heading-font={ props.Theme.HeadingFont }
					data-body-font={ props.Theme.BodyFont }
					data-heading-font-base64={ props.Theme.HeadingFontBase64 }
					data-body-font-base64={ props.Theme.BodyFontBase64 }
					data-heading-font-name={ props.Theme.HeadingFontName }
					data-body-font-name={ props.Theme.BodyFontName }
					data-primary-color={ props.Theme.PrimaryColor }
					data-secondary-color={ props.Theme.SecondaryColor }
					data-primary-color-dark={ props.Theme.PrimaryColorDark }
					data-secondary-color-dark={ props.Theme.SecondaryColorDark }
					data-white-color={ props.Theme.WhiteColor }
					data-black-color={ props.Theme.BlackColor }
					data-white-color-dark={ props.Theme.WhiteColorDark }
					data-black-color-light={ props.Theme.BlackColorLight }
					data-header-title={ props.Theme.HeaderTitle }
					data-header-title-hidden={ boolToDataAttr(props.Theme.HeaderTitleHidden) }
				></div>
				@installerPageScript()
			</div>
		</div>
	}
}

templ brandingPreviewInstallDetail(theme *models.AppTheme) {
	<div class="preview-page-bg h-full flex flex-col overflow-hidden">
		<!-- Page Header -->
		<header class="px-6 py-3 flex items-center justify-between flex-shrink-0 preview-card" style="border-left: none; border-right: none; border-top: none; border-radius: 0;">
			<div class="flex items-center gap-3">
				if theme.LogoLightBase64 != "" {
					<img src={ theme.LogoLightBase64 } alt="Logo" class="h-6 w-auto max-w-24 object-contain preview-logo-light"/>
				} else {
					<img src="" alt="Logo" class="h-6 w-auto max-w-24 object-contain hidden preview-logo-light"/>
				}
				if theme.LogoDarkBase64 != "" {
					<img src={ theme.LogoDarkBase64 } alt="Logo" class="h-6 w-auto max-w-24 object-contain hidden preview-logo-dark"/>
				} else {
					<img src="" alt="Logo" class="h-6 w-auto max-w-24 object-contain hidden preview-logo-dark"/>
				}
				<span class="text-sm font-semibold preview-text-heading preview-heading-font preview-header-title"></span>
			</div>
			<span class="text-sm preview-text-muted preview-body-font">user@example.com</span>
		</header>
		<!-- Main: Table + Sliding Panel -->
		<div class="relative flex-1 overflow-hidden">
			<!-- Left: Installs List (matches Installs List preview layout) -->
			<div class="absolute inset-0 overflow-hidden">
				<main class="mx-auto px-6 pt-4 w-full max-w-4xl">
					<h1 class="text-xl font-semibold preview-text-heading preview-heading-font mb-4">Installs</h1>
					<!-- Tabs -->
					<div class="flex border-b border-current mb-4 text-sm">
						<button class="px-4 py-2 font-medium preview-body-font" style="color: var(--preview-primary); border-bottom: 2px solid var(--preview-primary);">Needs Attention</button>
						<button class="px-4 py-2 preview-text-muted preview-body-font">Updating</button>
						<button class="px-4 py-2 preview-text-muted preview-body-font">Healthy</button>
					</div>
					<!-- Table -->
					<div class="preview-card rounded-lg overflow-hidden">
						<table class="w-full text-sm">
							<thead>
								<tr class="preview-status-bg">
									<th class="px-4 py-3 text-left preview-text-muted preview-body-font font-medium">Name</th>
									<th class="px-4 py-3 text-left preview-text-muted preview-body-font font-medium">App</th>
									<th class="px-4 py-3 text-left preview-text-muted preview-body-font font-medium">Status</th>
									<th class="px-4 py-3 text-left preview-text-muted preview-body-font font-medium">Region</th>
								</tr>
							</thead>
							<tbody>
								<tr class="border-t preview-status-border" style="background-color: color-mix(in srgb, var(--preview-primary) 8%, transparent);">
									<td class="px-4 py-3 preview-text-body preview-body-font font-medium" style="color: var(--preview-primary);">my-production</td>
									<td class="px-4 py-3 preview-text-body preview-body-font">Acme App</td>
									<td class="px-4 py-3"><span class="px-2 py-0.5 text-xs rounded-full bg-yellow-100 text-yellow-800">Needs Attention</span></td>
									<td class="px-4 py-3 preview-text-muted preview-body-font">us-east-1</td>
								</tr>
								<tr class="border-t preview-status-border">
									<td class="px-4 py-3 preview-text-body preview-body-font font-medium" style="color: var(--preview-primary);">my-staging</td>
									<td class="px-4 py-3 preview-text-body preview-body-font">Acme App</td>
									<td class="px-4 py-3"><span class="px-2 py-0.5 text-xs rounded-full bg-green-100 text-green-800">Healthy</span></td>
									<td class="px-4 py-3 preview-text-muted preview-body-font">eu-west-1</td>
								</tr>
							</tbody>
						</table>
					</div>
				</main>
			</div>
			<!-- Overlay -->
			<div class="absolute inset-0" style="background-color: rgba(0,0,0,0.3);"></div>
			<!-- Right: Detail Panel (overlays table content) -->
			<div class="absolute top-0 right-0 bottom-0 flex flex-col overflow-hidden preview-card" style="width: 64%; border-radius: 0; border-top: none; border-right: none; border-bottom: none;">
				<!-- Panel Header -->
				<div class="px-4 py-3 flex items-center justify-between flex-shrink-0" style="border-bottom: 1px solid #e5e7eb;">
					<div class="min-w-0 flex-1">
						<h2 class="text-sm font-semibold preview-text-heading preview-heading-font truncate">my-production</h2>
						<span class="text-xs font-mono preview-text-muted">a1b2c3d4-e5f6-7890</span>
					</div>
					<div class="flex items-center gap-2 ml-3 flex-shrink-0">
						<button class="flex items-center gap-1 text-xs px-2.5 py-1 preview-text-body preview-body-font preview-card" style="border-radius: 4px;">
							Actions
							<svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
						</button>
						<button class="p-1 preview-text-muted">
							<svg class="w-4 h-4" viewBox="0 0 256 256" fill="currentColor"><path d="M216,48V88a8,8,0,0,1-16,0V56H168a8,8,0,0,1,0-16h40A8,8,0,0,1,216,48ZM88,200H56V168a8,8,0,0,0-16,0v40a8,8,0,0,0,8,8H88a8,8,0,0,0,0-16Zm120-40a8,8,0,0,0-8,8v32H168a8,8,0,0,0,0,16h40a8,8,0,0,0,8-8V168A8,8,0,0,0,208,160ZM88,40H48a8,8,0,0,0-8,8V88a8,8,0,0,0,16,0V56H88a8,8,0,0,0,0-16Z"></path></svg>
						</button>
						<button class="text-lg leading-none preview-text-muted px-1">&times;</button>
					</div>
				</div>
				<!-- Tab Headers -->
				<div class="flex text-sm flex-shrink-0" style="border-bottom: 1px solid #e5e7eb;">
					<button class="px-4 py-2.5 preview-body-font font-medium" style="color: var(--preview-primary); border-bottom: 2px solid var(--preview-primary); margin-bottom: -1px;">Overview</button>
					<button class="px-4 py-2.5 preview-text-muted preview-body-font">History</button>
					<button class="px-4 py-2.5 preview-text-muted preview-body-font">Audit Log</button>
				</div>
				<!-- Panel Body -->
				<div class="p-4 space-y-3 overflow-hidden flex-1">
					<!-- Workflow Card -->
					<div class="preview-card p-4 rounded shadow-sm">
						<div class="flex items-center gap-2 mb-1">
							<h4 class="text-sm font-medium preview-text-heading preview-heading-font">Deploy</h4>
							<span class="text-xs px-2 py-0.5 rounded bg-blue-100 text-blue-800">in-progress</span>
						</div>
						<div class="flex items-center gap-2 text-xs preview-text-muted preview-body-font mb-1.5">
							<svg class="animate-spin h-3 w-3 flex-shrink-0" fill="none" viewBox="0 0 24 24">
								<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
								<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
							</svg>
							<span><span class="font-medium">Step 2 of 5:</span> Installing dependencies</span>
						</div>
						<!-- Progress bar -->
						<div class="w-full h-1 rounded-sm overflow-hidden preview-status-bg mb-2">
							<div class="h-full bg-blue-500 rounded-sm" style="width: 40%;"></div>
						</div>
						<p class="text-xs preview-text-muted preview-body-font mb-2">Jan 15, 2025 2:30 PM</p>
						<button class="text-xs text-white px-3 py-1.5 rounded" style="background-color: var(--preview-primary);">Approve Installation</button>
					</div>
					<!-- App Config + Platform Grid -->
					<div class="grid grid-cols-2 gap-3">
						<!-- App Config Card -->
						<div class="preview-card p-4 rounded shadow-sm">
							<div class="flex items-center gap-2 mb-2">
								<h3 class="text-sm font-medium preview-text-heading preview-heading-font">Acme App</h3>
								<span class="text-xs px-1.5 py-0.5 rounded-full bg-amber-100 text-amber-800">update available</span>
							</div>
							<div class="grid grid-cols-2 gap-x-3 gap-y-2 text-xs">
								<div>
									<p class="preview-text-muted preview-body-font">Installed Version</p>
									<p class="font-medium text-amber-600 preview-body-font">v3</p>
								</div>
								<div>
									<p class="preview-text-muted preview-body-font">Latest Version</p>
									<p class="font-medium preview-text-body preview-body-font">v4</p>
								</div>
								<div>
									<p class="preview-text-muted preview-body-font">Last Updated</p>
									<p class="font-medium preview-text-body preview-body-font">Jan 10, 2025</p>
								</div>
								<div>
									<p class="preview-text-muted preview-body-font">Published</p>
									<p class="font-medium preview-text-body preview-body-font">Jan 15, 2025</p>
								</div>
							</div>
						</div>
						<!-- Platform Card -->
						<div class="preview-card p-4 rounded shadow-sm">
							<h3 class="text-sm font-medium preview-text-heading preview-heading-font mb-3">Platform</h3>
							<div class="space-y-2 text-xs">
								<div>
									<p class="preview-text-muted preview-body-font">Name</p>
									<p class="font-medium preview-text-body preview-body-font">AWS</p>
								</div>
								<div>
									<p class="preview-text-muted preview-body-font">Region</p>
									<p class="font-medium preview-text-body preview-body-font">us-east-1</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ installerPageColorSchemeSection(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-1 text-cool-grey-800 dark:text-white">Color Scheme</h3>
		<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-4">
			Control whether customers see the portal in light mode, dark mode, or their system preference.
		</p>
		<div class="flex items-center space-x-1 bg-cool-grey-100 dark:bg-dark-grey-700 rounded-lg p-1">
			<label class={ "flex-1 text-center cursor-pointer", templ.KV("bg-white dark:bg-dark-grey-600 text-cool-grey-800 dark:text-white shadow-sm rounded-md", theme.GetThemeMode() == "auto"), templ.KV("text-cool-grey-600 dark:text-cool-grey-400", theme.GetThemeMode() != "auto") }>
				<input type="radio" name="themeMode" value="auto" class="sr-only" checked?={ theme.GetThemeMode() == "auto" } onchange="updateThemeModeUI()"/>
				<span class="block px-3 py-1.5 text-sm font-medium">System</span>
			</label>
			<label class={ "flex-1 text-center cursor-pointer", templ.KV("bg-white dark:bg-dark-grey-600 text-cool-grey-800 dark:text-white shadow-sm rounded-md", theme.GetThemeMode() == "light"), templ.KV("text-cool-grey-600 dark:text-cool-grey-400", theme.GetThemeMode() != "light") }>
				<input type="radio" name="themeMode" value="light" class="sr-only" checked?={ theme.GetThemeMode() == "light" } onchange="updateThemeModeUI()"/>
				<span class="block px-3 py-1.5 text-sm font-medium">Light</span>
			</label>
			<label class={ "flex-1 text-center cursor-pointer", templ.KV("bg-white dark:bg-dark-grey-600 text-cool-grey-800 dark:text-white shadow-sm rounded-md", theme.GetThemeMode() == "dark"), templ.KV("text-cool-grey-600 dark:text-cool-grey-400", theme.GetThemeMode() != "dark") }>
				<input type="radio" name="themeMode" value="dark" class="sr-only" checked?={ theme.GetThemeMode() == "dark" } onchange="updateThemeModeUI()"/>
				<span class="block px-3 py-1.5 text-sm font-medium">Dark</span>
			</label>
		</div>
	</div>
}

templ installerSettingsModeToggle() {
	<div class="flex items-center space-x-1 bg-cool-grey-100 dark:bg-dark-grey-700 rounded-lg p-1">
		<button
			type="button"
			id="settingsGlobalBtn"
			onclick="setSettingsMode('global')"
			class="flex-1 px-3 py-1.5 text-sm font-medium rounded-md transition-colors bg-white dark:bg-dark-grey-600 text-cool-grey-800 dark:text-white shadow-sm"
		>
			Global
		</button>
		<button
			type="button"
			id="settingsLightModeBtn"
			onclick="setSettingsMode('light')"
			class="flex-1 px-3 py-1.5 text-sm font-medium rounded-md transition-colors text-cool-grey-600 dark:text-cool-grey-400 hover:bg-cool-grey-200 dark:hover:bg-dark-grey-600"
		>
			Light Mode
		</button>
		<button
			type="button"
			id="settingsDarkModeBtn"
			onclick="setSettingsMode('dark')"
			class="flex-1 px-3 py-1.5 text-sm font-medium rounded-md transition-colors text-cool-grey-600 dark:text-cool-grey-400 hover:bg-cool-grey-200 dark:hover:bg-dark-grey-600"
		>
			Dark Mode
		</button>
	</div>
}

templ installerPageBrandingSectionLight(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Logo</h3>
		<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-4">
			This logo will be displayed when the customer portal is in light mode.
		</p>
		<div class="flex items-center space-x-4">
			<div class="flex-shrink-0 w-32 h-32 bg-white border-2 border-cool-grey-300 rounded flex items-center justify-center p-2">
				if theme.LogoLightBase64 != "" {
					<img id="installerLogoLightPreview" src={ theme.LogoLightBase64 } alt="Light logo preview" class="max-w-full max-h-full object-contain"/>
				} else {
					<img id="installerLogoLightPreview" src="" alt="Light logo preview" class="max-w-full max-h-full object-contain hidden"/>
				}
				<div id="installerLogoLightPlaceholder" class={ "text-cool-grey-400 text-xs text-center", templ.KV("hidden", theme.LogoLightBase64 != "") }>
					<span>No logo</span>
				</div>
			</div>
			<div class="flex-1">
				<input
					type="file"
					id="installerLogoLightUpload"
					accept="image/png,image/jpeg,image/svg+xml,image/gif"
					class="block w-full text-sm text-cool-grey-500 dark:text-cool-grey-400 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-sm file:font-medium file:bg-primary-50 dark:file:bg-primary-900 file:text-primary-700 dark:file:text-primary-300 hover:file:bg-primary-100 dark:hover:file:bg-primary-800"
				/>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Best for white or light backgrounds. PNG, JPG, SVG, or GIF. Max 500KB.</p>
				<button type="button" id="installerRemoveLogoLight" onclick="installerRemoveLogoLight()" class={ "mt-2 text-xs text-red-600 hover:text-red-800", templ.KV("hidden", theme.LogoLightBase64 == "") }>
					Remove logo
				</button>
			</div>
		</div>
	</div>
}

templ installerPageBrandingSectionDark(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Dark Mode Logo</h3>
		<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-4">
			This logo will be displayed when the customer portal is in dark mode. If not provided, the light mode logo will be used.
		</p>
		<div class="flex items-center space-x-4">
			<div class="flex-shrink-0 w-32 h-32 bg-dark-grey-900 border-2 border-dark-grey-700 rounded flex items-center justify-center p-2">
				if theme.LogoDarkBase64 != "" {
					<img id="installerLogoDarkPreview" src={ theme.LogoDarkBase64 } alt="Dark logo preview" class="max-w-full max-h-full object-contain"/>
				} else {
					<img id="installerLogoDarkPreview" src="" alt="Dark logo preview" class="max-w-full max-h-full object-contain hidden"/>
				}
				<div id="installerLogoDarkPlaceholder" class={ "text-cool-grey-500 text-xs text-center", templ.KV("hidden", theme.LogoDarkBase64 != "") }>
					<span>No logo</span><br/>
					<span class="text-[10px]">(will use light logo)</span>
				</div>
			</div>
			<div class="flex-1">
				<input
					type="file"
					id="installerLogoDarkUpload"
					accept="image/png,image/jpeg,image/svg+xml,image/gif"
					class="block w-full text-sm text-cool-grey-500 dark:text-cool-grey-400 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-sm file:font-medium file:bg-primary-50 dark:file:bg-primary-900 file:text-primary-700 dark:file:text-primary-300 hover:file:bg-primary-100 dark:hover:file:bg-primary-800"
				/>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Best for dark backgrounds. PNG, JPG, SVG, or GIF. Max 500KB.</p>
				<button type="button" id="installerRemoveLogoDark" onclick="installerRemoveLogoDark()" class={ "mt-2 text-xs text-red-600 hover:text-red-800", templ.KV("hidden", theme.LogoDarkBase64 == "") }>
					Remove logo
				</button>
			</div>
		</div>
	</div>
}

templ installerPageColorsSectionLight(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Colors</h3>
		<!-- Primary Color -->
		<div class="mb-5">
			<label for="installerPrimaryColorLight" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">Primary Color</label>
			<div class="flex items-center space-x-3">
				<input
					type="color"
					id="installerPrimaryColorLight"
					value={ getBrandingPrimaryColor(theme.PrimaryColor) }
					class="h-10 w-14 rounded border border-cool-grey-300 dark:border-dark-grey-500 cursor-pointer"
				/>
				<input
					type="text"
					id="installerPrimaryColorLightText"
					value={ getBrandingPrimaryColor(theme.PrimaryColor) }
					class="flex-1 px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md uppercase focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white"
					placeholder="#8040BF"
					pattern="^#[0-9A-Fa-f]{6}$"
				/>
			</div>
			<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Used for navigation bar and primary buttons.</p>
		</div>
		<!-- Secondary Color -->
		<div class="mb-5">
			<label for="installerSecondaryColorLight" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">Secondary Color</label>
			<div class="flex items-center space-x-3">
				<input
					type="color"
					id="installerSecondaryColorLight"
					value={ getBrandingSecondaryColor(theme.SecondaryColor) }
					class="h-10 w-14 rounded border border-cool-grey-300 dark:border-dark-grey-500 cursor-pointer"
				/>
				<input
					type="text"
					id="installerSecondaryColorLightText"
					value={ getBrandingSecondaryColor(theme.SecondaryColor) }
					class="flex-1 px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md uppercase focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white"
					placeholder="#8040BF"
					pattern="^#[0-9A-Fa-f]{6}$"
				/>
			</div>
			<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Used for links, accents, and secondary elements.</p>
		</div>
		<!-- White (Background) Color -->
		<div>
			<label for="installerWhiteColor" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">White</label>
			<div class="flex items-center space-x-3">
				<input
					type="color"
					id="installerWhiteColor"
					value={ getBrandingWhiteColor(theme.WhiteColor) }
					class="h-10 w-14 rounded border border-cool-grey-300 dark:border-dark-grey-500 cursor-pointer"
				/>
				<input
					type="text"
					id="installerWhiteColorText"
					value={ getBrandingWhiteColor(theme.WhiteColor) }
					class="flex-1 px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md uppercase focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white"
					placeholder="#ffffff"
					pattern="^#[0-9A-Fa-f]{6}$"
				/>
			</div>
			<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Background color for pages, panels, and cards in light mode.</p>
		</div>
		<!-- Black Color (Light Mode) -->
		<div class="mt-5">
			<label for="installerBlackColorLight" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">Black</label>
			<div class="flex items-center space-x-3">
				<input
					type="color"
					id="installerBlackColorLight"
					value={ getBrandingBlackColorLight(theme.BlackColorLight) }
					class="h-10 w-14 rounded border border-cool-grey-300 dark:border-dark-grey-500 cursor-pointer"
				/>
				<input
					type="text"
					id="installerBlackColorLightText"
					value={ getBrandingDarkColorText(theme.BlackColorLight) }
					class="flex-1 px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md uppercase focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white"
					placeholder="#121212"
					pattern="^#[0-9A-Fa-f]{6}$"
				/>
			</div>
			<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Dark surfaces used in light mode (panels, overlays).</p>
		</div>
	</div>
}

templ installerPageColorsSectionDark(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Dark Mode Colors</h3>
		<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-4">
			If not set, colors will fall back to the light mode colors.
		</p>
		<!-- Primary Color Dark -->
		<div class="mb-5">
			<label for="installerPrimaryColorDark" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">Primary Color</label>
			<div class="flex items-center space-x-3">
				<input
					type="color"
					id="installerPrimaryColorDark"
					value={ getBrandingDarkColor(theme.PrimaryColorDark, theme.PrimaryColor) }
					class="h-10 w-14 rounded border border-cool-grey-300 dark:border-dark-grey-500 cursor-pointer"
				/>
				<input
					type="text"
					id="installerPrimaryColorDarkText"
					value={ getBrandingDarkColorText(theme.PrimaryColorDark) }
					class="flex-1 px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md uppercase focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white"
					placeholder="(uses light mode)"
					pattern="^#[0-9A-Fa-f]{6}$"
				/>
			</div>
			<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Used for navigation bar and primary buttons in dark mode.</p>
		</div>
		<!-- Secondary Color Dark -->
		<div class="mb-5">
			<label for="installerSecondaryColorDark" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">Secondary Color</label>
			<div class="flex items-center space-x-3">
				<input
					type="color"
					id="installerSecondaryColorDark"
					value={ getBrandingDarkColor(theme.SecondaryColorDark, theme.SecondaryColor) }
					class="h-10 w-14 rounded border border-cool-grey-300 dark:border-dark-grey-500 cursor-pointer"
				/>
				<input
					type="text"
					id="installerSecondaryColorDarkText"
					value={ getBrandingDarkColorText(theme.SecondaryColorDark) }
					class="flex-1 px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md uppercase focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white"
					placeholder="(uses light mode)"
					pattern="^#[0-9A-Fa-f]{6}$"
				/>
			</div>
			<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Used for links, accents, and secondary elements in dark mode.</p>
		</div>
		<!-- White Color (Dark Mode) -->
		<div class="mb-5">
			<label for="installerWhiteColorDark" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">White</label>
			<div class="flex items-center space-x-3">
				<input
					type="color"
					id="installerWhiteColorDark"
					value={ getBrandingDarkColor(theme.WhiteColorDark, theme.WhiteColor) }
					class="h-10 w-14 rounded border border-cool-grey-300 dark:border-dark-grey-500 cursor-pointer"
				/>
				<input
					type="text"
					id="installerWhiteColorDarkText"
					value={ getBrandingDarkColorText(theme.WhiteColorDark) }
					class="flex-1 px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md uppercase focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white"
					placeholder="(uses light mode setting)"
					pattern="^#[0-9A-Fa-f]{6}$"
				/>
			</div>
			<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Light background surfaces in dark mode (cards, panels). Defaults to the light mode background.</p>
		</div>
		<!-- Black (Background) Color Dark -->
		<div>
			<label for="installerBlackColorDark" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">Black</label>
			<div class="flex items-center space-x-3">
				<input
					type="color"
					id="installerBlackColorDark"
					value={ getBrandingBlackColorDark(theme.BlackColor, theme.BlackColorLight) }
					class="h-10 w-14 rounded border border-cool-grey-300 dark:border-dark-grey-500 cursor-pointer"
				/>
				<input
					type="text"
					id="installerBlackColorDarkText"
					value={ getBrandingDarkColorText(theme.BlackColor) }
					class="flex-1 px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md uppercase focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white"
					placeholder="(uses light mode setting)"
					pattern="^#[0-9A-Fa-f]{6}$"
				/>
			</div>
			<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Background color for pages, panels, and cards in dark mode. Defaults to the light mode black.</p>
		</div>
	</div>
}

templ installerPageTypographySection(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Typography</h3>
		<div class="space-y-4">
			<!-- Heading Font -->
			<div>
				<label class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-2">Heading Font</label>
				<select id="installerHeadingFont" class="block w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white">
					<option value="">System Default</option>
					<optgroup label="Modern Sans-Serif">
						<option value="Inter" selected?={ theme.HeadingFont == "Inter" }>Inter</option>
						<option value="DM Sans" selected?={ theme.HeadingFont == "DM Sans" }>DM Sans</option>
						<option value="Plus Jakarta Sans" selected?={ theme.HeadingFont == "Plus Jakarta Sans" }>Plus Jakarta Sans</option>
						<option value="Outfit" selected?={ theme.HeadingFont == "Outfit" }>Outfit</option>
						<option value="Figtree" selected?={ theme.HeadingFont == "Figtree" }>Figtree</option>
						<option value="Manrope" selected?={ theme.HeadingFont == "Manrope" }>Manrope</option>
					</optgroup>
					<optgroup label="Classic Sans-Serif">
						<option value="Roboto" selected?={ theme.HeadingFont == "Roboto" }>Roboto</option>
						<option value="Open Sans" selected?={ theme.HeadingFont == "Open Sans" }>Open Sans</option>
						<option value="Lato" selected?={ theme.HeadingFont == "Lato" }>Lato</option>
						<option value="Montserrat" selected?={ theme.HeadingFont == "Montserrat" }>Montserrat</option>
					</optgroup>
					<optgroup label="Friendly & Rounded">
						<option value="Poppins" selected?={ theme.HeadingFont == "Poppins" }>Poppins</option>
						<option value="Nunito" selected?={ theme.HeadingFont == "Nunito" }>Nunito</option>
						<option value="Quicksand" selected?={ theme.HeadingFont == "Quicksand" }>Quicksand</option>
					</optgroup>
				</select>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Used for titles and headings.</p>
				<!-- Custom Heading Font Upload -->
				<div class="mt-3">
					<p class="text-xs text-cool-grey-500 dark:text-cool-grey-400 mb-2">Or upload a custom font file (overrides the selection above):</p>
					<!-- Font-loaded card: shown when base64 is saved -->
					<div
						id="installerHeadingFontCard"
						class={ templ.KV("hidden", theme.HeadingFontBase64 == ""), "flex items-center gap-3 py-2 px-3 bg-cool-grey-50 dark:bg-dark-grey-800 rounded border border-cool-grey-200 dark:border-dark-grey-600" }
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-cool-grey-500 dark:text-cool-grey-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
						</svg>
						<span id="installerHeadingFontLabel" class="text-sm font-medium text-cool-grey-700 dark:text-cool-grey-200 flex-1 truncate">
							if theme.HeadingFontName != "" {
								{ theme.HeadingFontName }
							} else {
								Custom font
							}
						</span>
						<button type="button" onclick="installerChangeHeadingFont()" class="text-xs text-primary-600 hover:underline">Change</button>
						<button type="button" onclick="installerRemoveHeadingFont()" class="text-xs text-red-600 hover:underline">Remove</button>
					</div>
					<!-- Upload input: shown when no font is saved -->
					<input
						type="file"
						id="installerHeadingFontUpload"
						accept=".woff2,.woff,font/woff2,font/woff"
						class={ templ.KV("hidden", theme.HeadingFontBase64 != ""), "block w-full text-sm text-cool-grey-500 dark:text-cool-grey-400 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-sm file:font-medium file:bg-primary-50 dark:file:bg-primary-900 file:text-primary-700 dark:file:text-primary-300 hover:file:bg-primary-100 dark:hover:file:bg-primary-800" }
					/>
					<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">WOFF2 or WOFF format. Max 280KB.</p>
					<p id="installerHeadingFontStatus" class="mt-1 text-xs text-green-600 dark:text-green-400 hidden">Custom font loaded.</p>
				</div>
			</div>
			<!-- Body Font -->
			<div>
				<label class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-2">Body Font</label>
				<select id="installerBodyFont" class="block w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white">
					<option value="">System Default</option>
					<optgroup label="Modern Sans-Serif">
						<option value="Inter" selected?={ theme.BodyFont == "Inter" }>Inter</option>
						<option value="DM Sans" selected?={ theme.BodyFont == "DM Sans" }>DM Sans</option>
						<option value="Plus Jakarta Sans" selected?={ theme.BodyFont == "Plus Jakarta Sans" }>Plus Jakarta Sans</option>
						<option value="Outfit" selected?={ theme.BodyFont == "Outfit" }>Outfit</option>
						<option value="Figtree" selected?={ theme.BodyFont == "Figtree" }>Figtree</option>
						<option value="Manrope" selected?={ theme.BodyFont == "Manrope" }>Manrope</option>
					</optgroup>
					<optgroup label="Classic Sans-Serif">
						<option value="Roboto" selected?={ theme.BodyFont == "Roboto" }>Roboto</option>
						<option value="Open Sans" selected?={ theme.BodyFont == "Open Sans" }>Open Sans</option>
						<option value="Lato" selected?={ theme.BodyFont == "Lato" }>Lato</option>
						<option value="Montserrat" selected?={ theme.BodyFont == "Montserrat" }>Montserrat</option>
					</optgroup>
					<optgroup label="Friendly & Rounded">
						<option value="Poppins" selected?={ theme.BodyFont == "Poppins" }>Poppins</option>
						<option value="Nunito" selected?={ theme.BodyFont == "Nunito" }>Nunito</option>
						<option value="Quicksand" selected?={ theme.BodyFont == "Quicksand" }>Quicksand</option>
					</optgroup>
				</select>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Used for paragraphs and body text.</p>
				<!-- Custom Body Font Upload -->
				<div class="mt-3">
					<p class="text-xs text-cool-grey-500 dark:text-cool-grey-400 mb-2">Or upload a custom font file (overrides the selection above):</p>
					<!-- Font-loaded card: shown when base64 is saved -->
					<div
						id="installerBodyFontCard"
						class={ templ.KV("hidden", theme.BodyFontBase64 == ""), "flex items-center gap-3 py-2 px-3 bg-cool-grey-50 dark:bg-dark-grey-800 rounded border border-cool-grey-200 dark:border-dark-grey-600" }
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-cool-grey-500 dark:text-cool-grey-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
						</svg>
						<span id="installerBodyFontLabel" class="text-sm font-medium text-cool-grey-700 dark:text-cool-grey-200 flex-1 truncate">
							if theme.BodyFontName != "" {
								{ theme.BodyFontName }
							} else {
								Custom font
							}
						</span>
						<button type="button" onclick="installerChangeBodyFont()" class="text-xs text-primary-600 hover:underline">Change</button>
						<button type="button" onclick="installerRemoveBodyFont()" class="text-xs text-red-600 hover:underline">Remove</button>
					</div>
					<!-- Upload input: shown when no font is saved -->
					<input
						type="file"
						id="installerBodyFontUpload"
						accept=".woff2,.woff,font/woff2,font/woff"
						class={ templ.KV("hidden", theme.BodyFontBase64 != ""), "block w-full text-sm text-cool-grey-500 dark:text-cool-grey-400 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-sm file:font-medium file:bg-primary-50 dark:file:bg-primary-900 file:text-primary-700 dark:file:text-primary-300 hover:file:bg-primary-100 dark:hover:file:bg-primary-800" }
					/>
					<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">WOFF2 or WOFF format. Max 280KB.</p>
					<p id="installerBodyFontStatus" class="mt-1 text-xs text-green-600 dark:text-green-400 hidden">Custom font loaded.</p>
				</div>
			</div>
		</div>
	</div>
}

templ installerPageHeaderTitleSection(theme *models.AppTheme, orgName string) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Header Title</h3>
		<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-4">
			Set a title that appears next to your logo in the customer portal header.
		</p>
		<div class="space-y-4">
			<div>
				<label class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1" for="installerHeaderTitle">Custom Title</label>
				<input
					type="text"
					id="installerHeaderTitle"
					value={ theme.HeaderTitle }
					placeholder={ theme.GetHeaderTitle(orgName) }
					oninput="updatePreview()"
					class="block w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md text-sm bg-white dark:bg-dark-grey-700 text-cool-grey-800 dark:text-white focus:ring-2 focus:ring-primary-400 focus:border-primary-600"
				/>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">
					Leave empty to use the default: "{ theme.GetHeaderTitle(orgName) }"
				</p>
			</div>
			<div class="flex items-center gap-2">
				<input
					type="checkbox"
					id="installerHeaderTitleHidden"
					if theme.HeaderTitleHidden {
						checked
					}
					onchange="updatePreview()"
					class="h-4 w-4 rounded border-cool-grey-300 text-primary-600 focus:ring-primary-500"
				/>
				<label class="text-sm text-cool-grey-700 dark:text-cool-grey-300" for="installerHeaderTitleHidden">Hide header title</label>
			</div>
		</div>
	</div>
}

templ installerPageFaviconSection(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Favicon</h3>
		<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-4">
			Upload a favicon to display in browser tabs when customers visit the portal.
		</p>
		<div class="flex items-center space-x-4">
			<div class="flex-shrink-0 w-16 h-16 bg-white border-2 border-cool-grey-300 rounded flex items-center justify-center p-2">
				if theme.FaviconBase64 != "" {
					<img id="installerFaviconPreview" src={ theme.FaviconBase64 } alt="Favicon preview" class="max-w-full max-h-full object-contain"/>
				} else {
					<img id="installerFaviconPreview" src="" alt="Favicon preview" class="max-w-full max-h-full object-contain hidden"/>
				}
				<div id="installerFaviconPlaceholder" class={ "text-cool-grey-400 text-xs text-center", templ.KV("hidden", theme.FaviconBase64 != "") }>
					<span>No favicon</span>
				</div>
			</div>
			<div class="flex-1">
				<input
					type="file"
					id="installerFaviconUpload"
					accept="image/x-icon,image/png,image/svg+xml"
					class="block w-full text-sm text-cool-grey-500 dark:text-cool-grey-400 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-sm file:font-medium file:bg-primary-50 dark:file:bg-primary-900 file:text-primary-700 dark:file:text-primary-300 hover:file:bg-primary-100 dark:hover:file:bg-primary-800"
				/>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">ICO, PNG, or SVG. Max 100KB.</p>
				<button type="button" id="installerRemoveFavicon" onclick="installerRemoveFavicon()" class={ "mt-2 text-xs text-red-600 hover:text-red-800", templ.KV("hidden", theme.FaviconBase64 == "") }>
					Remove favicon
				</button>
			</div>
		</div>
	</div>
}

templ installerPageCustomCSSSection(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Custom CSS</h3>
		<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-4">
			Add custom CSS rules that will be injected into the customer portal.
		</p>
		<textarea
			id="installerCustomCSS"
			rows="10"
			class="block w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md text-sm bg-white dark:bg-dark-grey-700 text-cool-grey-800 dark:text-white font-mono focus:ring-2 focus:ring-primary-400 focus:border-primary-600"
			placeholder="/* Add your custom CSS here */&#10;.my-class { color: red; }"
		>{ theme.CustomCSS }</textarea>
		<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">
			CSS is appended to the portal stylesheet after all theme variables are applied.
		</p>
	</div>
}

