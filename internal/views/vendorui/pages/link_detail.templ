package pages

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui/components"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui/partials"
)

// LinkDetailPageProps for the install link detail page
type LinkDetailPageProps struct {
	vendorui.LayoutProps
	Link                        *models.InstallLink
	InstallURL                  string
	CustomerDashboardInstallURL string // Full URL with subdomain for viewing install in customer dashboard
}

// LinkDetailPage renders the install link detail page
templ LinkDetailPage(props LinkDetailPageProps) {
	@vendorui.Layout(props.LayoutProps) {
		<div class="stratus-page-content overflow-auto">
			<div class="stratus-page-header">
				<div class="stratus-heading-group">
					<h1 class="stratus-page-title">Install Link Details</h1>
					<p class="stratus-page-subtitle">View and manage this install link.</p>
				</div>
			</div>
			<div class="stratus-page-section">
				<!-- Install Information Card -->
				<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500 mb-6">
					<h2 class="text-lg font-semibold text-cool-grey-900 dark:text-white mb-4">Install Information</h2>
					<div class="space-y-4">
						<div>
							<h3 class="text-lg font-semibold text-cool-grey-700 dark:text-cool-grey-300">Application</h3>
							<p class="text-xl text-cool-grey-900 dark:text-white">{ props.Link.AppName }</p>
							<p class="text-cool-grey-600 dark:text-cool-grey-400">App ID: { props.Link.AppID }</p>
						</div>
						<div>
							<h3 class="text-lg font-semibold text-cool-grey-700 dark:text-cool-grey-300">Created</h3>
							<p class="text-cool-grey-900 dark:text-cool-grey-200">{ props.Link.CreatedAt.Format("January 2, 2006 at 3:04 PM") }</p>
						</div>
						<div class="pt-4 border-t border-cool-grey-200 dark:border-dark-grey-600">
							@components.Button(components.ButtonProps{
								Text:    "Delete Install",
								Variant: "danger",
								OnClick: "deleteLink()",
							})
							<p class="text-xs text-cool-grey-500 dark:text-cool-grey-400 mt-2">
								This will permanently remove the install and cannot be undone.
							</p>
						</div>
					</div>
				</div>
				<!-- Link Management Card with HTMX polling -->
				<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
					<h2 class="text-lg font-semibold text-cool-grey-900 dark:text-white mb-4">Link Management</h2>
					<div class="space-y-4">
						@partials.LinkStatus(partials.LinkStatusProps{
							Link:                        props.Link,
							InstallURL:                  props.InstallURL,
							CustomerDashboardInstallURL: props.CustomerDashboardInstallURL,
							PrimaryColor:                props.PrimaryColor,
							BasePath:                    props.BasePath,
						})
					</div>
				</div>
			</div>
		</div>
		<!-- Config data for JavaScript -->
		<div
			id="link-detail-config"
			class="hidden"
			data-base-path={ props.BasePath }
			data-org-id={ props.Link.OrgID }
			data-link-id={ props.Link.ID }
			data-link-used={ boolToString(props.Link.Used) }
		></div>
		@linkDetailScript()
	}
}

func boolToString(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

templ linkDetailScript() {
	<script>
		(function() {
			var config = document.getElementById('link-detail-config');
			var basePath = config.dataset.basePath;
			var orgId = config.dataset.orgId;
			var linkId = config.dataset.linkId;
			var previousUsedState = config.dataset.linkUsed === 'true';

			document.body.addEventListener('htmx:afterSwap', function(evt) {
				if (evt.detail.target.id === 'link-status') {
					var linkStatusEl = evt.detail.target;
					var currentUsed = linkStatusEl.dataset.linkUsed === 'true';

					if (!previousUsedState && currentUsed) {
						showToast('Install link has been accepted by a customer!', 'success');
					}

					previousUsedState = currentUsed;
				}
			});

			window.copyToClipboard = function() {
				var urlEl = document.getElementById('installUrl');
				if (!urlEl) {
					showToast('Install URL not available - link may have been accepted', 'error');
					return;
				}
				var url = urlEl.textContent;
				navigator.clipboard.writeText(url).then(function() {
					showToast('Install link copied to clipboard!', 'success');
				}).catch(function() {
					var textarea = document.createElement('textarea');
					textarea.value = url;
					document.body.appendChild(textarea);
					textarea.select();
					document.execCommand('copy');
					document.body.removeChild(textarea);
					showToast('Install link copied to clipboard!', 'success');
				});
			};

			window.deleteLink = async function() {
				var confirmed = await showConfirmModal({
					title: 'Delete Install Link?',
					message: 'Are you sure you want to delete this install link? This action cannot be undone.',
					variant: 'danger',
					confirmText: 'Delete',
					cancelText: 'Cancel'
				});

				if (!confirmed) {
					return;
				}

				try {
					var response = await fetch(basePath + '/orgs/' + orgId + '/install-links/' + linkId, {
						method: 'DELETE'
					});

					if (response.ok) {
						showToast('Install link deleted successfully', 'success');
						setTimeout(function() {
							window.location.href = basePath + '/orgs/' + orgId + '/install-links';
						}, 1000);
					} else {
						showToast('Failed to delete install', 'error');
					}
				} catch (error) {
					showToast('Network error. Please try again.', 'error');
				}
			};
		})();
	</script>
}
