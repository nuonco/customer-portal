package pages

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui/components"
)

// AppOverviewPageProps for the app overview editor page
type AppOverviewPageProps struct {
	vendorui.LayoutProps
	Org              models.NuonOrg
	App              AppInfo
	OverviewMarkdown string
}

// AppOverviewPage renders the app overview markdown editor page
templ AppOverviewPage(props AppOverviewPageProps) {
	@vendorui.Layout(props.LayoutProps) {
		<div class="flex h-full overflow-hidden">
			@components.AppSubnav(components.AppSubnavProps{
				OrgID:         props.Org.ID,
				AppID:         props.App.ID,
				ActiveSubPage: "overview",
				BasePath:      props.BasePath,
			})
			<div
				class="stratus-page-content overflow-auto"
				id="appOverviewConfig"
			>
				<section class="stratus-page-section">
					<div class="stratus-card space-y-4">
						<div>
							<!-- Write / Preview tabs -->
							<div class="flex border-b border-cool-grey-200 dark:border-dark-grey-600 mb-3">
								<button
									type="button"
									id="tabWrite"
									onclick="switchTab('write')"
									class="px-4 py-2 text-sm font-medium border-b-2 border-primary-500 text-primary-600 dark:text-primary-400"
								>
									Edit
								</button>
								<button
									type="button"
									id="tabPreview"
									onclick="switchTab('preview')"
									class="px-4 py-2 text-sm font-medium border-b-2 border-transparent text-cool-grey-500 dark:text-cool-grey-400 hover:text-cool-grey-700 dark:hover:text-cool-grey-300"
								>
									Preview
								</button>
							</div>
							<!-- Write pane -->
							<div id="writePane">
								<textarea
									id="overviewMarkdown"
									rows="6"
									style="field-sizing: content"
									class="w-full min-h-[12rem] resize-none rounded-md border border-cool-grey-300 dark:border-dark-grey-600 bg-white dark:bg-dark-grey-800 text-cool-grey-900 dark:text-cool-grey-100 text-sm px-3 py-2 font-mono focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
									placeholder="# App Overview&#10;&#10;Describe your app here..."
								>{ props.OverviewMarkdown }</textarea>
							</div>
							<!-- Preview pane -->
							<div id="previewPane" class="hidden w-full min-h-[24rem] rounded-md border border-cool-grey-300 dark:border-dark-grey-600 bg-white dark:bg-dark-grey-800 px-3 py-2 overflow-auto">
								<div id="overviewPreview" class="prose"></div>
							</div>
						</div>
						<!-- Save button -->
						<div class="flex items-center gap-3 pt-2 border-t border-cool-grey-200 dark:border-dark-grey-700">
							<button
								type="button"
								id="appOverviewSaveBtn"
								onclick="saveAppOverview()"
								class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500"
							>
								Save
							</button>
							<span id="appOverviewSaveStatus" class="text-sm text-cool-grey-500 dark:text-cool-grey-400 hidden"></span>
						</div>
					</div>
				</section>
			</div>
		</div>
		@appOverviewScript(props.Org.ID, props.App.ID, props.BasePath)
	}
}

script appOverviewScript(orgID, appID, basePath string) {
	(function() {
		var activeTabClass = 'border-primary-500 text-primary-600 dark:text-primary-400';
		var inactiveTabClass = 'border-transparent text-cool-grey-500 dark:text-cool-grey-400 hover:text-cool-grey-700 dark:hover:text-cool-grey-300';

		function setTabClasses(tab, active) {
			var add = active ? activeTabClass : inactiveTabClass;
			var remove = active ? inactiveTabClass : activeTabClass;
			remove.split(' ').forEach(function(c) { tab.classList.remove(c); });
			add.split(' ').forEach(function(c) { tab.classList.add(c); });
		}

		window.switchTab = function(which) {
			var writePane = document.getElementById('writePane');
			var previewPane = document.getElementById('previewPane');
			var tabWrite = document.getElementById('tabWrite');
			var tabPreview = document.getElementById('tabPreview');

			if (which === 'write') {
				writePane.classList.remove('hidden');
				previewPane.classList.add('hidden');
				setTabClasses(tabWrite, true);
				setTabClasses(tabPreview, false);
			} else {
				writePane.classList.add('hidden');
				previewPane.classList.remove('hidden');
				setTabClasses(tabWrite, false);
				setTabClasses(tabPreview, true);

				var markdown = document.getElementById('overviewMarkdown').value;
				var preview = document.getElementById('overviewPreview');
				if (!markdown.trim()) {
					preview.innerHTML = '<p class="text-cool-grey-400 italic">Nothing to preview</p>';
					return;
				}
				preview.innerHTML = '<p class="text-cool-grey-400 italic">Loading preview…</p>';
				fetch(basePath + '/orgs/' + orgID + '/apps/' + appID + '/overview/preview', {
					method: 'POST',
					headers: {'Content-Type': 'application/json'},
					body: JSON.stringify({overview_markdown: markdown})
				}).then(function(r) {
					if (!r.ok) throw new Error('Failed');
					return r.text();
				}).then(function(html) {
					preview.innerHTML = html;
					// Render mermaid diagrams in preview
					var codes = preview.querySelectorAll('pre > code.language-mermaid');
					if (codes.length > 0) {
						var divs = [];
						codes.forEach(function(code) {
							var pre = code.parentElement;
							var div = document.createElement('div');
							div.className = 'mermaid';
							div.textContent = code.textContent;
							pre.parentElement.replaceChild(div, pre);
							divs.push(div);
						});
						function runMermaid() {
							mermaid.initialize({ startOnLoad: false, theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default' });
							mermaid.run({ nodes: divs });
						}
						if (typeof mermaid !== 'undefined' && typeof mermaid.run === 'function') {
							runMermaid();
						} else {
							var s = document.createElement('script');
							s.src = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
							s.onload = runMermaid;
							document.head.appendChild(s);
						}
					}
				}).catch(function() {
					preview.innerHTML = '<p class="text-red-600">Failed to load preview.</p>';
				});
			}
		};

		function showStatus(msg, isErr) {
			var el = document.getElementById('appOverviewSaveStatus');
			el.textContent = msg;
			el.className = 'text-sm ' + (isErr ? 'text-red-600' : 'text-cool-grey-500 dark:text-cool-grey-400');
			el.classList.remove('hidden');
		}

		window.saveAppOverview = function() {
			var btn = document.getElementById('appOverviewSaveBtn');
			btn.disabled = true;
			btn.textContent = 'Saving...';

			var markdown = document.getElementById('overviewMarkdown').value;

			fetch(basePath + '/orgs/' + orgID + '/apps/' + appID + '/overview', {
				method: 'PUT',
				headers: {'Content-Type': 'application/json'},
				body: JSON.stringify({overview_markdown: markdown})
			}).then(function(r) {
				btn.disabled = false;
				btn.textContent = 'Save';
				if (!r.ok) {
					showStatus('Failed to save overview.', true);
				} else {
					showStatus('Saved.', false);
				}
			}).catch(function() {
				btn.disabled = false;
				btn.textContent = 'Save';
				showStatus('Failed to save overview.', true);
			});
		};
	})();
}
