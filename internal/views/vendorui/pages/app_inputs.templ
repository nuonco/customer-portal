package pages

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui/components"
)

// AppInfo holds basic app identification info for vendor app pages
type AppInfo struct {
	ID   string
	Name string
}

// AppInputInfo represents an input field for display
type AppInputInfo struct {
	Name           string
	DisplayName    string
	Description    string
	Type           string
	Required       bool
	Sensitive      bool
	Default        string
	Source         string // "vendor" or "customer" from Nuon API
	CustomerFacing bool   // Local config: whether this input is customer-facing
}

// AppInputGroup represents a group of inputs
type AppInputGroup struct {
	Name             string
	DisplayName      string
	Inputs           []AppInputInfo
	CollapsedDefault bool // Whether this group is collapsed by default on customer page
}

// AppInputsPageProps for the app inputs page
type AppInputsPageProps struct {
	vendorui.LayoutProps
	Org         models.NuonOrg
	AppID       string // Nuon app ID for API calls
	App         AppInfo
	InputGroups []AppInputGroup
}

// hasInputs checks if there are any inputs across all groups
func hasInputs(groups []AppInputGroup) bool {
	for _, g := range groups {
		if len(g.Inputs) > 0 {
			return true
		}
	}
	return false
}

// AppInputsPage renders the app inputs configuration page
templ AppInputsPage(props AppInputsPageProps) {
	@vendorui.Layout(props.LayoutProps) {
		<div class="flex h-full overflow-hidden">
			@components.AppSubnav(components.AppSubnavProps{
				OrgID:         props.Org.ID,
				AppID:         props.App.ID,
				ActiveSubPage: "inputs",
				BasePath:      props.BasePath,
			})
			<div class="stratus-page-content overflow-auto">
				<div class="px-4 pt-4 md:px-6 md:pt-6">
					<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-4">
						Configure which inputs are customer-facing. Customer-facing inputs will be shown on the
						install form when customers accept an install link.
					</p>
				</div>
				<!-- Content -->
				<section class="stratus-page-section">
					if hasInputs(props.InputGroups) {
						@inputGroupsWithCheckboxes(props.InputGroups, props.Org.ID, props.AppID, props.BasePath)
					} else {
						@emptyInputsState()
					}
				</section>
			</div>
		</div>
		@appInputsScript(props.Org.ID, props.AppID, props.BasePath)
	}
}

templ inputGroupsWithCheckboxes(groups []AppInputGroup, orgID string, appID string, basePath string) {
	<div id="inputGroupsContainer" class="space-y-6">
		for _, group := range groups {
			if len(group.Inputs) > 0 {
				<div class="stratus-card overflow-hidden !p-0 sortable-group" data-group-name={ group.Name }>
					<table class="w-full" style="table-layout: fixed;">
						<colgroup>
							<col style="width: 24px;"/>
							<col style="width: 170px;"/>
							<col style="width: 170px;"/>
							<col/>
							<col style="width: 100px;"/>
							<col style="width: 50px;"/>
							<col style="width: 70px;"/>
							<col style="width: 140px;"/>
						</colgroup>
						<!-- Group Header -->
						<thead>
							<tr class="bg-cool-grey-100 dark:bg-dark-grey-800 group-drag-handle cursor-grab active:cursor-grabbing">
								<th scope="col" class="px-1 py-2">
									<svg class="h-4 w-4 text-cool-grey-400 dark:text-cool-grey-500 mx-auto" viewBox="0 0 24 24" fill="currentColor">
										<circle cx="9" cy="6" r="1.5"></circle>
										<circle cx="15" cy="6" r="1.5"></circle>
										<circle cx="9" cy="12" r="1.5"></circle>
										<circle cx="15" cy="12" r="1.5"></circle>
										<circle cx="9" cy="18" r="1.5"></circle>
										<circle cx="15" cy="18" r="1.5"></circle>
									</svg>
								</th>
								<th scope="col" colspan="5" class="px-2 py-2 text-left">
									<h3 class="text-sm font-semibold text-cool-grey-900 dark:text-white">
										{ group.DisplayName }
									</h3>
								</th>
								<th scope="col" colspan="2" class="px-2 py-2 text-right">
									<label class="inline-flex items-center gap-2 cursor-pointer" onclick="event.stopPropagation();">
										<span class="text-xs font-normal text-cool-grey-600 dark:text-cool-grey-400">Collapsed by Default</span>
										<div class="relative">
											<input
												type="checkbox"
												class="sr-only peer collapsed-by-default-checkbox"
												data-group-name={ group.Name }
												onchange="updateSaveBtn()"
												if group.CollapsedDefault {
													checked
												}
											/>
											<div class="w-8 h-4 bg-cool-grey-200 dark:bg-dark-grey-700 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-primary-300 dark:peer-focus:ring-primary-800 rounded-full peer peer-checked:after:translate-x-[16px] peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-cool-grey-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all dark:border-dark-grey-600 peer-checked:bg-primary-600"></div>
										</div>
									</label>
								</th>
							</tr>
							<tr class="bg-cool-grey-50 dark:bg-dark-grey-800/50">
								<th scope="col" class="px-1 py-1.5"></th>
								<th scope="col" class="px-2 py-1.5 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
									Display Name
								</th>
								<th scope="col" class="px-2 py-1.5 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
									Name
								</th>
								<th scope="col" class="px-2 py-1.5 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
									Description
								</th>
								<th scope="col" class="px-2 py-1.5 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
									Default
								</th>
								<th scope="col" class="px-2 py-1.5 text-center text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
									Req
								</th>
								<th scope="col" class="px-2 py-1.5 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
									Type
								</th>
								<th scope="col" class="px-2 py-1.5 text-center text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
									User-Facing
								</th>
							</tr>
						</thead>
						<tbody class="bg-white dark:bg-dark-grey-900 divide-y divide-cool-grey-200 dark:divide-dark-grey-700 sortable-inputs">
							for _, input := range group.Inputs {
								<tr class="hover:bg-cool-grey-50 dark:hover:bg-dark-grey-800 transition-colors sortable-input" data-input-name={ input.Name }>
									<td class="px-1 py-1.5 input-drag-handle cursor-grab active:cursor-grabbing">
										<svg class="h-3 w-3 text-cool-grey-400 dark:text-cool-grey-500 mx-auto" viewBox="0 0 24 24" fill="currentColor">
											<circle cx="9" cy="6" r="1.5"></circle>
											<circle cx="15" cy="6" r="1.5"></circle>
											<circle cx="9" cy="12" r="1.5"></circle>
											<circle cx="15" cy="12" r="1.5"></circle>
											<circle cx="9" cy="18" r="1.5"></circle>
											<circle cx="15" cy="18" r="1.5"></circle>
										</svg>
									</td>
									<td class="px-2 py-1.5">
										<span class="text-sm font-medium text-cool-grey-900 dark:text-white truncate block">
											{ input.DisplayName }
										</span>
									</td>
									<td class="px-2 py-1.5">
										<span class="text-xs text-cool-grey-600 dark:text-cool-grey-400 font-mono truncate block">
											{ input.Name }
										</span>
									</td>
									<td class="px-2 py-1.5">
										<span class="text-xs text-cool-grey-500 dark:text-cool-grey-400 truncate block" title={ input.Description }>
											{ input.Description }
										</span>
									</td>
									<td class="px-2 py-1.5">
										if input.Default != "" {
											<code class="text-xs text-cool-grey-600 dark:text-cool-grey-400 truncate block" title={ input.Default }>
												{ truncateDefault(input.Default) }
											</code>
										} else {
											<span class="text-cool-grey-400 dark:text-cool-grey-500 text-xs">-</span>
										}
									</td>
									<td class="px-2 py-1.5 text-center">
										if input.Required {
											<svg class="h-4 w-4 text-green-500 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
												<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
											</svg>
										} else {
											<span class="text-cool-grey-400 dark:text-cool-grey-500 text-xs">-</span>
										}
									</td>
									<td class="px-2 py-1.5">
										<div class="flex items-center gap-1">
											<span class="text-xs text-cool-grey-700 dark:text-cool-grey-300">
												{ input.Type }
											</span>
											if input.Sensitive {
												<span class="text-amber-500" title="sensitive">*</span>
											}
										</div>
									</td>
									<td class="px-2 py-1.5 text-center">
										<label class="relative inline-flex items-center cursor-pointer">
											<input
												type="checkbox"
												class="sr-only peer customer-facing-checkbox"
												data-input-name={ input.Name }
												onchange="updateSaveBtn()"
												if input.CustomerFacing {
													checked
												}
											/>
											<div class="w-8 h-4 bg-cool-grey-200 dark:bg-dark-grey-700 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-primary-300 dark:peer-focus:ring-primary-800 rounded-full peer peer-checked:after:translate-x-[16px] peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-cool-grey-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all dark:border-dark-grey-600 peer-checked:bg-primary-600"></div>
										</label>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
		<!-- Save Button -->
		<div class="flex justify-end">
			<button
				id="saveConfigBtn"
				onclick="saveCustomerInputConfig()"
				disabled
				class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 disabled:opacity-50 disabled:cursor-not-allowed"
			>
				<span id="saveConfigText">Save</span>
				<svg id="saveConfigSpinner" class="hidden animate-spin ml-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
					<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
					<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
				</svg>
			</button>
		</div>
	</div>
	<!-- Hidden element with data attributes for JavaScript -->
	<div id="inputConfigData" class="hidden" data-org-id={ orgID } data-app-id={ appID } data-base-path={ basePath }></div>
}

func truncateDefault(s string) string {
	if len(s) > 30 {
		return s[:27] + "..."
	}
	return s
}

templ emptyInputsState() {
	<div class="stratus-card overflow-hidden !p-0">
		<div class="py-16 text-center">
			<div class="flex justify-center mb-6">
				@emptyInputsIllustration()
			</div>
			<h3 class="text-lg font-semibold text-cool-grey-900 dark:text-white mb-2">
				No inputs configured
			</h3>
			<p class="text-cool-grey-500 dark:text-cool-grey-400 mb-4">
				This app has no inputs configured yet.<br/>
				Add inputs to your app configuration to get started.
			</p>
			<a
				href="https://docs.nuon.co/quickstart/configuration"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:underline font-medium"
			>
				Learn more about inputs
				<svg class="ml-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
				</svg>
			</a>
		</div>
	</div>
}

templ emptyInputsIllustration() {
	<svg width="154" height="94" viewBox="0 0 154 94" fill="none" xmlns="http://www.w3.org/2000/svg" style="opacity: 0.9;">
		<rect x="2" y="1" width="150" height="90" rx="10" fill="#F6F0FF"></rect>
		<rect x="2.5" y="1.5" width="149" height="89" rx="9.5" stroke="#C4B5D9" stroke-opacity="0.5"></rect>
		<line x1="2" y1="22" x2="152" y2="22" stroke="#E5E7EB" stroke-width="0.5"></line>
		<line x1="2" y1="46" x2="152" y2="46" stroke="#A855F7" stroke-opacity="0.6"></line>
		<line x1="2" y1="70" x2="152" y2="70" stroke="#E5E7EB" stroke-width="0.5"></line>
		<rect x="20" y="32" width="40" height="6" rx="2" fill="#EDE9FE"></rect>
		<rect x="20" y="56" width="50" height="6" rx="2" fill="#EDE9FE"></rect>
		<rect x="80" y="32" width="25" height="6" rx="2" fill="#D4D4D8"></rect>
		<rect x="80" y="56" width="30" height="6" rx="2" fill="#D4D4D8"></rect>
		<rect x="120" y="32" width="15" height="6" rx="2" fill="#D4D4D8"></rect>
		<rect x="120" y="56" width="15" height="6" rx="2" fill="#D4D4D8"></rect>
	</svg>
}

templ appInputsScript(orgID string, appID string, basePath string) {
	<style>
		.sortable-ghost {
			opacity: 0.5;
		}
		.sortable-chosen {
			background-color: rgb(243 232 255); /* primary-100 equivalent */
			box-shadow: 0 0 0 2px rgb(168 85 247); /* primary-500 ring */
		}
		.dark .sortable-chosen {
			background-color: rgb(88 28 135 / 0.3); /* primary-900/30 */
		}
	</style>
	<script>
		function getConfigData() {
			var configEl = document.getElementById('inputConfigData');
			return {
				orgID: configEl ? configEl.dataset.orgId : '',
				appID: configEl ? configEl.dataset.appId : '',
				basePath: configEl ? configEl.dataset.basePath : ''
			};
		}

		var initialConfigSnapshot = '';

		function getConfigSnapshot() {
			var customerInputNames = [];
			document.querySelectorAll('.customer-facing-checkbox').forEach(function(cb) {
				if (cb.checked) customerInputNames.push(cb.dataset.inputName);
			});
			var collapsedGroups = [];
			document.querySelectorAll('.collapsed-by-default-checkbox').forEach(function(cb) {
				if (cb.checked) collapsedGroups.push(cb.dataset.groupName);
			});
			return JSON.stringify({
				customerInputNames: customerInputNames,
				groupOrder: getGroupOrder(),
				inputOrder: getInputOrder(),
				collapsedGroups: collapsedGroups
			});
		}

		function updateSaveBtn() {
			document.getElementById('saveConfigBtn').disabled = (getConfigSnapshot() === initialConfigSnapshot);
		}

		// Initialize SortableJS for groups and inputs
		function initSortable() {
			var groupsContainer = document.getElementById('inputGroupsContainer');
			if (groupsContainer && typeof Sortable !== 'undefined') {
				new Sortable(groupsContainer, {
					animation: 150,
					handle: '.group-drag-handle',
					draggable: '.sortable-group',
					ghostClass: 'sortable-ghost',
					chosenClass: 'sortable-chosen',
					onEnd: updateSaveBtn
				});

				// Make inputs within each group sortable
				document.querySelectorAll('.sortable-inputs').forEach(function(tbody) {
					new Sortable(tbody, {
						animation: 150,
						handle: '.input-drag-handle',
						draggable: '.sortable-input',
						ghostClass: 'sortable-ghost',
						chosenClass: 'sortable-chosen',
						onEnd: updateSaveBtn
					});
				});
			}

			// Capture baseline after sortable is set up
			initialConfigSnapshot = getConfigSnapshot();
		}

		// Collect current group order from DOM
		function getGroupOrder() {
			var order = [];
			document.querySelectorAll('.sortable-group').forEach(function(group) {
				order.push(group.dataset.groupName);
			});
			return order;
		}

		// Collect current input order per group from DOM
		function getInputOrder() {
			var order = {};
			document.querySelectorAll('.sortable-group').forEach(function(group) {
				var groupName = group.dataset.groupName;
				var inputs = [];
				group.querySelectorAll('.sortable-input').forEach(function(input) {
					inputs.push(input.dataset.inputName);
				});
				order[groupName] = inputs;
			});
			return order;
		}

		// Collect groups that are collapsed by default
		function getCollapsedGroups() {
			var collapsed = [];
			document.querySelectorAll('.collapsed-by-default-checkbox:checked').forEach(function(checkbox) {
				collapsed.push(checkbox.dataset.groupName);
			});
			return collapsed;
		}

		function saveCustomerInputConfig() {
			var config = getConfigData();
			var btn = document.getElementById('saveConfigBtn');
			var text = document.getElementById('saveConfigText');
			var spinner = document.getElementById('saveConfigSpinner');

			// Disable button and show spinner
			btn.disabled = true;
			text.textContent = 'Saving...';
			spinner.classList.remove('hidden');

			// Collect all checked input names
			var customerInputNames = [];
			document.querySelectorAll('.customer-facing-checkbox:checked').forEach(function(checkbox) {
				customerInputNames.push(checkbox.dataset.inputName);
			});

			// Collect ordering
			var groupOrder = getGroupOrder();
			var inputOrder = getInputOrder();

			// Collect collapsed groups
			var collapsedGroups = getCollapsedGroups();

			// Make API call
			var url = config.basePath + '/orgs/' + config.orgID + '/apps-api/' + config.appID + '/customer-input-config';
			fetch(url, {
				method: 'PUT',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify({
					customer_input_names: customerInputNames,
					group_order: groupOrder,
					input_order: inputOrder,
					collapsed_groups: collapsedGroups
				})
			})
			.then(function(response) {
				if (!response.ok) {
					throw new Error('Failed to save configuration');
				}
				return response.json();
			})
			.then(function(data) {
				showToast('Configuration saved successfully', 'success');
				initialConfigSnapshot = getConfigSnapshot();
				btn.disabled = true;
			})
			.catch(function(error) {
				showToast('Failed to save configuration: ' + error.message, 'error');
				btn.disabled = false;
			})
			.finally(function() {
				text.textContent = 'Save';
				spinner.classList.add('hidden');
			});
		}

		// Run immediately — with hx-boost the DOM is already settled when
		// inline scripts execute, so DOMContentLoaded won't fire again.
		initSortable();
	</script>
}
