package pages

import (
	"fmt"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui/partials"
)

// AppInputInfo represents an input field for display
type AppInputInfo struct {
	Name        string
	DisplayName string
	Description string
	Type        string
	Required    bool
	Sensitive   bool
	Default     string
	Group       string
	Source      string // "vendor" or "customer"
}

// AppInputsPageProps for the app inputs page
type AppInputsPageProps struct {
	vendorui.LayoutProps
	Org           models.NuonOrg
	App           AppInfo
	VendorInputs  []AppInputInfo
	CustomerInputs []AppInputInfo
	ActiveTab     string // "vendor" or "customer"
}

// AppInputsPage renders the app inputs configuration page
templ AppInputsPage(props AppInputsPageProps) {
	@vendorui.Layout(props.LayoutProps) {
		<div class="flex h-full -m-6 overflow-hidden">
			@partials.AppSubnav(partials.AppSubnavProps{
				OrgID:         props.Org.ID,
				AppID:         props.App.ID,
				ActiveSubPage: "inputs",
				BasePath:      props.BasePath,
			})
			<div class="stratus-page-content overflow-auto">
				<div class="px-4 pt-4 md:px-6 md:pt-6">
					<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-4">
						View the input configuration for this app. Vendor inputs are set when creating install links,
						while customer inputs are set by the customer when accepting a link.
					</p>
					<!-- Tabs -->
					<div class="border-b border-cool-grey-200 dark:border-dark-grey-700">
						<nav class="-mb-px flex space-x-8">
							<button
								id="vendorTab"
								onclick="switchTab('vendor')"
								class={ "py-2 px-1 border-b-2 font-medium text-sm transition-colors",
									templ.KV("border-primary-500 text-primary-600 dark:text-primary-400", props.ActiveTab == "vendor" || props.ActiveTab == ""),
									templ.KV("border-transparent text-cool-grey-500 hover:text-cool-grey-700 hover:border-cool-grey-300 dark:text-cool-grey-400 dark:hover:text-cool-grey-300", props.ActiveTab != "vendor" && props.ActiveTab != "") }
							>
								Vendor Inputs
								<span class="ml-2 py-0.5 px-2 rounded-full text-xs bg-cool-grey-100 dark:bg-dark-grey-700 text-cool-grey-600 dark:text-cool-grey-400">
									{ intToStr(len(props.VendorInputs)) }
								</span>
							</button>
							<button
								id="customerTab"
								onclick="switchTab('customer')"
								class={ "py-2 px-1 border-b-2 font-medium text-sm transition-colors",
									templ.KV("border-primary-500 text-primary-600 dark:text-primary-400", props.ActiveTab == "customer"),
									templ.KV("border-transparent text-cool-grey-500 hover:text-cool-grey-700 hover:border-cool-grey-300 dark:text-cool-grey-400 dark:hover:text-cool-grey-300", props.ActiveTab != "customer") }
							>
								Customer Inputs
								<span class="ml-2 py-0.5 px-2 rounded-full text-xs bg-cool-grey-100 dark:bg-dark-grey-700 text-cool-grey-600 dark:text-cool-grey-400">
									{ intToStr(len(props.CustomerInputs)) }
								</span>
							</button>
						</nav>
					</div>
				</div>
				<!-- Tab Content -->
				<section class="stratus-page-section">
					<!-- Vendor Inputs Table -->
					<div id="vendorPanel" class={ templ.KV("hidden", props.ActiveTab == "customer") }>
						if len(props.VendorInputs) > 0 {
							@inputsTable(props.VendorInputs, "vendor")
						} else {
							@emptyInputsState("vendor")
						}
					</div>
					<!-- Customer Inputs Table -->
					<div id="customerPanel" class={ templ.KV("hidden", props.ActiveTab != "customer") }>
						if len(props.CustomerInputs) > 0 {
							@inputsTable(props.CustomerInputs, "customer")
						} else {
							@emptyInputsState("customer")
						}
					</div>
				</section>
			</div>
		</div>
		@appInputsScript()
	}
}

func intToStr(n int) string {
	return fmt.Sprintf("%d", n)
}

templ inputsTable(inputs []AppInputInfo, inputType string) {
	<div class="stratus-card overflow-hidden !p-0">
		<table class="min-w-full divide-y divide-cool-grey-200 dark:divide-dark-grey-700">
			<thead class="bg-cool-grey-50 dark:bg-dark-grey-800">
				<tr>
					<th scope="col" class="px-4 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
						Name
					</th>
					<th scope="col" class="px-4 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
						Type
					</th>
					<th scope="col" class="px-4 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
						Required
					</th>
					<th scope="col" class="px-4 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
						Default
					</th>
					<th scope="col" class="px-4 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
						Group
					</th>
				</tr>
			</thead>
			<tbody class="bg-white dark:bg-dark-grey-900 divide-y divide-cool-grey-200 dark:divide-dark-grey-700">
				for _, input := range inputs {
					<tr class="hover:bg-cool-grey-50 dark:hover:bg-dark-grey-800 transition-colors">
						<td class="px-4 py-3">
							<div class="flex flex-col">
								<span class="text-sm font-medium text-cool-grey-900 dark:text-white">
									{ input.DisplayName }
								</span>
								<span class="text-xs text-cool-grey-500 dark:text-cool-grey-400 font-mono">
									{ input.Name }
								</span>
								if input.Description != "" {
									<span class="text-xs text-cool-grey-500 dark:text-cool-grey-400 mt-1">
										{ input.Description }
									</span>
								}
							</div>
						</td>
						<td class="px-4 py-3">
							<div class="flex items-center gap-2">
								<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-cool-grey-100 dark:bg-dark-grey-700 text-cool-grey-700 dark:text-cool-grey-300">
									{ input.Type }
								</span>
								if input.Sensitive {
									<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400">
										sensitive
									</span>
								}
							</div>
						</td>
						<td class="px-4 py-3">
							if input.Required {
								<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400">
									required
								</span>
							} else {
								<span class="text-cool-grey-400 dark:text-cool-grey-500 text-sm">-</span>
							}
						</td>
						<td class="px-4 py-3">
							if input.Default != "" {
								<code class="text-xs bg-cool-grey-100 dark:bg-dark-grey-700 px-2 py-0.5 rounded text-cool-grey-700 dark:text-cool-grey-300">
									{ truncateDefault(input.Default) }
								</code>
							} else {
								<span class="text-cool-grey-400 dark:text-cool-grey-500 text-sm">-</span>
							}
						</td>
						<td class="px-4 py-3">
							if input.Group != "" {
								<span class="text-sm text-cool-grey-600 dark:text-cool-grey-400">
									{ input.Group }
								</span>
							} else {
								<span class="text-cool-grey-400 dark:text-cool-grey-500 text-sm">-</span>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

func truncateDefault(s string) string {
	if len(s) > 30 {
		return s[:27] + "..."
	}
	return s
}

templ emptyInputsState(inputType string) {
	<div class="stratus-card overflow-hidden !p-0">
		<table class="min-w-full">
			<thead class="bg-cool-grey-50 dark:bg-dark-grey-800 border-b border-cool-grey-200 dark:border-dark-grey-700">
				<tr>
					<th class="px-4 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
						Name
					</th>
					<th class="px-4 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
						Type
					</th>
					<th class="px-4 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
						Required
					</th>
					<th class="px-4 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
						Default
					</th>
					<th class="px-4 py-3 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
						Group
					</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					<td colspan="5" class="py-16 text-center">
						<div class="flex justify-center mb-6">
							@emptyInputsIllustration()
						</div>
						<h3 class="text-lg font-semibold text-cool-grey-900 dark:text-white mb-2">
							if inputType == "vendor" {
								No vendor inputs configured
							} else {
								No customer inputs configured
							}
						</h3>
						<p class="text-cool-grey-500 dark:text-cool-grey-400 mb-4">
							if inputType == "vendor" {
								Vendor inputs are set when creating install links.<br/>
								Add inputs with <code class="text-xs bg-cool-grey-100 dark:bg-dark-grey-700 px-1 rounded">source = "vendor"</code> to your app config.
							} else {
								Customer inputs are set by the customer when accepting a link.<br/>
								Add inputs with <code class="text-xs bg-cool-grey-100 dark:bg-dark-grey-700 px-1 rounded">source = "customer"</code> to your app config.
							}
						</p>
						<a
							href="https://docs.nuon.co/quickstart/configuration"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:underline font-medium"
						>
							Learn more about inputs
							<svg class="ml-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
							</svg>
						</a>
					</td>
				</tr>
			</tbody>
		</table>
	</div>
}

templ emptyInputsIllustration() {
	<svg width="154" height="94" viewBox="0 0 154 94" fill="none" xmlns="http://www.w3.org/2000/svg" style="opacity: 0.9;">
		<rect x="2" y="1" width="150" height="90" rx="10" fill="#F6F0FF"></rect>
		<rect x="2.5" y="1.5" width="149" height="89" rx="9.5" stroke="#C4B5D9" stroke-opacity="0.5"></rect>
		<line x1="2" y1="22" x2="152" y2="22" stroke="#E5E7EB" stroke-width="0.5"></line>
		<line x1="2" y1="46" x2="152" y2="46" stroke="#A855F7" stroke-opacity="0.6"></line>
		<line x1="2" y1="70" x2="152" y2="70" stroke="#E5E7EB" stroke-width="0.5"></line>
		<rect x="20" y="32" width="40" height="6" rx="2" fill="#EDE9FE"></rect>
		<rect x="20" y="56" width="50" height="6" rx="2" fill="#EDE9FE"></rect>
		<rect x="80" y="32" width="25" height="6" rx="2" fill="#D4D4D8"></rect>
		<rect x="80" y="56" width="30" height="6" rx="2" fill="#D4D4D8"></rect>
		<rect x="120" y="32" width="15" height="6" rx="2" fill="#D4D4D8"></rect>
		<rect x="120" y="56" width="15" height="6" rx="2" fill="#D4D4D8"></rect>
	</svg>
}

templ appInputsScript() {
	<script>
		function switchTab(tab) {
			var vendorTab = document.getElementById('vendorTab');
			var customerTab = document.getElementById('customerTab');
			var vendorPanel = document.getElementById('vendorPanel');
			var customerPanel = document.getElementById('customerPanel');

			// Active tab styles
			var activeClasses = 'border-primary-500 text-primary-600 dark:text-primary-400';
			var inactiveClasses = 'border-transparent text-cool-grey-500 hover:text-cool-grey-700 hover:border-cool-grey-300 dark:text-cool-grey-400 dark:hover:text-cool-grey-300';

			if (tab === 'vendor') {
				vendorTab.className = 'py-2 px-1 border-b-2 font-medium text-sm transition-colors ' + activeClasses;
				customerTab.className = 'py-2 px-1 border-b-2 font-medium text-sm transition-colors ' + inactiveClasses;
				vendorPanel.classList.remove('hidden');
				customerPanel.classList.add('hidden');
			} else {
				vendorTab.className = 'py-2 px-1 border-b-2 font-medium text-sm transition-colors ' + inactiveClasses;
				customerTab.className = 'py-2 px-1 border-b-2 font-medium text-sm transition-colors ' + activeClasses;
				vendorPanel.classList.add('hidden');
				customerPanel.classList.remove('hidden');
			}
		}
	</script>
}
