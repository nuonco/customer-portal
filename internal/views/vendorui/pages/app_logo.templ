package pages

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui/components"
)

// AppLogoPageProps for the app logo upload page
type AppLogoPageProps struct {
	vendorui.LayoutProps
	Org             models.NuonOrg
	App             AppInfo
	LogoLightBase64 string
	LogoDarkBase64  string
}

// AppLogoPage renders the app logo configuration page
templ AppLogoPage(props AppLogoPageProps) {
	@vendorui.Layout(props.LayoutProps) {
		<div class="flex h-full overflow-hidden">
			@components.AppSubnav(components.AppSubnavProps{
				OrgID:         props.Org.ID,
				AppID:         props.App.ID,
				ActiveSubPage: "logo",
				BasePath:      props.BasePath,
			})
			<div
				class="stratus-page-content overflow-auto"
				data-logo-light-base64={ props.LogoLightBase64 }
				data-logo-dark-base64={ props.LogoDarkBase64 }
				id="appLogoConfig"
			>
				<div class="px-4 pt-4 md:px-6 md:pt-6">
					<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-6">
						Upload logos for your app. The light mode logo is shown on light backgrounds; the dark mode logo is shown on dark backgrounds.
						If no dark logo is configured, the light logo is used in both modes.
					</p>
				</div>
				<section class="stratus-page-section">
					<div class="stratus-card space-y-8">
						<!-- Light mode logo -->
						<div>
							<h3 class="text-sm font-medium text-cool-grey-900 dark:text-white mb-3">Light mode logo</h3>
							<p class="text-xs text-cool-grey-500 dark:text-cool-grey-400 mb-3">Best for light backgrounds. PNG, JPG, SVG, GIF. Max 500KB.</p>
							<div class="flex items-start gap-4">
								<div class="w-32 h-32 rounded-lg border-2 border-dashed border-cool-grey-300 dark:border-dark-grey-600 bg-white dark:bg-dark-grey-800 flex items-center justify-center overflow-hidden flex-shrink-0">
									if props.LogoLightBase64 != "" {
										<img id="appLogoLightPreview" src={ props.LogoLightBase64 } alt="Light logo preview" class="max-w-full max-h-full object-contain"/>
									} else {
										<img id="appLogoLightPreview" src="" alt="Light logo preview" class="max-w-full max-h-full object-contain hidden"/>
									}
									<div id="appLogoLightPlaceholder" class={ "text-cool-grey-400 text-xs text-center px-2", templ.KV("hidden", props.LogoLightBase64 != "") }>
										No logo
									</div>
								</div>
								<div class="flex flex-col gap-2">
									<label class="cursor-pointer inline-flex items-center px-3 py-1.5 border border-cool-grey-300 dark:border-dark-grey-600 rounded-md text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 bg-white dark:bg-dark-grey-800 hover:bg-cool-grey-50 dark:hover:bg-dark-grey-700">
										Upload
										<input
											type="file"
											id="appLogoLightUpload"
											accept="image/png,image/jpeg,image/svg+xml,image/gif"
											onchange="window.handleLogoUpload(this, 'light')"
											class="hidden"
										/>
									</label>
									<button
										type="button"
										id="appRemoveLogoLight"
										onclick="appRemoveLogoLight()"
										disabled?={ props.LogoLightBase64 == "" }
										class="cursor-pointer inline-flex items-center px-3 py-1.5 border border-cool-grey-300 dark:border-dark-grey-600 rounded-md text-sm font-medium text-red-600 dark:text-red-400 bg-white dark:bg-dark-grey-800 hover:bg-red-50 dark:hover:bg-red-900/20 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-white dark:disabled:hover:bg-dark-grey-800"
									>Remove</button>
								</div>
							</div>
						</div>
						<!-- Dark mode logo -->
						<div>
							<h3 class="text-sm font-medium text-cool-grey-900 dark:text-white mb-3">Dark mode logo</h3>
							<p class="text-xs text-cool-grey-500 dark:text-cool-grey-400 mb-3">Best for dark backgrounds. PNG, JPG, SVG, GIF. Max 500KB.</p>
							<div class="flex items-start gap-4">
								<div class="w-32 h-32 rounded-lg border-2 border-dashed border-cool-grey-300 dark:border-dark-grey-600 bg-dark-grey-900 flex items-center justify-center overflow-hidden flex-shrink-0">
									if props.LogoDarkBase64 != "" {
										<img id="appLogoDarkPreview" src={ props.LogoDarkBase64 } alt="Dark logo preview" class="max-w-full max-h-full object-contain"/>
									} else {
										<img id="appLogoDarkPreview" src="" alt="Dark logo preview" class="max-w-full max-h-full object-contain hidden"/>
									}
									<div id="appLogoDarkPlaceholder" class={ "text-cool-grey-500 text-xs text-center px-2", templ.KV("hidden", props.LogoDarkBase64 != "") }>
										No logo
									</div>
								</div>
								<div class="flex flex-col gap-2">
									<label class="cursor-pointer inline-flex items-center px-3 py-1.5 border border-cool-grey-300 dark:border-dark-grey-600 rounded-md text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 bg-white dark:bg-dark-grey-800 hover:bg-cool-grey-50 dark:hover:bg-dark-grey-700">
										Upload
										<input
											type="file"
											id="appLogoDarkUpload"
											accept="image/png,image/jpeg,image/svg+xml,image/gif"
											onchange="window.handleLogoUpload(this, 'dark')"
											class="hidden"
										/>
									</label>
									<button
										type="button"
										id="appRemoveLogoDark"
										onclick="appRemoveLogoDark()"
										disabled?={ props.LogoDarkBase64 == "" }
										class="cursor-pointer inline-flex items-center px-3 py-1.5 border border-cool-grey-300 dark:border-dark-grey-600 rounded-md text-sm font-medium text-red-600 dark:text-red-400 bg-white dark:bg-dark-grey-800 hover:bg-red-50 dark:hover:bg-red-900/20 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-white dark:disabled:hover:bg-dark-grey-800"
									>Remove</button>
								</div>
							</div>
						</div>
						<!-- Save button -->
						<div class="flex items-center gap-3 pt-2 border-t border-cool-grey-200 dark:border-dark-grey-700">
							<button
								type="button"
								id="appLogoSaveBtn"
								onclick="saveAppLogo()"
								disabled
								class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 disabled:opacity-50 disabled:cursor-not-allowed"
							>
								Save
							</button>
							<span id="appLogoSaveStatus" class="text-sm text-cool-grey-500 dark:text-cool-grey-400 hidden"></span>
						</div>
					</div>
				</section>
			</div>
		</div>
		@appLogoScript(props.Org.ID, props.App.ID, props.BasePath)
	}
}

templ appLogoScript(orgID, appID, basePath string) {
	<div id="appLogoScriptData" class="hidden" data-org-id={ orgID } data-app-id={ appID } data-base-path={ basePath }></div>
	<script>
		// Inline script so it re-executes on hx-boost navigations.
		// State is stored on the DOM (data-dirty-light, data-dirty-dark) so it
		// survives dev-reload morphs that re-execute this script.
		(function() {
			var _sd = document.getElementById('appLogoScriptData');
			var _d = _sd.dataset;
			var _orgID = _d.orgId;
			var _appID = _d.appId;
			var _basePath = _d.basePath;

			// Dirty state accessors — stored on the DOM element so morphs don't lose them.
			function getDirtyLight() { return _sd.getAttribute('data-dirty-light'); }
			function getDirtyDark() { return _sd.getAttribute('data-dirty-dark'); }
			function setDirtyLight(v) { if (v === null) _sd.removeAttribute('data-dirty-light'); else _sd.setAttribute('data-dirty-light', v); }
			function setDirtyDark(v) { if (v === null) _sd.removeAttribute('data-dirty-dark'); else _sd.setAttribute('data-dirty-dark', v); }

			function updateSaveBtn() {
				document.getElementById('appLogoSaveBtn').disabled = (getDirtyLight() === null && getDirtyDark() === null);
			}

			// Restore button state on re-execution (after morph)
			updateSaveBtn();

			function showStatus(msg, isErr) {
				var el = document.getElementById('appLogoSaveStatus');
				el.textContent = msg;
				el.className = 'text-sm ' + (isErr ? 'text-red-600' : 'text-cool-grey-500 dark:text-cool-grey-400');
				el.classList.remove('hidden');
			}

			window.handleLogoUpload = function(input, mode) {
				var file = input.files[0];
				if (!file) return;
				if (file.size > 500 * 1024) { showToast('Logo must be under 500KB', 'warning'); return; }
				var reader = new FileReader();
				reader.onload = function() {
					var suffix = mode === 'light' ? 'Light' : 'Dark';
					if (mode === 'light') setDirtyLight(reader.result); else setDirtyDark(reader.result);
					var preview = document.getElementById('appLogo' + suffix + 'Preview');
					preview.src = reader.result;
					preview.classList.remove('hidden');
					document.getElementById('appLogo' + suffix + 'Placeholder').classList.add('hidden');
					document.getElementById('appRemoveLogo' + suffix).disabled = false;
					updateSaveBtn();
				};
				reader.readAsDataURL(file);
			};

			window.appRemoveLogoLight = function() {
				setDirtyLight('REMOVE');
				var preview = document.getElementById('appLogoLightPreview');
				preview.src = '';
				preview.classList.add('hidden');
				document.getElementById('appLogoLightPlaceholder').classList.remove('hidden');
				document.getElementById('appRemoveLogoLight').disabled = true;
				updateSaveBtn();
			};

			window.appRemoveLogoDark = function() {
				setDirtyDark('REMOVE');
				var preview = document.getElementById('appLogoDarkPreview');
				preview.src = '';
				preview.classList.add('hidden');
				document.getElementById('appLogoDarkPlaceholder').classList.remove('hidden');
				document.getElementById('appRemoveLogoDark').disabled = true;
				updateSaveBtn();
			};

			window.saveAppLogo = function() {
				var btn = document.getElementById('appLogoSaveBtn');
				btn.disabled = true;
				btn.textContent = 'Saving...';

				var config = document.getElementById('appLogoConfig');
				var body = {};
				var original = {
					light: config.dataset.logoLightBase64 || '',
					dark: config.dataset.logoDarkBase64 || ''
				};

				var dirtyLight = getDirtyLight();
				var dirtyDark = getDirtyDark();

				body.logo_light_base64 = dirtyLight !== null ? dirtyLight : original.light;
				body.logo_dark_base64 = dirtyDark !== null ? dirtyDark : original.dark;

				fetch(_basePath + '/orgs/' + _orgID + '/apps/' + _appID + '/logo', {
					method: 'PUT',
					headers: {'Content-Type': 'application/json'},
					body: JSON.stringify(body)
				}).then(function(r) {
					btn.disabled = false;
					btn.textContent = 'Save';
					if (!r.ok) {
						showStatus('Failed to save logos.', true);
					} else {
						if (dirtyLight !== null) {
							config.dataset.logoLightBase64 = dirtyLight === 'REMOVE' ? '' : dirtyLight;
							setDirtyLight(null);
						}
						if (dirtyDark !== null) {
							config.dataset.logoDarkBase64 = dirtyDark === 'REMOVE' ? '' : dirtyDark;
							setDirtyDark(null);
						}
						updateSaveBtn();
					}
				}).catch(function() {
					btn.disabled = false;
					btn.textContent = 'Save';
					showStatus('Failed to save logos.', true);
				});
			};
		})();
	</script>
}
