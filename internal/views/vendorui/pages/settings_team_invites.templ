package pages

import (
	"fmt"
	"time"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui/components"
)

// TeamInvitesPageProps for the team invites page
type TeamInvitesPageProps struct {
	vendorui.LayoutProps
	Org         *models.NuonOrg
	Invitations []models.OrgInvitation
}

// TeamInvitesPage renders the team invites page with sub-nav
templ TeamInvitesPage(props TeamInvitesPageProps) {
	@vendorui.Layout(props.LayoutProps) {
		<div class="flex flex-1 overflow-hidden">
			@components.TeamSubnav(components.TeamSubnavProps{
				OrgID:         props.CurrentOrg.ID,
				ActiveSubPage: "invites",
				BasePath:      props.BasePath,
			})
			<div class="stratus-page-content overflow-auto">
				<div class="stratus-page-header">
					<div class="stratus-heading-group">
						<h1 class="stratus-page-title">Invitation Links</h1>
						<p class="stratus-page-subtitle">Create and manage invitation links for your team.</p>
					</div>
				</div>
				<div class="stratus-page-section">
					@invitationsList(props.Invitations)
				</div>
			</div>
		</div>
		<!-- Config data for JavaScript -->
		<div
			id="team-invites-config"
			class="hidden"
			data-base-path={ props.BasePath }
			data-org-id={ props.Org.ID }
		></div>
		@teamInvitesScript()
	}
}

templ invitationsList(invitations []models.OrgInvitation) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white flex items-center gap-2">
			@teamInvitesLinkIcon()
			Invitation Links
			<span class="text-cool-grey-500 dark:text-cool-grey-400 font-normal text-sm">({ fmt.Sprintf("%d", len(invitations)) })</span>
		</h3>
		<div class="space-y-2 mb-4">
			for _, invite := range invitations {
				<div class="p-3 bg-cool-grey-50 dark:bg-dark-grey-800 rounded-lg">
					<div class="flex items-center justify-between mb-2">
						<div class="flex items-center gap-2">
							<span class="text-sm font-medium text-cool-grey-900 dark:text-white">{ invite.Email }</span>
						</div>
						<div class="flex items-center gap-1">
							<button
								type="button"
								onclick="copyInviteLink(this)"
								data-token={ invite.Token }
								class="p-1.5 text-cool-grey-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
								title="Copy invitation link"
							>
								@teamInvitesCopyIcon()
							</button>
							<button
								type="button"
								onclick="deleteInvitation(this)"
								data-invite-id={ invite.ID }
								class="p-1.5 text-cool-grey-400 hover:text-red-600 dark:hover:text-red-400 transition-colors"
								title="Delete invitation"
							>
								@teamInvitesTrashIcon()
							</button>
						</div>
					</div>
					<div class="flex items-center gap-3 text-xs text-cool-grey-500 dark:text-cool-grey-400">
						if invite.ExpiresAt != nil {
							<span>Expires: { formatInviteExpiration(*invite.ExpiresAt) }</span>
						} else {
							<span>No expiration</span>
						}
						<span>|</span>
						if invite.UsedCount > 0 {
							<span>Used</span>
						} else {
							<span>Available</span>
						}
					</div>
				</div>
			}
			if len(invitations) == 0 {
				<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400 text-center py-4">
					No active invitation links.
				</p>
			}
		</div>
		<!-- Generate Invitation Form -->
		<div class="border-t border-cool-grey-200 dark:border-dark-grey-600 pt-4">
			<h4 class="text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-3">Generate New Invitation</h4>
			<form id="generateInviteForm" class="space-y-3">
				<div>
					<label for="inviteEmail" class="block text-xs font-medium text-cool-grey-600 dark:text-cool-grey-400 mb-1">
						Email
					</label>
					<input
						type="email"
						id="inviteEmail"
						name="email"
						required
						placeholder="Enter email address"
						class="w-full px-3 py-2 text-sm border border-cool-grey-300 dark:border-dark-grey-500 rounded-md bg-white dark:bg-dark-grey-800 text-cool-grey-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 placeholder-cool-grey-400 dark:placeholder-cool-grey-500"
					/>
				</div>
				<div>
					<label for="inviteExpires" class="block text-xs font-medium text-cool-grey-600 dark:text-cool-grey-400 mb-1">
						Expires In
					</label>
					<select
						id="inviteExpires"
						name="expires"
						class="w-full px-3 py-2 text-sm border border-cool-grey-300 dark:border-dark-grey-500 rounded-md bg-white dark:bg-dark-grey-800 text-cool-grey-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
					>
						<option value="1">1 day</option>
						<option value="7" selected>7 days</option>
						<option value="30">30 days</option>
					</select>
				</div>
				<div class="flex justify-end pt-2">
					<button
						type="submit"
						id="generateInviteBtn"
						class="px-4 py-2 text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-md transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
					>
						<span id="generateInviteBtnText">Generate Link</span>
					</button>
				</div>
			</form>
		</div>
		<!-- Status Messages -->
		<div id="teamSuccessMessage" class="hidden mt-4 p-4 bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-800 text-green-700 dark:text-green-400 rounded-lg"></div>
		<div id="teamErrorMessage" class="hidden mt-4 p-4 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-400 rounded-lg"></div>
	</div>
}

func formatInviteExpiration(t time.Time) string {
	now := time.Now()
	if t.Before(now) {
		return "Expired"
	}
	diff := t.Sub(now)
	if diff < 24*time.Hour {
		return fmt.Sprintf("%.0f hours", diff.Hours())
	}
	days := int(diff.Hours() / 24)
	if days == 1 {
		return "1 day"
	}
	return fmt.Sprintf("%d days", days)
}

templ teamInvitesScript() {
	<script>
		(function() {
			var config = document.getElementById('team-invites-config');
			var basePath = config.dataset.basePath;
			var orgId = config.dataset.orgId;

			async function copyInviteLink(btn) {
				var token = btn.dataset.token;
				var url = window.location.origin + '/admin/invite?token=' + token;
				try {
					await navigator.clipboard.writeText(url);
					showToast('Invitation link copied to clipboard', 'success');
				} catch (err) {
					var input = document.createElement('input');
					input.value = url;
					document.body.appendChild(input);
					input.select();
					document.execCommand('copy');
					document.body.removeChild(input);
					showToast('Invitation link copied to clipboard', 'success');
				}
			}

			async function deleteInvitation(btn) {
				var inviteId = btn.dataset.inviteId;
				if (!confirm('Delete this invitation link? Anyone with this link will no longer be able to join.')) {
					return;
				}

				try {
					var response = await fetch(basePath + '/orgs/' + orgId + '/invitations/' + inviteId, {
						method: 'DELETE',
						headers: {
							'Content-Type': 'application/json'
						}
					});

					if (response.ok) {
						showToast('Invitation deleted', 'success');
						location.reload();
					} else {
						var data = await response.json();
						showToast(data.error || 'Failed to delete invitation', 'error');
					}
				} catch (error) {
					showToast('Network error. Please try again.', 'error');
				}
			}

			window.copyInviteLink = copyInviteLink;
			window.deleteInvitation = deleteInvitation;

			// Generate invitation form submission
			document.getElementById('generateInviteForm').addEventListener('submit', async function(e) {
				e.preventDefault();

				var btn = document.getElementById('generateInviteBtn');
				var btnText = document.getElementById('generateInviteBtnText');

				btn.disabled = true;
				btnText.textContent = 'Generating...';

				var email = document.getElementById('inviteEmail').value;
				var expiresDays = document.getElementById('inviteExpires').value;

				var expiresAt = null;
				if (expiresDays) {
					var date = new Date();
					date.setDate(date.getDate() + parseInt(expiresDays));
					expiresAt = date.toISOString();
				}

				try {
					var response = await fetch(basePath + '/orgs/' + orgId + '/invitations', {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json'
						},
						body: JSON.stringify({
							email: email,
							expires_at: expiresAt
						})
					});

					var data = await response.json();

					if (response.ok) {
						showToast('Invitation link created', 'success');
						var url = window.location.origin + '/admin/invite?token=' + data.token;
						try {
							await navigator.clipboard.writeText(url);
							showToast('Link copied to clipboard', 'success');
						} catch (err) {
							// Ignore clipboard errors
						}
						document.getElementById('generateInviteForm').reset();
						location.reload();
					} else {
						showToast(data.error || 'Failed to create invitation', 'error');
					}
				} catch (error) {
					showToast('Network error. Please try again.', 'error');
				} finally {
					btn.disabled = false;
					btnText.textContent = 'Generate Link';
				}
			});
		})();
	</script>
}

// Icons for team invites page
templ teamInvitesLinkIcon() {
	<svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor">
		<path d="M137.54,186.36a8,8,0,0,1,0,11.31l-9.94,10A56,56,0,0,1,48.38,128.4L72.5,104.28A56,56,0,0,1,149.31,102a8,8,0,1,1-10.64,12,40,40,0,0,0-54.85,1.63L59.7,139.72a40,40,0,0,0,56.58,56.58l9.94-9.94A8,8,0,0,1,137.54,186.36Zm70.08-138a56.08,56.08,0,0,0-79.22,0l-9.94,9.95a8,8,0,0,0,11.32,11.31l9.94-9.94a40,40,0,0,1,56.58,56.58L172.18,140a40,40,0,0,1-54.85,1.63,8,8,0,1,0-10.64,12,56,56,0,0,0,76.81-2.13l24.12-24.12A56.08,56.08,0,0,0,207.62,48.38Z"></path>
	</svg>
}

