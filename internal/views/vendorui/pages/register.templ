package pages

// RegisterPageProps for the vendor registration page
type RegisterPageProps struct {
	Title      string
	ButtonText string
	BasePath   string
	Error      string // Error message to display

	// Theme
	PrimaryColor       string
	PrimaryColorDark   string
	SecondaryColor     string
	SecondaryColorDark string
	HeadingFont        string
	BodyFont           string
	HeadingFontBase64  string
	BodyFontBase64     string
	LogoBase64         string
}

// RegisterPage renders the vendor registration page
templ RegisterPage(props RegisterPageProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.Title }</title>
			<link href="/static/css/vendor.css" rel="stylesheet"/>
			@registerDarkModeScript()
			@registerFontLinks(props)
			<script src="https://unpkg.com/htmx.org@1.9.10"></script>
			@registerThemeOverrides(props)
		</head>
		<body class="bg-cool-grey-50 dark:bg-dark-grey-950 dark:text-white">
			<nav class="bg-theme-primary text-white p-4">
				<div class="container mx-auto flex justify-between items-center">
					<div class="flex items-center space-x-3">
						if props.LogoBase64 != "" {
							<img src={ props.LogoBase64 } alt="Logo" class="h-8 w-auto max-w-xs object-contain"/>
						}
						<h1 class="text-xl font-heading font-strong">{ props.Title }</h1>
					</div>
				</div>
			</nav>
			<main class="container mx-auto p-4">
				<div class="max-w-md mx-auto bg-white dark:bg-dark-grey-900 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500 p-6 mt-10">
					<h2 class="text-2xl font-bold mb-6 text-center text-cool-grey-900 dark:text-white">{ props.Title }</h2>
					if props.Error != "" {
						<div class="mb-4 p-3 bg-red-100 dark:bg-red-900/30 border border-red-300 dark:border-red-700 rounded-md text-red-700 dark:text-red-300 text-sm">
							{ props.Error }
						</div>
					}
					<form action={ templ.SafeURL(props.BasePath + "/register") } method="POST" class="space-y-4">
						<div>
							<label for="name" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">
								Name
							</label>
							<input
								type="text"
								id="name"
								name="name"
								class="w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-600 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 dark:bg-dark-grey-800 dark:text-white"
								placeholder="Your name"
							/>
						</div>
						<div>
							<label for="email" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">
								Email
							</label>
							<input
								type="email"
								id="email"
								name="email"
								required
								class="w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-600 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 dark:bg-dark-grey-800 dark:text-white"
								placeholder="you@example.com"
							/>
						</div>
						<div>
							<label for="password" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">
								Password
							</label>
							<input
								type="password"
								id="password"
								name="password"
								required
								minlength="8"
								class="w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-600 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 dark:bg-dark-grey-800 dark:text-white"
								placeholder="••••••••"
							/>
							<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">
								Must be at least 8 characters
							</p>
						</div>
						<div>
							<label for="confirm_password" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">
								Confirm Password
							</label>
							<input
								type="password"
								id="confirm_password"
								name="confirm_password"
								required
								minlength="8"
								class="w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-600 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 dark:bg-dark-grey-800 dark:text-white"
								placeholder="••••••••"
							/>
						</div>
						<button
							type="submit"
							class="w-full bg-primary-600 text-white py-2 px-4 rounded-md hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 font-medium"
						>
							{ props.ButtonText }
						</button>
					</form>
					<p class="mt-4 text-sm text-cool-grey-600 dark:text-cool-grey-400 text-center">
						Already have an account?
						<a href={ templ.SafeURL(props.BasePath + "/login/") } class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 font-medium">
							Login
						</a>
					</p>
				</div>
			</main>
			<!-- Preview Button -->
			<div class="fixed bottom-4 right-4 z-50">
				<button
					onclick="openPreviewModal()"
					class="bg-amber-500 text-white text-sm font-medium px-4 py-2 rounded-md shadow-lg hover:bg-amber-600 focus:ring-2 focus:ring-amber-400 transition"
				>
					Preview
				</button>
			</div>
			<!-- Preview Modal -->
			<div id="preview-modal" class="fixed inset-0 bg-dark-grey-600/50 hidden overflow-y-auto" style="z-index: 100;">
				<div class="flex items-center justify-center min-h-full p-4">
					<div class="bg-white dark:bg-dark-grey-900 rounded-lg shadow-xl w-full max-w-md border border-cool-grey-300 dark:border-dark-grey-500 my-8">
						<div class="px-6 py-4 border-b border-cool-grey-200 dark:border-dark-grey-600 flex justify-between items-center">
							<h3 class="text-lg font-semibold text-cool-grey-900 dark:text-white">Preview Release</h3>
							<button type="button" onclick="closePreviewModal()" class="text-cool-grey-400 hover:text-cool-grey-600 dark:hover:text-cool-grey-300">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
								</svg>
							</button>
						</div>
						<div class="px-6 py-4">
							<p class="text-cool-grey-600 dark:text-cool-grey-400">
								This application is currently in preview and under active development. Features may change and some functionality may be incomplete.
							</p>
						</div>
						<div class="px-6 py-4 bg-cool-grey-50 dark:bg-dark-grey-800 rounded-b-lg flex justify-end">
							<button type="button" onclick="closePreviewModal()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-md hover:bg-primary-700 focus:ring-2 focus:ring-primary-500">
								Got it
							</button>
						</div>
					</div>
				</div>
			</div>
			<script>
				function openPreviewModal() {
					document.getElementById('preview-modal').classList.remove('hidden');
				}
				function closePreviewModal() {
					document.getElementById('preview-modal').classList.add('hidden');
				}
			</script>
		</body>
	</html>
}

templ registerDarkModeScript() {
	<script>
		(function() {
			if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
				document.documentElement.classList.add('dark');
			}
			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
				document.documentElement.classList.toggle('dark', e.matches);
			});
		})();
	</script>
}

templ registerFontLinks(props RegisterPageProps) {
	<link rel="preconnect" href="https://fonts.googleapis.com"/>
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
	if props.HeadingFontBase64 != "" {
		<style>
			@font-face {
				font-family: 'CustomHeading';
				src: url({ props.HeadingFontBase64 }) format('woff2');
				font-display: swap;
			}
		</style>
	}
	if props.BodyFontBase64 != "" {
		<style>
			@font-face {
				font-family: 'CustomBody';
				src: url({ props.BodyFontBase64 }) format('woff2');
				font-display: swap;
			}
		</style>
	}
}

templ registerThemeOverrides(props RegisterPageProps) {
	if props.PrimaryColor != "" || props.SecondaryColor != "" || props.HeadingFont != "" || props.BodyFont != "" {
		@templ.Raw(buildRegisterThemeCSS(props))
	}
}

func buildRegisterThemeCSS(props RegisterPageProps) string {
	css := "<style>:root {"
	if props.PrimaryColor != "" {
		css += "--theme-primary: " + props.PrimaryColor + ";"
		css += "--theme-primary-hover: " + props.PrimaryColorDark + ";"
	}
	if props.SecondaryColor != "" {
		css += "--theme-secondary: " + props.SecondaryColor + ";"
		css += "--theme-secondary-hover: " + props.SecondaryColorDark + ";"
	}
	if props.HeadingFontBase64 != "" {
		css += "--font-heading: 'CustomHeading', 'Inter', ui-sans-serif, system-ui, sans-serif;"
	} else if props.HeadingFont != "" {
		css += "--font-heading: '" + props.HeadingFont + "', 'Inter', ui-sans-serif, system-ui, sans-serif;"
	}
	if props.BodyFontBase64 != "" {
		css += "--font-body: 'CustomBody', 'Inter', ui-sans-serif, system-ui, sans-serif;"
	} else if props.BodyFont != "" {
		css += "--font-body: '" + props.BodyFont + "', 'Inter', ui-sans-serif, system-ui, sans-serif;"
	}
	css += "}</style>"
	return css
}
