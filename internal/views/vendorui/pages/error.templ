package pages

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui/components"
)

// ErrorPageProps for the error page
type ErrorPageProps struct {
	Title        string
	Error        string
	BasePath     string
	PrimaryColor string
}

// ErrorPage renders the error page
templ ErrorPage(props ErrorPageProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ getErrorTitle(props.Title) }</title>
			<link href="/static/css/vendor.css" rel="stylesheet"/>
			@errorPageDarkModeScript()
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
			if props.PrimaryColor != "" {
				@themeColorStyle(props.PrimaryColor)
			}
		</head>
		<body class="min-h-screen bg-cool-grey-100 dark:bg-dark-grey-950 font-sans antialiased">
			<div class="max-w-lg mx-auto mt-20">
				<div class="bg-white dark:bg-dark-grey-900 p-8 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500 text-center">
					<div class="mb-6">
						<div class="mx-auto w-16 h-16 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center">
							@errorIcon()
						</div>
					</div>
					<h2 class="text-2xl font-bold text-cool-grey-900 dark:text-white mb-4">Oops! Something went wrong</h2>
					if props.Error != "" {
						<p class="text-cool-grey-700 dark:text-cool-grey-300 mb-6">{ props.Error }</p>
					} else {
						<p class="text-cool-grey-700 dark:text-cool-grey-300 mb-6">An unexpected error occurred. Please try again.</p>
					}
					<div class="flex flex-col sm:flex-row gap-3 justify-center">
						@components.Button(components.ButtonProps{
							Text:    "Go Back",
							Variant: "secondary",
							OnClick: "window.history.back()",
						})
						@components.Button(components.ButtonProps{
							Text:    "Go to Login",
							Variant: "primary",
							Href:    props.BasePath + "/login",
						})
					</div>
				</div>
			</div>
		</body>
	</html>
}

func getErrorTitle(title string) string {
	if title != "" {
		return title
	}
	return "Error - Installer App"
}

templ errorPageDarkModeScript() {
	<script>
		(function() {
			var darkMode = localStorage.getItem('darkMode');
			if (darkMode === 'true' || (!darkMode && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			}
		})();
	</script>
}

templ themeColorStyle(primaryColor string) {
	<style>
		:root {
			--theme-primary: { primaryColor };
		}
	</style>
}

templ errorIcon() {
	<svg class="w-8 h-8 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
	</svg>
}
