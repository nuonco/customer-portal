package pages

import (
	"fmt"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui"
)

// CustomerInstall represents an install with app information
type CustomerInstall struct {
	ID             string
	InstallLinkID  string
	NuonInstallID  string
	NuonOrgID      string
	AppID          string
	Name           string
	AppName        string
	Platform       string
	Status         string
	Region         string
	CreatedAt      string
}

// CustomerDetailPageProps for the customer detail page
type CustomerDetailPageProps struct {
	vendorui.LayoutProps
	Org      models.NuonOrg
	Customer *models.User
	Installs []CustomerInstall
}

// CustomerDetailPage renders the customer detail page
templ CustomerDetailPage(props CustomerDetailPageProps) {
	@vendorui.Layout(props.LayoutProps) {
		<div class="stratus-page-content overflow-auto">
			<div class="stratus-page-header">
				<div class="stratus-heading-group">
					<h1 class="stratus-page-title">Customer Details</h1>
					<p class="stratus-page-subtitle">View customer information and their installs.</p>
				</div>
			</div>
			<div class="stratus-page-section">
				<!-- Customer Information Card -->
				<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500 mb-6">
					<h2 class="text-lg font-semibold text-cool-grey-900 dark:text-white mb-4">Customer Information</h2>
					<div class="space-y-4">
						<div class="flex items-center">
							<div class="flex-shrink-0 h-16 w-16 rounded-full bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center mr-4">
								<span class="text-xl font-medium text-primary-700 dark:text-primary-300">
									{ getInitials(props.Customer.Name) }
								</span>
							</div>
							<div>
								<h3 class="text-xl font-semibold text-cool-grey-900 dark:text-white">{ props.Customer.Name }</h3>
								<p class="text-cool-grey-600 dark:text-cool-grey-400">{ props.Customer.Email }</p>
							</div>
						</div>
						<div class="grid grid-cols-2 gap-4 pt-4 border-t border-cool-grey-200 dark:border-dark-grey-600">
							<div>
								<h4 class="text-sm font-medium text-cool-grey-500 dark:text-cool-grey-400">Customer ID</h4>
								<p class="text-sm text-cool-grey-900 dark:text-white mt-1 font-mono">{ props.Customer.ID }</p>
							</div>
							<div>
								<h4 class="text-sm font-medium text-cool-grey-500 dark:text-cool-grey-400">Total Installs</h4>
								<p class="text-sm text-cool-grey-900 dark:text-white mt-1">{ fmt.Sprintf("%d", len(props.Installs)) }</p>
							</div>
						</div>
					</div>
				</div>
				<!-- Installs Card -->
				<div class="bg-white dark:bg-dark-grey-900 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500 overflow-hidden">
					<div class="px-6 py-4 border-b border-cool-grey-200 dark:border-dark-grey-700">
						<h2 class="text-lg font-semibold text-cool-grey-900 dark:text-white">Installs</h2>
					</div>
					if len(props.Installs) > 0 {
						<div class="overflow-x-auto">
							<table class="min-w-full divide-y divide-cool-grey-200 dark:divide-dark-grey-700">
								<thead class="bg-cool-grey-50 dark:bg-dark-grey-800">
									<tr>
										<th scope="col" class="px-4 py-2.5 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
											Install Name
										</th>
										<th scope="col" class="px-4 py-2.5 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
											Application
										</th>
										<th scope="col" class="px-4 py-2.5 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
											Platform
										</th>
										<th scope="col" class="px-4 py-2.5 text-left text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
											Created
										</th>
										<th scope="col" class="px-3 py-2.5 w-20 text-center text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
											Link
										</th>
										<th scope="col" class="px-3 py-2.5 w-20 text-center text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
											Portal
										</th>
										<th scope="col" class="px-3 py-2.5 w-20 text-center text-xs font-medium text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wider">
											Dash
										</th>
									</tr>
								</thead>
								<tbody class="bg-white dark:bg-dark-grey-900 divide-y divide-cool-grey-200 dark:divide-dark-grey-700">
									for _, install := range props.Installs {
										@installTableRow(install, props.Org.ID, props.BasePath)
									}
								</tbody>
							</table>
						</div>
					} else {
						<div class="text-center py-8">
							<p class="text-cool-grey-500 dark:text-cool-grey-400">
								This customer has no installs.
							</p>
						</div>
					}
				</div>
			</div>
		</div>
	}
}

templ installTableRow(install CustomerInstall, orgID, basePath string) {
	<tr class="hover:bg-cool-grey-50 dark:hover:bg-dark-grey-800">
		<td class="px-4 py-3 whitespace-nowrap">
			<div class="text-sm font-medium text-cool-grey-900 dark:text-white">{ install.Name }</div>
			<div class="text-xs text-cool-grey-500 dark:text-cool-grey-400">{ install.ID }</div>
		</td>
		<td class="px-4 py-3 whitespace-nowrap">
			if install.AppID != "" {
				<a
					href={ templ.SafeURL(fmt.Sprintf("%s/orgs/%s/apps/%s/inputs", basePath, orgID, install.AppID)) }
					class="text-sm text-primary-600 dark:text-primary-400 hover:text-primary-900 dark:hover:text-primary-300 hover:underline"
				>
					{ install.AppName }
				</a>
			} else {
				<span class="text-sm text-cool-grey-400 dark:text-cool-grey-600">unknown</span>
			}
		</td>
		<td class="px-4 py-3 whitespace-nowrap">
			@platformBadge(install.Platform)
		</td>
		<td class="px-4 py-3 whitespace-nowrap">
			<div class="text-sm text-cool-grey-900 dark:text-white">{ install.CreatedAt }</div>
		</td>
		<td class="px-3 py-3 whitespace-nowrap text-center">
			if install.InstallLinkID != "" {
				<a
					href={ templ.SafeURL(fmt.Sprintf("%s/orgs/%s/links/%s", basePath, orgID, install.InstallLinkID)) }
					class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:text-primary-900 dark:hover:text-primary-300"
					title="View Install Link"
				>
					@linkIcon()
				</a>
			} else {
				<span class="inline-flex items-center text-cool-grey-300 dark:text-dark-grey-600 cursor-not-allowed" title="No install link">
					@linkIcon()
				</span>
			}
		</td>
		<td class="px-3 py-3 whitespace-nowrap text-center">
			<a
				href={ templ.SafeURL(fmt.Sprintf("/installs/%s", install.ID)) }
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:text-primary-900 dark:hover:text-primary-300"
				title="View in Customer Portal"
			>
				@eyeIcon()
			</a>
		</td>
		<td class="px-3 py-3 whitespace-nowrap text-center">
			<a
				href={ templ.SafeURL(fmt.Sprintf("https://app.nuon.co/%s/installs/%s", install.NuonOrgID, install.NuonInstallID)) }
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:text-primary-900 dark:hover:text-primary-300"
				title="View in Dashboard"
			>
				@externalLinkIcon()
			</a>
		</td>
	</tr>
}

templ statusBadge(status string) {
	switch status {
		case "running", "active", "healthy":
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300">
				<svg class="mr-1.5 h-2 w-2" fill="currentColor" viewBox="0 0 8 8">
					<circle cx="4" cy="4" r="3"></circle>
				</svg>
				{ status }
			</span>
		case "pending", "deploying", "creating":
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-300">
				<svg class="mr-1.5 h-2 w-2" fill="currentColor" viewBox="0 0 8 8">
					<circle cx="4" cy="4" r="3"></circle>
				</svg>
				{ status }
			</span>
		case "failed", "error", "unhealthy":
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-300">
				<svg class="mr-1.5 h-2 w-2" fill="currentColor" viewBox="0 0 8 8">
					<circle cx="4" cy="4" r="3"></circle>
				</svg>
				{ status }
			</span>
		default:
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-cool-grey-100 dark:bg-cool-grey-700 text-cool-grey-800 dark:text-cool-grey-300">
				{ status }
			</span>
	}
}

templ eyeIcon() {
	<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
	</svg>
}

templ externalLinkIcon() {
	<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
	</svg>
}
