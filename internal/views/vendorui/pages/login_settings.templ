package pages

import (
	"strings"

	"github.com/nuonco/customer-portal/internal/models"
	"github.com/nuonco/customer-portal/internal/views/vendorui"
	"github.com/nuonco/customer-portal/internal/views/vendorui/components"
	"github.com/nuonco/customer-portal/internal/views/vendorui/partials"
)

// LoginSettingsPageProps for the login settings page
type LoginSettingsPageProps struct {
	vendorui.LayoutProps
	Config     *models.CustomerAuthConfig
	Theme      *models.AppTheme
	TestResult string // "success", "error", or empty
	TestError  string
}

// LoginSettingsPage renders the login settings page
templ LoginSettingsPage(props LoginSettingsPageProps) {
	@vendorui.Layout(props.LayoutProps) {
		<div class="flex flex-1 overflow-hidden">
			@components.PortalSubnav(components.PortalSubnavProps{
				OrgID:         props.CurrentOrg.ID,
				ActiveSubPage: "login",
				BasePath:      props.BasePath,
			})
			<div class="stratus-page-content overflow-auto">
				@vendorui.APIErrorBanner(props.LayoutProps)
				<div class="stratus-page-header">
					<div class="stratus-heading-group">
						<h1 class="stratus-page-title">Login</h1>
						<p class="stratus-page-subtitle">Configure the customer login page and authentication settings.</p>
					</div>
				</div>
				<div class="stratus-page-section">
					<div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-6 items-start">
						<!-- Left Column: Settings -->
						<div class="space-y-6">
							@loginSettingsModeToggle()
							<div id="globalSettings" class="space-y-6">
								@loginPageTextSection(props.Theme)
								@loginEnableToggleSection(props.Config)
								@loginOidcConfigSection(props.Config)
								@loginFallbackInfoSection()
							</div>
							<div id="lightModeSettings" class="hidden space-y-6">
								@loginPageAppearanceSection(props.Theme)
							</div>
							<div id="darkModeSettings" class="hidden space-y-6">
								@loginPageDarkAppearanceSection(props.Theme)
							</div>
							@loginSaveSection(props.PrimaryColor)
						</div>
						<!-- Right Column: Preview -->
						<div>
							@components.PreviewContainer(components.PreviewContainerProps{
								Title:          "Preview",
								Description:    "This is what your customers will see.",
								InitialMode:    "light",
								InitialSize:    "desktop",
								PrimaryColor:   getBrandingPrimaryColor(props.Theme.PrimaryColor),
								WhiteColor:     getBrandingWhiteColor(props.Theme.WhiteColor),
								BlackColor:     getBrandingBlackColor(props.Theme.BlackColor),
							}) {
								@partials.LoginPreview(partials.LoginPreviewProps{
									Title:             props.Theme.GetLoginTitle(),
									Subtitle:          props.Theme.GetLoginSubtitle(),
									RightSideStyle:    getLoginPreviewRightSideStyle(props.Theme),
									HasRightSideImage: props.Theme.GetLoginRightSideImage() != "",
									LogoLightBase64:   props.Theme.LogoLightBase64,
									LogoDarkBase64:    props.Theme.LogoDarkBase64,
								})
							}
						</div>
					</div>
				</div>
				<!-- Config data for JavaScript -->
				<div
					id="login-settings-config"
					class="hidden"
					data-base-path={ props.BasePath }
					data-org-id={ props.CurrentOrg.ID }
					data-enabled={ loginBoolToString(props.Config.Enabled) }
					data-has-secret={ loginBoolToString(props.Config.HasClientSecret()) }
					data-primary-color={ getBrandingPrimaryColor(props.Theme.PrimaryColor) }
					data-primary-color-dark={ props.Theme.PrimaryColorDark }
					data-white-color={ getBrandingWhiteColor(props.Theme.WhiteColor) }
					data-black-color={ getBrandingBlackColor(props.Theme.BlackColor) }
					data-logo-light-base64={ props.Theme.LogoLightBase64 }
					data-logo-dark-base64={ props.Theme.LogoDarkBase64 }
					data-login-right-side-image={ props.Theme.GetLoginRightSideImage() }
					data-login-right-side-gradient={ props.Theme.GetLoginRightSideGradient() }
					data-login-right-side-image-dark={ props.Theme.GetLoginRightSideImageDark() }
					data-login-right-side-gradient-dark={ props.Theme.GetLoginRightSideGradientDark() }
					data-provider-name={ props.Config.ProviderName }
					data-issuer-url={ props.Config.IssuerURL }
					data-client-id={ props.Config.ClientID }
					data-scopes={ getLoginScopesValue(props.Config.Scopes) }
					data-login-title={ props.Theme.GetLoginTitle() }
					data-login-subtitle={ props.Theme.GetLoginSubtitle() }
					data-gradient-color1={ getGradientColor1Text(props.Theme.GetLoginRightSideGradient()) }
					data-gradient-color2={ getGradientColor2Text(props.Theme.GetLoginRightSideGradient()) }
					data-gradient-direction={ getGradientDirection(props.Theme.GetLoginRightSideGradient()) }
					data-gradient-color1-dark={ getGradientColor1Text(props.Theme.GetLoginRightSideGradientDark()) }
					data-gradient-color2-dark={ getGradientColor2Text(props.Theme.GetLoginRightSideGradientDark()) }
					data-gradient-direction-dark={ getGradientDirection(props.Theme.GetLoginRightSideGradientDark()) }
				></div>
				@loginSettingsScript()
			</div>
		</div>
	}
}

func loginBoolToString(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

templ loginSettingsModeToggle() {
	<div class="flex items-center space-x-1 bg-cool-grey-100 dark:bg-dark-grey-700 rounded-lg p-1">
		<button
			type="button"
			id="settingsGlobalBtn"
			onclick="setSettingsMode('global')"
			class="flex-1 px-3 py-1.5 text-sm font-medium rounded-md transition-colors bg-white dark:bg-dark-grey-600 text-cool-grey-800 dark:text-white shadow-sm"
		>
			Global
		</button>
		<button
			type="button"
			id="settingsLightModeBtn"
			onclick="setSettingsMode('light')"
			class="flex-1 px-3 py-1.5 text-sm font-medium rounded-md transition-colors text-cool-grey-600 dark:text-cool-grey-400 hover:bg-cool-grey-200 dark:hover:bg-dark-grey-600"
		>
			Light Mode
		</button>
		<button
			type="button"
			id="settingsDarkModeBtn"
			onclick="setSettingsMode('dark')"
			class="flex-1 px-3 py-1.5 text-sm font-medium rounded-md transition-colors text-cool-grey-600 dark:text-cool-grey-400 hover:bg-cool-grey-200 dark:hover:bg-dark-grey-600"
		>
			Dark Mode
		</button>
	</div>
}

templ loginPageTextSection(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Login Page Text</h3>
		<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-4">Customize the text displayed on the customer login page.</p>
		<div class="space-y-4">
			<div>
				<label for="loginTitle" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">Title</label>
				<input
					type="text"
					id="loginTitle"
					value={ theme.GetLoginTitle() }
					placeholder="Customer Portal"
					oninput="updatePreview(); loginCheckForChanges()"
					class="block w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white dark:placeholder-cool-grey-500"
				/>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Main heading shown on the customer login page.</p>
			</div>
			<div>
				<label for="loginSubtitle" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">Subtitle</label>
				<input
					type="text"
					id="loginSubtitle"
					value={ theme.GetLoginSubtitle() }
					placeholder="Manage your installs."
					oninput="updatePreview(); loginCheckForChanges()"
					class="block w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white dark:placeholder-cool-grey-500"
				/>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Descriptive text shown below the title.</p>
			</div>
		</div>
	</div>
}

templ loginPageAppearanceSection(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Login Page Appearance</h3>
		<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-4">Customize the right-side image and gradient for the light mode login page.</p>
		<div class="space-y-4">
			<div>
				<label class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-2">Right Side Image</label>
				<div class="flex items-center space-x-4">
					<div class="flex-shrink-0">
						if theme.GetLoginRightSideImage() != "" {
							<img id="loginRightSidePreview" src={ theme.GetLoginRightSideImage() } alt="Login right side preview" class="h-24 w-auto max-w-32 object-cover border border-cool-grey-200 dark:border-dark-grey-600 rounded bg-white dark:bg-dark-grey-700"/>
						} else {
							<img id="loginRightSidePreview" src="" alt="Login right side preview" class="h-24 w-auto max-w-32 object-cover border border-cool-grey-200 dark:border-dark-grey-600 rounded bg-white dark:bg-dark-grey-700 hidden"/>
						}
						<div id="loginRightSidePlaceholder" class={ "h-24 w-32 bg-white dark:bg-dark-grey-700 border border-cool-grey-200 dark:border-dark-grey-600 rounded flex items-center justify-center", templ.KV("hidden", theme.GetLoginRightSideImage() != "") }>
							<span class="text-cool-grey-400 dark:text-cool-grey-500 text-xs text-center px-2">No image</span>
						</div>
					</div>
					<div class="flex-1">
						<div class="flex items-center gap-2">
							<label class="cursor-pointer inline-flex items-center px-3 py-1.5 border border-cool-grey-300 dark:border-dark-grey-600 rounded-md text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 bg-white dark:bg-dark-grey-800 hover:bg-cool-grey-50 dark:hover:bg-dark-grey-700">
								Upload
								<input
									type="file"
									id="loginRightSideUpload"
									accept="image/png,image/jpeg,image/svg+xml,image/gif,image/webp"
									onchange="handleLoginRightSideUpload(this)"
									class="hidden"
								/>
							</label>
							<button
								type="button"
								id="removeLoginRightSide"
								onclick="removeLoginRightSide()"
								disabled?={ theme.GetLoginRightSideImage() == "" }
								class="cursor-pointer inline-flex items-center px-3 py-1.5 border border-cool-grey-300 dark:border-dark-grey-600 rounded-md text-sm font-medium text-red-600 dark:text-red-400 bg-white dark:bg-dark-grey-800 hover:bg-red-50 dark:hover:bg-red-900/20 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-white dark:disabled:hover:bg-dark-grey-800"
							>Remove</button>
						</div>
						<p id="loginRightSideHelpText" class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">PNG, JPG, SVG, GIF, or WebP. Max 500KB.</p>
					</div>
				</div>
			</div>
			<div>
				<label class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-2">Right Side Gradient (alternative to image)</label>
				<div class="space-y-3">
					<div>
						<label for="gradientColor1" class="block text-xs font-medium text-cool-grey-600 dark:text-cool-grey-400 mb-1">Start Color</label>
						<div class="flex items-center space-x-2">
							<input
								type="color"
								id="gradientColor1"
								value={ getGradientColor1ForPicker(theme.GetLoginRightSideGradient(), theme.PrimaryColor) }
								oninput="handleGradientPickerInput('gradientColor1', 'gradientColor1Text', updateGradientPreview); loginCheckForChanges()"
								class="h-10 w-14 rounded border border-cool-grey-300 dark:border-dark-grey-500 cursor-pointer"
							/>
							<input
								type="text"
								id="gradientColor1Text"
								value={ getGradientColor1Text(theme.GetLoginRightSideGradient()) }
								placeholder="(uses primary color)"
								oninput="handleGradientTextInput('gradientColor1Text', 'gradientColor1', document.getElementById('login-settings-config').dataset.primaryColor || '#8040BF', updateGradientPreview); loginCheckForChanges()"
								class="flex-1 px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md uppercase focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white dark:placeholder-cool-grey-500"
								pattern="^#[0-9A-Fa-f]{6}$"
							/>
						</div>
					</div>
					<div>
						<label for="gradientColor2" class="block text-xs font-medium text-cool-grey-600 dark:text-cool-grey-400 mb-1">End Color</label>
						<div class="flex items-center space-x-2">
							<input
								type="color"
								id="gradientColor2"
								value={ getGradientColor2ForPicker(theme.GetLoginRightSideGradient(), theme.PrimaryColor) }
								oninput="handleGradientPickerInput('gradientColor2', 'gradientColor2Text', updateGradientPreview); loginCheckForChanges()"
								class="h-10 w-14 rounded border border-cool-grey-300 dark:border-dark-grey-500 cursor-pointer"
							/>
							<input
								type="text"
								id="gradientColor2Text"
								value={ getGradientColor2Text(theme.GetLoginRightSideGradient()) }
								placeholder="(uses primary color)"
								oninput="handleGradientTextInput('gradientColor2Text', 'gradientColor2', document.getElementById('login-settings-config').dataset.primaryColor || '#8040BF', updateGradientPreview); loginCheckForChanges()"
								class="flex-1 px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md uppercase focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white dark:placeholder-cool-grey-500"
								pattern="^#[0-9A-Fa-f]{6}$"
							/>
						</div>
					</div>
					<div>
						<label for="gradientDirection" class="block text-xs font-medium text-cool-grey-600 dark:text-cool-grey-400 mb-1">Direction</label>
						<select
							id="gradientDirection"
							onchange="updateGradientPreview(); loginCheckForChanges()"
							class="w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white"
						>
							<option value="135deg" selected?={ getGradientDirection(theme.GetLoginRightSideGradient()) == "135deg" }>Diagonal (↘)</option>
							<option value="180deg" selected?={ getGradientDirection(theme.GetLoginRightSideGradient()) == "180deg" }>Vertical (↓)</option>
							<option value="90deg" selected?={ getGradientDirection(theme.GetLoginRightSideGradient()) == "90deg" }>Horizontal (→)</option>
							<option value="45deg" selected?={ getGradientDirection(theme.GetLoginRightSideGradient()) == "45deg" }>Diagonal (↗)</option>
						</select>
					</div>
					<div>
						<div id="gradientPreview" class="h-24 w-32 border border-cool-grey-300 dark:border-dark-grey-500 rounded" style={ getGradientPreviewStyle(theme.GetLoginRightSideGradient(), theme.PrimaryColor, theme.PrimaryColor) }></div>
					</div>
				</div>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Configure a gradient background. Note: Image takes priority over gradient if both are set.</p>
			</div>
		</div>
	</div>
}

templ loginPageDarkAppearanceSection(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Login Page Appearance (Dark)</h3>
		<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-4">Override the right-side image and gradient for dark mode. When not set, the light mode values are used.</p>
		<div class="space-y-4">
			<div>
				<label class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-2">Right Side Image (Dark)</label>
				<div class="flex items-center space-x-4">
					<div class="flex-shrink-0">
						if theme.GetLoginRightSideImageDark() != "" {
							<img id="loginRightSideDarkPreview" src={ theme.GetLoginRightSideImageDark() } alt="Login right side dark preview" class="h-24 w-auto max-w-32 object-cover border border-cool-grey-200 dark:border-dark-grey-600 rounded bg-white dark:bg-dark-grey-700"/>
						} else {
							<img id="loginRightSideDarkPreview" src="" alt="Login right side dark preview" class="h-24 w-auto max-w-32 object-cover border border-cool-grey-200 dark:border-dark-grey-600 rounded bg-white dark:bg-dark-grey-700 hidden"/>
						}
						<div id="loginRightSideDarkPlaceholder" class={ "h-24 w-32 bg-white dark:bg-dark-grey-700 border border-cool-grey-200 dark:border-dark-grey-600 rounded flex items-center justify-center", templ.KV("hidden", theme.GetLoginRightSideImageDark() != "") }>
							<span class="text-cool-grey-400 dark:text-cool-grey-500 text-xs text-center px-2">Uses light mode</span>
						</div>
					</div>
					<div class="flex-1">
						<div class="flex items-center gap-2">
							<label class="cursor-pointer inline-flex items-center px-3 py-1.5 border border-cool-grey-300 dark:border-dark-grey-600 rounded-md text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 bg-white dark:bg-dark-grey-800 hover:bg-cool-grey-50 dark:hover:bg-dark-grey-700">
								Upload
								<input
									type="file"
									id="loginRightSideDarkUpload"
									accept="image/png,image/jpeg,image/svg+xml,image/gif,image/webp"
									onchange="handleLoginRightSideDarkUpload(this)"
									class="hidden"
								/>
							</label>
							<button
								type="button"
								id="removeLoginRightSideDark"
								onclick="removeLoginRightSideDark()"
								disabled?={ theme.GetLoginRightSideImageDark() == "" }
								class="cursor-pointer inline-flex items-center px-3 py-1.5 border border-cool-grey-300 dark:border-dark-grey-600 rounded-md text-sm font-medium text-red-600 dark:text-red-400 bg-white dark:bg-dark-grey-800 hover:bg-red-50 dark:hover:bg-red-900/20 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-white dark:disabled:hover:bg-dark-grey-800"
							>Remove</button>
						</div>
						<p id="loginRightSideDarkHelpText" class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">PNG, JPG, SVG, GIF, or WebP. Max 500KB.</p>
					</div>
				</div>
			</div>
			<div>
				<label class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-2">Right Side Gradient (Dark, alternative to image)</label>
				<div class="space-y-3">
					<div>
						<label for="gradientColor1Dark" class="block text-xs font-medium text-cool-grey-600 dark:text-cool-grey-400 mb-1">Start Color</label>
						<div class="flex items-center space-x-2">
							<input
								type="color"
								id="gradientColor1Dark"
								value={ getGradientColor1ForPicker(theme.GetLoginRightSideGradientDark(), theme.PrimaryColor) }
								oninput="handleGradientPickerInput('gradientColor1Dark', 'gradientColor1DarkText', updateDarkGradientPreview); loginCheckForChanges()"
								class="h-10 w-14 rounded border border-cool-grey-300 dark:border-dark-grey-500 cursor-pointer"
							/>
							<input
								type="text"
								id="gradientColor1DarkText"
								value={ getGradientColor1Text(theme.GetLoginRightSideGradientDark()) }
								placeholder="(uses light mode)"
								oninput="handleGradientTextInput('gradientColor1DarkText', 'gradientColor1Dark', document.getElementById('login-settings-config').dataset.primaryColor || '#8040BF', updateDarkGradientPreview); loginCheckForChanges()"
								class="flex-1 px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md uppercase focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white dark:placeholder-cool-grey-500"
								pattern="^#[0-9A-Fa-f]{6}$"
							/>
						</div>
					</div>
					<div>
						<label for="gradientColor2Dark" class="block text-xs font-medium text-cool-grey-600 dark:text-cool-grey-400 mb-1">End Color</label>
						<div class="flex items-center space-x-2">
							<input
								type="color"
								id="gradientColor2Dark"
								value={ getGradientColor2ForPicker(theme.GetLoginRightSideGradientDark(), theme.PrimaryColor) }
								oninput="handleGradientPickerInput('gradientColor2Dark', 'gradientColor2DarkText', updateDarkGradientPreview); loginCheckForChanges()"
								class="h-10 w-14 rounded border border-cool-grey-300 dark:border-dark-grey-500 cursor-pointer"
							/>
							<input
								type="text"
								id="gradientColor2DarkText"
								value={ getGradientColor2Text(theme.GetLoginRightSideGradientDark()) }
								placeholder="(uses light mode)"
								oninput="handleGradientTextInput('gradientColor2DarkText', 'gradientColor2Dark', document.getElementById('login-settings-config').dataset.primaryColor || '#8040BF', updateDarkGradientPreview); loginCheckForChanges()"
								class="flex-1 px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md uppercase focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white dark:placeholder-cool-grey-500"
								pattern="^#[0-9A-Fa-f]{6}$"
							/>
						</div>
					</div>
					<div>
						<label for="gradientDirectionDark" class="block text-xs font-medium text-cool-grey-600 dark:text-cool-grey-400 mb-1">Direction</label>
						<select
							id="gradientDirectionDark"
							onchange="updateDarkGradientPreview(); loginCheckForChanges()"
							class="w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600 text-sm bg-white dark:bg-dark-grey-700 dark:text-white"
						>
							<option value="135deg" selected?={ getGradientDirection(theme.GetLoginRightSideGradientDark()) == "135deg" }>Diagonal (↘)</option>
							<option value="180deg" selected?={ getGradientDirection(theme.GetLoginRightSideGradientDark()) == "180deg" }>Vertical (↓)</option>
							<option value="90deg" selected?={ getGradientDirection(theme.GetLoginRightSideGradientDark()) == "90deg" }>Horizontal (→)</option>
							<option value="45deg" selected?={ getGradientDirection(theme.GetLoginRightSideGradientDark()) == "45deg" }>Diagonal (↗)</option>
						</select>
					</div>
					<div>
						<div id="gradientPreviewDark" class="h-24 w-32 border border-cool-grey-300 dark:border-dark-grey-500 rounded" style={ getGradientPreviewStyle(theme.GetLoginRightSideGradientDark(), theme.PrimaryColor, theme.PrimaryColor) }></div>
					</div>
				</div>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Configure a dark mode gradient. Leave empty to use the light mode gradient.</p>
			</div>
		</div>
	</div>
}

templ loginEnableToggleSection(config *models.CustomerAuthConfig) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<div class="flex items-center justify-between">
			<div>
				<h3 class="text-lg font-semibold text-cool-grey-800 dark:text-white">OIDC Authentication</h3>
				<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mt-1">
					Enable single sign-on for customers using an OIDC provider (Google, Okta, Auth0, etc.)
				</p>
			</div>
			<label class="relative inline-flex items-center cursor-pointer">
				<input
					type="checkbox"
					id="oidcEnabled"
					class="sr-only peer"
					onchange="updateEnabledStatus(this.checked); loginCheckForChanges()"
					if config.Enabled {
						checked
					}
				/>
				<div class="w-11 h-6 bg-cool-grey-300 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary-300 dark:peer-focus:ring-primary-800 rounded-full peer dark:bg-dark-grey-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-cool-grey-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-dark-grey-600 peer-checked:bg-primary-600"></div>
			</label>
		</div>
		<div id="enabledStatus" class="mt-3">
			if config.Enabled {
				<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400">
					<svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
					</svg>
					OIDC Enabled
				</span>
			} else {
				<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-cool-grey-100 text-cool-grey-800 dark:bg-dark-grey-700 dark:text-cool-grey-300">
					Using email/password authentication
				</span>
			}
		</div>
	</div>
}

templ loginOidcConfigSection(config *models.CustomerAuthConfig) {
	<div id="oidcConfigSection" class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">OIDC Configuration</h3>
		<div class="space-y-4">
			<!-- Provider Name -->
			<div>
				<label for="providerName" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">
					Provider
				</label>
				<select
					id="providerName"
					onchange="loginCheckForChanges()"
					class="w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-800 dark:text-white rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600"
				>
					<option value="" if config.ProviderName == "" { selected }>Select a provider...</option>
					<option value="Google" if config.ProviderName == "Google" { selected }>Google</option>
					<option value="Okta" if config.ProviderName == "Okta" { selected }>Okta</option>
					<option value="Auth0" if config.ProviderName == "Auth0" { selected }>Auth0</option>
					<option value="Azure AD" if config.ProviderName == "Azure AD" { selected }>Azure AD</option>
					<option value="Custom" if config.ProviderName == "Custom" { selected }>Custom OIDC</option>
				</select>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">
					The identity provider your customers will use to sign in.
				</p>
			</div>
			<!-- Issuer URL -->
			<div>
				<label for="issuerUrl" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">
					Issuer URL <span class="text-red-500">*</span>
				</label>
				<input
					type="url"
					id="issuerUrl"
					value={ config.IssuerURL }
					placeholder="https://accounts.google.com"
					oninput="loginCheckForChanges()"
					class="w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-800 dark:text-white rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600"
				/>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">
					The OIDC issuer URL (discovery endpoint). For Google: https://accounts.google.com
				</p>
			</div>
			<!-- Client ID -->
			<div>
				<label for="clientId" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">
					Client ID <span class="text-red-500">*</span>
				</label>
				<input
					type="text"
					id="clientId"
					value={ config.ClientID }
					placeholder="your-client-id.apps.googleusercontent.com"
					oninput="loginCheckForChanges()"
					class="w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-800 dark:text-white rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600"
				/>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">
					The OAuth client ID from your identity provider.
				</p>
			</div>
			<!-- Client Secret -->
			<div>
				<label for="clientSecret" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">
					Client Secret <span class="text-red-500">*</span>
				</label>
				<div class="relative">
					<input
						type="password"
						id="clientSecret"
						placeholder={ getLoginSecretPlaceholder(config.HasClientSecret()) }
						oninput="loginCheckForChanges()"
						class="w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-800 dark:text-white rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600 pr-10"
					/>
					<button
						type="button"
						onclick="toggleSecretVisibility()"
						class="absolute inset-y-0 right-0 pr-3 flex items-center text-cool-grey-400 hover:text-cool-grey-600"
					>
						<svg id="eyeIcon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
						</svg>
					</button>
				</div>
				if config.HasClientSecret() {
					<p class="mt-1 text-xs text-green-600 dark:text-green-400">
						<svg class="w-3 h-3 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
						</svg>
						Secret is configured. Leave blank to keep existing secret.
					</p>
				} else {
					<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">
						The OAuth client secret from your identity provider.
					</p>
				}
			</div>
			<!-- Scopes -->
			<div>
				<label for="scopes" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">
					Scopes
				</label>
				<input
					type="text"
					id="scopes"
					value={ getLoginScopesValue(config.Scopes) }
					placeholder="openid,profile,email"
					oninput="loginCheckForChanges()"
					class="w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-800 dark:text-white rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600"
				/>
				<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">
					Comma-separated OAuth scopes. Default: openid,profile,email
				</p>
			</div>
			<!-- Test Connection Button -->
			<div class="pt-4 border-t border-cool-grey-200 dark:border-dark-grey-600">
				<button
					type="button"
					id="testConnectionBtn"
					onclick="testConnection()"
					class="inline-flex items-center px-4 py-2 text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 bg-white dark:bg-dark-grey-700 border border-cool-grey-300 dark:border-dark-grey-500 rounded-md hover:bg-cool-grey-50 dark:hover:bg-dark-grey-600 focus:ring-2 focus:ring-primary-500"
				>
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
					Test Connection
				</button>
				<div id="testResult" class="mt-3 hidden"></div>
			</div>
		</div>
	</div>
}

func getLoginSecretPlaceholder(hasSecret bool) string {
	if hasSecret {
		return "••••••••••••••••"
	}
	return "Enter client secret"
}

func getLoginScopesValue(scopes string) string {
	if scopes == "" {
		return "openid,profile,email"
	}
	return scopes
}

// parseGradientColor1 extracts the first color from a gradient string, or returns empty if not found
func parseGradientColor1(gradient string) string {
	if gradient == "" {
		return ""
	}
	// Parse gradient like "linear-gradient(135deg, #667eea, #764ba2)"
	// Extract first color
	start := strings.Index(gradient, "#")
	if start != -1 {
		end := start + 7
		if end <= len(gradient) {
			return gradient[start:end]
		}
	}
	return ""
}

// parseGradientColor2 extracts the second color from a gradient string, or returns empty if not found
func parseGradientColor2(gradient string) string {
	if gradient == "" {
		return ""
	}
	// Find last occurrence of #
	lastHash := strings.LastIndex(gradient, "#")
	firstHash := strings.Index(gradient, "#")
	if lastHash != -1 && lastHash != firstHash {
		end := lastHash + 7
		if end <= len(gradient) {
			color := gradient[lastHash:end]
			// Remove trailing characters like )
			if strings.Contains(color, ")") {
				color = strings.Split(color, ")")[0]
			}
			return color
		}
	}
	return ""
}

// getGradientColor1ForPicker returns a color for the color picker input (always valid - parsed or primary fallback)
func getGradientColor1ForPicker(gradient, primaryColor string) string {
	if parsed := parseGradientColor1(gradient); parsed != "" {
		return parsed
	}
	if primaryColor != "" {
		return primaryColor
	}
	return "#8040BF" // default primary
}

// getGradientColor1Text returns the parsed color for the text input (empty if no gradient set, for placeholder display)
func getGradientColor1Text(gradient string) string {
	return parseGradientColor1(gradient)
}

// getGradientColor2ForPicker returns a color for the color picker input (always valid - parsed or primary fallback)
func getGradientColor2ForPicker(gradient, primaryColor string) string {
	if parsed := parseGradientColor2(gradient); parsed != "" {
		return parsed
	}
	if primaryColor != "" {
		return primaryColor
	}
	return "#8040BF" // default primary
}

// getGradientColor2Text returns the parsed color for the text input (empty if no gradient set, for placeholder display)
func getGradientColor2Text(gradient string) string {
	return parseGradientColor2(gradient)
}

func getGradientDirection(gradient string) string {
	if gradient == "" {
		return "135deg"
	}
	// Parse gradient and extract direction
	if strings.Contains(gradient, "135deg") {
		return "135deg"
	}
	if strings.Contains(gradient, "180deg") {
		return "180deg"
	}
	if strings.Contains(gradient, "90deg") {
		return "90deg"
	}
	if strings.Contains(gradient, "45deg") {
		return "45deg"
	}
	return "135deg"
}

// getGradientPreviewStyle returns the style for the gradient preview box
func getGradientPreviewStyle(gradient, primaryColor, primaryColor2 string) string {
	if gradient != "" {
		return "background: " + gradient + ";"
	}
	// Fall back to primary gradient
	primary := primaryColor
	if primary == "" {
		primary = "#8040BF"
	}
	color2 := primaryColor2
	if color2 == "" {
		color2 = primary
	}
	return "background: linear-gradient(135deg, " + primary + ", " + color2 + ");"
}

templ loginSaveSection(primaryColor string) {
	<div class="flex flex-col space-y-3">
		<button
			type="button"
			id="saveButton"
			onclick="saveLoginSettings()"
			disabled
			class={ "w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 text-base rounded-md font-medium text-white disabled:opacity-50 disabled:cursor-not-allowed",
				templ.KV("bg-theme-primary hover:bg-theme-primary-hover", primaryColor != ""),
				templ.KV("bg-primary-600 hover:bg-primary-700", primaryColor == "") }
			if primaryColor != "" {
				style={ "background-color: " + primaryColor }
			}
		>
			Save
		</button>
		<div id="successMessage" class="hidden p-4 bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-800 text-green-700 dark:text-green-300 rounded-lg">
			<div class="flex items-center">
				<svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
					<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
				</svg>
				Settings saved successfully!
			</div>
		</div>
		<div id="errorMessage" class="hidden p-4 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-300 rounded-lg"></div>
	</div>
}

templ loginFallbackInfoSection() {
	<div class="bg-blue-50 dark:bg-blue-900/20 p-4 rounded-lg border border-blue-200 dark:border-blue-800">
		<div class="flex">
			<svg class="w-5 h-5 text-blue-500 dark:text-blue-400 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
			</svg>
			<div>
				<h4 class="text-sm font-medium text-blue-800 dark:text-blue-300">Customer Auth Fallback</h4>
				<p class="mt-1 text-sm text-blue-700 dark:text-blue-400">
					When no OIDC provider is configured, customer login will default to the same provider used for admin login.
				</p>
			</div>
		</div>
	</div>
}

templ loginSettingsScript() {
	<script>
		(function() {
			var config = document.getElementById('login-settings-config');
			var basePath = config.dataset.basePath;
			var orgId = config.dataset.orgId;
			window._loginRightSideBase64 = '';
			window._loginRightSideBase64Dark = '';
			window._previewMode = 'light';

			// Tab switching
			window.setSettingsMode = function(mode, skipPreviewSync) {
				var globalSettings = document.getElementById('globalSettings');
				var lightSettings = document.getElementById('lightModeSettings');
				var darkSettings = document.getElementById('darkModeSettings');
				var settingsGlobalBtn = document.getElementById('settingsGlobalBtn');
				var settingsLightBtn = document.getElementById('settingsLightModeBtn');
				var settingsDarkBtn = document.getElementById('settingsDarkModeBtn');

				var activeClass = ['bg-white', 'dark:bg-dark-grey-600', 'text-cool-grey-800', 'dark:text-white', 'shadow-sm'];
				var inactiveClass = ['text-cool-grey-600', 'dark:text-cool-grey-400', 'hover:bg-cool-grey-200', 'dark:hover:bg-dark-grey-600'];

				[globalSettings, lightSettings, darkSettings].forEach(function(el) { if (el) el.classList.add('hidden'); });
				[settingsGlobalBtn, settingsLightBtn, settingsDarkBtn].forEach(function(btn) {
					if (!btn) return;
					activeClass.forEach(function(c) { btn.classList.remove(c); });
					inactiveClass.forEach(function(c) { btn.classList.add(c); });
				});

				var contentEl, activeBtn;
				if (mode === 'light') {
					contentEl = lightSettings; activeBtn = settingsLightBtn;
				} else if (mode === 'dark') {
					contentEl = darkSettings; activeBtn = settingsDarkBtn;
				} else {
					contentEl = globalSettings; activeBtn = settingsGlobalBtn;
				}
				if (contentEl) contentEl.classList.remove('hidden');
				if (activeBtn) {
					activeClass.forEach(function(c) { activeBtn.classList.add(c); });
					inactiveClass.forEach(function(c) { activeBtn.classList.remove(c); });
				}
				// Sync preview mode for light/dark tabs only
				if (!skipPreviewSync && (mode === 'light' || mode === 'dark')) {
					setPreviewMode(mode, true);
				}
			};

			// Update preview function
			window.updatePreview = function() {
				var title = document.getElementById('loginTitle').value || 'Customer Portal';
				var subtitle = document.getElementById('loginSubtitle').value || "Manage your installs.";
				var isDarkMode = window._previewMode === 'dark';

				// Get primary color based on preview mode (matching branding page behavior)
				var primaryColor;
				if (isDarkMode) {
					var darkPrimary = config.dataset.primaryColorDark || '';
					primaryColor = darkPrimary || config.dataset.primaryColor || '#8040BF';
				} else {
					primaryColor = config.dataset.primaryColor || '#8040BF';
				}

				// Update CSS variables on preview container (matching branding page)
				var container = document.getElementById('previewContainer');
				if (container) {
					container.style.setProperty('--preview-primary', primaryColor);
					container.style.setProperty('--preview-white', config.dataset.whiteColor || '#f8fafc');
					container.style.setProperty('--preview-black', config.dataset.blackColor || '#121212');
				}

				// Update title and subtitle
				var previewTitle = document.getElementById('loginPreviewTitle');
				var previewSubtitle = document.getElementById('loginPreviewSubtitle');
				if (previewTitle) previewTitle.textContent = title;
				if (previewSubtitle) previewSubtitle.textContent = subtitle;

				// Update logo based on mode
				var previewLogoLight = document.getElementById('loginPreviewLogoLight');
				var previewLogoDark = document.getElementById('loginPreviewLogoDark');
				var lightLogoSrc = config.dataset.logoLightBase64 || '';
				var darkLogoSrc = config.dataset.logoDarkBase64 || '';

				if (previewLogoLight) {
					if (lightLogoSrc) {
						previewLogoLight.src = lightLogoSrc;
						previewLogoLight.classList.remove('hidden');
					} else {
						previewLogoLight.classList.add('hidden');
					}
				}

				if (previewLogoDark) {
					if (darkLogoSrc) {
						previewLogoDark.src = darkLogoSrc;
						previewLogoDark.classList.remove('hidden');
					} else if (lightLogoSrc) {
						// Fall back to light logo for dark mode
						previewLogoDark.src = lightLogoSrc;
						previewLogoDark.classList.remove('hidden');
					} else {
						previewLogoDark.classList.add('hidden');
					}
				}

				// Update right side preview
				var rightSide = document.getElementById('loginPreviewRightSide');
				var gridOverlay = document.getElementById('loginPreviewGridOverlay');

				if (rightSide) {
					var isDarkMode = window._previewMode === 'dark';

					// Image: prefer in-progress edit, then fall back to saved value for current mode
					var imageBase64;
					if (isDarkMode) {
						imageBase64 = window._loginRightSideBase64Dark;
						if (!imageBase64) imageBase64 = config.dataset.loginRightSideImageDark || '';
						// Fall back to light if no dark value
						if (!imageBase64) imageBase64 = window._loginRightSideBase64 || config.dataset.loginRightSideImage || '';
					} else {
						imageBase64 = window._loginRightSideBase64;
						if (imageBase64 === 'REMOVE') imageBase64 = '';
						else if (!imageBase64) imageBase64 = config.dataset.loginRightSideImage || '';
					}
					if (imageBase64 === 'REMOVE') imageBase64 = '';

					// Gradient: prefer in-progress edit, then fall back to saved value for current mode
					var gradient;
					if (isDarkMode) {
						gradient = window._gradientValueDark || config.dataset.loginRightSideGradientDark || '';
						// Fall back to light if no dark value
						if (!gradient) gradient = window._gradientValue || config.dataset.loginRightSideGradient || '';
					} else {
						gradient = window._gradientValue;
						if (gradient === 'REMOVE') gradient = '';
						else if (!gradient) gradient = config.dataset.loginRightSideGradient || '';
					}
					if (gradient === 'REMOVE') gradient = '';

					// Priority: Image > Gradient > Primary Color
					if (imageBase64) {
						rightSide.style.background = '';
						rightSide.style.backgroundImage = 'url(' + imageBase64 + ')';
						rightSide.style.backgroundSize = 'cover';
						rightSide.style.backgroundPosition = 'center';
						if (gridOverlay) gridOverlay.classList.add('hidden');
					} else if (gradient) {
						rightSide.style.backgroundImage = '';
						rightSide.style.background = gradient;
						if (gridOverlay) gridOverlay.classList.remove('hidden');
					} else {
						// No image, no custom gradient - use default primary-based gradient
						rightSide.style.backgroundImage = '';
						var fallbackColor = config.dataset.primaryColor || '#8040BF';
						rightSide.style.background = 'linear-gradient(135deg, ' + primaryColor + ', ' + fallbackColor + ')';
						if (gridOverlay) gridOverlay.classList.remove('hidden');
					}
				}

			};

			// Hook into preview mode changes
			// Hook into preview mode changes to sync settings panel
			// Only switch away from Global tab if currently on light/dark tab
			window.onPreviewModeChange = function(mode) {
				var globalSettings = document.getElementById('globalSettings');
				if (!globalSettings.classList.contains('hidden')) return;
				setSettingsMode(mode, true);
			};

			// Toggle enable/disable
			window.updateEnabledStatus = function(enabled) {
				var statusDiv = document.getElementById('enabledStatus');
				if (enabled) {
					statusDiv.innerHTML = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400"><svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>OIDC Enabled</span>';
				} else {
					statusDiv.innerHTML = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-cool-grey-100 text-cool-grey-800 dark:bg-dark-grey-700 dark:text-cool-grey-300">Using email/password authentication</span>';
				}
			};

			// Toggle password visibility
			window.toggleSecretVisibility = function() {
				var input = document.getElementById('clientSecret');
				var icon = document.getElementById('eyeIcon');
				if (input.type === 'password') {
					input.type = 'text';
					icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>';
				} else {
					input.type = 'password';
					icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>';
				}
			};

			// Test connection
			window.testConnection = async function() {
				var btn = document.getElementById('testConnectionBtn');
				var resultDiv = document.getElementById('testResult');

				btn.disabled = true;
				btn.innerHTML = '<svg class="animate-spin w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>Testing...';

				// First save the current settings
				var formData = getFormData();

				try {
					// Save settings first
					var saveResponse = await fetch(basePath + '/orgs/' + orgId + '/settings/login', {
						method: 'PUT',
						headers: { 'Content-Type': 'application/json' },
						credentials: 'same-origin',
						body: JSON.stringify(formData)
					});

					if (!saveResponse.ok) {
						throw new Error('Failed to save settings before testing');
					}

					// Then test the connection
					var response = await fetch(basePath + '/orgs/' + orgId + '/settings/login/test', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						credentials: 'same-origin'
					});

					var data = await response.json();

					resultDiv.classList.remove('hidden');
					if (response.ok) {
						resultDiv.innerHTML = '<div class="p-3 bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-800 text-green-700 dark:text-green-300 rounded-md flex items-center"><svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>Connection successful! OIDC provider is reachable.</div>';
					} else {
						resultDiv.innerHTML = '<div class="p-3 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-300 rounded-md flex items-start"><svg class="w-5 h-5 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg><div><strong>Connection failed</strong><br/>' + (data.error || 'Unknown error') + '</div></div>';
					}
				} catch (error) {
					resultDiv.classList.remove('hidden');
					resultDiv.innerHTML = '<div class="p-3 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-300 rounded-md">Network error: ' + error.message + '</div>';
				}

				btn.disabled = false;
				btn.innerHTML = '<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>Test Connection';
			};

			// Remove login right side image
			window.removeLoginRightSide = function() {
				window._loginRightSideBase64 = 'REMOVE';
				document.getElementById('loginRightSidePreview').classList.add('hidden');
				document.getElementById('loginRightSidePlaceholder').classList.remove('hidden');
				document.getElementById('loginRightSideUpload').value = '';
				document.getElementById('removeLoginRightSide').disabled = true;
				document.getElementById('loginRightSideHelpText').textContent = 'PNG, JPG, SVG, GIF, or WebP. Max 500KB.';
				updatePreview();
				checkForChanges();
			};

			// Update gradient preview
			window.updateGradientPreview = function() {
				var primaryColor = config.dataset.primaryColor || '#8040BF';
				var fallbackColor = config.dataset.primaryColor || '#8040BF';
				var color1Text = document.getElementById('gradientColor1Text').value;
				var color2Text = document.getElementById('gradientColor2Text').value;
				// Use text input values if set, otherwise fall back to primary color
				var color1 = color1Text || primaryColor;
				var color2 = color2Text || fallbackColor;
				var direction = document.getElementById('gradientDirection').value;
				var gradient = 'linear-gradient(' + direction + ', ' + color1 + ', ' + color2 + ')';
				document.getElementById('gradientPreview').style.background = gradient;
				// Only set gradient value if at least one custom color is specified
				if (color1Text || color2Text) {
					window._gradientValue = gradient;
				}
				updatePreview();
			};

			function getFormData() {
				var formData = {
					enabled: document.getElementById('oidcEnabled').checked,
					provider_name: document.getElementById('providerName').value,
					issuer_url: document.getElementById('issuerUrl').value,
					client_id: document.getElementById('clientId').value,
					client_secret: document.getElementById('clientSecret').value,
					scopes: document.getElementById('scopes').value,
					login_title: document.getElementById('loginTitle').value,
					login_subtitle: document.getElementById('loginSubtitle').value
				};

				// Add login right side image if changed
				if (window._loginRightSideBase64) {
					formData.login_right_side_image_base64 = window._loginRightSideBase64;
				}

				// Always send gradient - empty string clears any saved gradient
				var color1Text = document.getElementById('gradientColor1Text').value;
				var color2Text = document.getElementById('gradientColor2Text').value;
				if (color1Text || color2Text) {
					// Custom gradient specified
					formData.login_right_side_gradient = window._gradientValue || '';
				} else {
					// No custom colors - clear saved gradient to use primary color defaults
					formData.login_right_side_gradient = '';
				}

				// Add dark mode login right side image if changed
				if (window._loginRightSideBase64Dark) {
					formData.login_right_side_image_base64_dark = window._loginRightSideBase64Dark;
				}

				// Dark gradient
				var color1DarkText = document.getElementById('gradientColor1DarkText') ? document.getElementById('gradientColor1DarkText').value : '';
				var color2DarkText = document.getElementById('gradientColor2DarkText') ? document.getElementById('gradientColor2DarkText').value : '';
				if (color1DarkText || color2DarkText) {
					formData.login_right_side_gradient_dark = window._gradientValueDark || '';
				} else {
					formData.login_right_side_gradient_dark = '';
				}

				return formData;
			}

			// Save settings
			window.saveLoginSettings = async function() {
				var saveButton = document.getElementById('saveButton');
				var successMessage = document.getElementById('successMessage');
				var errorMessage = document.getElementById('errorMessage');

				saveButton.textContent = 'Saving...';
				saveButton.disabled = true;
				successMessage.classList.add('hidden');
				errorMessage.classList.add('hidden');

				var formData = getFormData();

				try {
					var response = await fetch(basePath + '/orgs/' + orgId + '/settings/login', {
						method: 'PUT',
						headers: { 'Content-Type': 'application/json' },
						credentials: 'same-origin',
						body: JSON.stringify(formData)
					});

					var data = await response.json();

					if (response.ok) {
						successMessage.classList.remove('hidden');
						showToast('Login settings saved!', 'success');
						setTimeout(function() { successMessage.classList.add('hidden'); }, 3000);

						// Update saved state for change detection
						config.dataset.enabled = formData.enabled ? 'true' : 'false';
						config.dataset.providerName = formData.provider_name || '';
						config.dataset.issuerUrl = formData.issuer_url || '';
						config.dataset.clientId = formData.client_id || '';
						config.dataset.scopes = formData.scopes || '';
						config.dataset.loginTitle = formData.login_title || '';
						config.dataset.loginSubtitle = formData.login_subtitle || '';
						if (formData.login_right_side_image_base64) {
							config.dataset.loginRightSideImage = formData.login_right_side_image_base64 === 'REMOVE' ? '' : formData.login_right_side_image_base64;
							window._loginRightSideBase64 = '';
						}
						if (formData.login_right_side_image_base64_dark) {
							config.dataset.loginRightSideImageDark = formData.login_right_side_image_base64_dark === 'REMOVE' ? '' : formData.login_right_side_image_base64_dark;
							window._loginRightSideBase64Dark = '';
						}
						config.dataset.loginRightSideGradient = formData.login_right_side_gradient || '';
						config.dataset.loginRightSideGradientDark = formData.login_right_side_gradient_dark || '';
						// Update parsed gradient data attributes
						var g1 = document.getElementById('gradientColor1Text');
						var g2 = document.getElementById('gradientColor2Text');
						var gd = document.getElementById('gradientDirection');
						config.dataset.gradientColor1 = g1 ? g1.value : '';
						config.dataset.gradientColor2 = g2 ? g2.value : '';
						config.dataset.gradientDirection = gd ? gd.value : '';
						var g1d = document.getElementById('gradientColor1DarkText');
						var g2d = document.getElementById('gradientColor2DarkText');
						var gdd = document.getElementById('gradientDirectionDark');
						config.dataset.gradientColor1Dark = g1d ? g1d.value : '';
						config.dataset.gradientColor2Dark = g2d ? g2d.value : '';
						config.dataset.gradientDirectionDark = gdd ? gdd.value : '';
						checkForChanges();

						// Update the "has secret" indicator if secret was changed
						if (formData.client_secret) {
							var secretHelp = document.querySelector('#clientSecret').parentElement.nextElementSibling;
							if (secretHelp) {
								secretHelp.innerHTML = '<svg class="w-3 h-3 inline mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>Secret is configured. Leave blank to keep existing secret.';
								secretHelp.className = 'mt-1 text-xs text-green-600 dark:text-green-400';
							}
						}
					} else {
						errorMessage.innerHTML = '<div class="flex items-center"><svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg>' + (data.error || 'Failed to save settings') + '</div>';
						errorMessage.classList.remove('hidden');
					}
				} catch (error) {
					errorMessage.innerHTML = '<div class="flex items-center"><svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg>Network error. Please try again.</div>';
					errorMessage.classList.remove('hidden');
				}

				saveButton.textContent = 'Save';
				checkForChanges();
			};

			// Light mode login image upload — wraps shared handler and shows filename
			window.handleLoginRightSideUpload = function(input) {
				var file = input.files[0];
				var fileName = file ? file.name : '';
				handleLoginImageUpload(input, '_loginRightSideBase64', 'loginRightSidePreview', 'loginRightSidePlaceholder', 'removeLoginRightSide');
				if (input.files[0] && fileName) {
					document.getElementById('loginRightSideHelpText').textContent = fileName;
				}
			};

			// Dark mode login image upload — wraps shared handler and shows filename
			window.handleLoginRightSideDarkUpload = function(input) {
				var file = input.files[0];
				var fileName = file ? file.name : '';
				handleLoginImageUpload(input, '_loginRightSideBase64Dark', 'loginRightSideDarkPreview', 'loginRightSideDarkPlaceholder', 'removeLoginRightSideDark');
				if (input.files[0] && fileName) {
					document.getElementById('loginRightSideDarkHelpText').textContent = fileName;
				}
			};

			// Login image upload handler (shared by light and dark)
			window.handleLoginImageUpload = function(input, globalVar, previewId, placeholderId, removeBtnId) {
				var file = input.files[0];
				if (!file) return;

				if (file.size > 500 * 1024) {
					showToast('Image file must be under 500KB', 'error');
					input.value = '';
					return;
				}

				var validTypes = ['image/png', 'image/jpeg', 'image/svg+xml', 'image/gif', 'image/webp'];
				if (!validTypes.includes(file.type)) {
					showToast('Please upload a PNG, JPG, SVG, or GIF image', 'error');
					input.value = '';
					return;
				}

				var reader = new FileReader();
				reader.onload = function() {
					window[globalVar] = reader.result;
					var preview = document.getElementById(previewId);
					var placeholder = document.getElementById(placeholderId);
					var removeBtn = document.getElementById(removeBtnId);

					preview.src = window[globalVar];
					preview.classList.remove('hidden');
					placeholder.classList.add('hidden');
					removeBtn.disabled = false;
					updatePreview();
					checkForChanges();
				};
				reader.readAsDataURL(file);
			};

			// Remove dark login right side image
			window.removeLoginRightSideDark = function() {
				window._loginRightSideBase64Dark = 'REMOVE';
				document.getElementById('loginRightSideDarkPreview').classList.add('hidden');
				document.getElementById('loginRightSideDarkPlaceholder').classList.remove('hidden');
				document.getElementById('loginRightSideDarkUpload').value = '';
				document.getElementById('removeLoginRightSideDark').disabled = true;
				document.getElementById('loginRightSideDarkHelpText').textContent = 'PNG, JPG, SVG, GIF, or WebP. Max 500KB.';
				updatePreview();
				checkForChanges();
			};

			// Dark gradient preview
			window.updateDarkGradientPreview = function() {
				var primaryColor = config.dataset.primaryColor || '#8040BF';
				var fallbackColor = config.dataset.primaryColor || '#8040BF';
				var color1Text = document.getElementById('gradientColor1DarkText').value;
				var color2Text = document.getElementById('gradientColor2DarkText').value;
				var color1 = color1Text || primaryColor;
				var color2 = color2Text || fallbackColor;
				var direction = document.getElementById('gradientDirectionDark').value;
				var gradient = 'linear-gradient(' + direction + ', ' + color1 + ', ' + color2 + ')';
				document.getElementById('gradientPreviewDark').style.background = gradient;
				if (color1Text || color2Text) {
					window._gradientValueDark = gradient;
				}
				updatePreview();
			};

			function checkForChanges() {
				var saveButton = document.getElementById('saveButton');
				var current = {
					enabled: document.getElementById('oidcEnabled').checked ? 'true' : 'false',
					provider_name: document.getElementById('providerName') ? document.getElementById('providerName').value : '',
					issuer_url: document.getElementById('issuerUrl') ? document.getElementById('issuerUrl').value : '',
					client_id: document.getElementById('clientId') ? document.getElementById('clientId').value : '',
					client_secret: document.getElementById('clientSecret') ? document.getElementById('clientSecret').value : '',
					scopes: document.getElementById('scopes') ? document.getElementById('scopes').value : '',
					login_title: document.getElementById('loginTitle') ? document.getElementById('loginTitle').value : '',
					login_subtitle: document.getElementById('loginSubtitle') ? document.getElementById('loginSubtitle').value : '',
					gradient_color1: document.getElementById('gradientColor1Text') ? document.getElementById('gradientColor1Text').value : '',
					gradient_color2: document.getElementById('gradientColor2Text') ? document.getElementById('gradientColor2Text').value : '',
					gradient_direction: document.getElementById('gradientDirection') ? document.getElementById('gradientDirection').value : '',
					gradient_color1_dark: document.getElementById('gradientColor1DarkText') ? document.getElementById('gradientColor1DarkText').value : '',
					gradient_color2_dark: document.getElementById('gradientColor2DarkText') ? document.getElementById('gradientColor2DarkText').value : '',
					gradient_direction_dark: document.getElementById('gradientDirectionDark') ? document.getElementById('gradientDirectionDark').value : ''
				};
				var saved = {
					enabled: config.dataset.enabled || 'false',
					provider_name: config.dataset.providerName || '',
					issuer_url: config.dataset.issuerUrl || '',
					client_id: config.dataset.clientId || '',
					client_secret: '',
					scopes: config.dataset.scopes || '',
					login_title: config.dataset.loginTitle || '',
					login_subtitle: config.dataset.loginSubtitle || '',
					gradient_color1: config.dataset.gradientColor1 || '',
					gradient_color2: config.dataset.gradientColor2 || '',
					gradient_direction: config.dataset.gradientDirection || '',
					gradient_color1_dark: config.dataset.gradientColor1Dark || '',
					gradient_color2_dark: config.dataset.gradientColor2Dark || '',
					gradient_direction_dark: config.dataset.gradientDirectionDark || ''
				};
				var hasChanges = Object.keys(current).some(function(k) { return current[k] !== saved[k]; });
				if (!hasChanges) {
					if (window._loginRightSideBase64 && window._loginRightSideBase64 !== '') hasChanges = true;
					if (window._loginRightSideBase64Dark && window._loginRightSideBase64Dark !== '') hasChanges = true;
				}
				saveButton.disabled = !hasChanges;
			}

			window.loginCheckForChanges = function() {
				checkForChanges();
			};

			// Initialize dark gradient preview
			if (document.getElementById('gradientColor1Dark')) {
				var initialDarkGradient = config.dataset.loginRightSideGradientDark || '';
				if (initialDarkGradient) {
					window._gradientValueDark = initialDarkGradient;
				}
				updateDarkGradientPreview();
			}

			// Shared gradient helper functions
			window.handleGradientPickerInput = function(pickerId, textId, updateFn) {
				document.getElementById(textId).value = document.getElementById(pickerId).value.toUpperCase();
				updateFn();
			};

			window.handleGradientTextInput = function(textId, pickerId, fallbackColor, updateFn) {
				var value = document.getElementById(textId).value;
				if (value === '') {
					document.getElementById(pickerId).value = fallbackColor;
					updateFn();
				} else if (/^#[0-9A-Fa-f]{6}$/.test(value)) {
					document.getElementById(pickerId).value = value;
					updateFn();
				}
			};

			// Initialize gradient preview on page load
			if (document.getElementById('gradientColor1')) {
				// Check if a gradient was initially set (both text fields will have values from server)
				var initialColor1Text = document.getElementById('gradientColor1Text').value;
				var initialColor2Text = document.getElementById('gradientColor2Text').value;
				var initialGradient = config.dataset.loginRightSideGradient || '';

				// If there's an existing gradient, set up the state
				if (initialGradient && (initialColor1Text || initialColor2Text)) {
					window._gradientValue = initialGradient;
				}
				// Update the preview (will use text values or fall back to primary color)
				updateGradientPreview();
			}

			// Initialize preview on page load
			updatePreview();
		})();
	</script>
}
