package pages

import (
	"github.com/powertoolsdev/mono/exp/installer/app/internal/models"
	"github.com/powertoolsdev/mono/exp/installer/app/internal/views/vendorui"
)

// ThemeSettingsPageProps for the theme settings page
type ThemeSettingsPageProps struct {
	vendorui.LayoutProps
	Theme *models.AppTheme
}

// ThemeSettingsPage renders the theme settings page
templ ThemeSettingsPage(props ThemeSettingsPageProps) {
	@vendorui.Layout(props.LayoutProps) {
		<div class="max-w-6xl mx-auto">
			<h2 class="text-2xl font-semibold text-cool-grey-900 dark:text-white mb-6">Theme Settings</h2>
			<p class="text-cool-grey-600 dark:text-cool-grey-400 mb-6">Customize the appearance of the customer portal. These settings apply globally to all customers.</p>
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
				<div class="space-y-6">
					@brandingSection(props.Theme)
					@colorsSection(props.Theme)
					@typographySection(props.Theme)
					@supportSection(props.Theme)
					@saveSection(props.PrimaryColor)
				</div>
				@livePreviewSection(props.Theme)
			</div>
		</div>
		<!-- Config data for JavaScript -->
		<div
			id="theme-settings-config"
			class="hidden"
			data-base-path={ props.BasePath }
			data-logo-base64={ props.Theme.LogoBase64 }
			data-heading-font-base64={ props.Theme.HeadingFontBase64 }
			data-body-font-base64={ props.Theme.BodyFontBase64 }
			data-heading-font={ props.Theme.HeadingFont }
			data-body-font={ props.Theme.BodyFont }
		></div>
		@themeSettingsScript()
	}
}

templ brandingSection(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Branding</h3>
		<div class="mb-6">
			<label class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-2">Logo</label>
			<div class="flex items-center space-x-4">
				<div class="flex-shrink-0">
					if theme.LogoBase64 != "" {
						<img id="logoPreview" src={ theme.LogoBase64 } alt="Logo preview" class="h-12 w-auto max-w-32 object-contain border border-cool-grey-200 dark:border-dark-grey-600 rounded"/>
					} else {
						<img id="logoPreview" src="" alt="Logo preview" class="h-12 w-auto max-w-32 object-contain border border-cool-grey-200 dark:border-dark-grey-600 rounded hidden"/>
					}
					<div
						id="logoPlaceholder"
						class={ "h-12 w-20 bg-cool-grey-100 dark:bg-dark-grey-700 border border-cool-grey-200 dark:border-dark-grey-600 rounded flex items-center justify-center",
							templ.KV("hidden", theme.LogoBase64 != "") }
					>
						<span class="text-cool-grey-400 dark:text-cool-grey-500 text-xs">No logo</span>
					</div>
				</div>
				<div class="flex-1">
					<input
						type="file"
						id="logoUpload"
						accept="image/png,image/jpeg,image/svg+xml,image/gif"
						class="block w-full text-sm text-cool-grey-500 dark:text-cool-grey-400 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-sm file:font-medium file:bg-primary-50 dark:file:bg-primary-900/30 file:text-primary-700 dark:file:text-primary-300 hover:file:bg-primary-100 dark:hover:file:bg-primary-900/50"
					/>
				</div>
			</div>
			<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">PNG, JPG, SVG, or GIF. Max 500KB.</p>
			if theme.LogoBase64 != "" {
				<button type="button" id="removeLogo" onclick="removeLogo()" class="mt-2 text-xs text-red-600 hover:text-red-800">
					Remove logo
				</button>
			}
		</div>
	</div>
}

func getColorValue(color, defaultColor string) string {
	if color != "" {
		return color
	}
	return defaultColor
}

templ colorsSection(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Colors</h3>
		<div class="mb-6">
			<label for="primaryColor" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">Primary Color</label>
			<div class="flex items-center space-x-3">
				<input
					type="color"
					id="primaryColor"
					value={ getColorValue(theme.PrimaryColor, "#8040BF") }
					class="h-10 w-14 rounded border border-cool-grey-300 dark:border-dark-grey-500 cursor-pointer"
				/>
				<input
					type="text"
					id="primaryColorText"
					value={ getColorValue(theme.PrimaryColor, "#8040BF") }
					class="flex-1 px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-800 dark:text-white rounded-md uppercase focus:ring-2 focus:ring-primary-400 focus:border-primary-600"
					placeholder="#8040BF"
					pattern="^#[0-9A-Fa-f]{6}$"
				/>
			</div>
			<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Used for navigation bar and primary buttons.</p>
		</div>
		<div>
			<label for="secondaryColor" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">Secondary Color</label>
			<div class="flex items-center space-x-3">
				<input
					type="color"
					id="secondaryColor"
					value={ getColorValue(theme.SecondaryColor, "#8040BF") }
					class="h-10 w-14 rounded border border-cool-grey-300 dark:border-dark-grey-500 cursor-pointer"
				/>
				<input
					type="text"
					id="secondaryColorText"
					value={ getColorValue(theme.SecondaryColor, "#8040BF") }
					class="flex-1 px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-800 dark:text-white rounded-md uppercase focus:ring-2 focus:ring-primary-400 focus:border-primary-600"
					placeholder="#8040BF"
					pattern="^#[0-9A-Fa-f]{6}$"
				/>
			</div>
			<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Used for links, accents, and secondary elements.</p>
		</div>
	</div>
}

templ typographySection(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Typography</h3>
		@headingFontSection(theme)
		@bodyFontSection(theme)
	</div>
}

templ headingFontSection(theme *models.AppTheme) {
	<div class="mb-6">
		<label class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-2">Heading Font</label>
		<div class="flex space-x-4 mb-3">
			<label class="inline-flex items-center cursor-pointer">
				<input
					type="radio"
					name="headingFontSource"
					value="google"
					if theme.HeadingFontBase64 == "" {
						checked
					}
					class="form-radio h-4 w-4 text-primary-600"
					onchange="toggleHeadingFontSource('google')"
				/>
				<span class="ml-2 text-sm text-cool-grey-700 dark:text-cool-grey-300">Google Fonts</span>
			</label>
			<label class="inline-flex items-center cursor-pointer">
				<input
					type="radio"
					name="headingFontSource"
					value="custom"
					if theme.HeadingFontBase64 != "" {
						checked
					}
					class="form-radio h-4 w-4 text-primary-600"
					onchange="toggleHeadingFontSource('custom')"
				/>
				<span class="ml-2 text-sm text-cool-grey-700 dark:text-cool-grey-300">Upload Custom</span>
			</label>
		</div>
		<div id="headingFontGoogle" class={ templ.KV("hidden", theme.HeadingFontBase64 != "") }>
			@fontSelect("headingFont", theme.HeadingFont)
		</div>
		<div id="headingFontCustom" class={ templ.KV("hidden", theme.HeadingFontBase64 == "") }>
			<input
				type="file"
				id="headingFontUpload"
				accept=".woff2,.woff"
				class="block w-full text-sm text-cool-grey-500 dark:text-cool-grey-400 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-sm file:font-medium file:bg-primary-50 dark:file:bg-primary-900/30 file:text-primary-700 dark:file:text-primary-300 hover:file:bg-primary-100 dark:hover:file:bg-primary-900/50"
			/>
			<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">WOFF2 or WOFF format. Max 200KB.</p>
			<div id="headingFontCustomStatus" class={ "mt-2 flex items-center text-sm text-green-600", templ.KV("hidden", theme.HeadingFontBase64 == "") }>
				@checkIcon()
				<span id="headingFontName" class="truncate">
					if theme.HeadingFontBase64 != "" && theme.HeadingFont != "" {
						{ theme.HeadingFont }
					} else {
						Custom font
					}
				</span>
				<button type="button" onclick="removeCustomHeadingFont()" class="ml-3 text-red-600 hover:text-red-800 text-xs flex-shrink-0">Remove</button>
			</div>
		</div>
		<p class="mt-2 text-xs text-cool-grey-500 dark:text-cool-grey-400">Used for titles, headings, and bold text.</p>
	</div>
}

templ bodyFontSection(theme *models.AppTheme) {
	<div>
		<label class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-2">Body Font</label>
		<div class="flex space-x-4 mb-3">
			<label class="inline-flex items-center cursor-pointer">
				<input
					type="radio"
					name="bodyFontSource"
					value="google"
					if theme.BodyFontBase64 == "" {
						checked
					}
					class="form-radio h-4 w-4 text-primary-600"
					onchange="toggleBodyFontSource('google')"
				/>
				<span class="ml-2 text-sm text-cool-grey-700 dark:text-cool-grey-300">Google Fonts</span>
			</label>
			<label class="inline-flex items-center cursor-pointer">
				<input
					type="radio"
					name="bodyFontSource"
					value="custom"
					if theme.BodyFontBase64 != "" {
						checked
					}
					class="form-radio h-4 w-4 text-primary-600"
					onchange="toggleBodyFontSource('custom')"
				/>
				<span class="ml-2 text-sm text-cool-grey-700 dark:text-cool-grey-300">Upload Custom</span>
			</label>
		</div>
		<div id="bodyFontGoogle" class={ templ.KV("hidden", theme.BodyFontBase64 != "") }>
			@fontSelect("bodyFont", theme.BodyFont)
		</div>
		<div id="bodyFontCustom" class={ templ.KV("hidden", theme.BodyFontBase64 == "") }>
			<input
				type="file"
				id="bodyFontUpload"
				accept=".woff2,.woff"
				class="block w-full text-sm text-cool-grey-500 dark:text-cool-grey-400 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-sm file:font-medium file:bg-primary-50 dark:file:bg-primary-900/30 file:text-primary-700 dark:file:text-primary-300 hover:file:bg-primary-100 dark:hover:file:bg-primary-900/50"
			/>
			<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">WOFF2 or WOFF format. Max 200KB.</p>
			<div id="bodyFontCustomStatus" class={ "mt-2 flex items-center text-sm text-green-600", templ.KV("hidden", theme.BodyFontBase64 == "") }>
				@checkIcon()
				<span id="bodyFontName" class="truncate">
					if theme.BodyFontBase64 != "" && theme.BodyFont != "" {
						{ theme.BodyFont }
					} else {
						Custom font
					}
				</span>
				<button type="button" onclick="removeCustomBodyFont()" class="ml-3 text-red-600 hover:text-red-800 text-xs flex-shrink-0">Remove</button>
			</div>
		</div>
		<p class="mt-2 text-xs text-cool-grey-500 dark:text-cool-grey-400">Used for paragraphs and regular text.</p>
	</div>
}

templ fontSelect(id, selectedFont string) {
	<select
		id={ id }
		class="block w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-800 dark:text-white rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600"
	>
		<option value="">System Default</option>
		<optgroup label="Modern Sans-Serif">
			@fontOption("Inter", selectedFont)
			@fontOption("DM Sans", selectedFont)
			@fontOption("Plus Jakarta Sans", selectedFont)
			@fontOption("Outfit", selectedFont)
			@fontOption("Figtree", selectedFont)
			@fontOption("Manrope", selectedFont)
			@fontOption("Space Grotesk", selectedFont)
		</optgroup>
		<optgroup label="Classic Sans-Serif">
			@fontOption("Roboto", selectedFont)
			@fontOption("Open Sans", selectedFont)
			@fontOption("Lato", selectedFont)
			@fontOption("Montserrat", selectedFont)
			@fontOption("Source Sans 3", selectedFont)
			@fontOption("Work Sans", selectedFont)
			@fontOption("Raleway", selectedFont)
		</optgroup>
		<optgroup label="Friendly &amp; Rounded">
			@fontOption("Poppins", selectedFont)
			@fontOption("Nunito", selectedFont)
			@fontOption("Quicksand", selectedFont)
			@fontOption("Lexend", selectedFont)
			@fontOption("Mulish", selectedFont)
		</optgroup>
		<optgroup label="Professional">
			@fontOption("IBM Plex Sans", selectedFont)
			@fontOption("Red Hat Display", selectedFont)
			@fontOption("Archivo", selectedFont)
		</optgroup>
		<optgroup label="Serif">
			@fontOption("Merriweather", selectedFont)
			@fontOption("Lora", selectedFont)
			@fontOption("Playfair Display", selectedFont)
		</optgroup>
	</select>
}

templ fontOption(fontName, selectedFont string) {
	<option
		value={ fontName }
		if fontName == selectedFont {
			selected
		}
	>{ fontName }</option>
}

templ checkIcon() {
	<svg class="w-4 h-4 mr-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
		<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
	</svg>
}

templ supportSection(theme *models.AppTheme) {
	<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Support</h3>
		<div>
			<label for="supportContact" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">Support Contact</label>
			<input
				type="text"
				id="supportContact"
				value={ theme.SupportContact }
				placeholder="support@yourcompany.com or https://support.yourcompany.com"
				class="block w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-800 dark:text-white rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600"
			/>
			<p class="mt-1 text-xs text-cool-grey-500 dark:text-cool-grey-400">Email address or URL shown to customers for help.</p>
		</div>
	</div>
}

templ saveSection(primaryColor string) {
	<div class="flex space-x-3">
		<button
			type="button"
			id="saveButton"
			onclick="saveSettings()"
			class={ "flex-1 inline-flex items-center justify-center px-6 py-3 text-base rounded-md font-medium text-white",
				templ.KV("bg-theme-primary hover:bg-theme-primary-hover", primaryColor != ""),
				templ.KV("bg-primary-600 hover:bg-primary-700", primaryColor == "") }
			if primaryColor != "" {
				style={ "background-color: " + primaryColor }
			}
		>
			Save Changes
		</button>
	</div>
	<div id="successMessage" class="hidden p-4 bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-800 text-green-700 dark:text-green-300 rounded-lg">
		Settings saved successfully!
	</div>
	<div id="errorMessage" class="hidden p-4 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-300 rounded-lg"></div>
}

templ livePreviewSection(theme *models.AppTheme) {
	<div class="lg:sticky lg:top-4">
		<div class="bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
			<h3 class="text-lg font-semibold mb-4 text-cool-grey-800 dark:text-white">Live Preview</h3>
			<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-4">This is how your customer portal will appear.</p>
			<div id="previewContainer" class="border border-cool-grey-300 dark:border-dark-grey-500 rounded-lg overflow-hidden">
				<nav
					id="previewHeader"
					class="text-white p-4"
					style={ "background-color: " + getColorValue(theme.PrimaryColor, "#8040BF") }
				>
					<div class="flex justify-between items-center">
						<div class="flex items-center space-x-3">
							if theme.LogoBase64 != "" {
								<img id="previewLogo" src={ theme.LogoBase64 } alt="Logo" class="h-8 w-auto max-w-32 object-contain"/>
							} else {
								<img id="previewLogo" src="" alt="Logo" class="h-8 w-auto max-w-32 object-contain hidden"/>
							}
							<span
								id="previewTitle"
								class="text-xl font-bold"
								if theme.HeadingFont != "" {
									style={ "font-family: '" + theme.HeadingFont + "', ui-sans-serif, system-ui, sans-serif;" }
								}
							>My Installs</span>
						</div>
						<span
							class="text-sm opacity-75"
							if theme.BodyFont != "" {
								style={ "font-family: '" + theme.BodyFont + "', ui-sans-serif, system-ui, sans-serif;" }
							}
						>customer@example.com</span>
					</div>
				</nav>
				<div class="p-4 bg-cool-grey-50 dark:bg-dark-grey-800">
					<div class="bg-white dark:bg-dark-grey-900 p-4 rounded shadow-sm">
						<h4
							id="previewHeading"
							class="font-semibold text-cool-grey-900 dark:text-white mb-2"
							if theme.HeadingFont != "" {
								style={ "font-family: '" + theme.HeadingFont + "', ui-sans-serif, system-ui, sans-serif;" }
							}
						>Sample Install</h4>
						<p
							id="previewBody"
							class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-3"
							if theme.BodyFont != "" {
								style={ "font-family: '" + theme.BodyFont + "', ui-sans-serif, system-ui, sans-serif;" }
							}
						>This is an example of how content will appear.</p>
						<a
							id="previewLink"
							href="#"
							class="text-sm hover:underline"
							style={ "color: " + getColorValue(theme.SecondaryColor, "#8040BF") + ";" + previewBodyFontStyle(theme.BodyFont) }
						>View details &rarr;</a>
					</div>
				</div>
				<div
					id="previewFooter"
					class={ "p-3 bg-cool-grey-100 dark:bg-dark-grey-700 border-t border-cool-grey-200 dark:border-dark-grey-600 text-center text-sm text-cool-grey-600 dark:text-cool-grey-400",
						templ.KV("hidden", theme.SupportContact == "") }
					if theme.BodyFont != "" {
						style={ "font-family: '" + theme.BodyFont + "', ui-sans-serif, system-ui, sans-serif;" }
					}
				>
					Need help? Contact <a id="previewSupportLink" href="#" class="hover:underline" style={ "color: " + getColorValue(theme.SecondaryColor, "#8040BF") }>support</a>
				</div>
			</div>
		</div>
	</div>
}

func previewBodyFontStyle(bodyFont string) string {
	if bodyFont != "" {
		return " font-family: '" + bodyFont + "', ui-sans-serif, system-ui, sans-serif;"
	}
	return ""
}

templ themeSettingsScript() {
	<script>
		(function() {
			var config = document.getElementById('theme-settings-config');
			var basePath = config.dataset.basePath;
			var logoBase64 = config.dataset.logoBase64 || '';
			var headingFontBase64 = config.dataset.headingFontBase64 || '';
			var bodyFontBase64 = config.dataset.bodyFontBase64 || '';
			var customHeadingFontName = config.dataset.headingFont || '';
			var customBodyFontName = config.dataset.bodyFont || '';
			var initialLogoBase64 = logoBase64;
			var initialHeadingFontBase64 = headingFontBase64;
			var initialBodyFontBase64 = bodyFontBase64;

			function getCookie(name) {
				var value = '; ' + document.cookie;
				var parts = value.split('; ' + name + '=');
				if (parts.length === 2) return parts.pop().split(';').shift();
				return null;
			}

			// Color picker sync
			document.getElementById('primaryColor').addEventListener('input', function(e) {
				document.getElementById('primaryColorText').value = e.target.value.toUpperCase();
				updatePreview();
			});

			document.getElementById('primaryColorText').addEventListener('input', function(e) {
				var value = e.target.value;
				if (/^#[0-9A-Fa-f]{6}$/.test(value)) {
					document.getElementById('primaryColor').value = value;
					updatePreview();
				}
			});

			document.getElementById('secondaryColor').addEventListener('input', function(e) {
				document.getElementById('secondaryColorText').value = e.target.value.toUpperCase();
				updatePreview();
			});

			document.getElementById('secondaryColorText').addEventListener('input', function(e) {
				var value = e.target.value;
				if (/^#[0-9A-Fa-f]{6}$/.test(value)) {
					document.getElementById('secondaryColor').value = value;
					updatePreview();
				}
			});

			document.getElementById('supportContact').addEventListener('input', updatePreview);
			document.getElementById('headingFont').addEventListener('change', function(e) {
				loadGoogleFont(e.target.value);
				updatePreview();
			});
			document.getElementById('bodyFont').addEventListener('change', function(e) {
				loadGoogleFont(e.target.value);
				updatePreview();
			});

			var loadedFonts = {};
			function loadGoogleFont(fontFamily) {
				if (!fontFamily || loadedFonts[fontFamily]) return;
				var link = document.createElement('link');
				link.rel = 'stylesheet';
				link.href = 'https://fonts.googleapis.com/css2?family=' + encodeURIComponent(fontFamily) + ':wght@400;500;600;700&display=swap';
				document.head.appendChild(link);
				loadedFonts[fontFamily] = true;
			}

			// Load initial fonts
			if (customHeadingFontName && !headingFontBase64) loadGoogleFont(customHeadingFontName);
			if (customBodyFontName && !bodyFontBase64) loadGoogleFont(customBodyFontName);

			window.toggleHeadingFontSource = function(source) {
				var googleSection = document.getElementById('headingFontGoogle');
				var customSection = document.getElementById('headingFontCustom');
				if (source === 'google') {
					googleSection.classList.remove('hidden');
					customSection.classList.add('hidden');
					headingFontBase64 = '';
					document.getElementById('headingFontCustomStatus').classList.add('hidden');
				} else {
					googleSection.classList.add('hidden');
					customSection.classList.remove('hidden');
				}
				updatePreview();
			};

			window.toggleBodyFontSource = function(source) {
				var googleSection = document.getElementById('bodyFontGoogle');
				var customSection = document.getElementById('bodyFontCustom');
				if (source === 'google') {
					googleSection.classList.remove('hidden');
					customSection.classList.add('hidden');
					bodyFontBase64 = '';
					document.getElementById('bodyFontCustomStatus').classList.add('hidden');
				} else {
					googleSection.classList.add('hidden');
					customSection.classList.remove('hidden');
				}
				updatePreview();
			};

			document.getElementById('headingFontUpload').addEventListener('change', function(e) {
				var file = e.target.files[0];
				if (!file) return;
				if (file.size > 200 * 1024) {
					showToast('Font file must be under 200KB', 'error');
					e.target.value = '';
					return;
				}
				var validExtensions = ['.woff2', '.woff'];
				var fileExt = file.name.toLowerCase().slice(file.name.lastIndexOf('.'));
				if (validExtensions.indexOf(fileExt) === -1) {
					showToast('Please upload a WOFF2 or WOFF font file', 'error');
					e.target.value = '';
					return;
				}
				customHeadingFontName = file.name.replace(/\.(woff2?|woff)$/i, '');
				var reader = new FileReader();
				reader.onload = function() {
					headingFontBase64 = reader.result;
					document.getElementById('headingFontCustomStatus').classList.remove('hidden');
					document.getElementById('headingFontName').textContent = customHeadingFontName;
					loadCustomFontPreview(headingFontBase64, 'heading');
					updatePreview();
				};
				reader.readAsDataURL(file);
			});

			document.getElementById('bodyFontUpload').addEventListener('change', function(e) {
				var file = e.target.files[0];
				if (!file) return;
				if (file.size > 200 * 1024) {
					showToast('Font file must be under 200KB', 'error');
					e.target.value = '';
					return;
				}
				var validExtensions = ['.woff2', '.woff'];
				var fileExt = file.name.toLowerCase().slice(file.name.lastIndexOf('.'));
				if (validExtensions.indexOf(fileExt) === -1) {
					showToast('Please upload a WOFF2 or WOFF font file', 'error');
					e.target.value = '';
					return;
				}
				customBodyFontName = file.name.replace(/\.(woff2?|woff)$/i, '');
				var reader = new FileReader();
				reader.onload = function() {
					bodyFontBase64 = reader.result;
					document.getElementById('bodyFontCustomStatus').classList.remove('hidden');
					document.getElementById('bodyFontName').textContent = customBodyFontName;
					loadCustomFontPreview(bodyFontBase64, 'body');
					updatePreview();
				};
				reader.readAsDataURL(file);
			});

			window.removeCustomHeadingFont = function() {
				headingFontBase64 = 'REMOVE';
				customHeadingFontName = '';
				document.getElementById('headingFontUpload').value = '';
				document.getElementById('headingFontCustomStatus').classList.add('hidden');
				document.getElementById('headingFontName').textContent = 'Custom font';
				updatePreview();
			};

			window.removeCustomBodyFont = function() {
				bodyFontBase64 = 'REMOVE';
				customBodyFontName = '';
				document.getElementById('bodyFontUpload').value = '';
				document.getElementById('bodyFontCustomStatus').classList.add('hidden');
				document.getElementById('bodyFontName').textContent = 'Custom font';
				updatePreview();
			};

			function loadCustomFontPreview(base64Data, fontType) {
				var fontName = fontType === 'heading' ? 'PreviewHeading' : 'PreviewBody';
				var styleId = 'preview-font-' + fontName;
				var oldStyle = document.getElementById(styleId);
				if (oldStyle) oldStyle.remove();
				var format = base64Data.indexOf('woff2') !== -1 ? 'woff2' : 'woff';
				var style = document.createElement('style');
				style.id = styleId;
				style.textContent = '@font-face { font-family: "' + fontName + '"; src: url(' + base64Data + ') format("' + format + '"); font-display: swap; }';
				document.head.appendChild(style);
			}

			// Load initial custom fonts
			if (headingFontBase64) loadCustomFontPreview(headingFontBase64, 'heading');
			if (bodyFontBase64) loadCustomFontPreview(bodyFontBase64, 'body');
			if (headingFontBase64 || bodyFontBase64) setTimeout(updatePreview, 100);

			document.getElementById('logoUpload').addEventListener('change', function(e) {
				var file = e.target.files[0];
				if (!file) return;
				if (file.size > 500 * 1024) {
					showToast('Logo file must be under 500KB', 'error');
					e.target.value = '';
					return;
				}
				var validTypes = ['image/png', 'image/jpeg', 'image/svg+xml', 'image/gif'];
				if (validTypes.indexOf(file.type) === -1) {
					showToast('Please upload a PNG, JPG, SVG, or GIF image', 'error');
					e.target.value = '';
					return;
				}
				var reader = new FileReader();
				reader.onload = function() {
					logoBase64 = reader.result;
					var preview = document.getElementById('logoPreview');
					var placeholder = document.getElementById('logoPlaceholder');
					preview.src = logoBase64;
					preview.classList.remove('hidden');
					placeholder.classList.add('hidden');
					var removeBtn = document.getElementById('removeLogo');
					if (!removeBtn) {
						removeBtn = document.createElement('button');
						removeBtn.id = 'removeLogo';
						removeBtn.type = 'button';
						removeBtn.className = 'mt-2 text-xs text-red-600 hover:text-red-800';
						removeBtn.textContent = 'Remove logo';
						removeBtn.onclick = removeLogo;
						placeholder.parentElement.parentElement.appendChild(removeBtn);
					}
					removeBtn.classList.remove('hidden');
					updatePreview();
				};
				reader.readAsDataURL(file);
			});

			window.removeLogo = function() {
				logoBase64 = 'REMOVE';
				document.getElementById('logoPreview').classList.add('hidden');
				document.getElementById('logoPlaceholder').classList.remove('hidden');
				document.getElementById('logoUpload').value = '';
				var removeBtn = document.getElementById('removeLogo');
				if (removeBtn) removeBtn.classList.add('hidden');
				updatePreview();
			};

			function updatePreview() {
				var primaryColor = document.getElementById('primaryColor').value;
				var secondaryColor = document.getElementById('secondaryColor').value;
				var supportContact = document.getElementById('supportContact').value;
				var headingFont = document.getElementById('headingFont').value;
				var bodyFont = document.getElementById('bodyFont').value;

				document.getElementById('previewHeader').style.backgroundColor = primaryColor;

				var previewLogo = document.getElementById('previewLogo');
				if (logoBase64 && logoBase64 !== 'REMOVE') {
					previewLogo.src = logoBase64;
					previewLogo.classList.remove('hidden');
				} else {
					previewLogo.classList.add('hidden');
				}

				document.getElementById('previewLink').style.color = secondaryColor;
				document.getElementById('previewSupportLink').style.color = secondaryColor;

				var previewFooter = document.getElementById('previewFooter');
				if (supportContact) {
					previewFooter.classList.remove('hidden');
				} else {
					previewFooter.classList.add('hidden');
				}

				var headingFontStyle;
				if (headingFontBase64 && headingFontBase64 !== 'REMOVE' && headingFontBase64 !== '') {
					headingFontStyle = "'PreviewHeading', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif";
				} else if (headingFont) {
					headingFontStyle = "'" + headingFont + "', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif";
				} else {
					headingFontStyle = 'ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif';
				}
				document.getElementById('previewTitle').style.fontFamily = headingFontStyle;
				document.getElementById('previewHeading').style.fontFamily = headingFontStyle;

				var bodyFontStyle;
				if (bodyFontBase64 && bodyFontBase64 !== 'REMOVE' && bodyFontBase64 !== '') {
					bodyFontStyle = "'PreviewBody', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif";
				} else if (bodyFont) {
					bodyFontStyle = "'" + bodyFont + "', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif";
				} else {
					bodyFontStyle = 'ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif';
				}
				document.getElementById('previewBody').style.fontFamily = bodyFontStyle;
				document.getElementById('previewLink').style.fontFamily = bodyFontStyle;
				document.getElementById('previewFooter').style.fontFamily = bodyFontStyle;
			}

			window.saveSettings = async function() {
				var saveButton = document.getElementById('saveButton');
				var successMessage = document.getElementById('successMessage');
				var errorMessage = document.getElementById('errorMessage');

				saveButton.textContent = 'Saving...';
				saveButton.disabled = true;
				successMessage.classList.add('hidden');
				errorMessage.classList.add('hidden');

				var headingFontSource = document.querySelector('input[name="headingFontSource"]:checked').value;
				var bodyFontSource = document.querySelector('input[name="bodyFontSource"]:checked').value;

				var headingFontName = document.getElementById('headingFont').value;
				var bodyFontName = document.getElementById('bodyFont').value;

				if (headingFontSource === 'custom' && headingFontBase64 && headingFontBase64 !== 'REMOVE') {
					headingFontName = customHeadingFontName;
				}
				if (bodyFontSource === 'custom' && bodyFontBase64 && bodyFontBase64 !== 'REMOVE') {
					bodyFontName = customBodyFontName;
				}

				var formData = {
					primary_color: document.getElementById('primaryColor').value,
					secondary_color: document.getElementById('secondaryColor').value,
					support_contact: document.getElementById('supportContact').value,
					heading_font: headingFontName,
					body_font: bodyFontName
				};

				if (logoBase64 && logoBase64 !== initialLogoBase64) {
					formData.logo_base64 = logoBase64;
				}

				if (headingFontBase64 === 'REMOVE') {
					formData.heading_font_base64 = 'REMOVE';
				} else if (headingFontBase64 && headingFontBase64 !== initialHeadingFontBase64) {
					formData.heading_font_base64 = headingFontBase64;
				}

				if (bodyFontBase64 === 'REMOVE') {
					formData.body_font_base64 = 'REMOVE';
				} else if (bodyFontBase64 && bodyFontBase64 !== initialBodyFontBase64) {
					formData.body_font_base64 = bodyFontBase64;
				}

				try {
					var token = getCookie('jwt');
					var response = await fetch(basePath + '/settings', {
						method: 'PUT',
						headers: {
							'Content-Type': 'application/json',
							'Authorization': 'Bearer ' + token
						},
						body: JSON.stringify(formData)
					});

					var data = await response.json();

					if (response.ok) {
						successMessage.classList.remove('hidden');
						setTimeout(function() { successMessage.classList.add('hidden'); }, 3000);
					} else {
						errorMessage.textContent = data.error || 'Failed to save settings';
						errorMessage.classList.remove('hidden');
					}
				} catch (error) {
					errorMessage.textContent = 'Network error. Please try again.';
					errorMessage.classList.remove('hidden');
				}

				saveButton.textContent = 'Save Changes';
				saveButton.disabled = false;
			};
		})();
	</script>
}
