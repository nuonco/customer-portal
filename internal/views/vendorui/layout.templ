package vendorui

import (
	"os"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui/components"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/vendorui/partials"
)

func isLiveReload() bool {
	return os.Getenv("LIVE_RELOAD") == "true"
}

// LayoutProps contains all data needed for the vendor layout
type LayoutProps struct {
	Title       string
	ActivePage  string // "orgs" | "install-links" | "apps"
	User        *models.User
	CurrentOrg  *models.NuonOrg
	Orgs        []models.NuonOrg
	Breadcrumbs []partials.Breadcrumb
	BasePath    string

	// Entity title bar
	EntityTitle   string
	EntityID      string
	EntityActions []partials.EntityAction

	// Theme colors (computed from theme settings)
	PrimaryColor     string
	PrimaryColorDark string
	HeadingFont        string
	BodyFont           string
	HeadingFontBase64  string
	BodyFontBase64     string
	LogoBase64         string

	// Portal URL components (for org dropdown link)
	PortalScheme     string // e.g., "https://"
	PortalBaseDomain string // e.g., "portal.nuon.co"
	DashboardURL     string // e.g., "https://app.nuon.co"

	// Org status (live check against Nuon API)
	OrgStatus        string // "active" | "error"
	OrgStatusMessage string // e.g., "Connected" or "Unable to reach Nuon API"

	// Inline error for Nuon API failures (token expired, unreachable, etc.)
	NuonAPIError         string
	NuonAPIShowUpdateCTA bool

	// Asset paths (cache-busted)
	CSSPath string

	// Superuser access
	IsSuperuser bool
}

// Layout renders the vendor layout with sidebar, topbar, and content area
templ Layout(props LayoutProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.Title }</title>
			<link rel="icon" type="image/svg+xml" href="/static/images/favicon-admin.svg"/>
			<!-- Stratus Design System - Vendor CSS -->
			<link href={ props.CSSPath } rel="stylesheet"/>
			<!-- Phosphor icon font (Bold weight) -->
			<link href="/static/css/phosphor-bold.css" rel="stylesheet"/>
			<!-- Dark mode and sidebar state detection - runs before page renders to prevent flash -->
			@darkModeAndSidebarScript()
			<!-- Inter font (Stratus default) -->
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
			<!-- Custom fonts via @font-face -->
			if props.HeadingFontBase64 != "" {
				@customHeadingFont(props.HeadingFontBase64)
			}
			if props.BodyFontBase64 != "" {
				@customBodyFont(props.BodyFontBase64)
			}
			<!-- HTMX for dynamic interactions -->
			<script src="https://unpkg.com/htmx.org@1.9.10"></script>
			<script src="https://unpkg.com/htmx.org@1.9.10/dist/ext/head-support.js"></script>
			<script src="https://unpkg.com/idiomorph@0.3.0/dist/idiomorph-ext.min.js"></script>
			<!-- SortableJS for drag-and-drop -->
			<script src="/static/js/sortable.min.js"></script>
			<!-- Mermaid diagram rendering -->
			<script defer src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
			<script>
				document.addEventListener('DOMContentLoaded', function() {
					mermaid.initialize({ startOnLoad: false, theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default' });
				});
			</script>
			<!-- Vendor Theme Overrides -->
			if props.PrimaryColor != "" || props.HeadingFont != "" || props.BodyFont != "" || props.HeadingFontBase64 != "" || props.BodyFontBase64 != "" {
				@themeOverrides(props)
			}
			@layoutScripts(props.BasePath)
		</head>
		<body hx-boost="true" hx-ext="head-support" hx-swap="innerHTML show:top swap:0ms settle:0ms" class="bg-cool-grey-50 dark:bg-dark-grey-900 dark:text-white overflow-hidden">
			<div class="flex h-screen overflow-hidden">
				<!-- Sidebar -->
				@partials.Sidebar(partials.SidebarProps{
					ActivePage:       props.ActivePage,
					CurrentOrg:       props.CurrentOrg,
					Orgs:             props.Orgs,
					BasePath:         props.BasePath,
					LogoBase64:       props.LogoBase64,
					PortalScheme:     props.PortalScheme,
					PortalBaseDomain: props.PortalBaseDomain,
					DashboardURL:     props.DashboardURL,
					OrgStatus:        props.OrgStatus,
					OrgStatusMessage: props.OrgStatusMessage,
				})
				<!-- Main Content Area -->
				<div class="flex-1 flex flex-col h-full">
					<!-- Topbar with Breadcrumbs -->
					@partials.Topbar(partials.TopbarProps{
						Breadcrumbs: props.Breadcrumbs,
						User:        props.User,
						BasePath:    props.BasePath,
						CurrentOrg:  props.CurrentOrg,
						Orgs:        props.Orgs,
						IsSuperuser: props.IsSuperuser,
					})
					<!-- Entity Title Bar (shown on detail pages) -->
					@partials.TitleBar(partials.TitleBarProps{
						EntityTitle:   props.EntityTitle,
						EntityID:      props.EntityID,
						EntityActions: props.EntityActions,
					})
					<!-- Page Content -->
					<main class="flex-1 flex flex-col overflow-hidden">
						if props.NuonAPIError != "" {
							<div class="mx-6 mt-4 p-4 bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 rounded-lg flex items-start gap-3">
								<div class="flex-1">
									<p class="text-sm font-medium text-red-800 dark:text-red-200">Unable to connect to Nuon API</p>
									<p class="text-sm text-red-700 dark:text-red-300 mt-0.5">{ props.NuonAPIError }</p>
								</div>
								if props.NuonAPIShowUpdateCTA && props.CurrentOrg != nil {
									<a href={ templ.SafeURL(props.BasePath + "/orgs/" + props.CurrentOrg.ID + "/connection") }
										class="text-sm font-medium text-red-700 dark:text-red-300 underline hover:text-red-900 dark:hover:text-red-100 whitespace-nowrap">
										Update connection →
									</a>
								}
							</div>
						}
						{ children... }
					</main>
				</div>
			</div>
			<!-- Toast and Modal components -->
			@components.ModalScript()
			@components.Toast()
			@components.ConfirmModal()
			@createOrgModal(props.BasePath)
			@keyboardShortcutsModal()
			<!-- Theme Settings Panel - lazy loaded via HTMX -->
			<div id="settings-panel-container"></div>
			if isLiveReload() {
				<script src="/static/js/dev-reload.js"></script>
			}
		</body>
	</html>
}

templ darkModeAndSidebarScript() {
	<script>
		(function() {
			// Check system preference for dark mode
			if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
				document.documentElement.classList.add('dark');
			}
			// Listen for system preference changes
			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
				document.documentElement.classList.toggle('dark', e.matches);
			});

			// Check sidebar cookies and apply collapsed classes to <html>
			// This prevents the flash where sidebars expand then collapse on page load
			// Classes on <html> survive Idiomorph morphs (which only touch <body>)
			var cookies = document.cookie.split(';');
			for (var i = 0; i < cookies.length; i++) {
				var cookie = cookies[i].trim();
				if (cookie.startsWith('sidebar_open=0')) {
					document.documentElement.classList.add('sidebar-collapsed');
				}
				if (cookie.startsWith('page_sidebar_open=0')) {
					document.documentElement.classList.add('page-sidebar-collapsed');
				}
			}
		})();
	</script>
}

templ customHeadingFont(base64URL string) {
	<style>
		@font-face {
			font-family: 'CustomHeading';
			src: url({ templ.SafeURL(base64URL) }) format('woff2');
			font-display: swap;
		}
	</style>
}

templ customBodyFont(base64URL string) {
	<style>
		@font-face {
			font-family: 'CustomBody';
			src: url({ templ.SafeURL(base64URL) }) format('woff2');
			font-display: swap;
		}
	</style>
}

func buildVendorThemeCSS(props LayoutProps) string {
	css := ""
	if props.PrimaryColor != "" {
		css += "--theme-primary: " + props.PrimaryColor + ";"
		css += "--theme-primary-hover: " + props.PrimaryColorDark + ";"
	}
	if props.HeadingFontBase64 != "" {
		css += "--font-heading: 'CustomHeading', 'Inter', ui-sans-serif, system-ui, sans-serif;"
	} else if props.HeadingFont != "" {
		css += "--font-heading: '" + props.HeadingFont + "', 'Inter', ui-sans-serif, system-ui, sans-serif;"
	}
	if props.BodyFontBase64 != "" {
		css += "--font-body: 'CustomBody', 'Inter', ui-sans-serif, system-ui, sans-serif;"
	} else if props.BodyFont != "" {
		css += "--font-body: '" + props.BodyFont + "', 'Inter', ui-sans-serif, system-ui, sans-serif;"
	}
	if css == "" {
		return ""
	}
	return "<style>:root{" + css + "}</style>"
}

templ themeOverrides(props LayoutProps) {
	@templ.Raw(buildVendorThemeCSS(props))
}

templ layoutScripts(basePath string) {
	<script>
		function logout() {
			// Redirect to server-side logout handler which clears both local JWT and WorkOS session
			window.location.href = "/admin/logout";
		}

		// Cookie helpers for sidebar state persistence
		function getCookie(name) {
			const value = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
			return value ? value.pop() : null;
		}

		function setCookie(name, value) {
			document.cookie = name + '=' + value + '; path=/; max-age=31536000; samesite=lax';
		}

		// Main Sidebar Toggle
		function toggleMainSidebar() {
			const sidebar = document.getElementById('main-sidebar');
			if (sidebar) {
				const isCollapsed = sidebar.classList.toggle('collapsed');
				document.documentElement.classList.toggle('sidebar-collapsed', isCollapsed);
				setCookie('sidebar_open', isCollapsed ? '0' : '1');
			}
		}

		// Page Sidebar (Sub-nav) Toggle
		function togglePageSidebar() {
			const subnav = document.getElementById('page-sidebar');
			if (subnav) {
				const isCollapsed = subnav.classList.toggle('collapsed');
				document.documentElement.classList.toggle('page-sidebar-collapsed', isCollapsed);
				setCookie('page_sidebar_open', isCollapsed ? '0' : '1');
			}
		}

		// Keyboard Shortcuts Modal
		function openKeyboardShortcutsModal() {
			openModal('keyboard-shortcuts-modal');
			const userDropdown = document.getElementById('userDropdown');
			if (userDropdown) {
				userDropdown.classList.add('hidden');
			}
		}

		function closeKeyboardShortcutsModal() {
			closeModal('keyboard-shortcuts-modal');
		}

		// Connect Org Modal
		function openCreateOrgModal() {
			const modal = document.getElementById('create-org-modal');
			openModal('create-org-modal');
			// Focus on org ID input
			const orgIdInput = document.getElementById('org-org-id');
			if (orgIdInput) {
				setTimeout(function() { orgIdInput.focus(); }, 200);
			}
			// Close user dropdown if open
			const userDropdown = document.getElementById('userDropdown');
			if (userDropdown) {
				userDropdown.classList.add('hidden');
			}
		}

		function closeCreateOrgModal() {
			closeModal('create-org-modal', function() {
				const form = document.getElementById('create-org-form');
				if (form) form.reset();
				const errorDiv = document.getElementById('create-org-error');
				if (errorDiv) errorDiv.classList.add('hidden');
			});
		}

		// Global Keyboard Shortcuts
		document.addEventListener('keydown', function(e) {
			// Alt+S = Toggle main sidebar
			if (e.altKey && !e.shiftKey && e.key.toLowerCase() === 's') {
				toggleMainSidebar();
				e.preventDefault();
				return;
			}

			// Alt+Shift+S = Toggle page sidebar
			if (e.altKey && e.shiftKey && e.key.toLowerCase() === 's') {
				togglePageSidebar();
				e.preventDefault();
				return;
			}

			// ? = Open keyboard shortcuts modal (when not typing in input)
			if (e.key === '?' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) {
				openKeyboardShortcutsModal();
				e.preventDefault();
				return;
			}

			// Escape = Close any open modal
			if (e.key === 'Escape') {
				closeKeyboardShortcutsModal();
				closeCreateOrgModal();
			}
		});

		// Initialize sidebar state from cookies on page load
		document.addEventListener('DOMContentLoaded', function() {
			if (document.documentElement.classList.contains('sidebar-collapsed')) {
				const sidebar = document.getElementById('main-sidebar');
				if (sidebar) {
					sidebar.classList.add('collapsed');
				}
			}
			if (getCookie('page_sidebar_open') === '0') {
				const subnav = document.getElementById('page-sidebar');
				if (subnav) {
					subnav.classList.add('collapsed');
				}
				document.documentElement.classList.add('page-sidebar-collapsed');
			}
		});

		// Re-apply collapsed classes after hx-boost navigation replaces <body>
		document.body.addEventListener('htmx:afterSettle', function() {
			if (document.documentElement.classList.contains('sidebar-collapsed')) {
				const sidebar = document.getElementById('main-sidebar');
				if (sidebar && !sidebar.classList.contains('collapsed')) {
					sidebar.classList.add('collapsed');
				}
			}
			if (document.documentElement.classList.contains('page-sidebar-collapsed')) {
				const subnav = document.getElementById('page-sidebar');
				if (subnav && !subnav.classList.contains('collapsed')) {
					subnav.classList.add('collapsed');
				}
			}
		});
	</script>
}

templ createOrgModal(basePath string) {
	@components.Modal(components.ModalProps{
		ID:      "create-org-modal",
		Title:   "Connect Org",
		OnClose: "closeCreateOrgModal()",
	}) {
		<form id="create-org-form" class="px-6 py-6 space-y-4">
			<div>
				<label for="org-org-id" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">
					Nuon Org ID <span class="text-red-500">*</span>
				</label>
				<input
					type="text"
					id="org-org-id"
					name="org_id"
					required
					class="w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-800 dark:text-white rounded-md focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
					placeholder="org_..."
				/>
			</div>
			<div>
				<label for="org-api-token" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">
					API Token <span class="text-red-500">*</span>
				</label>
				<input
					type="password"
					id="org-api-token"
					name="api_token"
					required
					class="w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-800 dark:text-white rounded-md focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
					placeholder="nuon_pat_..."
				/>
				<p class="mt-1 text-sm text-cool-grey-500 dark:text-cool-grey-400">
					To get a new token, run: <code>nuon orgs api-token -j</code>
				</p>
			</div>
			<div>
				<label for="org-api-url" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">
					API URL
				</label>
				<input
					type="text"
					id="org-api-url"
					name="api_url"
					class="w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-800 dark:text-white rounded-md focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
					placeholder="https://api.nuon.co"
				/>
				<p class="mt-1 text-sm text-cool-grey-500 dark:text-cool-grey-400">
					Leave blank to use the default API URL.
				</p>
			</div>
			<div id="create-org-error" class="hidden p-3 bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 rounded-md text-red-700 dark:text-red-300 text-sm"></div>
		</form>
		@components.ModalFooter() {
			@components.ModalButtonSecondary("Cancel", "closeCreateOrgModal()")
			@components.ModalButtonPrimary("Connect", templ.Attributes{"type": "button", "onclick": "submitCreateOrg()"})
		}
	}
	<!-- Config data for JavaScript -->
	<div
		id="create-org-config"
		class="hidden"
		data-base-path={ basePath }
	></div>
	@createOrgScript()
}

templ createOrgScript() {
	<script>
		async function submitCreateOrg() {
			const configEl = document.getElementById('create-org-config');
			const basePath = configEl.dataset.basePath;
			const form = document.getElementById('create-org-form');
			const errorDiv = document.getElementById('create-org-error');
			const formData = new FormData(form);

			errorDiv.classList.add('hidden');

			try {
				const response = await fetch(basePath + '/org/create', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json'
					},
					credentials: 'same-origin',
					body: JSON.stringify({
						org_id: formData.get('org_id'),
						api_token: formData.get('api_token'),
						api_url: formData.get('api_url') || undefined
					})
				});

				if (response.ok) {
					const data = await response.json();
					// Org connected successfully, redirect to the org's links page
					window.location.href = data.redirect_to || (basePath + '/orgs/');
				} else {
					const error = await response.json();
					errorDiv.textContent = error.error || 'Failed to connect org';
					errorDiv.classList.remove('hidden');
				}
			} catch (err) {
				errorDiv.textContent = 'Network error. Please try again.';
				errorDiv.classList.remove('hidden');
			}
		}
	</script>
}

templ keyboardShortcutsModal() {
	@components.Modal(components.ModalProps{
		ID:       "keyboard-shortcuts-modal",
		Title:    "Keyboard Shortcuts",
		MaxWidth: "max-w-md",
		OnClose:  "closeKeyboardShortcutsModal()",
	}) {
		<div class="px-6 py-6 space-y-3">
			<div class="flex justify-between items-center">
				<span class="text-cool-grey-600 dark:text-cool-grey-400">Toggle main sidebar</span>
				<div class="flex gap-1">
					<kbd class="stratus-kbd">Alt</kbd>
					<kbd class="stratus-kbd">S</kbd>
				</div>
			</div>
			<div class="flex justify-between items-center">
				<span class="text-cool-grey-600 dark:text-cool-grey-400">Toggle page sidebar</span>
				<div class="flex gap-1">
					<kbd class="stratus-kbd">Alt</kbd>
					<kbd class="stratus-kbd">Shift</kbd>
					<kbd class="stratus-kbd">S</kbd>
				</div>
			</div>
			<div class="flex justify-between items-center">
				<span class="text-cool-grey-600 dark:text-cool-grey-400">Show keyboard shortcuts</span>
				<div class="flex gap-1">
					<kbd class="stratus-kbd">?</kbd>
				</div>
			</div>
			<div class="flex justify-between items-center">
				<span class="text-cool-grey-600 dark:text-cool-grey-400">Close modal</span>
				<div class="flex gap-1">
					<kbd class="stratus-kbd">Esc</kbd>
				</div>
			</div>
		</div>
	}
}
