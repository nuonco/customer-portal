package components

// ConfirmModal provides confirmation and prompt modal dialogs
// Include once per page that needs modal dialogs
//
// Usage in JavaScript:
//
// Simple confirmation (replaces confirm()):
//   const confirmed = await showConfirmModal({
//       title: "Delete Item?",
//       message: "Are you sure you want to delete this item?"
//   });
//   if (confirmed) { ... }
//
// Warning dialog with custom buttons:
//   const confirmed = await showConfirmModal({
//       title: "Warning",
//       message: "This action cannot be undone.",
//       variant: "danger",
//       confirmText: "Delete",
//       cancelText: "Keep"
//   });
//
// Input prompt (replaces prompt()):
//   const value = await showPromptModal({
//       title: "Confirm Action",
//       message: "Please type the name to confirm:",
//       placeholder: "Enter name",
//       expectedValue: "my-item",
//       validationMessage: "Name does not match"
//   });
//   if (value !== null) { ... }
templ ConfirmModal() {
	<!-- Confirmation Modal Container -->
	<div id="confirm-modal" class="fixed inset-0 hidden overflow-y-auto backdrop-blur-xs bg-black/2 dark:bg-black/10" style="z-index: 100;" onclick="if(event.target===this) closeConfirmModal(confirmModalOptions.isPrompt ? null : false)">
		<div class="flex items-center justify-center min-h-full p-4" onclick="if(event.target===this) closeConfirmModal(confirmModalOptions.isPrompt ? null : false)">
			<div id="confirm-modal-dialog" class="bg-white dark:bg-dark-grey-900 w-full max-w-lg my-8 overflow-clip" style="border-radius: 10px; border: 1px solid rgba(158,168,179,0.24); box-shadow: 0px 16px 56px -16px rgba(0,0,0,0.08), 0px 1px 4px 0px rgba(0,0,0,0.08), 0px 0px 16px -4px rgba(0,0,0,0.08);">
				<!-- Modal Header -->
				<div id="confirm-modal-header" class="px-4 py-6 border-b flex items-center justify-between" style="border-color: rgba(158,168,179,0.24);">
					<div class="flex items-center gap-3">
						<i id="confirm-modal-icon" class="hidden text-xl text-cool-grey-500 dark:text-cool-grey-400"></i>
						<h3 id="confirm-modal-title" class="text-lg font-semibold text-cool-grey-900 dark:text-white"></h3>
					</div>
					<button
						type="button"
						class="text-cool-grey-400 hover:text-cool-grey-600 dark:hover:text-cool-grey-200"
						onclick="closeConfirmModal(confirmModalOptions.isPrompt ? null : false)"
					>
						<i class="ph-bold ph-x text-lg"></i>
					</button>
				</div>
				<!-- Modal Body -->
				<div class="px-6 py-6">
					<!-- Warning Banner (hidden by default) -->
					<div id="confirm-modal-warning" class="hidden mb-4 px-4 py-3 rounded-md bg-amber-50 dark:bg-amber-950 border border-amber-200 dark:border-amber-800">
						<div class="flex items-start gap-2">
							<i class="ph-bold ph-warning text-amber-600 dark:text-amber-400 mt-0.5"></i>
							<p id="confirm-modal-warning-text" class="text-sm text-amber-800 dark:text-amber-200"></p>
						</div>
					</div>
					<!-- Message (plain text mode) -->
					<p id="confirm-modal-message" class="text-cool-grey-600 dark:text-cool-grey-400"></p>
					<!-- Rich body HTML (hidden by default) -->
					<div id="confirm-modal-body-html" class="hidden text-sm text-cool-grey-600 dark:text-cool-grey-400"></div>
					<!-- Input Field (hidden by default, shown for prompt modals) -->
					<div id="confirm-modal-input-container" class="hidden mt-4">
						<input
							type="text"
							id="confirm-modal-input"
							class="block w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-800 dark:text-white rounded-md focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
							onkeydown="if(event.key==='Enter'){event.preventDefault();closeConfirmModal('confirm')}"
						/>
						<p id="confirm-modal-validation" class="hidden mt-2 text-sm text-red-600 dark:text-red-400"></p>
					</div>
				</div>
				<!-- Modal Footer -->
				<div class="px-4 py-6 bg-white dark:bg-dark-grey-900 flex justify-end space-x-2" style="border-top: 1px solid rgba(158,168,179,0.24); border-radius: 0 0 10px 10px;">
					<button
						type="button"
						id="confirm-modal-cancel"
						class="h-8 px-3 text-sm font-medium text-primary-600 dark:text-primary-400 bg-white dark:bg-dark-grey-700 rounded-lg hover:bg-cool-grey-50 dark:hover:bg-dark-grey-600"
						style="border: 1px solid rgba(158,168,179,0.24); box-shadow: 0px 1px 2px 0px rgba(0,0,0,0.08);"
						onclick="closeConfirmModal(confirmModalOptions.isPrompt ? null : false)"
					>
						Cancel
					</button>
					<button
						type="button"
						id="confirm-modal-confirm"
						class="h-8 px-3 text-sm font-medium text-white rounded-lg inline-flex items-center gap-1.5"
						style="box-shadow: 0px 1px 2px 0px rgba(0,0,0,0.08);"
						onclick="closeConfirmModal(confirmModalOptions.isPrompt ? 'confirm' : true)"
					>
						Confirm
					</button>
				</div>
			</div>
		</div>
	</div>
	@confirmModalScript()
}

templ confirmModalScript() {
	<script>
		// Modal state management
		let confirmModalResolve = null;
		let confirmModalOptions = null;

		// Show confirmation modal (replaces confirm())
		// Returns Promise<boolean>
		function showConfirmModal(options) {
			return new Promise((resolve) => {
				confirmModalResolve = resolve;
				confirmModalOptions = {
					title: options.title || 'Confirm',
					message: options.message || 'Are you sure?',
					confirmText: options.confirmText || 'Confirm',
					cancelText: options.cancelText || 'Cancel',
					variant: options.variant || 'primary', // primary, danger, warning
					isPrompt: false
				};

				renderConfirmModal();
				openConfirmModalAnimated();
			});
		}

		// Show prompt modal (replaces prompt())
		// Returns Promise<string | null>
		// Options:
		//   icon: CSS class for header icon (e.g. 'ph-bold ph-trash')
		//   warningBanner: text for amber warning banner
		//   bodyHTML: rich HTML body content (replaces message)
		//   disableUntilMatch: if true, confirm button disabled until input matches expectedValue
		function showPromptModal(options) {
			return new Promise((resolve) => {
				confirmModalResolve = resolve;
				confirmModalOptions = {
					title: options.title || 'Enter Value',
					message: options.message || '',
					confirmText: options.confirmText || 'Confirm',
					cancelText: options.cancelText || 'Cancel',
					variant: options.variant || 'primary',
					isPrompt: true,
					placeholder: options.placeholder || '',
					expectedValue: options.expectedValue || null,
					validationMessage: options.validationMessage || 'Invalid input',
					icon: options.icon || null,
					warningBanner: options.warningBanner || null,
					bodyHTML: options.bodyHTML || null,
					disableUntilMatch: options.disableUntilMatch || false,
					confirmIcon: options.confirmIcon || null
				};

				renderConfirmModal();

				const inputContainer = document.getElementById('confirm-modal-input-container');
				const input = document.getElementById('confirm-modal-input');
				inputContainer.classList.remove('hidden');
				input.placeholder = confirmModalOptions.placeholder;
				input.value = '';

				// Disable confirm button until input matches
				if (confirmModalOptions.disableUntilMatch && confirmModalOptions.expectedValue) {
					const confirmBtn = document.getElementById('confirm-modal-confirm');
					confirmBtn.disabled = true;
					confirmBtn.classList.add('opacity-50', 'cursor-not-allowed');
					input.oninput = function() {
						if (input.value === confirmModalOptions.expectedValue) {
							confirmBtn.disabled = false;
							confirmBtn.classList.remove('opacity-50', 'cursor-not-allowed');
						} else {
							confirmBtn.disabled = true;
							confirmBtn.classList.add('opacity-50', 'cursor-not-allowed');
						}
					};
				}

				openConfirmModalAnimated();
				input.focus();
			});
		}

		function openConfirmModalAnimated() {
			openModal('confirm-modal');
		}

		function closeConfirmModalAnimated(callback) {
			closeModal('confirm-modal', callback);
		}

		function renderConfirmModal() {
			const modal = document.getElementById('confirm-modal');
			const title = document.getElementById('confirm-modal-title');
			const message = document.getElementById('confirm-modal-message');
			const confirmBtn = document.getElementById('confirm-modal-confirm');
			const cancelBtn = document.getElementById('confirm-modal-cancel');
			const inputContainer = document.getElementById('confirm-modal-input-container');
			const validation = document.getElementById('confirm-modal-validation');
			const iconEl = document.getElementById('confirm-modal-icon');
			const warningEl = document.getElementById('confirm-modal-warning');
			const warningText = document.getElementById('confirm-modal-warning-text');
			const bodyHTML = document.getElementById('confirm-modal-body-html');

			title.textContent = confirmModalOptions.title;
			cancelBtn.textContent = confirmModalOptions.cancelText;

			// Header icon
			if (confirmModalOptions.icon) {
				iconEl.className = confirmModalOptions.icon + ' text-xl text-cool-grey-500 dark:text-cool-grey-400';
				iconEl.classList.remove('hidden');
			} else {
				iconEl.className = 'hidden';
			}

			// Warning banner
			if (confirmModalOptions.warningBanner) {
				warningText.innerHTML = confirmModalOptions.warningBanner;
				warningEl.classList.remove('hidden');
			} else {
				warningEl.classList.add('hidden');
			}

			// Body content: rich HTML or plain message
			if (confirmModalOptions.bodyHTML) {
				bodyHTML.innerHTML = confirmModalOptions.bodyHTML;
				bodyHTML.classList.remove('hidden');
				message.classList.add('hidden');
			} else {
				message.textContent = confirmModalOptions.message;
				message.classList.remove('hidden');
				bodyHTML.classList.add('hidden');
			}

			// Reset input container
			inputContainer.classList.add('hidden');
			validation.classList.add('hidden');

			// Confirm button content (icon + text)
			if (confirmModalOptions.confirmIcon) {
				confirmBtn.innerHTML = '<i class="' + confirmModalOptions.confirmIcon + '"></i> ' + confirmModalOptions.confirmText;
			} else {
				confirmBtn.textContent = confirmModalOptions.confirmText;
			}

			// Reset disabled state
			confirmBtn.disabled = false;
			confirmBtn.classList.remove('opacity-50', 'cursor-not-allowed');

			// Set button variant styling - Stratus Design System
			confirmBtn.className = 'h-8 px-3 text-sm font-medium text-white rounded-lg inline-flex items-center gap-1.5';
			confirmBtn.style.boxShadow = '0px 1px 2px 0px rgba(0,0,0,0.08)';
			switch (confirmModalOptions.variant) {
				case 'danger':
					confirmBtn.classList.add('bg-red-600', 'hover:bg-red-700');
					break;
				case 'warning':
					confirmBtn.classList.add('bg-red-600', 'hover:bg-red-700');
					break;
				default:
					confirmBtn.classList.add('bg-primary-600', 'hover:bg-primary-700');
			}

			// Re-apply icon + text after className reset
			if (confirmModalOptions.confirmIcon) {
				confirmBtn.innerHTML = '<i class="' + confirmModalOptions.confirmIcon + '"></i> ' + confirmModalOptions.confirmText;
			}
		}

		function closeConfirmModal(result) {
			var validation = document.getElementById('confirm-modal-validation');

			// For prompt modals, validate input if expectedValue is set
			if (confirmModalOptions.isPrompt && result !== null) {
				var input = document.getElementById('confirm-modal-input');
				var value = input.value;

				if (confirmModalOptions.expectedValue && value !== confirmModalOptions.expectedValue) {
					validation.textContent = confirmModalOptions.validationMessage;
					validation.classList.remove('hidden');
					input.focus();
					return; // Don't close modal
				}

				closeConfirmModalAnimated(function() {
					if (confirmModalResolve) {
						confirmModalResolve(value);
						confirmModalResolve = null;
					}
				});
				return;
			}

			closeConfirmModalAnimated(function() {
				if (confirmModalResolve) {
					confirmModalResolve(result);
					confirmModalResolve = null;
				}
			});
		}

	</script>
}
