package components

// PreviewContainerProps for the reusable preview component
type PreviewContainerProps struct {
	Title          string // e.g. "Live Preview"
	Description    string // e.g. "This is your customers will see."
	InitialMode    string // "light" or "dark" (default: "light")
	InitialSize    string // "desktop", "tablet", or "mobile" (default: "desktop")
	PrimaryColor   string // CSS hex color for --preview-primary
	SecondaryColor string // CSS hex color for --preview-secondary
}

func (p PreviewContainerProps) getInitialMode() string {
	if p.InitialMode == "dark" {
		return "dark"
	}
	return "light"
}

func (p PreviewContainerProps) getInitialSize() string {
	switch p.InitialSize {
	case "mobile", "tablet":
		return p.InitialSize
	default:
		return "desktop"
	}
}

func (p PreviewContainerProps) getModeClass() string {
	if p.getInitialMode() == "dark" {
		return "preview-dark"
	}
	return "preview-light"
}

func (p PreviewContainerProps) getContainerClass() string {
	return "preview-container-" + p.getInitialSize()
}

func (p PreviewContainerProps) getSizeClass() string {
	return "preview-size-" + p.getInitialSize()
}

func (p PreviewContainerProps) getPrimaryColor() string {
	if p.PrimaryColor == "" {
		return "#8040BF"
	}
	return p.PrimaryColor
}

func (p PreviewContainerProps) getSecondaryColor() string {
	if p.SecondaryColor == "" {
		return "#8040BF"
	}
	return p.SecondaryColor
}

// PreviewContainer renders a reusable preview container with device size and light/dark mode toggles
templ PreviewContainer(props PreviewContainerProps) {
	<div class="w-fit bg-white dark:bg-dark-grey-900 p-6 rounded-lg shadow-md border border-cool-grey-300 dark:border-dark-grey-500">
		<div class="flex items-center justify-between mb-3">
			<div>
				<h3 class="text-lg font-semibold text-cool-grey-800 dark:text-white">{ props.Title }</h3>
				<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400">{ props.Description }</p>
			</div>
			<div class="flex items-center space-x-2">
				<!-- Device Size Toggle -->
				<div class="flex items-center space-x-1 bg-cool-grey-100 dark:bg-dark-grey-700 rounded-lg p-1">
					<button
						type="button"
						id="previewMobileBtn"
						onclick="setPreviewSize('mobile')"
						title="Mobile"
						class={ "p-1.5 rounded-md transition-colors",
							templ.KV("bg-white dark:bg-dark-grey-600 text-cool-grey-800 dark:text-white shadow-sm", props.getInitialSize() == "mobile"),
							templ.KV("text-cool-grey-600 dark:text-cool-grey-400 hover:bg-cool-grey-200 dark:hover:bg-dark-grey-600", props.getInitialSize() != "mobile") }
					>
						<!-- Smartphone icon -->
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
							<line x1="12" y1="18" x2="12.01" y2="18"></line>
						</svg>
					</button>
					<button
						type="button"
						id="previewTabletBtn"
						onclick="setPreviewSize('tablet')"
						title="Tablet"
						class={ "p-1.5 rounded-md transition-colors",
							templ.KV("bg-white dark:bg-dark-grey-600 text-cool-grey-800 dark:text-white shadow-sm", props.getInitialSize() == "tablet"),
							templ.KV("text-cool-grey-600 dark:text-cool-grey-400 hover:bg-cool-grey-200 dark:hover:bg-dark-grey-600", props.getInitialSize() != "tablet") }
					>
						<!-- Tablet icon -->
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
							<line x1="12" y1="18" x2="12.01" y2="18"></line>
						</svg>
					</button>
					<button
						type="button"
						id="previewDesktopBtn"
						onclick="setPreviewSize('desktop')"
						title="Desktop"
						class={ "p-1.5 rounded-md transition-colors",
							templ.KV("bg-white dark:bg-dark-grey-600 text-cool-grey-800 dark:text-white shadow-sm", props.getInitialSize() == "desktop"),
							templ.KV("text-cool-grey-600 dark:text-cool-grey-400 hover:bg-cool-grey-200 dark:hover:bg-dark-grey-600", props.getInitialSize() != "desktop") }
					>
						<!-- Monitor icon -->
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
							<line x1="8" y1="21" x2="16" y2="21"></line>
							<line x1="12" y1="17" x2="12" y2="21"></line>
						</svg>
					</button>
				</div>
				<!-- Light/Dark Mode Toggle -->
				<div class="flex items-center space-x-1 bg-cool-grey-100 dark:bg-dark-grey-700 rounded-lg p-1">
					<button
						type="button"
						id="previewLightModeBtn"
						onclick="setPreviewMode('light')"
						title="Light mode"
						class={ "p-1.5 rounded-md transition-colors",
							templ.KV("bg-white dark:bg-dark-grey-600 text-cool-grey-800 dark:text-white shadow-sm", props.getInitialMode() == "light"),
							templ.KV("text-cool-grey-600 dark:text-cool-grey-400 hover:bg-cool-grey-200 dark:hover:bg-dark-grey-600", props.getInitialMode() != "light") }
					>
						<!-- Sun icon -->
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="5"></circle>
							<line x1="12" y1="1" x2="12" y2="3"></line>
							<line x1="12" y1="21" x2="12" y2="23"></line>
							<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
							<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
							<line x1="1" y1="12" x2="3" y2="12"></line>
							<line x1="21" y1="12" x2="23" y2="12"></line>
							<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
							<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
						</svg>
					</button>
					<button
						type="button"
						id="previewDarkModeBtn"
						onclick="setPreviewMode('dark')"
						title="Dark mode"
						class={ "p-1.5 rounded-md transition-colors",
							templ.KV("bg-white dark:bg-dark-grey-600 text-cool-grey-800 dark:text-white shadow-sm", props.getInitialMode() == "dark"),
							templ.KV("text-cool-grey-600 dark:text-cool-grey-400 hover:bg-cool-grey-200 dark:hover:bg-dark-grey-600", props.getInitialMode() != "dark") }
					>
						<!-- Moon icon -->
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
						</svg>
					</button>
				</div>
			</div>
		</div>
		<!-- Preview Container with scaling -->
		<div class="w-fit border border-cool-grey-300 dark:border-dark-grey-500 rounded-lg overflow-hidden">
			<div
				id="previewContainer"
				class={ props.getModeClass(), props.getContainerClass() }
				style={ "--preview-primary: " + props.getPrimaryColor() + "; --preview-secondary: " + props.getSecondaryColor() + ";" }
			>
				<!-- Scaled preview frame -->
				<div id="previewScaler" class={ "origin-top-left", props.getSizeClass() }>
					{ children... }
				</div>
			</div>
		</div>
		<!-- Preview styles -->
		@previewContainerStyles()
	</div>
	@previewContainerScript()
}

templ previewContainerStyles() {
	<style>
		/* Light mode preview */
		.preview-light .preview-page-bg { background-color: #f8fafc; }
		.preview-light .preview-card { background-color: #ffffff; border: 1px solid #d1d5db; }
		.preview-light .preview-text-heading { color: #374151; }
		.preview-light .preview-text-body { color: #1f2937; }
		.preview-light .preview-text-muted { color: #6b7280; }
		.preview-light .preview-status-bg { background-color: #f8fafc; }
		.preview-light .preview-status-border { border: 1px solid #e5e7eb; }
		.preview-light .preview-logo-light { display: block; }
		.preview-light .preview-logo-dark { display: none !important; }

		/* Dark mode preview */
		.preview-dark .preview-page-bg { background-color: #0f172a; }
		.preview-dark .preview-card { background-color: #1e293b; border: 1px solid #334155; }
		.preview-dark .preview-text-heading { color: #e2e8f0; }
		.preview-dark .preview-text-body { color: #f8fafc; }
		.preview-dark .preview-text-muted { color: #94a3b8; }
		.preview-dark .preview-status-bg { background-color: #1e293b; }
		.preview-dark .preview-status-border { border: 1px solid #334155; }
		.preview-dark .preview-logo-light { display: none !important; }
		.preview-dark .preview-logo-dark { display: block; }

		/* Desktop: 1280x800 viewport, scaled to 832x520 displayed */
		.preview-size-desktop {
			transform: scale(0.65);
			transform-origin: top left;
			width: 1280px;
			height: 800px;
			overflow: hidden;
		}

		/* Tablet: 768x1024 viewport (iPad portrait), scaled to 576x768 displayed */
		.preview-size-tablet {
			transform: scale(0.75);
			transform-origin: top left;
			width: 768px;
			height: 1024px;
			overflow: hidden;
		}

		/* Mobile: 375x667 viewport (iPhone), scaled to 319x567 displayed */
		.preview-size-mobile {
			transform: scale(0.85);
			transform-origin: top left;
			width: 375px;
			height: 667px;
			overflow: hidden;
		}

		/* Container sizes to match scaled output */
		.preview-container-desktop { width: 832px; height: 520px; overflow: hidden; }
		.preview-container-tablet { width: 576px; height: 768px; overflow: hidden; }
		.preview-container-mobile { width: 319px; height: 567px; overflow: hidden; }

		/* Mobile preview responsive adjustments */
		.preview-size-mobile .preview-card .flex.gap-6 {
			flex-direction: column;
			gap: 1rem;
		}
		.preview-size-mobile .preview-text-muted {
			font-size: 0.7rem;
		}
		.preview-size-mobile header .flex.items-center.justify-between {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5rem;
		}
	</style>
}

templ previewContainerScript() {
	<script>
		(function() {
			// Initialize preview state from DOM
			var container = document.getElementById('previewContainer');
			var scaler = document.getElementById('previewScaler');

			// Extract initial state from class names
			window._previewMode = container.classList.contains('preview-dark') ? 'dark' : 'light';
			window._previewSize = 'desktop';
			if (container.classList.contains('preview-container-tablet')) {
				window._previewSize = 'tablet';
			} else if (container.classList.contains('preview-container-mobile')) {
				window._previewSize = 'mobile';
			}

			window.setPreviewMode = function(mode, skipCallback) {
				window._previewMode = mode;
				var container = document.getElementById('previewContainer');
				var lightBtn = document.getElementById('previewLightModeBtn');
				var darkBtn = document.getElementById('previewDarkModeBtn');

				// Update container class (preserve size class)
				var sizeClass = 'preview-container-' + window._previewSize;
				if (mode === 'light') {
					container.className = 'preview-light ' + sizeClass;
					lightBtn.classList.add('bg-white', 'dark:bg-dark-grey-600', 'text-cool-grey-800', 'dark:text-white', 'shadow-sm');
					lightBtn.classList.remove('text-cool-grey-600', 'dark:text-cool-grey-400', 'hover:bg-cool-grey-200', 'dark:hover:bg-dark-grey-600');
					darkBtn.classList.remove('bg-white', 'dark:bg-dark-grey-600', 'text-cool-grey-800', 'dark:text-white', 'shadow-sm');
					darkBtn.classList.add('text-cool-grey-600', 'dark:text-cool-grey-400', 'hover:bg-cool-grey-200', 'dark:hover:bg-dark-grey-600');
				} else {
					container.className = 'preview-dark ' + sizeClass;
					darkBtn.classList.add('bg-white', 'dark:bg-dark-grey-600', 'text-cool-grey-800', 'dark:text-white', 'shadow-sm');
					darkBtn.classList.remove('text-cool-grey-600', 'dark:text-cool-grey-400', 'hover:bg-cool-grey-200', 'dark:hover:bg-dark-grey-600');
					lightBtn.classList.remove('bg-white', 'dark:bg-dark-grey-600', 'text-cool-grey-800', 'dark:text-white', 'shadow-sm');
					lightBtn.classList.add('text-cool-grey-600', 'dark:text-cool-grey-400', 'hover:bg-cool-grey-200', 'dark:hover:bg-dark-grey-600');
				}

				// Call page-specific callback if it exists
				if (!skipCallback && typeof window.onPreviewModeChange === 'function') {
					window.onPreviewModeChange(mode);
				}

				// Call updatePreview if it exists
				if (typeof window.updatePreview === 'function') {
					window.updatePreview();
				}
			};

			window.setPreviewSize = function(size) {
				window._previewSize = size;
				var scaler = document.getElementById('previewScaler');
				var container = document.getElementById('previewContainer');

				// Update scaler class based on size
				scaler.className = 'origin-top-left preview-size-' + size;

				// Update container class for correct height (preserve light/dark mode class)
				var modeClass = window._previewMode === 'dark' ? 'preview-dark' : 'preview-light';
				container.className = modeClass + ' preview-container-' + size;

				// Update button active states
				['mobile', 'tablet', 'desktop'].forEach(function(s) {
					var btn = document.getElementById('preview' + s.charAt(0).toUpperCase() + s.slice(1) + 'Btn');
					if (s === size) {
						btn.classList.add('bg-white', 'dark:bg-dark-grey-600', 'text-cool-grey-800', 'dark:text-white', 'shadow-sm');
						btn.classList.remove('text-cool-grey-600', 'dark:text-cool-grey-400', 'hover:bg-cool-grey-200', 'dark:hover:bg-dark-grey-600');
					} else {
						btn.classList.remove('bg-white', 'dark:bg-dark-grey-600', 'text-cool-grey-800', 'dark:text-white', 'shadow-sm');
						btn.classList.add('text-cool-grey-600', 'dark:text-cool-grey-400', 'hover:bg-cool-grey-200', 'dark:hover:bg-dark-grey-600');
					}
				});

				// Call page-specific callback if it exists
				if (typeof window.onPreviewSizeChange === 'function') {
					window.onPreviewSizeChange(size);
				}
			};
		})();
	</script>
}
