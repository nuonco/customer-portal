package components

import "fmt"

// SubnavItem represents a single navigation item in the sub-nav
type SubnavItem struct {
	URL       string
	Label     string
	Icon      templ.Component
	ActiveKey string
}

// PageSubnavProps for the shared sub-navigation sidebar
type PageSubnavProps struct {
	Items         []SubnavItem
	ActiveSubPage string
}

// PortalSubnavProps for the customer portal sub-navigation sidebar
type PortalSubnavProps struct {
	OrgID         string
	ActiveSubPage string
	BasePath      string
}

// TeamSubnavProps for the team settings sub-navigation sidebar
type TeamSubnavProps struct {
	OrgID         string
	ActiveSubPage string
	BasePath      string
}

// AppSubnavProps for the app sub-navigation sidebar
type AppSubnavProps struct {
	OrgID         string
	AppID         string
	ActiveSubPage string
	BasePath      string
}

// PageSubnav renders a configurable sub-navigation sidebar
templ PageSubnav(props PageSubnavProps) {
	<style>
		#page-sidebar.collapsed { width: 4.5rem; }
		#page-sidebar.collapsed .subnav-text { display: none; }
		#page-sidebar.collapsed .subnav-link { justify-content: center; padding-left: 0.5rem; padding-right: 0.5rem; }

		/* Nav link hover */
		#page-sidebar .subnav-link:hover { background-color: rgb(0 0 0 / 0.05); }
		:root.dark #page-sidebar .subnav-link:hover { background-color: rgb(255 255 255 / 0.1); }

		/* Handle hover — blue border line */
		#page-sidebar .subnav-handle:hover { border-color: var(--color-primary-600); }

		/* Handle button — hidden by default, shown on handle hover */
		#page-sidebar .subnav-handle .subnav-handle-button { opacity: 0; transition: opacity 150ms ease-in-out; }
		#page-sidebar .subnav-handle:hover .subnav-handle-button { opacity: 1; }
	</style>
	<div
		class="w-56 flex-shrink-0 border-r relative transition-[width] duration-150 ease-in-out"
		style="border-color: var(--border-color);"
		id="page-sidebar"
	>
		<div class="p-4">
			<nav class="space-y-1">
				for _, item := range props.Items {
					<a
						href={ templ.SafeURL(item.URL) }
						class={
							"subnav-link flex items-center gap-4 px-3 py-2.5 rounded-md transition-colors w-full text-sm h-9 [&_svg]:w-5 [&_svg]:h-5 [&_svg]:flex-shrink-0",
							templ.KV("bg-primary-200 text-primary-800 dark:bg-primary-600/25 dark:text-primary-400 [&_svg]:text-primary-800 dark:[&_svg]:text-primary-400", props.ActiveSubPage == item.ActiveKey),
							templ.KV("text-cool-grey-800 dark:text-cool-grey-400", props.ActiveSubPage != item.ActiveKey),
						}
					>
						@item.Icon
						<span class="subnav-text">{ item.Label }</span>
					</a>
				}
			</nav>
		</div>
		<div
			class="subnav-handle hidden md:flex absolute right-[-1rem] top-0 w-4 h-full cursor-pointer border-l border-transparent transition-[border-color] duration-150 ease-in-out"
			onclick="togglePageSidebar()"
		>
			<div class="stratus-tooltip-container">
				<button
					class="subnav-handle-button absolute left-[-0.875rem] top-1/2 -translate-y-1/2 p-1 rounded-lg shadow-md border border-cool-grey-200 bg-white cursor-pointer dark:bg-dark-grey-300 dark:border-dark-grey-500"
					aria-label="Toggle page sidebar"
				>
					<svg class="w-4 h-4 text-cool-grey-600 dark:text-cool-grey-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor">
						<path d="M112,48V208a8,8,0,0,1-16,0V136H43.31l18.35,18.34a8,8,0,0,1-11.32,11.32l-32-32a8,8,0,0,1,0-11.32l32-32a8,8,0,0,1,11.32,11.32L43.31,120H96V48a8,8,0,0,1,16,0Zm125.66,74.34-32-32a8,8,0,0,0-11.32,11.32L212.69,120H160V48a8,8,0,0,0-16,0V208a8,8,0,0,0,16,0V136h52.69l-18.35,18.34a8,8,0,0,0,11.32,11.32l32-32A8,8,0,0,0,237.66,122.34Z"></path>
					</svg>
				</button>
				<div class="stratus-tooltip stratus-tooltip-left">
					<span>Toggle panel</span>
					<div class="flex gap-0.5 ml-2">
						<kbd class="stratus-kbd-sm">Alt</kbd>
						<kbd class="stratus-kbd-sm">Shift</kbd>
						<kbd class="stratus-kbd-sm">S</kbd>
					</div>
				</div>
			</div>
		</div>
	</div>
}

// PortalSubnav renders the customer portal sub-navigation sidebar
templ PortalSubnav(props PortalSubnavProps) {
	@PageSubnav(PageSubnavProps{
		ActiveSubPage: props.ActiveSubPage,
		Items: []SubnavItem{
			{
				URL:       fmt.Sprintf("%s/orgs/%s/portal/branding", props.BasePath, props.OrgID),
				Label:     "Branding",
				Icon:      brandingIcon(),
				ActiveKey: "branding",
			},
			{
				URL:       fmt.Sprintf("%s/orgs/%s/portal/login", props.BasePath, props.OrgID),
				Label:     "Login",
				Icon:      loginIcon(),
				ActiveKey: "login",
			},
			{
				URL:       fmt.Sprintf("%s/orgs/%s/portal/dns", props.BasePath, props.OrgID),
				Label:     "DNS",
				Icon:      dnsIcon(),
				ActiveKey: "dns",
			},
			{
				URL:       fmt.Sprintf("%s/orgs/%s/portal/custom-theme", props.BasePath, props.OrgID),
				Label:     "Custom Theme",
				Icon:      customThemeIcon(),
				ActiveKey: "custom-theme",
			},
		},
	})
}

// TeamSubnav renders the team settings sub-navigation sidebar
templ TeamSubnav(props TeamSubnavProps) {
	@PageSubnav(PageSubnavProps{
		ActiveSubPage: props.ActiveSubPage,
		Items: []SubnavItem{
			{
				URL:       fmt.Sprintf("%s/orgs/%s/team/members", props.BasePath, props.OrgID),
				Label:     "Members",
				Icon:      membersIcon(),
				ActiveKey: "members",
			},
			{
				URL:       fmt.Sprintf("%s/orgs/%s/team/invites", props.BasePath, props.OrgID),
				Label:     "Invites",
				Icon:      invitesIcon(),
				ActiveKey: "invites",
			},
		},
	})
}

// AppSubnav renders the app sub-navigation sidebar using the shared PageSubnav component
templ AppSubnav(props AppSubnavProps) {
	@PageSubnav(PageSubnavProps{
		ActiveSubPage: props.ActiveSubPage,
		Items: []SubnavItem{
			{
				URL:       fmt.Sprintf("%s/orgs/%s/apps/%s/inputs", props.BasePath, props.OrgID, props.AppID),
				Label:     "Inputs",
				Icon:      inputsIcon(),
				ActiveKey: "inputs",
			},
			{
				URL:       fmt.Sprintf("%s/orgs/%s/apps/%s/logo", props.BasePath, props.OrgID, props.AppID),
				Label:     "Logo",
				Icon:      logoIcon(),
				ActiveKey: "logo",
			},
		},
	})
}

