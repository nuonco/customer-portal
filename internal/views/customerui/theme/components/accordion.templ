package components

import "fmt"

// AccordionItemStatus represents the status of an accordion phase
type AccordionItemStatus string

const (
	AccordionNotStarted AccordionItemStatus = "not_started"
	AccordionInProgress AccordionItemStatus = "in_progress"
	AccordionCompleted  AccordionItemStatus = "completed"
	AccordionFailed     AccordionItemStatus = "failed"
)

// AccordionItem represents a single expandable accordion item
type AccordionItem struct {
	Title        string
	Status       AccordionItemStatus
	Open         bool
	StepNumber   int
	StepProgress string // e.g. "Step 2 of 3"
}

templ Accordion(item AccordionItem) {
	<details
		class="provision-phase"
		if item.Open {
			open
		}
	>
		<summary class="provision-phase-summary list-none [&::-webkit-details-marker]:hidden">
			<div class="flex items-center gap-3 flex-1 min-w-0">
				<!-- Step number circle with status icon -->
				switch item.Status {
				case AccordionCompleted:
					<div class="provision-phase-circle provision-phase-completed">
						<i class="ph-bold ph-check text-xs"></i>
					</div>
				case AccordionInProgress:
					<div class="provision-phase-circle provision-phase-in-progress">
						<span class="text-xs font-semibold">{ fmt.Sprintf("%d", item.StepNumber) }</span>
					</div>
				case AccordionFailed:
					<div class="provision-phase-circle provision-phase-failed">
						<i class="ph-bold ph-x text-xs"></i>
					</div>
				default:
					<div class="provision-phase-circle provision-phase-not-started">
						<span class="text-xs font-semibold">{ fmt.Sprintf("%d", item.StepNumber) }</span>
					</div>
				}
				<!-- Title and status -->
				<div class="flex-1 min-w-0">
					<span class="text-sm font-medium text-cool-grey-900 dark:text-white">{ item.Title }</span>
					if item.StepProgress != "" && item.Status == AccordionInProgress {
						<span class="text-xs text-cool-grey-500 dark:text-cool-grey-400 ml-2">{ item.StepProgress }</span>
					}
				</div>
				<!-- Status badge -->
				switch item.Status {
				case AccordionCompleted:
					<span class="badge-success text-xs">Completed</span>
				case AccordionInProgress:
					<span class="badge-info text-xs">
						<i class="ph-bold ph-circle-notch animate-spin text-xs mr-1"></i>
						In Progress
					</span>
				case AccordionFailed:
					<span class="badge-error text-xs">Failed</span>
				default:
					<span class="badge-neutral text-xs">Pending</span>
				}
			</div>
			<i class="ph-bold ph-caret-down text-sm text-cool-grey-400 dark:text-cool-grey-500 provision-phase-chevron ml-2"></i>
		</summary>
		<div class="provision-phase-content">
			{ children... }
		</div>
	</details>
}
