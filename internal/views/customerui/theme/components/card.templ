package components

import "strings"

type CardSize string

const (
	CardDefault CardSize = ""
	CardLarge   CardSize = "lg"
)

type CardProps struct {
	Size        CardSize
	Title       string          // simple title text; ignored when Header is set
	Header      templ.Component // custom header content; takes precedence over Title
	AccentColor string          // top border accent color (e.g. "var(--theme-primary)")
	Class       string
	ID          string
	Style       string
}

templ Card(props CardProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ cardClasses(props) }
		style={ cardStyle(props) }
	>
		if props.Header != nil {
			<div class="px-4 py-3 border-b" style="border-color: var(--theme-border-subtle)">
				@props.Header
			</div>
			<div class="p-4">
				{ children... }
			</div>
		} else if props.Title != "" {
			<div class="px-4 py-3 border-b" style="border-color: var(--theme-border-subtle)">
				<h4 class="text-base text-cool-grey-900 dark:text-white">{ props.Title }</h4>
			</div>
			<div class="p-4">
				{ children... }
			</div>
		} else {
			{ children... }
		}
	</div>
}

func cardStyle(props CardProps) string {
	s := props.Style
	if props.AccentColor != "" {
		accent := "border-top: 2px solid " + props.AccentColor + ";"
		if s != "" {
			s = accent + " " + s
		} else {
			s = accent
		}
	}
	return s
}

func cardClasses(props CardProps) string {
	classes := "card-base"
	if props.Header != nil || props.Title != "" {
		classes += " !p-0"
	}
	if props.Size == CardLarge {
		classes += " card-lg"
	}
	if props.Class != "" {
		classes += " " + strings.TrimSpace(props.Class)
	}
	return classes
}
