package components

import (
	"fmt"
	"strings"
)

// PlatformFromRegion determines cloud platform from a region string
func PlatformFromRegion(region string) string {
	if strings.Contains(region, "us-") || strings.Contains(region, "eu-") || strings.Contains(region, "ap-") {
		return "aws"
	} else if strings.Contains(region, "eastus") || strings.Contains(region, "westus") || strings.Contains(region, "northeurope") {
		return "azure"
	} else if strings.Contains(region, "us-central") || strings.Contains(region, "us-east") || strings.Contains(region, "europe-") {
		return "gcp"
	}
	return "unknown"
}

// NormalizePlatform maps runner types (e.g. "aws-eks", "azure-aks") to base platform names.
func NormalizePlatform(platform string) string {
	if strings.HasPrefix(platform, "aws") {
		return "aws"
	} else if strings.HasPrefix(platform, "azure") {
		return "azure"
	} else if platform == "gcp" {
		return "gcp"
	}
	return platform
}

// PlatformChip renders a cloud platform logo
templ PlatformChip(platform string) {
	switch NormalizePlatform(platform) {
	case "aws":
		<img src="/static/images/logos/aws.svg" class="platform-logo dark:hidden" alt="AWS"/>
		<img src="/static/images/logos/aws.svg" class="platform-logo hidden dark:block dark:invert" alt="AWS"/>
	case "azure":
		<img src="/static/images/logos/azure.svg" class="platform-logo" alt="Azure"/>
	case "gcp":
		<img src="/static/images/logos/google.svg" class="platform-logo" alt="GCP"/>
	default:
		<i class="ph-bold ph-cloud platform-logo text-cool-grey-400 dark:text-cool-grey-500"></i>
	}
}

// HealthPillsProps for compact health check indicators
type HealthPillsProps struct {
	HasHealthChecks bool
	Passed          int
	Failed          int
	Pending         int
}

// HealthPills renders compact health check status pills
templ HealthPills(props HealthPillsProps) {
	if props.HasHealthChecks {
		<div class="health-pills">
			if props.Passed > 0 {
				<span class="health-pill health-pill-passed" title={ fmt.Sprintf("%d passed", props.Passed) }>
					<i class="ph-bold ph-check text-xs"></i>
					{ fmt.Sprintf("%d", props.Passed) }
				</span>
			}
			if props.Failed > 0 {
				<span class="health-pill health-pill-failed" title={ fmt.Sprintf("%d failed", props.Failed) }>
					<i class="ph-bold ph-x text-xs"></i>
					{ fmt.Sprintf("%d", props.Failed) }
				</span>
			}
			if props.Pending > 0 {
				<span class="health-pill health-pill-pending" title={ fmt.Sprintf("%d pending", props.Pending) }>
					<i class="ph-bold ph-circle-notch text-xs animate-spin"></i>
					{ fmt.Sprintf("%d", props.Pending) }
				</span>
			}
		</div>
	} else {
		<span class="text-xs text-cool-grey-400 dark:text-cool-grey-500 italic">—</span>
	}
}
