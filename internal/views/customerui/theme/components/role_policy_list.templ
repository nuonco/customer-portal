package components

// RolePolicyListItem holds display data for a single IAM policy in a role.
type RolePolicyListItem struct {
	Name     string
	Type     string // "AWS managed" or "Vendor defined"
	Contents string // pretty-printed JSON, may be empty
}

// RolePolicyListProps holds the list of policies to display.
type RolePolicyListProps struct {
	Items []RolePolicyListItem
}

templ RolePolicyList(props RolePolicyListProps) {
	if len(props.Items) == 0 {
		@EmptyState(EmptyStateProps{Title: "No policies", Icon: "ph-shield-slash"})
	} else {
		<div>
			for _, item := range props.Items {
				<details class="group border-b border-cool-grey-100 dark:border-dark-grey-700">
					<summary class="flex items-center w-full cursor-pointer select-none text-sm hover:bg-cool-grey-50 dark:hover:bg-dark-grey-800">
						<span class="flex-1 py-2 pr-4 font-mono text-cool-grey-900 dark:text-white truncate">{ item.Name }</span>
						<span class="text-xs text-cool-grey-500 dark:text-cool-grey-400 pr-2 shrink-0">{ item.Type }</span>
						<span class="w-8 shrink-0 flex items-center justify-center text-cool-grey-400">
							<i class="ph-bold ph-caret-down group-open:hidden"></i>
							<i class="ph-bold ph-caret-up hidden group-open:inline"></i>
						</span>
					</summary>
					<div class="px-4 py-3 border-b border-cool-grey-100 dark:border-dark-grey-700">
						if item.Contents != "" {
							@CodeBlock(item.Contents, "json")
						} else {
							<p class="text-xs text-cool-grey-400 dark:text-cool-grey-500 italic">No policy document (AWS managed policy)</p>
						}
					</div>
				</details>
			}
		</div>
	}
}
