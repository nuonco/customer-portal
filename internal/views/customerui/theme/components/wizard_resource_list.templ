package components

// WizardResourceItem represents a single resource row in the wizard resource list.
type WizardResourceItem struct {
	Address string
	Action  string // "create", "update", "delete", "replace", or "" for neutral
}

// WizardResourceActionColor returns Tailwind classes for the action badge.
func WizardResourceActionColor(action string) string {
	switch action {
	case "create":
		return "bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300"
	case "update":
		return "bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300"
	case "delete":
		return "bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300"
	case "replace":
		return "bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300"
	default:
		return "bg-cool-grey-100 dark:bg-cool-grey-800 text-cool-grey-600 dark:text-cool-grey-400"
	}
}

templ wizardResourceActionIcon(action string) {
	switch action {
	case "create":
		<i class="ph-bold ph-plus"></i>
	case "update":
		<i class="ph-bold ph-pencil-simple"></i>
	case "delete":
		<i class="ph-bold ph-minus"></i>
	case "replace":
		<i class="ph-bold ph-arrows-clockwise"></i>
	default:
		<i class="ph-bold ph-cube"></i>
	}
}

// WizardResourceList renders a compact list of resource items with action icons.
templ WizardResourceList(items []WizardResourceItem) {
	if len(items) > 0 {
		<div class="divide-y divide-cool-grey-100 dark:divide-dark-grey-700">
			for _, item := range items {
				<div class="flex items-center gap-2 py-2 text-xs">
					<span class={ "inline-flex items-center justify-center w-5 h-5 rounded-full text-xs", WizardResourceActionColor(item.Action) }>
						@wizardResourceActionIcon(item.Action)
					</span>
					<span class="font-mono text-cool-grey-700 dark:text-cool-grey-300 truncate" title={ item.Address }>{ item.Address }</span>
				</div>
			}
		</div>
	}
}
