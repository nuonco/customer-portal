package components

import "fmt"

// PaginationProps for pagination controls
type PaginationProps struct {
	CurrentPage  int
	TotalPages   int
	HasPrevious  bool
	HasNext      bool
	PreviousPage int
	NextPage     int
	BaseURL      string // e.g., "?tab=healthy&page="
}

// Pagination renders pagination controls
templ Pagination(props PaginationProps) {
	<nav class="customer-card flex items-center justify-between mt-6 px-4 py-3">
		<div class="flex-1 flex justify-between sm:hidden">
			if props.HasPrevious {
				<a href={ templ.SafeURL(props.BaseURL + fmt.Sprintf("%d", props.PreviousPage)) } class="pagination-nav-btn">
					Previous
				</a>
			}
			if props.HasNext {
				<a href={ templ.SafeURL(props.BaseURL + fmt.Sprintf("%d", props.NextPage)) } class="pagination-nav-btn ml-3">
					Next
				</a>
			}
		</div>
		<div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
			<div>
				<p class="text-sm text-cool-grey-700 dark:text-cool-grey-300">
					Page <span class="font-medium">{ fmt.Sprintf("%d", props.CurrentPage) }</span> of <span class="font-medium">{ fmt.Sprintf("%d", props.TotalPages) }</span>
				</p>
			</div>
			<div>
				<nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px">
					if props.HasPrevious {
						<a href={ templ.SafeURL(props.BaseURL + fmt.Sprintf("%d", props.PreviousPage)) } class="pagination-btn rounded-l-md">
							<span class="sr-only">Previous</span>
							<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"></path>
							</svg>
						</a>
					} else {
						<span class="pagination-btn-disabled rounded-l-md">
							<span class="sr-only">Previous</span>
							<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"></path>
							</svg>
						</span>
					}
					if props.HasNext {
						<a href={ templ.SafeURL(props.BaseURL + fmt.Sprintf("%d", props.NextPage)) } class="pagination-btn rounded-r-md">
							<span class="sr-only">Next</span>
							<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
							</svg>
						</a>
					} else {
						<span class="pagination-btn-disabled rounded-r-md">
							<span class="sr-only">Next</span>
							<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
							</svg>
						</span>
					}
				</nav>
			</div>
		</div>
	</nav>
}
