package components

import "fmt"

// PaginationProps for pagination controls
type PaginationProps struct {
	CurrentPage  int
	TotalPages   int
	HasPrevious  bool
	HasNext      bool
	PreviousPage int
	NextPage     int
	BaseURL      string // e.g., "?tab=healthy&page="
	ShowingFrom  int    // first item index on current page (e.g. 1)
	ShowingTo    int    // last item index on current page (e.g. 10)
	TotalCount   int    // total items across all pages
}

// Pagination renders pagination controls
templ Pagination(props PaginationProps) {
	<nav class="flex items-center justify-between px-3 py-3">
		<div class="flex-1 flex justify-between sm:hidden">
			if props.HasPrevious {
				<a href={ templ.SafeURL(props.BaseURL + fmt.Sprintf("%d", props.PreviousPage)) } class="button button-pagination pagination-nav-btn">
					Previous
				</a>
			}
			if props.HasNext {
				<a href={ templ.SafeURL(props.BaseURL + fmt.Sprintf("%d", props.NextPage)) } class="button button-pagination pagination-nav-btn ml-3">
					Next
				</a>
			}
		</div>
		<div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
			<div>
				<p class="text-sm text-cool-grey-700 dark:text-cool-grey-300">
					if props.TotalCount > 0 {
						{ fmt.Sprintf("%d-%d of %d", props.ShowingFrom, props.ShowingTo, props.TotalCount) }
					} else {
						Page <span class="font-medium">{ fmt.Sprintf("%d", props.CurrentPage) }</span> of <span class="font-medium">{ fmt.Sprintf("%d", props.TotalPages) }</span>
					}
				</p>
			</div>
			<div>
				<nav class="relative z-0 inline-flex -space-x-px">
					if props.HasPrevious {
						<a href={ templ.SafeURL(props.BaseURL + fmt.Sprintf("%d", props.PreviousPage)) } class="button button-pagination pagination-btn">
							<span class="sr-only">Previous</span>
							<i class="ph-bold ph-caret-left text-xl"></i>
						</a>
					} else {
						<span class="pagination-btn-disabled">
							<span class="sr-only">Previous</span>
							<i class="ph-bold ph-caret-left text-xl"></i>
						</span>
					}
					if props.HasNext {
						<a href={ templ.SafeURL(props.BaseURL + fmt.Sprintf("%d", props.NextPage)) } class="button button-pagination pagination-btn">
							<span class="sr-only">Next</span>
							<i class="ph-bold ph-caret-right text-xl"></i>
						</a>
					} else {
						<span class="pagination-btn-disabled">
							<span class="sr-only">Next</span>
							<i class="ph-bold ph-caret-right text-xl"></i>
						</span>
					}
				</nav>
			</div>
		</div>
	</nav>
}
