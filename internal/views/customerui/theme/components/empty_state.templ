package components

import "fmt"

// EmptyStateProps for empty state display
type EmptyStateProps struct {
	Title string
	Icon  string // Any Phosphor icon class, e.g. "ph-stack", "ph-clock". Defaults to "ph-empty".
	Compact bool   // Use smaller padding
	Class   string // Additional CSS classes
}

func emptyStateIcon(icon string) string {
	if icon == "" {
		return "ph-empty"
	}
	return icon
}

// EmptyState renders an empty state display
templ EmptyState(props EmptyStateProps) {
	<div class={ "text-center", templ.KV("py-12", !props.Compact), templ.KV("py-6", props.Compact), props.Class } style="border-radius: var(--theme-radius); opacity: 0.4;">
		<i class={ fmt.Sprintf("ph-bold %s text-[32px] mb-4 block", emptyStateIcon(props.Icon)) }></i>
		<h3 class="text-base font-normal">{ props.Title }</h3>
	</div>
}
