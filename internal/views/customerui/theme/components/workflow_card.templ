package components

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui"
)

// WorkflowCardProps defines properties for the WorkflowCard component
type WorkflowCardProps struct {
	Workflow     customerui.WorkflowData
	InstallID    string
	BasePath     string
	PrimaryColor string
}

// WorkflowCard renders a single workflow with status and action buttons
templ WorkflowCard(props WorkflowCardProps) {
	<div id={ "workflow-" + props.Workflow.ID } class="card-base">
		<div class="flex justify-between items-start">
			<div class="flex-grow">
				<div class="flex items-center space-x-3 mb-2">
					<h4 class="text-xl text-cool-grey-900 dark:text-white">{ props.Workflow.Name }</h4>
					<span class={ "px-3 py-1 text-sm font-medium rounded-full", props.Workflow.StatusClass }>
						{ props.Workflow.Status }
					</span>
				</div>
				<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-2">
					Started: { props.Workflow.CreatedAt.Format("3:04 PM") }
					if !props.Workflow.FinishedAt.IsZero() {
						<span class="mx-1">&bull;</span>
						Completed: { props.Workflow.FinishedAt.Format("3:04 PM") }
					}
				</p>
				<p class="text-xs text-cool-grey-500 dark:text-cool-grey-400 font-mono">Update ID: { props.Workflow.ID }</p>
			</div>
			<div class="flex space-x-3 ml-4">
				@approveAllButton(props)
				@cancelButton(props)
			</div>
		</div>
		@workflowStatusMessage(props.Workflow.Status)
	</div>
}

templ approveAllButton(props WorkflowCardProps) {
	if props.Workflow.CanApproveAll {
		<button
			hx-post={ props.BasePath + "/installs/" + props.InstallID + "/workflows/" + props.Workflow.ID + "/approve-all" }
			hx-target={ "#workflow-" + props.Workflow.ID }
			hx-swap="outerHTML"
			hx-trigger="confirmed"
			hx-indicator="this"
			onclick="confirmApproveAll(this)"
			class="btn-theme-primary"
		>
			<span class="htmx-indicator">
				@spinnerIcon()
			</span>
			Approve
		</button>
	} else {
		<div class="relative group">
			<button
				disabled
				class="bg-cool-grey-300 dark:bg-dark-grey-600 text-cool-grey-500 dark:text-cool-grey-400 px-4 py-2 text-sm cursor-not-allowed rounded-theme"
			>
				Approve
			</button>
			<div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-1 bg-dark-grey-800 text-white text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap z-10">
				{ props.Workflow.ApproveAllDisabledReason }
			</div>
		</div>
	}
}

templ cancelButton(props WorkflowCardProps) {
	if props.Workflow.CanCancel {
		<button
			hx-post={ props.BasePath + "/installs/" + props.InstallID + "/workflows/" + props.Workflow.ID + "/cancel" }
			hx-target={ "#workflow-" + props.Workflow.ID }
			hx-swap="outerHTML"
			hx-trigger="confirmed"
			hx-indicator="this"
			onclick="confirmCancelWorkflow(this)"
			class="btn-theme-secondary"
		>
			<span class="htmx-indicator">
				@spinnerIcon()
			</span>
			Cancel
		</button>
	} else {
		<div class="relative group">
			<button
				disabled
				class="bg-cool-grey-300 dark:bg-dark-grey-600 text-cool-grey-500 dark:text-cool-grey-400 px-4 py-2 text-sm cursor-not-allowed rounded-theme"
			>
				Cancel
			</button>
			<div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-1 bg-dark-grey-800 text-white text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap z-10">
				{ props.Workflow.CancelDisabledReason }
			</div>
		</div>
	}
}

templ spinnerIcon() {
	<svg class="animate-spin h-4 w-4 inline mr-1" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
		<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
		<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
	</svg>
}

templ workflowStatusMessage(status string) {
	if status == "approval-awaiting" {
		<div class="mt-4 alert-warning">
			<p class="text-sm text-orange-800 dark:text-orange-300">
				<strong>Approval Required:</strong> This update is waiting for your approval to proceed.
			</p>
		</div>
	} else if status == "in-progress" {
		<div class="status-card mt-4 p-4">
			<div class="flex items-center space-x-2">
				<div class="animate-spin rounded-full h-4 w-4 border-b-2 border-primary-600"></div>
				<p class="text-sm text-cool-grey-800 dark:text-cool-grey-300">
					<strong>In Progress:</strong> This update is currently running.
				</p>
			</div>
		</div>
	} else if status == "error" {
		<div class="mt-4 alert-error">
			<p class="text-sm text-red-800 dark:text-red-300">
				<strong>Failed:</strong> This update encountered an error.
			</p>
		</div>
	} else if status == "cancelled" {
		<div class="mt-4 alert-warning">
			<p class="text-sm text-orange-800 dark:text-orange-300">
				<strong>Cancelled:</strong> This update was cancelled.
			</p>
		</div>
	} else if status == "success" || status == "approved" || status == "active" || status == "completed" {
		<div class="mt-4 alert-success">
			<p class="text-sm text-green-800 dark:text-green-300">
				<strong>Completed:</strong> This update completed successfully.
			</p>
		</div>
	}
}
