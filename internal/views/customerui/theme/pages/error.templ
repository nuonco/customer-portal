package pages

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui"
)

// ErrorPageProps contains data needed for the customer error page
type ErrorPageProps struct {
	LayoutProps customerui.LayoutProps
	Error       string
}

// ErrorPage renders a customer-facing error page
templ ErrorPage(props ErrorPageProps) {
	@customerui.Layout(props.LayoutProps) {
		<div class="min-h-[60vh] flex items-center justify-center px-4">
			<div class="text-center">
				<div class="mx-auto mb-6 text-red-500 dark:text-red-400">
					<i class="ph-bold ph-warning text-[64px]"></i>
				</div>
				<h1 class="text-2xl font-heading font-bold text-cool-grey-900 dark:text-white mb-4">Something went wrong</h1>
				<p class="text-cool-grey-600 dark:text-cool-grey-400 mb-8 max-w-md">{ props.Error }</p>
				<a
					href={ templ.SafeURL(props.LayoutProps.BasePath + "/installs") }
					class="button button-primary btn-theme-primary px-4 py-2 text-sm"
				>
					<i class="ph-bold ph-house text-base mr-2"></i>
					Back to Installs
				</a>
			</div>
		</div>
	}
}
