}

templ debugGroupInfoCard(props DebugWorkflowsPageProps) {
	if group := selectedStepGroup(props); group != nil {
		@components.Card(components.CardProps{Title: "Step Group"}) {
			<div id="debug-group-card-content">
				@DebugGroupCardContent(props)
			</div>
		}
	}
}

templ DebugGroupCardContent(props DebugWorkflowsPageProps) {
	if group := selectedStepGroup(props); group != nil {
		@components.TabBar(components.TabBarProps{
			Tabs: debugGroupTabs(props),
		})
		if props.ActiveGroupTab == "json" {
			@debugAPIEndpoint(fmt.Sprintf("GET /v1/workflows/%s → step_groups[]", props.SelectedWorkflow.ID))
			@components.CodeBlock(mustMarshalJSON(group), "json")
		} else {
			@debugGroupInfo(group)
		}
	}
}

templ debugGroupInfo(group *nuon.WorkflowStepGroup) {
	<div class="grid grid-cols-2 gap-6">
		<div class="space-y-2">
			@debugInfoRow("ID", group.ID)
			@debugInfoRow("Name", group.Name)
			@debugInfoRow("Group Index", fmt.Sprintf("%d", group.GroupIdx))
			@debugInfoRow("Created", formatTimestamp(group.CreatedAt))
		</div>
		<div class="space-y-2">
			if group.Status.Status != "" {
				<div class="flex gap-2 text-sm">
					<span class="text-cool-grey-500 dark:text-cool-grey-400 shrink-0 whitespace-nowrap">Status</span>
					@debugStatusBadge(&group.Status)
				</div>
			}
			if group.Parallel {
				@debugInfoRow("Parallel", "true")
			}
			@debugInfoRow("Steps", fmt.Sprintf("%d", len(group.Steps)))
		</div>
	</div>
	if len(group.Labels) > 0 {
		<div class="mt-4 border-t pt-4" style="border-color: var(--theme-border-subtle)">
			<h5 class="text-sm font-medium text-cool-grey-900 dark:text-white mb-2">Labels</h5>
			<div class="flex gap-2 flex-wrap">
				for k, v := range group.Labels {
					<span class="inline-flex items-center gap-1 text-xs px-2.5 py-1 rounded-full font-mono bg-cool-grey-100 text-cool-grey-600 dark:bg-dark-grey-700 dark:text-cool-grey-300">
						<span class="font-medium">{ k }:</span>
						<span>{ v }</span>
					</span>
				}
			</div>
		</div>
	}
	if group.QueueSignal != nil {
		<div class="mt-4 border-t pt-4" style="border-color: var(--theme-border-subtle)">
			<h5 class="text-sm font-medium text-cool-grey-900 dark:text-white mb-2">Queue Signal</h5>
			<div class="grid grid-cols-2 gap-6">
				<div class="space-y-2">
					@debugInfoRow("ID", group.QueueSignal.ID)
					@debugInfoRow("Type", group.QueueSignal.Type)
					@debugInfoRow("Queue ID", group.QueueSignal.QueueID)
					@debugInfoRow("Created", formatTimestamp(group.QueueSignal.CreatedAt))
				</div>
				<div class="space-y-2">
					if group.QueueSignal.Status.Status != "" {
						<div class="flex gap-2 text-sm">
							<span class="text-cool-grey-500 dark:text-cool-grey-400 shrink-0 whitespace-nowrap">Status</span>
							@debugStatusBadge(&group.QueueSignal.Status)
						</div>
					}
					@debugInfoRow("Owner", fmt.Sprintf("%s / %s", group.QueueSignal.OwnerType, group.QueueSignal.OwnerID))
					if group.QueueSignal.ExecutionCount > 0 {
						@debugInfoRow("Executions", fmt.Sprintf("%d", group.QueueSignal.ExecutionCount))
					}
				</div>
			</div>
		</div>
	}
}

