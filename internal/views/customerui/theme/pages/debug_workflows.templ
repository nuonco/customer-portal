			@debugInfoRow("ID", pv.ID)
			@debugInfoRow("Created", formatTimestamp(pv.CreatedAt))
		</div>
		<div class="space-y-2">
			if pv.Status.Status != "" {
				<div class="flex gap-2 text-sm">
					<span class="text-cool-grey-500 dark:text-cool-grey-400 shrink-0 whitespace-nowrap">Status</span>
					@debugStatusBadge(&pv.Status)
				</div>
			}
		</div>
