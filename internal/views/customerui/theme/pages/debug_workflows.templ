templ debugWorkflowActions(props DebugWorkflowsPageProps) {
	<div class="border-t pt-4 mt-4 flex justify-end gap-2" style="border-color: var(--theme-border-subtle)">
		<!-- Approve -->
		<form method="POST" action={ templ.SafeURL(debugActionURL(props, "approve")) }>
			if workflowCanApprove(props.SelectedWorkflow) {
				<input type="hidden" name="step_id" value={ workflowApprovalStep(props.SelectedWorkflow).ID }/>
				<input type="hidden" name="approval_id" value={ workflowApprovalStep(props.SelectedWorkflow).Approval.ID }/>
			}
			<button
				type="submit"
				class="button button-primary btn-theme-primary text-xs px-3 py-1.5"
				disabled?={ !workflowCanApprove(props.SelectedWorkflow) }
			>
				Approve
			</button>
		</form>
		<!-- Approve All -->
		<form method="POST" action={ templ.SafeURL(debugActionURL(props, "approve-all")) }>
			<button
				type="submit"
				class="button button-primary btn-theme-primary text-xs px-3 py-1.5"
				disabled?={ !workflowCanApproveAll(props.SelectedWorkflow) }
			>
				Approve All
			</button>
		</form>
		<!-- Retry -->
		<form method="POST" action={ templ.SafeURL(debugActionURL(props, "retry")) }>
			if workflowCanRetry(props.SelectedWorkflow) {
				<input type="hidden" name="step_id" value={ workflowRetryableStep(props.SelectedWorkflow).ID }/>
			}
			<button
				type="submit"
				class="button button-neutral btn-neutral text-xs px-3 py-1.5"
				disabled?={ !workflowCanRetry(props.SelectedWorkflow) }
			>
				Retry
			</button>
		</form>
		<!-- Cancel -->
		<form method="POST" action={ templ.SafeURL(debugActionURL(props, "cancel")) }>
			<button
				type="submit"
				class="button button-danger btn-theme-outline text-xs px-3 py-1.5"
				disabled?={ !workflowCanCancel(props.SelectedWorkflow) }
			>
				Cancel
			</button>
		</form>
	</div>
}

templ debugWorkflowCardHeader(name, id, status string) {
	<div class="flex items-center justify-between">
		<h4 class="text-base text-cool-grey-900 dark:text-white">
			{ name }
			<span class="text-xs text-cool-grey-500 dark:text-cool-grey-400 font-mono ml-2">{ id }</span>
		</h4>
		if status != "" {
			<span class={ "inline-flex items-center px-2 py-0.5 rounded text-xs font-medium", debugStatusClasses(status) }>
				{ status }
			</span>
		}
	</div>
}

templ debugInfoRow(label, value string) {
	<div class="flex gap-2 text-sm">
		<span class="text-cool-grey-500 dark:text-cool-grey-400 shrink-0 whitespace-nowrap">{ label }</span>
		<span class="font-mono text-xs break-all">{ value }</span>
	</div>
}

templ debugStepRow(props DebugWorkflowsPageProps, step *nuon.WorkflowStep) {
	<a
		href={ templ.SafeURL(debugStepRowHref(props, step.ID)) }
		hx-get={ debugStepRowHxGet(props, step.ID) }
		hx-target={ panelWrapperTarget }
		hx-swap="outerHTML"
		hx-push-url={ debugStepRowHref(props, step.ID) }
		hx-boost="false"
		class={ "flex items-center gap-3 px-2 py-1.5 rounded text-xs hover:bg-cool-grey-50 dark:hover:bg-dark-grey-900 cursor-pointer",
			templ.KV("bg-cool-grey-100 dark:bg-dark-grey-800", props.SelectedStep != nil && props.SelectedStep.ID == step.ID) }
	>
		<span class="w-6 text-right text-cool-grey-400 font-mono">{ fmt.Sprintf("%d", step.Idx) }</span>
		<span class="w-5">
			@debugStepStatusIcon(step)
		</span>
		<span class="flex-1 truncate font-medium">{ step.Name }</span>
		<span class="text-cool-grey-400 w-16 text-right">{ formatDuration(step.ExecutionTime) }</span>
	</a>
}

templ debugStepStatusIcon(step *nuon.WorkflowStep) {
	if step.Status != nil {
		switch step.Status.Status {
			case "success", "approved":
				<i class="ph-bold ph-check-circle text-green-500"></i>
			case "error":
				<i class="ph-bold ph-x-circle text-red-500"></i>
			case "in-progress", "planning", "applying", "provisioning", "generating", "checking-plan", "retrying", "queued":
				<i class="ph-bold ph-circle-notch text-blue-500"></i>
			case "approval-awaiting", "awaiting-user-run":
				<i class="ph-bold ph-clock text-yellow-500"></i>
			case "pending":
				<i class="ph-bold ph-circle-dashed text-cool-grey-400"></i>
			case "cancelled", "discarded", "user-skipped", "auto-skipped":
				<i class="ph-bold ph-minus-circle text-cool-grey-400"></i>
			default:
				<i class="ph-bold ph-circle text-cool-grey-300"></i>
		}
	} else {
		<i class="ph-bold ph-circle text-cool-grey-300"></i>
	}
}

const panelContentTarget = "#debug-workflow-panel-content"
const panelWrapperTarget = "#debug-workflow-panel-wrapper"

// debugURL returns a URLBuilder pre-filled with all current debug page state.
func debugURL(props DebugWorkflowsPageProps) *utils.URLBuilder {
	return utils.NewURL(props.BasePath, "installs", props.Install.ID, "debug", "workflows", props.SelectedWorkflow.ID).
		Set("tab", debugTabParam(props.ActiveTab)).
		Set("step", selectedStepID(props)).
		Set("step_tab", debugTabParam(props.ActiveStepTab)).
		SetBool("expanded", props.Expanded).
		Set("target_tab", debugTabParam(props.ActiveTargetTab)).
		Set("stack_tab", debugTabParam(props.ActiveStackTab)).
		Set("group_tab", debugTabParam(props.ActiveGroupTab)).
		Set("signal_tab", debugTabParam(props.ActiveSignalTab)).
		Set("approval_tab", debugTabParam(props.ActiveApprovalTab)).
		Set("policy_tab", debugTabParam(props.ActivePolicyTab)).
		Set("alert_type", props.AlertType).
		SetEncoded("alert_msg", props.AlertMsg)
}

// debugTabParam returns empty for default "info" tab, otherwise the tab value.
func debugTabParam(tab string) string {
	if tab != "" && tab != "info" {
		return tab
	}
	return ""
}

// debugWorkflowRowURL returns the full page URL for a workflow row.
func debugWorkflowRowURL(props DebugWorkflowsPageProps, workflowID string) string {
	return utils.NewURL(props.BasePath, "installs", props.Install.ID, "debug", "workflows", workflowID).Build()
}

// debugWorkflowRowPartialURL returns the partial=panel URL for a workflow row.
func debugWorkflowRowPartialURL(props DebugWorkflowsPageProps, workflowID string) string {
	return utils.NewURL(props.BasePath, "installs", props.Install.ID, "debug", "workflows", workflowID).
		Set("partial", "panel").Build()
}

// debugListURL returns the URL for the debug workflow list (no workflow selected).
func debugListURL(props DebugWorkflowsPageProps) string {
	return utils.NewURL(props.BasePath, "installs", props.Install.ID, "debug", "workflows").Build()
}

// debugListPartialURL returns the partial=panel URL for the debug workflow list.
func debugListPartialURL(props DebugWorkflowsPageProps) string {
	return utils.NewURL(props.BasePath, "installs", props.Install.ID, "debug", "workflows").
		Set("partial", "panel").Build()
}

func debugPanelTabs(props DebugWorkflowsPageProps) []components.Tab {
	tabURL := func(tab string) *utils.URLBuilder {
		p := props
		p.ActiveTab = tab
		return debugURL(p)
	}
	return []components.Tab{
		{Label: "Info", Href: tabURL("info").Build(), HxGet: tabURL("info").Set("partial", "panel").Build(), HxTarget: panelWrapperTarget, HxSwap: "outerHTML", Active: props.ActiveTab == "info"},
		{Label: "Step Groups", Href: tabURL("step-groups").Build(), HxGet: tabURL("step-groups").Set("partial", "panel").Build(), HxTarget: panelWrapperTarget, HxSwap: "outerHTML", Active: props.ActiveTab == "step-groups"},
		{Label: "JSON", Href: tabURL("json").Build(), HxGet: tabURL("json").Set("partial", "panel").Build(), HxTarget: panelWrapperTarget, HxSwap: "outerHTML", Active: props.ActiveTab == "json"},
	}
}

func debugStepDetailTabs(props DebugWorkflowsPageProps) []components.Tab {
	tabURL := func(stepTab string) *utils.URLBuilder {
		p := props
		p.ActiveStepTab = stepTab
		return debugURL(p)
	}
	return []components.Tab{
		{Label: "Info", Href: tabURL("info").Build(), HxGet: tabURL("info").Set("partial", "step-card").Build(), HxTarget: "#debug-step-card-content", Active: props.ActiveStepTab == "info"},
		{Label: "JSON", Href: tabURL("json").Build(), HxGet: tabURL("json").Set("partial", "step-card").Build(), HxTarget: "#debug-step-card-content", Active: props.ActiveStepTab == "json"},
	}
}

