package pages

import (
	"encoding/json"
	"fmt"
	"strings"
	"time"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/components"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/partials"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/partials/workflows"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/utils"
	"github.com/nuonco/mono/services/customer-dashboard/pkg/nuon"
	nuonmodels "github.com/nuonco/nuon/sdks/nuon-go/models"
)

// DebugWorkflowsPageProps contains all data for the debug workflows page.
type DebugWorkflowsPageProps struct {
	customerui.LayoutProps
	Install          *models.Install
	AppName          string
	Workflows        []*nuon.Workflow
	Pagination       components.PaginationProps
	SelectedWorkflow    *nuon.Workflow     // nil when no workflow selected
	WorkflowJSON        string                      // pretty-printed JSON of selected workflow
	SelectedStep         *nuon.WorkflowStep // step to display in detail card
	SelectedStepIsActive bool                        // true when SelectedStep is the active step (not manually picked)
	ActiveTab            string                      // "info" or "json" — workflow panel tab
	ActiveStepTab        string                      // "info" or "json" — step detail tab
	Expanded             bool                        // whether the panel is expanded to full width
	SelectedStepTarget     interface{}                // typed target resource (e.g. *models.AppInstallDeploy)
	SelectedStepTargetJSON string                    // pretty-printed JSON of the step's target resource
	ActiveTargetTab        string                    // "info" or "json" — target card tab
	SelectedStepStackSetup partials.StackSetupData    // platform-specific stack setup data
	SelectedStepStackJSON  string                    // JSON of the full install stack
	ActiveStackTab         string                    // "info" or "json" — stack setup card tab
	ActiveGroupTab         string                    // "info" or "json" — step group card tab
	ActiveSignalTab        string                    // "info" or "json" — queue signal card tab
	ActiveApprovalTab      string                    // "info" or "json" — approval card tab
	ActivePolicyTab        string                    // "info" or "json" — policy validation card tab
	AlertType            string                      // "error", "success", or "" — type of alert to display
	AlertMsg             string                      // alert message text
	CurrentQuery         string                      // raw query string from the current request URL (for preserving state in form actions)
}

templ DebugWorkflowsPage(props DebugWorkflowsPageProps) {
	@customerui.Layout(props.LayoutProps) {
		@components.PageHeader(components.PageHeaderProps{
			Title: "Debug",
			Icon:  "bug",
		})
		<div class="px-6 pb-6">
			<!-- Tab bar -->
			<div class="flex gap-4 border-b mb-4" style="border-color: var(--theme-border-subtle)">
				<div class="px-1 pb-2 text-sm font-medium border-b-2" style="border-color: var(--theme-primary); color: var(--theme-primary)">
					Workflows
				</div>
			</div>
			if len(props.Workflows) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Title: "No workflows",
					Icon:  "ph-clock",
				})
			} else {
				<div class="overflow-x-auto">
					<table class="w-full text-sm">
						<thead>
							<tr class="text-left text-cool-grey-500 dark:text-cool-grey-400 text-xs uppercase tracking-wider">
								<th class="pb-2 pr-4 font-medium">ID</th>
								<th class="pb-2 pr-4 font-medium">Type</th>
								<th class="pb-2 pr-4 font-medium">Status</th>
								<th class="pb-2 pr-4 font-medium">Created</th>
								<th class="pb-2 font-medium">Duration</th>
							</tr>
						</thead>
						<tbody>
							for _, wf := range props.Workflows {
								<tr>
									<td class="py-2 pr-4" colspan="5">
										@debugWorkflowRow(props, wf)
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				@components.Pagination(props.Pagination)
			}
		</div>
		@DebugWorkflowPanel(props)
	}
}

templ debugWorkflowRow(props DebugWorkflowsPageProps, wf *nuon.Workflow) {
	<a
		href={ templ.SafeURL(debugWorkflowRowURL(props, wf.ID)) }
		hx-get={ debugWorkflowRowPartialURL(props, wf.ID) }
		hx-target={ panelWrapperTarget }
		hx-swap="outerHTML"
		hx-push-url={ debugWorkflowRowURL(props, wf.ID) }
		hx-boost="false"
		class={ "flex items-center gap-4 px-3 py-2 rounded-md hover:bg-cool-grey-100 dark:hover:bg-dark-grey-800 transition-colors cursor-pointer text-sm",
			templ.KV("bg-cool-grey-100 dark:bg-dark-grey-800", props.SelectedWorkflow != nil && props.SelectedWorkflow.ID == wf.ID) }
	>
		<span class="font-mono text-xs text-cool-grey-500 dark:text-cool-grey-400 w-24 truncate" title={ wf.ID }>{ truncateID(wf.ID) }</span>
		<span class="w-24">{ wf.Type }</span>
		<span class="w-28">
			@debugStatusBadge(wf.Status)
		</span>
		<span class="w-36 text-cool-grey-500 dark:text-cool-grey-400">{ formatTimestamp(wf.CreatedAt) }</span>
		<span class="text-cool-grey-500 dark:text-cool-grey-400">{ formatDuration(wf.ExecutionTime) }</span>
	</a>
}

templ debugStatusBadge(status *nuon.CompositeStatus) {
	if status != nil {
		<span class={ "inline-flex items-center px-2 py-0.5 rounded text-xs font-medium", debugStatusClasses(status.Status) }>
			{ status.Status }
		</span>
	}
}

// DebugWorkflowPanel renders the full panel with overlay (for HTMX outerHTML swaps on expand/collapse).
templ DebugWorkflowPanel(props DebugWorkflowsPageProps) {
	if props.SelectedWorkflow != nil {
		@components.Panel(components.PanelProps{
			Title:         "Workflow Detail",
			ID:            "debug-workflow-panel",
			Open:          true,
			Expanded:      props.Expanded,
			CloseURL:      debugListURL(props),
			HxCloseGet:    debugListPartialURL(props),
			ExpandURL:     debugExpandURL(props, true),
			CollapseURL:   debugExpandURL(props, false),
			HxExpandGet:   debugExpandPartialURL(props, true),
			HxCollapseGet: debugExpandPartialURL(props, false),
		}) {
			@DebugWorkflowPanelContent(props)
		}
	} else {
		@components.Panel(components.PanelProps{
			Title: "Workflow Detail",
			ID:    "debug-workflow-panel",
			Open:  false,
		})
	}
}

// DebugWorkflowPanelContentWithOOB renders panel content + OOB swaps for panel/overlay classes.
templ DebugWorkflowPanelContentWithOOB(props DebugWorkflowsPageProps) {
	if props.SelectedWorkflow != nil {
		@DebugWorkflowPanelContent(props)
	}
	<div
		id="debug-workflow-panel"
		class={ "secondary-panel", templ.KV("open", props.SelectedWorkflow != nil), templ.KV("panel-full", props.Expanded) }
		hx-swap-oob="morph"
	></div>
	<div
		id="debug-workflow-panel-overlay"
		class={ "secondary-panel-overlay", templ.KV("open", props.SelectedWorkflow != nil) }
		hx-swap-oob="morph"
	></div>
}

// DebugWorkflowPanelContent renders just the panel inner content (for HTMX partial swaps).
templ DebugWorkflowPanelContent(props DebugWorkflowsPageProps) {
	@components.TabBar(components.TabBarProps{
		Tabs: debugPanelTabs(props),
	})
	if props.ActiveTab == "json" {
		@debugAPIEndpoint(fmt.Sprintf("GET /v1/workflows/%s", props.SelectedWorkflow.ID))
		@components.CodeBlock(props.WorkflowJSON, "json")
	} else if props.ActiveTab == "step-groups" {
		@debugWorkflowStepsTab(props)
	} else {
		@debugWorkflowInfoTab(props)
	}
}

templ debugWorkflowInfoTab(props DebugWorkflowsPageProps) {
	<!-- Top-level info card -->
	@components.Card(components.CardProps{Header: debugWorkflowCardHeader(props.SelectedWorkflow.Name, props.SelectedWorkflow.ID, workflowStatus(props.SelectedWorkflow))}) {
		<div class="grid grid-cols-2 gap-6">
			<div class="space-y-2">
				@debugInfoRow("Type", props.SelectedWorkflow.Type)
				@debugInfoRow("Plan Only", fmt.Sprintf("%v", props.SelectedWorkflow.PlanOnly))
				@debugInfoRow("Approval", props.SelectedWorkflow.ApprovalOption)
				@debugInfoRow("Owner", fmt.Sprintf("%s (%s)", props.SelectedWorkflow.OwnerType, props.SelectedWorkflow.OwnerID))
			</div>
			<div class="space-y-2">
				@debugInfoRow("Created", formatTimestamp(props.SelectedWorkflow.CreatedAt))
				@debugInfoRow("Started", formatTimestamp(props.SelectedWorkflow.StartedAt))
				@debugInfoRow("Finished", formatTimestamp(props.SelectedWorkflow.FinishedAt))
				@debugInfoRow("Duration", formatDuration(props.SelectedWorkflow.ExecutionTime))
			</div>
		</div>
		<!-- Action buttons -->
		@debugWorkflowActions(props)
	}
	if props.AlertType != "" && props.AlertMsg != "" {
		<div class="mt-4 relative">
			@components.Alert(components.AlertProps{Type: props.AlertType, Message: props.AlertMsg})
			<a
				href={ templ.SafeURL(debugDismissAlertURL(props)) }
				hx-get={ debugDismissAlertPartialURL(props) }
				hx-target={ panelWrapperTarget }
				hx-swap="outerHTML"
				hx-push-url={ debugDismissAlertURL(props) }
				hx-boost="false"
				class="absolute top-3 right-3 text-cool-grey-400 hover:text-cool-grey-600 dark:hover:text-cool-grey-200"
			>
				<i class="ph-bold ph-x text-sm"></i>
			</a>
		</div>
	}
}

templ debugWorkflowStepsTab(props DebugWorkflowsPageProps) {
	if len(props.SelectedWorkflow.StepGroups) > 0 {
		<div class="@container">
			<div class="flex flex-col @5xl:flex-row @5xl:items-start gap-4">
				<div class="@5xl:w-1/3 @5xl:shrink-0 @5xl:min-w-0">
					@components.Card(components.CardProps{Header: debugStepGroupsCardHeader(props.SelectedWorkflow)}) {
						for i, group := range props.SelectedWorkflow.StepGroups {
							if i > 0 {
								<div class="border-b" style="border-color: var(--theme-border-subtle)"></div>
							}
							<div class="py-2">
								<div class="px-3 py-1.5 flex items-center gap-2">
									<span class="text-xs font-medium" style="color: var(--theme-text-muted)">
										if group.Name != "" {
											{ group.Name }
										} else {
											{ fmt.Sprintf("Group %d", group.GroupIdx) }
										}
									</span>
									@debugStatusBadge(groupStatusPtr(group))
									if group.Parallel {
										<span class="text-[10px] px-1 py-0.5 rounded" style="background: var(--theme-surface-secondary); color: var(--theme-text-muted)">parallel</span>
									}
									<span class="ml-auto text-[10px]" style="color: var(--theme-text-muted)">
										{ fmt.Sprintf("%d steps", len(group.Steps)) }
									</span>
								</div>
								<div class="space-y-0.5">
									for _, step := range group.Steps {
										@debugStepRow(props, step)
									}
								</div>
							</div>
						}
					}
				</div>
				if props.SelectedStep != nil {
					<div class="@5xl:w-2/3 @5xl:min-w-0 space-y-4">
						@debugGroupInfoCard(props)
						@debugSelectedStepCard(props)
						if props.SelectedStep.Approval != nil {
							@debugApprovalCard(props)
						}
						if props.SelectedStep.PolicyValidation != nil {
							@debugPolicyValidationCard(props)
						}
						@debugStepTargetCard(props)
						if props.SelectedStepStackJSON != "" {
							@debugStackSetupCard(props)
						}
					</div>
				}
			</div>
		</div>
	} else {
		@components.EmptyState(components.EmptyStateProps{
			Title: "No step groups",
			Icon:  "ph-list",
		})
	}
}

templ debugStepTargetCard(props DebugWorkflowsPageProps) {
	if props.SelectedStep.StepTargetType != "" && props.SelectedStep.StepTargetID != "" {
		@components.Card(components.CardProps{Header: debugTargetCardHeader(props.SelectedStep.StepTargetType, props.SelectedStep.StepTargetID)}) {
			<div id="debug-target-card-content">
				@DebugTargetCardContent(props)
			</div>
		}
	}
}

// DebugTargetCardContent renders the target card's tab bar + content (for HTMX partial swaps).
templ DebugTargetCardContent(props DebugWorkflowsPageProps) {
	if props.SelectedStepTargetJSON != "" {
		@components.TabBar(components.TabBarProps{
			Tabs: debugTargetTabs(props),
		})
		if props.ActiveTargetTab == "json" {
			@debugAPIEndpoint(debugTargetEndpoint(props))
			@components.CodeBlock(props.SelectedStepTargetJSON, "json")
		} else {
			@debugTargetInfo(props)
		}
	} else {
		<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400">
			Target type <span class="font-mono">{ props.SelectedStep.StepTargetType }</span> is not yet supported.
		</p>
	}
}

templ debugTargetCardHeader(targetType, targetID string) {
	<div class="flex items-center justify-between">
		<h4 class="text-base text-cool-grey-900 dark:text-white">Target</h4>
		<div class="flex items-center gap-2 text-xs text-cool-grey-500 dark:text-cool-grey-400 font-mono">
			<span>{ targetType }</span>
			<span>{ targetID }</span>
		</div>
	</div>
}

templ debugTargetInfo(props DebugWorkflowsPageProps) {
	switch target := props.SelectedStepTarget.(type) {
		case *nuonmodels.AppInstallDeploy:
			@debugTargetInfoDeploy(target)
		case *nuonmodels.AppInstallSandboxRun:
			@debugTargetInfoSandboxRun(target)
		case *nuonmodels.AppInstallActionWorkflowRun:
			@debugTargetInfoActionRun(target)
		case *nuonmodels.AppInstallStackVersion:
			@debugTargetInfoStackVersion(target)
		case map[string]interface{}:
			@debugTargetInfoGeneric(target)
		default:
			<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400 italic">No info view available for this target type.</p>
	}
}

templ debugTargetInfoDeploy(d *nuonmodels.AppInstallDeploy) {
	<div class="grid grid-cols-2 gap-6">
		<div class="space-y-2">
			@debugInfoRow("ID", d.ID)
			@debugInfoRow("Component", d.ComponentName)
			@debugInfoRow("Component ID", d.ComponentID)
			@debugInfoRow("Deploy Type", string(d.InstallDeployType))
			@debugInfoRow("Status", d.Status)
			@debugInfoRow("Plan Only", fmt.Sprintf("%v", d.PlanOnly))
		</div>
		<div class="space-y-2">
			@debugInfoRow("Created", formatTimestamp(d.CreatedAt))
			@debugInfoRow("Status", d.StatusDescription)
			if d.BuildID != "" {
				@debugInfoRow("Build ID", d.BuildID)
			}
			if d.ReleaseID != "" {
				@debugInfoRow("Release ID", d.ReleaseID)
			}
		</div>
	</div>
}

templ debugTargetInfoSandboxRun(r *nuonmodels.AppInstallSandboxRun) {
	<div class="grid grid-cols-2 gap-6">
		<div class="space-y-2">
			@debugInfoRow("ID", r.ID)
			@debugInfoRow("Status", r.Status)
			@debugInfoRow("Run Type", string(r.RunType))
			@debugInfoRow("Status Description", r.StatusDescription)
		</div>
		<div class="space-y-2">
			@debugInfoRow("Created", formatTimestamp(r.CreatedAt))
			@debugInfoRow("Updated", formatTimestamp(r.UpdatedAt))
			@debugInfoRow("Install ID", r.InstallID)
		</div>
	</div>
}

templ debugTargetInfoActionRun(r *nuonmodels.AppInstallActionWorkflowRun) {
	<div class="grid grid-cols-2 gap-6">
		<div class="space-y-2">
			@debugInfoRow("ID", r.ID)
			@debugInfoRow("Status", r.Status)
			@debugInfoRow("Trigger Type", string(r.TriggerType))
			@debugInfoRow("Status Description", r.StatusDescription)
		</div>
		<div class="space-y-2">
			@debugInfoRow("Created", formatTimestamp(r.CreatedAt))
			@debugInfoRow("Duration", formatDuration(r.ExecutionTime))
			@debugInfoRow("Install ID", r.InstallID)
		</div>
	</div>
}

templ debugTargetInfoStackVersion(v *nuonmodels.AppInstallStackVersion) {
	<div class="grid grid-cols-2 gap-6">
		<div class="space-y-2">
			@debugInfoRow("ID", v.ID)
			if v.CompositeStatus != nil {
				@debugInfoRow("Status", string(v.CompositeStatus.Status))
			}
			@debugInfoRow("Install ID", v.InstallID)
			if v.Checksum != "" {
				@debugInfoRow("Checksum", v.Checksum)
			}
		</div>
		<div class="space-y-2">
			@debugInfoRow("Created", formatTimestamp(v.CreatedAt))
			if v.AppConfigID != "" {
				@debugInfoRow("App Config ID", v.AppConfigID)
			}
		</div>
	</div>
}

templ debugTargetInfoGeneric(data map[string]interface{}) {
	<div class="space-y-2">
		for k, v := range data {
			if s, ok := v.(string); ok && s != "" {
				@debugInfoRow(k, s)
			}
		}
	</div>
}

templ debugStackSetupCard(props DebugWorkflowsPageProps) {
	@components.Card(components.CardProps{Header: debugStackSetupCardHeader(props.SelectedStepStackSetup.Platform)}) {
		<div id="debug-stack-card-content">
			@DebugStackCardContent(props)
		</div>
	}
}

// DebugStackCardContent renders the stack setup card's tab bar + content (for HTMX partial swaps).
templ DebugStackCardContent(props DebugWorkflowsPageProps) {
	@components.TabBar(components.TabBarProps{
		Tabs: debugStackSetupTabs(props),
	})
	if props.ActiveStackTab == "json" {
		@debugAPIEndpoint(fmt.Sprintf("GET /v1/installs/%s/stack", props.Install.NuonInstallID))
		@components.CodeBlock(props.SelectedStepStackJSON, "json")
	} else {
		@debugStackSetupInfo(props)
	}
}

templ debugStackSetupCardHeader(platform string) {
	<div class="flex items-center justify-between">
		<h4 class="text-base text-cool-grey-900 dark:text-white">Stack Setup</h4>
		if platform != "" {
			<span class="text-xs text-cool-grey-500 dark:text-cool-grey-400 font-mono">{ platform }</span>
		}
	</div>
}

templ debugStackSetupInfo(props DebugWorkflowsPageProps) {
	switch props.SelectedStepStackSetup.Platform {
		case "aws":
			@debugStackSetupAWS(props.SelectedStepStackSetup)
		case "gcp":
			@debugStackSetupGCP(props.SelectedStepStackSetup)
		case "azure":
			@debugStackSetupAzure(props.SelectedStepStackSetup)
		default:
			@debugInfoRow("Platform", props.SelectedStepStackSetup.Platform)
	}
}

templ debugStackSetupAWS(setup partials.StackSetupData) {
	<div class="space-y-3">
		<p class="text-sm">Complete setup in AWS Console</p>
		if setup.CloudFormationLink != "" {
			<a
				href={ templ.SafeURL(setup.CloudFormationLink) }
				target="_blank"
				rel="noopener noreferrer"
				class="button button-primary btn-theme-primary inline-flex items-center gap-2 text-sm"
			>
				Open in AWS
				<i class="ph-bold ph-arrow-square-out text-base"></i>
			</a>
		} else {
			<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400 italic">No CloudFormation link available.</p>
		}
	</div>
}

templ debugStackSetupGCP(setup partials.StackSetupData) {
	<div class="space-y-4">
		<div>
			<p class="text-sm font-medium mb-1">1. Clone the install stack module</p>
			@components.CodeBlock("git clone https://github.com/nuonco/install-stacks.git\ncd install-stacks/gcp", "bash")
		</div>
		<div>
			<p class="text-sm font-medium mb-1">2. Configure remote state (recommended)</p>
			<p class="text-xs text-cool-grey-500 dark:text-cool-grey-400 mb-2">Create a <code class="text-xs">backend.tf</code> file to store Terraform state in GCS</p>
			@components.CodeBlock(workflows.GcpBackendSnippet(setup.NuonInstallID), "hcl")
		</div>
		if setup.TfvarsContent != "" {
			<div>
				<p class="text-sm font-medium mb-1">3. Save the install configuration</p>
				<p class="text-xs text-cool-grey-500 dark:text-cool-grey-400 mb-2">Save this as <code class="text-xs">install.tfvars</code></p>
				@components.CodeBlock(setup.TfvarsContent, "hcl")
			</div>
		}
		<div>
			<p class="text-sm font-medium mb-1">4. Apply with Terraform</p>
			@components.CodeBlock(workflows.GcpApplyCmd(), "bash")
		</div>
	</div>
}

templ debugStackSetupAzure(setup partials.StackSetupData) {
	<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400 italic">Azure stack setup info view coming soon. Check the JSON tab for raw data.</p>
}

templ debugSelectedStepCard(props DebugWorkflowsPageProps) {
	@components.Card(components.CardProps{Header: debugStepCardHeader(props.SelectedStep), Footer: debugStepActions(props)}) {
		@debugStepTabs(props)
	}
}

templ debugStepCardHeader(step *nuon.WorkflowStep) {
	<div class="flex items-center justify-between">
		<h4 class="text-base text-cool-grey-900 dark:text-white">{ step.Name }</h4>
		if step.Status != nil {
			<span class={ "inline-flex items-center px-2 py-0.5 rounded text-xs font-medium", debugStatusClasses(step.Status.Status) }>
				{ step.Status.Status }
			</span>
		}
	</div>
}

templ debugStepTabs(props DebugWorkflowsPageProps) {
	<div id="debug-step-card-content">
		@DebugStepCardContent(props)
	</div>
}

// DebugStepCardContent renders the step card's tab bar + content (for HTMX partial swaps).
templ DebugStepCardContent(props DebugWorkflowsPageProps) {
	@components.TabBar(components.TabBarProps{
		Tabs: debugStepDetailTabs(props),
	})
	if props.ActiveStepTab == "json" {
		@debugAPIEndpoint(fmt.Sprintf("GET /v1/workflows/%s → steps[]", props.SelectedWorkflow.ID))
		@components.CodeBlock(mustMarshalJSON(props.SelectedStep), "json")
	} else {
		@debugStepInfoDefault(props.SelectedStep)
	}
}

templ debugStepActions(props DebugWorkflowsPageProps) {
	<div class="flex justify-end gap-2">
		if props.SelectedStep.Approval != nil {
			<!-- Approve -->
			<form method="POST" action={ templ.SafeURL(debugActionURL(props, "approve")) }>
				if stepCanApprove(props.SelectedStep) {
					<input type="hidden" name="step_id" value={ props.SelectedStep.ID }/>
					<input type="hidden" name="approval_id" value={ props.SelectedStep.Approval.ID }/>
				}
				<button
					type="submit"
					class="button button-primary btn-theme-primary text-xs px-3 py-1.5 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-transparent"
					disabled?={ !stepCanApprove(props.SelectedStep) }
				>
					Approve
				</button>
			</form>
		}
		if props.SelectedStep.Retryable {
			<!-- Retry -->
			<form method="POST" action={ templ.SafeURL(debugActionURL(props, "retry")) }>
				if stepCanRetry(props.SelectedStep) {
					<input type="hidden" name="step_id" value={ props.SelectedStep.ID }/>
				}
				<button
					type="submit"
					class="button button-neutral btn-neutral text-xs px-3 py-1.5 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-transparent"
					disabled?={ !stepCanRetry(props.SelectedStep) }
				>
					Retry
				</button>
			</form>
		}
		if props.SelectedStep.Skippable {
			<!-- Skip (no backend support yet) -->
			<button
				type="button"
				class="button button-neutral btn-neutral text-xs px-3 py-1.5 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-transparent"
				disabled
				title="Skip is not yet supported by the API"
			>
				Skip
			</button>
		}
	</div>
}

templ debugStepInfoDefault(step *nuon.WorkflowStep) {
	<div class="grid grid-cols-2 gap-6">
		<div class="space-y-2">
			@debugInfoRow("Execution Type", step.ExecutionType)
			@debugInfoRow("Group", stepGroupLabel(step))
		</div>
		<div class="space-y-2">
			@debugInfoRow("Created", formatTimestamp(step.CreatedAt))
			@debugInfoRow("Started", formatTimestamp(step.StartedAt))
			@debugInfoRow("Finished", formatTimestamp(step.FinishedAt))
			@debugInfoRow("Duration", formatDuration(step.ExecutionTime))
		</div>
	</div>
	<!-- Flags -->
	<div class="flex gap-2 mt-4">
		@debugStepFlag("Retryable", step.Retryable)
		@debugStepFlag("Retried", step.Retried)
		@debugStepFlag("Skippable", step.Skippable)
		@debugStepFlag("Finished", step.Finished)
	</div>
	<!-- Metadata -->
	if len(step.Metadata) > 0 {
		<div class="mt-4 border-t pt-4" style="border-color: var(--theme-border-subtle)">
			<h5 class="text-sm font-medium text-cool-grey-900 dark:text-white mb-2">Metadata</h5>
			<div class="space-y-2">
				for k, v := range step.Metadata {
					@debugInfoRow(k, v)
				}
			</div>
		</div>
	}
}

templ debugStepFlag(label string, value bool) {
	<span class={ "inline-flex items-center px-2 py-0.5 rounded text-xs font-medium",
		templ.KV("bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200", value),
		templ.KV("bg-cool-grey-100 text-cool-grey-500 dark:bg-dark-grey-700 dark:text-cool-grey-400", !value) }>
		{ label }
	</span>
}

templ debugApprovalCard(props DebugWorkflowsPageProps) {
	@components.Card(components.CardProps{Title: "Approval"}) {
		<div id="debug-approval-card-content">
			@DebugApprovalCardContent(props)
		</div>
	}
}

templ DebugApprovalCardContent(props DebugWorkflowsPageProps) {
	@components.TabBar(components.TabBarProps{
		Tabs: debugApprovalTabs(props),
	})
	if props.ActiveApprovalTab == "json" {
		@debugAPIEndpoint(fmt.Sprintf("GET /v1/workflows/%s → steps[].approval", props.SelectedWorkflow.ID))
		@components.CodeBlock(mustMarshalJSON(props.SelectedStep.Approval), "json")
	} else {
		@debugApprovalInfo(props.SelectedStep.Approval)
	}
}

templ debugApprovalInfo(approval *nuon.WorkflowStepApproval) {
	<div class="grid grid-cols-2 gap-6">
		<div class="space-y-2">
			@debugInfoRow("ID", approval.ID)
			@debugInfoRow("Type", approval.Type)
			@debugInfoRow("Created", formatTimestamp(approval.CreatedAt))
		</div>
		<div class="space-y-2">
			@debugInfoRow("Owner", fmt.Sprintf("%s / %s", approval.OwnerType, approval.OwnerID))
			if approval.RunnerJobID != nil {
				@debugInfoRow("Runner Job", *approval.RunnerJobID)
			}
		</div>
	</div>
	if approval.Response != nil {
		<div class="mt-4 border-t pt-4" style="border-color: var(--theme-border-subtle)">
			<h5 class="text-sm font-medium text-cool-grey-900 dark:text-white mb-2">Response</h5>
			<div class="space-y-2">
				@debugInfoRow("ID", approval.Response.ID)
				@debugInfoRow("Type", approval.Response.Type)
				@debugInfoRow("Created", formatTimestamp(approval.Response.CreatedAt))
				if approval.Response.Note != "" {
					@debugInfoRow("Note", approval.Response.Note)
				}
			</div>
		</div>
	}
}

