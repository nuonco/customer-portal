package pages

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/components"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/utils"
)

// RegisterPageProps for the customer registration page
type RegisterPageProps struct {
	Title       string
	BasePath    string
	RedirectURL string
	Theme       *models.AppTheme
	Error       string
	CSSPath     string
}

// RegisterPage renders the customer registration page
templ RegisterPage(props RegisterPageProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.Title }</title>
			if props.Theme != nil && props.Theme.FaviconBase64 != "" {
				<link rel="icon" href={ templ.SafeURL(props.Theme.FaviconBase64) }/>
			}
			<link href={ props.CSSPath } rel="stylesheet"/>
			@registerDarkModeScript()
			@registerFontLinks(props.Theme)
			<script src="https://unpkg.com/htmx.org@1.9.10"></script>
			@registerThemeStyles(props.Theme)
		</head>
		<body class="bg-cool-grey-50 dark:bg-dark-grey-950 dark:text-white">
			<nav class="bg-theme-primary text-white p-4">
				<div class="container mx-auto flex justify-between items-center">
					<div class="flex items-center space-x-3">
						if props.Theme != nil {
							if props.Theme.LogoDarkBase64 != "" {
								<!-- Both logos available - show appropriate one based on dark mode -->
								<img src={ props.Theme.LogoLightBase64 } alt="Logo" class="h-8 w-auto max-w-xs object-contain dark:hidden"/>
								<img src={ props.Theme.LogoDarkBase64 } alt="Logo" class="h-8 w-auto max-w-xs object-contain hidden dark:block"/>
							} else if props.Theme.LogoLightBase64 != "" {
								<!-- Only light logo available - show in both modes -->
								<img src={ props.Theme.LogoLightBase64 } alt="Logo" class="h-8 w-auto max-w-xs object-contain"/>
							}
						}
						<h1 class="text-xl font-heading font-semibold">{ props.Title }</h1>
					</div>
				</div>
			</nav>
			<main class="container mx-auto p-4">
				@components.Card(components.CardProps{Class: "max-w-md mx-auto mt-10"}) {
					<h2 class="text-2xl font-bold mb-6 text-center text-cool-grey-900 dark:text-white">{ props.Title }</h2>
					if props.Error != "" {
						<div class="mb-4 alert-error">
							{ props.Error }
						</div>
					}
					<form id="registerForm" class="space-y-4">
						<div>
							<label for="name" class="field-label">
								Name
							</label>
							<input
								type="text"
								id="name"
								name="name"
								required
								class="mt-1 field-input"
								placeholder="Enter your name"
							/>
						</div>
						<div>
							<label for="email" class="field-label">
								Email
							</label>
							<input
								type="email"
								id="email"
								name="email"
								required
								class="mt-1 field-input"
								placeholder="Enter your email"
							/>
						</div>
						<div>
							<label for="password" class="field-label">
								Password
							</label>
							<input
								type="password"
								id="password"
								name="password"
								required
								minlength="8"
								class="mt-1 field-input"
								placeholder="Enter your password (min 8 characters)"
							/>
						</div>
						<div>
							<label for="confirmPassword" class="field-label">
								Confirm Password
							</label>
							<input
								type="password"
								id="confirmPassword"
								name="confirmPassword"
								required
								minlength="8"
								class="mt-1 field-input"
								placeholder="Confirm your password"
							/>
						</div>
						<button
							type="submit"
							class="button button-primary w-full btn-theme-primary"
						>
							Create Account
						</button>
					</form>
					<p class="mt-4 text-sm text-cool-grey-600 dark:text-cool-grey-400 text-center">
						Already have an account?
						if props.RedirectURL != "" {
							<a href={ templ.SafeURL(props.BasePath + "/login?redirect=" + props.RedirectURL) } class="text-primary-600 hover:text-primary-700 dark:text-primary-400">Sign in</a>
						} else {
							<a href={ templ.SafeURL(props.BasePath + "/login") } class="text-primary-600 hover:text-primary-700 dark:text-primary-400">Sign in</a>
						}
					</p>
					<div id="error" class="mt-4 alert-error hidden"></div>
				}
			</main>
			<!-- Config data for JavaScript -->
			<div id="register-config" class="hidden" data-register-url={ props.BasePath + "/register" } data-login-url={ props.BasePath + "/login" } data-redirect-url={ props.RedirectURL }></div>
			@customerRegisterScript()
		</body>
	</html>
}

templ registerDarkModeScript() {
	<script>
		(function() {
			if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
				document.documentElement.classList.add('dark');
			}
			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
				document.documentElement.classList.toggle('dark', e.matches);
			});
		})();
	</script>
}

templ registerFontLinks(theme *models.AppTheme) {
	<link rel="preconnect" href="https://fonts.googleapis.com"/>
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
	if theme != nil && theme.HeadingFontBase64 != "" {
		<style>
			@font-face {
				font-family: 'CustomHeading';
				src: url({ theme.HeadingFontBase64 }) format('woff2');
				font-display: swap;
			}
		</style>
	}
	if theme != nil && theme.BodyFontBase64 != "" {
		<style>
			@font-face {
				font-family: 'CustomBody';
				src: url({ theme.BodyFontBase64 }) format('woff2');
				font-display: swap;
			}
		</style>
	}
}

templ registerThemeStyles(theme *models.AppTheme) {
	@templ.Raw(utils.BuildLoginThemeCSS(theme))
}

templ customerRegisterScript() {
	<script>
		(function() {
			var config = document.getElementById("register-config");
			var registerURL = config.dataset.registerUrl;
			var loginURL = config.dataset.loginUrl;
			var redirectTo = config.dataset.redirectUrl;

			document.getElementById("registerForm").addEventListener("submit", async function(e) {
				e.preventDefault();

				var name = document.getElementById("name").value;
				var email = document.getElementById("email").value;
				var password = document.getElementById("password").value;
				var confirmPassword = document.getElementById("confirmPassword").value;
				var errorDiv = document.getElementById("error");

				// Validate passwords match
				if (password !== confirmPassword) {
					errorDiv.textContent = "Passwords do not match";
					errorDiv.classList.remove("hidden");
					return;
				}

				try {
					var response = await fetch(registerURL, {
						method: "POST",
						headers: {
							"Content-Type": "application/json"
						},
						body: JSON.stringify({ name: name, email: email, password: password })
					});

					var data = await response.json();

					if (response.ok) {
						document.cookie = "jwt=" + encodeURIComponent(data.token) + "; path=/";
						// Redirect to provided URL or default to /installs
						window.location.href = redirectTo || "/installs";
					} else {
						errorDiv.textContent = data.message || "Registration failed";
						errorDiv.classList.remove("hidden");
					}
				} catch (error) {
					errorDiv.textContent = "Network error. Please try again.";
					errorDiv.classList.remove("hidden");
				}
			});
		})();
	</script>
}
