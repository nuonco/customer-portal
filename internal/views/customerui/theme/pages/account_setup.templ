package pages

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/components"
)

// AccountSetupPageProps for the account setup page
type AccountSetupPageProps struct {
	LayoutProps      customerui.LayoutProps
	HasOtherAccounts bool
}

// AccountSetupPage renders the create-account form for new customers.
templ AccountSetupPage(props AccountSetupPageProps) {
	@customerui.Layout(props.LayoutProps) {
		<div class="min-h-[60vh] flex items-center justify-center px-4">
			<div class="w-full max-w-md">
				@components.Card(components.CardProps{Class: "p-8"}) {
					<div class="text-center mb-6">
						<h2 class="page-title mb-2">Create your group</h2>
						<p class="text-cool-grey-600 dark:text-cool-grey-400">Enter your company name to get started. Team members can be invited later.</p>
					</div>
					<form
						hx-post="/account/create"
						class="space-y-4"
					>
						<div>
							<label for="name" class="field-label">Company Name</label>
							<input
								type="text"
								id="name"
								name="name"
								required
								class="mt-1 field-input"
								placeholder="e.g. Acme Inc."
								autofocus
							/>
						</div>
						<div class="flex justify-end gap-3">
							if props.HasOtherAccounts {
								<a href="/account" class="button button-outline btn-theme-outline px-4 py-2 text-sm">Cancel</a>
							}
							<button type="submit" class="button button-primary btn-theme-primary px-4 py-2 text-sm">
								Create
							</button>
						</div>
					</form>
					<div id="error" class="mt-4 alert-error hidden"></div>
				}
			</div>
		</div>
	}
}
