package pages

import (
	"fmt"

	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/components"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/partials"
)

// CustomerAppsPageProps for the customer apps catalog page
type CustomerAppsPageProps struct {
	customerui.LayoutProps
	Apps []partials.PublishedAppDisplay
}

// CustomerAppDetailPageProps for the single app detail page
type CustomerAppDetailPageProps struct {
	customerui.LayoutProps
	App partials.PublishedAppDisplay
}

// CustomerAppsPage renders the customer-facing app catalog
templ CustomerAppsPage(props CustomerAppsPageProps) {
	@customerui.Layout(props.LayoutProps) {
		@components.PageHeader(components.PageHeaderProps{Title: "App Catalog", Icon: "squares-four"}) {
			if len(props.Apps) == 1 && props.Apps[0].Status == "coming_soon" {
				<span class="inline-flex items-center px-3 py-1.5 rounded-md text-sm font-medium bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200">Coming Soon</span>
			} else if len(props.Apps) == 1 {
				<a href={ templ.SafeURL(fmt.Sprintf("%s/apps/%s/install", props.BasePath, props.Apps[0].AppID)) } class="button button-primary btn-theme-primary">Install</a>
			}
		}
		<div class="px-6 pb-6">
			if props.NuonAPIError != "" {
				<div class="mb-6">
					@components.Alert(components.AlertProps{
						Type:    "error",
						Message: props.NuonAPIError,
					})
				</div>
			}
			if len(props.Apps) == 1 {
				@appFullWidthCard(props.Apps[0], props.BasePath)
			} else if len(props.Apps) > 1 {
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
					for _, app := range props.Apps {
						@appCatalogCard(app, props.BasePath)
					}
				</div>
			} else {
				@components.EmptyState(components.EmptyStateProps{
				Title:   "No Apps Available",
				Icon:    "ph-tray",
			})
			}
		</div>
	}
}

templ appFullWidthCard(app partials.PublishedAppDisplay, basePath string) {
	@partials.AppInfoCard(app, basePath)
}

templ appCatalogCard(app partials.PublishedAppDisplay, basePath string) {
	@components.Card(components.CardProps{Class: "flex flex-col"}) {
		<div class="mb-4">
			<div class="flex items-start justify-between">
				<div class="flex items-center gap-2 min-w-0">
					if app.LogoLightBase64 != "" || app.LogoDarkBase64 != "" {
						if app.LogoDarkBase64 != "" {
							<img src={ app.LogoLightBase64 } class="w-8 h-8 rounded object-contain flex-shrink-0 dark:hidden" alt=""/>
							<img src={ app.LogoDarkBase64 } class="w-8 h-8 rounded object-contain flex-shrink-0 hidden dark:block" alt=""/>
						} else {
							<img src={ app.LogoLightBase64 } class="w-8 h-8 rounded object-contain flex-shrink-0" alt=""/>
						}
					}
				</div>
				@components.PlatformChip(app.Platform)
			</div>
			<h3 class="text-sm font-semibold text-cool-grey-900 dark:text-white truncate mt-2">{ app.AppName }</h3>
			if app.Description != "" {
				<p class="text-xs text-cool-grey-700 dark:text-cool-grey-300 mt-2">{ app.Description }</p>
			}
		</div>
		<div class="mt-auto pt-4 flex justify-end">
				<a
					href={ templ.SafeURL(fmt.Sprintf("%s/apps/%s", basePath, app.AppID)) }
					class="inline-flex items-center gap-1 text-sm font-medium text-theme-primary border-b border-transparent hover:border-theme-primary"
				>
					View
					<i class="ph-bold ph-caret-right text-base"></i>
				</a>
		</div>
	}
}

// CustomerAppDetailPage renders the full detail view for a single published app.
templ CustomerAppDetailPage(props CustomerAppDetailPageProps) {
	@customerui.Layout(props.LayoutProps) {
		@components.PageHeader(components.PageHeaderProps{BackLink: props.BasePath + "/apps", BackText: "Back to catalog"}) {
			if props.App.Status == "coming_soon" {
				<span class="inline-flex items-center px-3 py-1.5 rounded-md text-sm font-medium bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200">Coming Soon</span>
			} else {
				<a href={ templ.SafeURL(props.BasePath + "/apps/" + props.App.AppID + "/install") } class="button button-primary btn-theme-primary">Install</a>
			}
		}
		<div class="px-6 pb-6">
			if props.NuonAPIError != "" {
				<div class="mb-6">
					@components.Alert(components.AlertProps{
						Type:    "error",
						Message: props.NuonAPIError,
					})
				</div>
			}
			@appFullWidthCard(props.App, props.BasePath)
		</div>
	}
}
