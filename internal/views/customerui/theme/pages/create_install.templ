package pages

import (
	"github.com/nuonco/customer-portal/internal/views/customerui"
	"github.com/nuonco/customer-portal/internal/views/customerui/theme/partials/wizard"
)

// CreateInstallPage renders the unified install form (full page with layout).
templ CreateInstallPage(props wizard.ConfigureStepProps) {
	@customerui.Layout(props.LayoutProps) {
		@CreateInstallPageContent(props)
	}
}

// CreateInstallPageContent renders the configure step content without layout
// (used by install-link standalone page for partial swaps).
templ CreateInstallPageContent(props wizard.ConfigureStepProps) {
	<input type="hidden" id="wizard-step-idx" value="0"/>
	<div class="max-w-4xl mx-auto pt-6 mb-6">
		@inputsStepIndicator()
	</div>
	@wizard.ConfigureStep(props)
}

// inputsStepIndicator renders the wizard step bar with "Configure" as active.
templ inputsStepIndicator() {
	<nav class="flex items-center justify-between">
		for i, step := range []struct{ Name, Icon string }{
			{"Configure", "ph-sliders-horizontal"},
			{"Stack", "ph-stack"},
			{"Sandbox", "ph-shipping-container"},
			{"Components", "ph-cards"},
		} {
			<div class="flex items-center gap-2 flex-1">
				<div class={
					"flex items-center gap-2 px-3 py-2 rounded-lg text-sm transition-colors flex-1 justify-center",
					templ.KV("font-medium", i == 0),
					templ.KV("text-cool-grey-400 dark:text-cool-grey-600", i > 0),
				}>
					if i == 0 {
						<i class={ "ph-bold text-base", step.Icon }></i>
					} else {
						<i class={ "ph-bold text-base", step.Icon }></i>
					}
					<span class="hidden sm:inline">{ step.Name }</span>
				</div>
			</div>
		}
	</nav>
}
