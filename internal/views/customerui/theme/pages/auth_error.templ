package pages

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui"
)

// AuthErrorPageProps contains data needed for the authentication error page
type AuthErrorPageProps struct {
	LayoutProps customerui.LayoutProps
	Message     string
}

// AuthErrorPage renders an authentication error page with a friendly message
// This is used when OIDC authentication fails (invalid state, missing code, etc.)
templ AuthErrorPage(props AuthErrorPageProps) {
	@customerui.Layout(props.LayoutProps) {
		<div class="min-h-[60vh] flex items-center justify-center px-4">
			<div class="text-center max-w-lg">
				<div class="mx-auto mb-6 text-red-500 dark:text-red-400">
					<i class="ph-bold ph-warning text-[80px]"></i>
				</div>
				<h1 class="text-2xl font-heading font-bold text-cool-grey-900 dark:text-white mb-4">
					Authentication Error
				</h1>
				<p class="text-cool-grey-600 dark:text-cool-grey-400 mb-8">
					{ props.Message }
				</p>
				<a
					href={ templ.SafeURL(props.LayoutProps.BasePath + "/login") }
					class="inline-flex items-center px-6 py-3 text-sm font-medium text-white bg-theme-primary hover:bg-theme-primary-hover transition-colors"
					style="border-radius: var(--theme-radius)"
				>
					<i class="ph-bold ph-sign-in text-base mr-2"></i>
					Try Again
				</a>
			</div>
		</div>
	}
}
