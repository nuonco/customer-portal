package pages

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/components"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/partials"
)

// InstallPageProps shared props for all install detail tab pages
type InstallPageProps struct {
	customerui.LayoutProps
	Install         *models.Install
	AppName         string
	APIDeletedError bool
	PageTitle       string // Display title for the current tab ("Overview", "Stack", etc.)
	PageIcon        string // Phosphor icon name for the current tab (e.g. "house-simple")
}

// installPageShell renders the shared shell for install detail pages:
// page header, content slot, secondary panel, modals, and config div.
templ installPageShell(props InstallPageProps) {
	<!-- Page Header -->
	@components.PageHeader(components.PageHeaderProps{Title: props.PageTitle, Icon: props.PageIcon}) {
		if props.Install.Status != "deprovisioning" && !props.APIDeletedError {
			@components.SwitcherDropdown(components.DropdownProps{
				ID:    "actionsDropdown",
				Label: "Manage",
				Icon:  "ph-bold ph-caret-up-down",
			}) {
				<button type="button" onclick="document.getElementById('editInputsModal').classList.remove('hidden')" class="sw-dropdown-item">
					Edit Inputs
				</button>
				<button type="button" onclick="document.getElementById('reprovisionModal').classList.remove('hidden')" class="sw-dropdown-item">
					Reprovision
				</button>
				<button type="button" onclick="document.getElementById('deprovisionModal').classList.remove('hidden')" class="sw-dropdown-item-danger button button-danger">
					Deprovision
				</button>
			}
		}
	}

	if props.NuonAPIError != "" {
		<div class="px-6 mb-4">
			@components.Alert(components.AlertProps{
				Type:    "error",
				Message: props.NuonAPIError,
			})
		</div>
	}

	<!-- Tab content -->
	{ children... }

	@components.SecondaryPanel()

	<!-- Reprovision Confirmation Modal -->
	@partials.ModalWrapper("reprovisionModal", "max-w-md") {
		<h3 class="text-lg font-semibold text-cool-grey-900 dark:text-white mb-2">Reprovision Installation?</h3>
		<p class="text-cool-grey-600 dark:text-cool-grey-400 mb-6">
			This will re-run the provisioning workflow for this installation. Existing resources will be updated in place.
		</p>
		<div class="flex justify-end space-x-3">
			<button type="button" onclick="document.getElementById('reprovisionModal').classList.add('hidden')" class="button button-outline btn-theme-outline">
				Cancel
			</button>
			<form method="POST" action={ templ.SafeURL(props.BasePath + "/installs/" + props.Install.ID + "/reprovision") }>
				<button type="submit" class="button button-primary btn-theme-primary">
					Reprovision
				</button>
			</form>
		</div>
	}

	<!-- Deprovision Confirmation Modal -->
	@partials.ModalWrapper("deprovisionModal", "max-w-md") {
		<h3 class="text-lg font-semibold text-cool-grey-900 dark:text-white mb-2">Deprovision Installation?</h3>
		<p class="text-cool-grey-600 dark:text-cool-grey-400 mb-6">
			Are you sure you want to deprovision this installation? This action cannot be undone and will destroy all data associated with this installation.
		</p>
		<div class="flex justify-end space-x-3">
			<button type="button" onclick="document.getElementById('deprovisionModal').classList.add('hidden')" class="button button-outline btn-theme-outline">
				Cancel
			</button>
			<form method="POST" action={ templ.SafeURL(props.BasePath + "/installs/" + props.Install.ID + "/deprovision") }>
				<button type="submit" class="button button-danger btn-theme-primary" style="background-color: #ef4444; border-color: #dc2626">
					Deprovision
				</button>
			</form>
		</div>
	}

	<!-- Edit Inputs Modal -->
	@partials.EditInputsModalPanel()

	<!-- Access role info modal -->
	@partials.AccessEnableRoleModal()
}
