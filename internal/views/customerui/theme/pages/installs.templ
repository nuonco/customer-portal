	switch platform {
	case "aws":
		<span class="platform-chip platform-chip-aws">
			<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
				<path d="M6.763 10.036c0 .296.032.535.088.71.064.176.144.368.256.576.04.063.056.127.056.183 0 .08-.048.16-.152.24l-.503.335a.383.383 0 0 1-.208.072c-.08 0-.16-.04-.239-.112a2.47 2.47 0 0 1-.287-.375 6.18 6.18 0 0 1-.248-.471c-.622.734-1.405 1.101-2.347 1.101-.67 0-1.205-.191-1.596-.574-.391-.384-.59-.894-.59-1.533 0-.678.239-1.23.726-1.644.487-.415 1.133-.623 1.955-.623.272 0 .551.024.846.064.296.04.6.104.918.176v-.583c0-.607-.127-1.03-.375-1.277-.255-.248-.686-.367-1.3-.367-.28 0-.567.032-.863.104a6.432 6.432 0 0 0-.862.28.483.483 0 0 1-.151.048c-.08 0-.12-.072-.12-.224v-.391c0-.112.016-.2.056-.256.04-.064.112-.127.216-.191.28-.144.614-.264 1.005-.36.391-.096.806-.144 1.246-.144.95 0 1.644.216 2.091.648.439.432.662 1.086.662 1.963v2.586zm-3.24 1.214c.263 0 .534-.048.822-.144.287-.096.543-.271.758-.51.128-.152.224-.32.272-.512.047-.191.08-.423.08-.694v-.335a6.66 6.66 0 0 0-.735-.136 6.02 6.02 0 0 0-.75-.048c-.535 0-.926.104-1.19.32-.263.215-.39.518-.39.917 0 .375.095.655.295.846.191.2.47.296.838.296zm6.41.862c-.104 0-.176-.016-.232-.056-.056-.032-.104-.104-.144-.208l-1.614-5.31a1.156 1.156 0 0 1-.056-.28c0-.111.056-.168.167-.168h.79c.112 0 .192.016.24.056.055.032.103.104.143.208l1.157 4.558 1.07-4.558c.032-.112.08-.176.136-.208a.487.487 0 0 1 .248-.056h.646c.112 0 .192.016.248.056.056.032.104.104.136.208l1.086 4.613 1.19-4.613c.04-.112.088-.176.143-.208a.464.464 0 0 1 .24-.056h.75c.111 0 .175.056.175.168 0 .032-.008.064-.016.104-.008.04-.024.096-.048.176l-1.654 5.31c-.04.104-.088.176-.144.208-.056.032-.136.056-.232.056h-.694c-.112 0-.192-.016-.248-.064-.056-.04-.104-.112-.136-.216l-1.062-4.445-1.054 4.437c-.032.112-.08.176-.136.216-.056.048-.144.064-.248.064h-.694v.008zm10.256.215c-.415 0-.83-.048-1.229-.143-.399-.096-.71-.2-.918-.32-.128-.071-.216-.151-.248-.232a.627.627 0 0 1-.048-.224v-.407c0-.152.064-.224.183-.224a.443.443 0 0 1 .14.024c.048.016.12.048.2.08.27.12.566.216.886.28.328.064.646.096.975.096.503 0 .894-.088 1.165-.264a.86.86 0 0 0 .415-.758.777.777 0 0 0-.215-.559c-.144-.152-.415-.288-.806-.415l-1.157-.36c-.583-.183-1.014-.454-1.277-.814-.263-.36-.398-.758-.398-1.189 0-.344.08-.648.232-.912.152-.264.36-.495.607-.686.247-.192.527-.335.846-.431.32-.096.662-.144 1.021-.144.184 0 .375.008.566.032.199.024.39.056.574.096.176.048.343.096.503.152.16.056.288.112.375.168.128.08.224.16.272.24a.57.57 0 0 1 .072.279v.375c0 .152-.064.232-.183.232a.847.847 0 0 1-.303-.096 3.65 3.65 0 0 0-1.533-.312c-.455 0-.815.072-1.062.223-.248.152-.375.384-.375.703 0 .224.08.416.239.567.16.152.455.304.878.44l1.134.359c.574.184.99.44 1.237.766.248.327.367.702.367 1.117 0 .351-.072.67-.207.95-.144.28-.344.527-.598.735-.256.208-.566.368-.935.48-.383.12-.79.175-1.229.175z"/>
			</svg>
			AWS
		</span>
	case "azure":
		<span class="platform-chip platform-chip-azure">
			<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
				<path d="M5.483 21.3H24L14.025 4.013l-3.038 8.347 5.836 6.938L5.483 21.3zM13.23 2.7L6.105 8.677 0 19.253h5.505l7.725-16.553z"/>
			</svg>
			Azure
		</span>
	case "gcp":
		<span class="platform-chip platform-chip-gcp">
			<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
				<path d="M12.19 2.38a9.344 9.344 0 0 0-9.234 6.893c.053-.02-.055.013 0 0-3.875 2.551-3.922 8.11-.247 10.941l.006-.007-.007.03a6.717 6.717 0 0 0 4.077 1.356h5.173l.03.03h5.192c6.687.053 9.376-8.605 3.835-12.87a9.344 9.344 0 0 0-8.825-6.373zM8.453 19.342H6.593a4.538 4.538 0 0 1-4.537-4.537 4.538 4.538 0 0 1 4.537-4.538l2.116.006c.053-.007.1-.007.153-.013-.054.007-.107.013-.16.013l.267.006h.14l-.14-.006-.267-.006a7.16 7.16 0 0 0 .267-.54l.073-.126c1.39-2.243 4.12-3.58 7.027-2.58l.07.024.063.023.063.027a7.14 7.14 0 0 1 4.437 7.973 7.14 7.14 0 0 1-7.027 5.793H8.453z"/>
			</svg>
			GCP
		</span>
	default:
		<span class="platform-chip platform-chip-unknown">
			<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
			</svg>
			Cloud
		</span>
	}
}

templ healthPills(install customerui.InstallWithApprovalStatus) {
	if install.HasHealthChecks {
		<div class="health-pills">
			if install.HealthChecksPassed > 0 {
				<span class="health-pill health-pill-passed" title={ fmt.Sprintf("%d passed", install.HealthChecksPassed) }>
					<svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
					</svg>
					{ fmt.Sprintf("%d", install.HealthChecksPassed) }
				</span>
			}
			if install.HealthChecksFailed > 0 {
				<span class="health-pill health-pill-failed" title={ fmt.Sprintf("%d failed", install.HealthChecksFailed) }>
					<svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
					</svg>
					{ fmt.Sprintf("%d", install.HealthChecksFailed) }
				</span>
			}
			if install.HealthChecksPending > 0 {
				<span class="health-pill health-pill-pending" title={ fmt.Sprintf("%d pending", install.HealthChecksPending) }>
					<svg class="w-3 h-3 animate-spin" fill="none" viewBox="0 0 24 24">
						<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
						<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
					</svg>
					{ fmt.Sprintf("%d", install.HealthChecksPending) }
				</span>
			}
		</div>
	} else {
		<span class="text-xs text-cool-grey-400 dark:text-cool-grey-500 italic">—</span>
	}
}

templ installsPanelScripts() {
	<script>
		(function() {
			// Get config
			var configEl = document.getElementById('installs-page-config');
			var basePath = configEl ? configEl.dataset.basePath : '';

			// State
			var currentInstallId = null;
			var historyLoaded = false;
			var auditLoaded = false;

			// Open panel for an install
			window.openInstallPanel = function(installId, installName, detailUrl) {
				currentInstallId = installId;
				historyLoaded = false;
				auditLoaded = false;

				// Update panel title
				document.getElementById('panel-install-name').textContent = installName;

				// Reset to Manage tab
				switchPanelTab('manage');

				// Show panel
				document.getElementById('detail-panel-overlay').classList.add('open');
				document.getElementById('detail-panel').classList.add('open');

				// Highlight active row
				document.querySelectorAll('.install-row').forEach(function(row) {
					row.classList.remove('active');
				});
				var activeRow = document.querySelector('[data-install-id="' + installId + '"]');
				if (activeRow) {
					activeRow.classList.add('active');
				}

				// Load manage content from panel endpoint
				loadPanelContent('manage', basePath + '/installs/' + installId + '/panel');

				// Prevent body scroll
				document.body.style.overflow = 'hidden';
			};

			// Close panel
			window.closeInstallPanel = function() {
				document.getElementById('detail-panel-overlay').classList.remove('open');
				document.getElementById('detail-panel').classList.remove('open');

				// Remove row highlight
				document.querySelectorAll('.install-row').forEach(function(row) {
					row.classList.remove('active');
				});

				// Reset state
				currentInstallId = null;
				historyLoaded = false;
				auditLoaded = false;

				// Restore body scroll
				document.body.style.overflow = '';
			};

			// Switch tabs
			window.switchPanelTab = function(tabName) {
				// Update tab buttons
				document.getElementById('tab-manage-btn').classList.toggle('active', tabName === 'manage');
				document.getElementById('tab-history-btn').classList.toggle('active', tabName === 'history');
				document.getElementById('tab-audit-btn').classList.toggle('active', tabName === 'audit');

				// Update tab panes
				document.getElementById('tab-manage').classList.toggle('active', tabName === 'manage');
				document.getElementById('tab-history').classList.toggle('active', tabName === 'history');
				document.getElementById('tab-audit').classList.toggle('active', tabName === 'audit');

				// Lazy load history tab
				if (tabName === 'history' && !historyLoaded && currentInstallId) {
					loadPanelContent('history', basePath + '/installs/' + currentInstallId + '/panel/history');
					historyLoaded = true;
				}

				// Lazy load audit tab
				if (tabName === 'audit' && !auditLoaded && currentInstallId) {
					loadPanelContent('audit', basePath + '/installs/' + currentInstallId + '/panel/audit');
					auditLoaded = true;
				}
			};

			// Load content into panel (panel endpoints return just the content, no layout wrapper)
			function loadPanelContent(tab, url) {
				var containerId = 'panel-content-' + tab;
				var container = document.getElementById(containerId);

				// Show loading
				container.innerHTML = '<div class="panel-loading"><div class="panel-loading-spinner"><\/div><\/div>';

				fetch(url)
					.then(function(response) {
						if (!response.ok) throw new Error('Failed to load');
						return response.text();
					})
					.then(function(html) {
						// Panel endpoints return just the content, inject directly
						container.innerHTML = html;

						// Re-run any scripts that were in the content
						var scripts = container.querySelectorAll('script');
						scripts.forEach(function(script) {
							var newScript = document.createElement('script');
							newScript.textContent = script.textContent;
							script.parentNode.replaceChild(newScript, script);
						});
					})
					.catch(function(error) {
						container.innerHTML = '<div class="text-center py-8 text-red-500">Failed to load content. <button onclick="location.reload()" class="underline">Retry<\/button><\/div>';
					});
			}

			// Close on ESC key
			document.addEventListener('keydown', function(e) {
				if (e.key === 'Escape') {
					closeInstallPanel();
				}
			});

			// Close when clicking outside panel (on overlay)
			document.getElementById('detail-panel-overlay').addEventListener('click', function(e) {
				if (e.target === this) {
					closeInstallPanel();
				}
			});

			// Check for auto-open parameter (used after accepting install link)
			var urlParams = new URLSearchParams(window.location.search);
			var autoOpenId = urlParams.get('open');
			if (autoOpenId) {
				// Find the row with this install ID
				var row = document.querySelector('[data-install-id="' + autoOpenId + '"]');
				if (row) {
					var name = row.dataset.installName;
					var detailUrl = basePath + '/installs/' + autoOpenId + '/panel';
					openInstallPanel(autoOpenId, name, detailUrl);
				}
				// Clean up URL (remove the param)
				history.replaceState({}, '', basePath + '/installs');
			}
		})();
	</script>
}
