package pages

import (
	"fmt"
	"strings"

	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/components"
)

// InstallsPageProps for the installs list page
type InstallsPageProps struct {
	customerui.LayoutProps
	Pagination       customerui.InstallPaginationData
	InitialInstallID string // ID of install to auto-open
}

// InstallsPage renders the customer installs page with table layout and sliding panel
templ InstallsPage(props InstallsPageProps) {
	@customerui.Layout(props.LayoutProps) {
		if len(props.Pagination.Installs) > 0 {
			<!-- Installs Table -->
			@components.Table(components.TableProps{
				Header: installsTableHeader(),
				Footer: paginationFooter(props),
			}) {
				for _, install := range props.Pagination.Installs {
					@installTableRow(install, props.BasePath)
				}
			}
		} else if props.User == nil || props.Pagination.TotalCount == 0 {
			if props.User == nil {
				<!-- Not logged in — show login CTA -->
				@components.EmptyState(components.EmptyStateProps{
					Title:   "You are not logged in",
					Message: "Log in to view and manage your installs",
					Icon:    "inbox",
				})
				<div class="text-center mt-4">
					<a
						href={ templ.SafeURL(props.BasePath + "/login") }
						class="inline-flex items-center justify-center text-sm h-9 px-4 py-1 leading-[21px] font-strong tracking-tight border border-transparent bg-theme-primary hover:bg-theme-primary-hover text-white transition-colors"
						style="border-radius: var(--theme-radius)"
					>
						Log in
					</a>
				</div>
			} else {
				<!-- No Installs At All (logged in) -->
				@components.EmptyState(components.EmptyStateProps{
					Title:   "No installs yet",
					Message: "Select an app from the Catalog to get started",
					Icon:    "inbox",
				})
				<div class="text-center mt-4">
					<a
						href={ templ.SafeURL(props.BasePath + "/apps") }
						class="button button-primary btn-theme-primary inline-flex items-center justify-center text-sm h-9 px-4 py-1 leading-[21px] font-strong tracking-tight border border-transparent bg-theme-primary hover:bg-theme-primary-hover text-white transition-colors"
					>
						Go to App Catalog
					</a>
				</div>
			}
		}

		<!-- Panel Overlay -->
		<div id="detail-panel-overlay" class="panel-overlay" onclick="closeInstallPanel()"></div>

		<!-- Sliding Detail Panel -->
		<div id="detail-panel" class="detail-panel">
			<div class="panel-header">
				<div class="min-w-0 flex-1">
					<h2 id="panel-install-name">Loading...</h2>
					<span id="panel-install-id" class="text-xs font-mono text-cool-grey-500 dark:text-cool-grey-400 truncate block"></span>
				</div>
				<div class="flex items-center gap-2 flex-shrink-0">
					<div id="panel-actions-container"></div>
					<button id="panel-expand-btn" type="button" onclick="togglePanelSize()" class="button button-icon panel-header-btn" title="Expand to full screen">
						<i id="panel-expand-icon" class="ph-bold ph-arrows-out text-xl"></i>
						<i id="panel-collapse-icon" class="ph-bold ph-arrows-in text-xl hidden"></i>
					</button>
					<button class="button button-icon panel-close-btn" onclick="closeInstallPanel()" aria-label="Close panel">
						<i class="ph-bold ph-x text-xl"></i>
					</button>
				</div>
			</div>
			<!-- Tab Headers -->
			<div class="panel-tab-headers">
				<button id="tab-overview-btn" class="button button-nav nav-item active" onclick="switchPanelTab('overview')">Overview</button>
				<button id="tab-history-btn" class="button button-nav nav-item" onclick="switchPanelTab('history')">History</button>
				<button id="tab-audit-btn" class="button button-nav nav-item" onclick="switchPanelTab('audit')">Audit Log</button>
			</div>
			<div class="panel-content">
				<!-- Overview Tab -->
				<div id="tab-overview" class="panel-tab-pane active">
					<div id="panel-content-overview" class="panel-body">
						<div class="panel-loading">
							<div class="panel-loading-spinner"></div>
						</div>
					</div>
				</div>
				<!-- History Tab -->
				<div id="tab-history" class="panel-tab-pane">
					<div id="panel-content-history" class="panel-body">
						<div class="panel-loading">
							<div class="panel-loading-spinner"></div>
						</div>
					</div>
				</div>
				<!-- Audit Log Tab -->
				<div id="tab-audit" class="panel-tab-pane">
					<div id="panel-content-audit" class="panel-body">
						<div class="panel-loading">
							<div class="panel-loading-spinner"></div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Config data for JavaScript -->
		<div
			id="installs-page-config"
			class="hidden"
			data-base-path={ props.BasePath }
		></div>

		<!-- Panel JavaScript -->
		@installsPanelScripts()
	}
}

templ installsTableHeader() {
	<tr>
		<th>Name</th>
		<th>App</th>
		<th>Platform</th>
		<th class="hide-mobile">Region</th>
		<th class="hide-mobile">Created</th>
	</tr>
}

templ installTableRow(install customerui.InstallWithApprovalStatus, basePath string) {
	{{
		platform := components.PlatformFromRegion(install.Region)
		panelURL := basePath + "/installs/" + install.ID + "/panel"
		detailURL := basePath + "/installs/" + install.ID
		// Escape single quotes in names for JavaScript
		escapedName := strings.ReplaceAll(install.Name, "'", "\\'")
		beforeRequestCall := fmt.Sprintf("preparePanel(this, '%s', '%s')", install.ID, escapedName)
	}}
	<tr
		class="install-row"
		data-install-id={ install.ID }
		data-install-name={ install.Name }
		hx-get={ panelURL }
		hx-target="#panel-content-overview"
		hx-swap="innerHTML show:no-scroll"
		hx-push-url={ detailURL }
		hx-on::before-request={ templ.ComponentScript{Call: beforeRequestCall} }
		hx-on::after-settle="finalizePanelLoad()"
	>
		<td>
			<span class="install-name-link">{ install.Name }</span>
		</td>
		<td>{ install.AppName }</td>
		<td>
			@components.PlatformChip(platform)
		</td>
		<td>
			if install.Region != "" {
				{ install.Region }
			} else {
				<span class="text-cool-grey-400 dark:text-cool-grey-500">—</span>
			}
		</td>
		<td>
			{ install.CreatedAt.Format("Jan 2, 2006") }
		</td>
	</tr>
}

templ installsPanelScripts() {
	<script>
		(function() {
			// Get config
			var configEl = document.getElementById('installs-page-config');
			var basePath = configEl ? configEl.dataset.basePath : '';

			// State
			var currentInstallId = null;
			var historyLoaded = false;
			var auditLoaded = false;

			// Prepare panel state before HTMX loads content
			window.preparePanel = function(rowElement, installId, installName) {
				// Store current install context
				currentInstallId = installId;
				historyLoaded = false;
				auditLoaded = false;

				// Update panel header with provided values (from HTMX call)
				document.getElementById('panel-install-name').textContent = installName;
				document.getElementById('panel-install-id').textContent = installId;

				// Clear actions container until panel content loads
				document.getElementById('panel-actions-container').innerHTML = '';

				// Highlight the active row
				document.querySelectorAll('.install-row').forEach(function(row) {
					row.classList.remove('active');
				});
				rowElement.classList.add('active');

				// Show the panel and overlay
				document.getElementById('detail-panel-overlay').classList.add('open');
				document.getElementById('detail-panel').classList.add('open');
				document.body.style.overflow = 'hidden';

				// Ensure overview tab is active
				switchPanelTab('overview');

				// Show loading spinner in the container (HTMX will replace it)
				document.getElementById('panel-content-overview').innerHTML =
					'<div class="panel-loading"><div class="panel-loading-spinner"></div></div>';
			};

			// Finalize panel after HTMX loads and settles content
			window.finalizePanelLoad = function() {
				// HTMX has already injected the content and processed all HTMX attributes
				// The banner polling is now active!

				// Enable panel expand button
				var expandBtn = document.getElementById('panel-expand-btn');
				if (expandBtn) {
					expandBtn.disabled = false;
				}
			};

			// Close panel
			window.closeInstallPanel = function() {
				document.getElementById('detail-panel-overlay').classList.remove('open');
				document.getElementById('detail-panel').classList.remove('open');

				// Remove row highlight
				document.querySelectorAll('.install-row').forEach(function(row) {
					row.classList.remove('active');
				});

				// Push new URL state when closing panel
				var currentPath = window.location.pathname;
				// Only push state if we're currently on an install detail URL
				if (currentPath.match(/\/installs\/[^\/]+/)) {
					var params = new URLSearchParams(window.location.search);
					var newUrl = basePath + '/installs' + (params.toString() ? '?' + params.toString() : '');
					history.pushState({panelClosed: true}, '', newUrl);
				}

				// Reset state
				currentInstallId = null;
				historyLoaded = false;
				auditLoaded = false;

				// Reset expand state
				var panel = document.getElementById('detail-panel');
				panel.classList.remove('panel-full');
				document.getElementById('panel-expand-icon').classList.remove('hidden');
				document.getElementById('panel-collapse-icon').classList.add('hidden');
				document.getElementById('panel-expand-btn').setAttribute('title', 'Expand to full screen');

				// Restore body scroll
				document.body.style.overflow = '';
			};

			// Toggle panel between default and full width
			window.togglePanelSize = function() {
				var panel = document.getElementById('detail-panel');
				var expandIcon = document.getElementById('panel-expand-icon');
				var collapseIcon = document.getElementById('panel-collapse-icon');
				var expandBtn = document.getElementById('panel-expand-btn');

				if (panel.classList.contains('panel-full')) {
					panel.classList.remove('panel-full');
					expandIcon.classList.remove('hidden');
					collapseIcon.classList.add('hidden');
					expandBtn.setAttribute('title', 'Expand to full screen');
				} else {
					panel.classList.add('panel-full');
					expandIcon.classList.add('hidden');
					collapseIcon.classList.remove('hidden');
					expandBtn.setAttribute('title', 'Resize to default size');
				}
			};

			// Switch tabs
			window.switchPanelTab = function(tabName) {
				// Update tab buttons
				document.getElementById('tab-overview-btn').classList.toggle('active', tabName === 'overview');
				document.getElementById('tab-history-btn').classList.toggle('active', tabName === 'history');
				document.getElementById('tab-audit-btn').classList.toggle('active', tabName === 'audit');

				// Update tab panes
				document.getElementById('tab-overview').classList.toggle('active', tabName === 'overview');
				document.getElementById('tab-history').classList.toggle('active', tabName === 'history');
				document.getElementById('tab-audit').classList.toggle('active', tabName === 'audit');

				// Lazy load history tab using HTMX
				if (tabName === 'history' && !historyLoaded && currentInstallId) {
					if (typeof htmx !== 'undefined') {
						htmx.ajax('GET', basePath + '/installs/' + currentInstallId + '/panel/history', {
							target: '#panel-content-history',
							swap: 'innerHTML'
						});
					}
					historyLoaded = true;
				}

				// Lazy load audit tab using HTMX
				if (tabName === 'audit' && !auditLoaded && currentInstallId) {
					if (typeof htmx !== 'undefined') {
						htmx.ajax('GET', basePath + '/installs/' + currentInstallId + '/panel/audit', {
							target: '#panel-content-audit',
							swap: 'innerHTML'
						});
					}
					auditLoaded = true;
				}
			};

			// Close on ESC key
			document.addEventListener('keydown', function(e) {
				if (e.key === 'Escape') {
					closeInstallPanel();
				}
			});

			// Close when clicking outside panel (on overlay)
			document.getElementById('detail-panel-overlay').addEventListener('click', function(e) {
				if (e.target === this) {
					closeInstallPanel();
				}
			});

			// Check if we're on /installs/:install_id route (used after accepting install link)
			// Wrapped in DOMContentLoaded to ensure table rows are rendered
			document.addEventListener('DOMContentLoaded', function() {
				var pathMatch = window.location.pathname.match(/\/installs\/([^\/\?]+)/);
				if (pathMatch && pathMatch[1]) {
					var installId = pathMatch[1];
					var row = document.querySelector('[data-install-id="' + installId + '"]');
					if (row) {
						// Trigger HTMX request to load panel
						if (typeof htmx !== 'undefined') {
							htmx.trigger(row, 'click');
						}
					}
				}
			});

			// Handle back/forward button navigation
			window.addEventListener('popstate', function(event) {
				var pathMatch = window.location.pathname.match(/\/installs\/([^\/\?]+)/);

				if (pathMatch && pathMatch[1]) {
					// URL has install ID - open panel
					var installId = pathMatch[1];
					var row = document.querySelector('[data-install-id="' + installId + '"]');
					if (row && currentInstallId !== installId) {
						if (typeof htmx !== 'undefined') {
							htmx.trigger(row, 'click');
						}
					}
				} else {
					// URL is just /installs - close panel
					if (currentInstallId) {
						closeInstallPanel();
					}
				}
			});
		})();
	</script>
}

templ paginationFooter(props InstallsPageProps) {
	@components.Pagination(components.PaginationProps{
		CurrentPage:  props.Pagination.CurrentPage,
		TotalPages:   props.Pagination.TotalPages,
		HasPrevious:  props.Pagination.HasPrevious,
		HasNext:      props.Pagination.HasNext,
		PreviousPage: props.Pagination.PreviousPage,
		NextPage:     props.Pagination.NextPage,
		BaseURL:      "?page=",
		ShowingFrom:  props.Pagination.ShowingFrom,
		ShowingTo:    props.Pagination.ShowingTo,
		TotalCount:   int(props.Pagination.TotalCount),
	})
}
