package pages

import (
	"fmt"
	"strings"

	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/components"
)

// InstallsPageProps for the installs list page
type InstallsPageProps struct {
	customerui.LayoutProps
	Pagination customerui.InstallPaginationData
}

// InstallsPage renders the customer installs page with table layout and sliding panel
templ InstallsPage(props InstallsPageProps) {
	@customerui.Layout(props.LayoutProps) {
		if props.Pagination.TotalCount > 0 || props.Pagination.CurrentTab != "" {
			<!-- Tab Interface -->
			<div class="mb-6">
				<div class="border-b border-cool-grey-200 dark:border-dark-grey-600">
					<nav class="-mb-px flex space-x-8">
						@installTab("needs-attention", "Needs Attention", props.Pagination.CurrentTab, props.Pagination.NeedsAttentionCount, props.PrimaryColor)
						@installTab("updating", "Updating", props.Pagination.CurrentTab, props.Pagination.UpdatingCount, props.PrimaryColor)
						@installTab("healthy", "Healthy", props.Pagination.CurrentTab, props.Pagination.HealthyCount, props.PrimaryColor)
					</nav>
				</div>
			</div>
			if len(props.Pagination.Installs) > 0 {
				<!-- Tab Content Description -->
				<div class="mb-4">
					if props.Pagination.CurrentTab == "healthy" {
						<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400">These installs are running smoothly with all health checks passing.</p>
					} else if props.Pagination.CurrentTab == "updating" {
						<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400">These installs have updates in progress that don't require your approval.</p>
					} else {
						<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400">These installs have pending approvals or health check issues requiring your attention.</p>
					}
				</div>
				<div class="flex justify-between items-center mb-4">
					<span class="text-sm text-cool-grey-600 dark:text-cool-grey-400">
						{ fmt.Sprintf("%d-%d of %d", props.Pagination.ShowingFrom, props.Pagination.ShowingTo, props.Pagination.TotalCount) }
					</span>
				</div>
				<!-- Installs Table -->
				<div class="table-wrapper">
					<table class="installs-table">
						<thead>
							<tr>
								<th>Install</th>
								<th>App</th>
								<th>Platform</th>
								<th>Status</th>
								<th>Health</th>
								<th class="hide-mobile">Region</th>
								<th class="hide-mobile">Created</th>
							</tr>
						</thead>
						<tbody>
							for _, install := range props.Pagination.Installs {
								@installTableRow(install, props.BasePath)
							}
						</tbody>
					</table>
				</div>
				<!-- Pagination Controls -->
				if props.Pagination.TotalPages > 1 {
					<div class="mt-6">
						@components.Pagination(components.PaginationProps{
							CurrentPage:  props.Pagination.CurrentPage,
							TotalPages:   props.Pagination.TotalPages,
							HasPrevious:  props.Pagination.HasPrevious,
							HasNext:      props.Pagination.HasNext,
							PreviousPage: props.Pagination.PreviousPage,
							NextPage:     props.Pagination.NextPage,
							BaseURL:      fmt.Sprintf("?tab=%s&page=", props.Pagination.CurrentTab),
						})
					</div>
				}
			} else {
				<!-- Empty State for Current Tab -->
				if props.Pagination.CurrentTab == "healthy" {
					@components.EmptyState(components.EmptyStateProps{
						Title:   "No Healthy Installs",
						Message: "All your installs currently need attention or are being updated.",
						Icon:    "check-circle",
					})
				} else if props.Pagination.CurrentTab == "updating" {
					@components.EmptyState(components.EmptyStateProps{
						Title:   "No Updates In Progress",
						Message: "There are no installs currently being updated.",
						Icon:    "refresh",
					})
				} else {
					@components.EmptyState(components.EmptyStateProps{
						Title:   "No Installs Needing Attention",
						Message: "All your installs are running smoothly with passing health checks!",
						Icon:    "check-circle",
					})
				}
			}
		} else {
			<!-- No Installs At All -->
			@components.EmptyState(components.EmptyStateProps{
				Title:   "No Installs Yet",
				Message: "Your installations will appear here once you've used an install link.",
				Icon:    "inbox",
			})
		}

		<!-- Panel Overlay -->
		<div id="detail-panel-overlay" class="panel-overlay" onclick="closeInstallPanel()"></div>

		<!-- Sliding Detail Panel -->
		<div id="detail-panel" class="detail-panel">
			<div class="panel-header">
				<h2 id="panel-install-name">Loading...</h2>
				<button class="panel-close-btn" onclick="closeInstallPanel()" aria-label="Close panel">&times;</button>
			</div>
			<!-- Tab Headers -->
			<div class="panel-tab-headers">
				<button id="tab-manage-btn" class="panel-tab-button active" onclick="switchPanelTab('manage')">Manage</button>
				<button id="tab-history-btn" class="panel-tab-button" onclick="switchPanelTab('history')">History</button>
				<button id="tab-audit-btn" class="panel-tab-button" onclick="switchPanelTab('audit')">Audit Log</button>
			</div>
			<div class="panel-content">
				<!-- Manage Tab -->
				<div id="tab-manage" class="panel-tab-pane active">
					<div id="panel-content-manage" class="panel-body">
						<div class="panel-loading">
							<div class="panel-loading-spinner"></div>
						</div>
					</div>
				</div>
				<!-- History Tab -->
				<div id="tab-history" class="panel-tab-pane">
					<div id="panel-content-history" class="panel-body">
						<div class="panel-loading">
							<div class="panel-loading-spinner"></div>
						</div>
					</div>
				</div>
				<!-- Audit Log Tab -->
				<div id="tab-audit" class="panel-tab-pane">
					<div id="panel-content-audit" class="panel-body">
						<div class="panel-loading">
							<div class="panel-loading-spinner"></div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Config data for JavaScript -->
		<div
			id="installs-page-config"
			class="hidden"
			data-base-path={ props.BasePath }
		></div>

		<!-- Panel JavaScript -->
		@installsPanelScripts()
	}
}

templ installTab(tabID, label, currentTab string, count int64, primaryColor string) {
	{{
		isActive := currentTab == tabID || (tabID == "needs-attention" && currentTab == "")

		// Determine tab colors
		borderClass := "border-transparent"
		textClass := "text-cool-grey-500 hover:text-cool-grey-700 dark:hover:text-cool-grey-300 hover:border-cool-grey-300 dark:hover:border-dark-grey-500"

		if isActive {
			switch tabID {
			case "needs-attention":
				borderClass = "border-orange-500"
				textClass = "text-orange-600"
			case "updating":
				if primaryColor != "" {
					borderClass = "border-theme-primary"
					textClass = "text-theme-primary"
				} else {
					borderClass = "border-primary-600"
					textClass = "text-primary-600"
				}
			case "healthy":
				borderClass = "border-green-500"
				textClass = "text-green-600"
			}
		}

		// Badge colors
		badgeBgClass := "bg-cool-grey-100 dark:bg-dark-grey-700"
		badgeTextClass := "text-cool-grey-900 dark:text-cool-grey-300"

		if count > 0 {
			switch tabID {
			case "needs-attention":
				badgeBgClass = "bg-orange-100 dark:bg-orange-900/30"
				badgeTextClass = "text-orange-800 dark:text-orange-300"
			case "updating":
				badgeBgClass = "bg-blue-100 dark:bg-blue-900/30"
				badgeTextClass = "text-blue-800 dark:text-blue-300"
			case "healthy":
				badgeBgClass = "bg-green-100 dark:bg-green-900/30"
				badgeTextClass = "text-green-800 dark:text-green-300"
			}
		}
	}}
	<a
		href={ templ.SafeURL("?tab=" + tabID) }
		class={ "whitespace-nowrap py-2 px-1 border-b-2 font-medium text-sm", borderClass, textClass }
	>
		{ label }
		<span class={ "ml-2 rounded-full px-2.5 py-0.5 text-xs font-medium", badgeBgClass, badgeTextClass }>
			{ fmt.Sprintf("%d", count) }
		</span>
	</a>
}

templ installTableRow(install customerui.InstallWithApprovalStatus, basePath string) {
	{{
		// Determine platform from region or other data
		platform := "unknown"
		if strings.Contains(install.Region, "us-") || strings.Contains(install.Region, "eu-") || strings.Contains(install.Region, "ap-") {
			platform = "aws"
		} else if strings.Contains(install.Region, "eastus") || strings.Contains(install.Region, "westus") || strings.Contains(install.Region, "northeurope") {
			platform = "azure"
		} else if strings.Contains(install.Region, "us-central") || strings.Contains(install.Region, "us-east") || strings.Contains(install.Region, "europe-") {
			platform = "gcp"
		}

		detailURL := basePath + "/installs/" + install.ID
		// Escape single quotes in names for JavaScript
		escapedName := strings.ReplaceAll(install.Name, "'", "\\'")
		onClickCall := fmt.Sprintf("openInstallPanel('%s', '%s', '%s')", install.ID, escapedName, detailURL)
	}}
	<tr
		class="install-row"
		data-install-id={ install.ID }
		data-install-name={ install.Name }
		data-detail-url={ detailURL }
		onclick={ templ.ComponentScript{Call: onClickCall} }
	>
		<td>
			<span class="install-name-link">{ install.Name }</span>
		</td>
		<td>{ install.InstallLink.AppName }</td>
		<td>
			@platformChip(platform)
		</td>
		<td>
			@components.StatusBadge(components.StatusBadgeProps{
				Status:  string(install.Status),
				Variant: "install",
				Size:    "sm",
			})
		</td>
		<td>
			@healthPills(install)
		</td>
		<td class="hide-mobile">
			if install.Region != "" {
				{ install.Region }
			} else {
				<span class="text-cool-grey-400 dark:text-cool-grey-500">—</span>
			}
		</td>
		<td class="hide-mobile">
			{ install.CreatedAt.Format("Jan 2, 2006") }
		</td>
	</tr>
}

