package pages

import "github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui"

templ InstallAppInfoPage(props InstallPageProps) {
	@customerui.Layout(props.LayoutProps) {
		@installPageShell(props) {
			<div
				id="panel-content-app-info"
				class="panel-body"
				hx-get={ props.BasePath + "/installs/" + props.Install.ID + "/panel/app-info" }
				hx-trigger="load"
				hx-swap="innerHTML"
			>
				<div class="panel-loading">
					<div class="panel-loading-spinner"></div>
				</div>
			</div>
		}
	}
}
