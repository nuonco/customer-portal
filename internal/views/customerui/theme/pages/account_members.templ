package pages

import (
	"fmt"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/components"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/partials"
)

// AccountPageProps for the account page
type AccountPageProps struct {
	LayoutProps customerui.LayoutProps
	Account     models.CustomerAccount
	Members     []models.CustomerAccountMember
	Invites     []models.CustomerAccountInvite
	IsOwner     bool
}

// AccountPage renders the account settings page with name editing, members, and invites.
templ AccountPage(props AccountPageProps) {
	@customerui.Layout(props.LayoutProps) {
		<!-- Page Header -->
		<div class="page-header flex items-center justify-between gap-4 mb-6 px-6 pt-6">
			<div class="min-w-0 flex-1">
				if props.IsOwner {
					<!-- Display state -->
					<div id="account-name-display" class="flex items-center gap-2">
						<h1 class="text-xl font-semibold text-cool-grey-900 dark:text-white truncate flex items-center gap-2">
							<i class="ph-bold ph-user-circle text-xl"></i>
							<span id="account-name-title">{ props.Account.Name }</span>
						</h1>
						<button
							onclick="document.getElementById('account-name-display').classList.add('hidden');document.getElementById('account-name-edit').classList.remove('hidden');document.getElementById('account-name-input').focus();"
							class="button button-icon text-cool-grey-400 hover:text-cool-grey-600 dark:hover:text-cool-grey-300"
						>
							<i class="ph-bold ph-pencil-simple text-base"></i>
						</button>
					</div>
					<!-- Edit state -->
					<div id="account-name-edit" class="hidden">
						<form
							hx-put="/account"
							hx-target="#account-name-result"
							hx-swap="innerHTML"
							class="flex items-center gap-3"
						>
							<input
								type="text"
								name="name"
								id="account-name-input"
								value={ props.Account.Name }
								required
								class="flex-1 px-3 py-2 text-sm rounded-lg border bg-white dark:bg-cool-grey-800 text-cool-grey-900 dark:text-white"
								style="border-color: var(--theme-border);"
							/>
							<button type="submit" class="button button-primary btn-theme-primary px-3 py-1.5 text-sm shrink-0" id="account-name-save" disabled>
								Save
							</button>
							<button
								type="button"
								onclick="document.getElementById('account-name-edit').classList.add('hidden');document.getElementById('account-name-display').classList.remove('hidden');document.getElementById('account-name-input').value=document.getElementById('account-name-title').textContent;document.getElementById('account-name-save').disabled=true;"
								class="button button-outline btn-theme-outline px-3 py-1.5 text-sm shrink-0"
							>
								Cancel
							</button>
							<script>
								(function() {
									var input = document.getElementById('account-name-input');
									var btn = document.getElementById('account-name-save');
									var title = document.getElementById('account-name-title');
									input.addEventListener('input', function() {
										btn.disabled = (input.value === title.textContent || input.value.trim() === '');
									});
									document.body.addEventListener('htmx:afterRequest', function(evt) {
										if (evt.detail.elt && evt.detail.elt.closest && evt.detail.elt.closest('#account-name-edit') && evt.detail.successful) {
											title.textContent = input.value;
											document.getElementById('account-name-edit').classList.add('hidden');
											document.getElementById('account-name-display').classList.remove('hidden');
											btn.disabled = true;
										}
									});
								})();
							</script>
						</form>
						<div id="account-name-result" class="mt-1"></div>
					</div>
				} else {
					<h1 class="text-xl font-semibold text-cool-grey-900 dark:text-white truncate flex items-center gap-2">
						<i class="ph-bold ph-user-circle text-xl"></i>
						{ props.Account.Name }
					</h1>
				}
			</div>
			<div class="flex items-center gap-2 flex-shrink-0">
				if props.IsOwner {
					<button
						onclick="document.getElementById('invite-modal').classList.remove('hidden')"
						class="button button-primary btn-theme-primary px-3 py-1.5 text-sm"
					>
						Add members
					</button>
				}
			</div>
		</div>
		<!-- Content -->
		<div class="px-6">
			<!-- Sub-tabs -->
			<div class="flex border-b border-cool-grey-200 dark:border-dark-grey-600 mb-4">
				<button
					class="button button-nav nav-item active"
					data-subtab="members"
					onclick="switchAccountTab('members')"
				>
					Members
					<span class="ml-1 text-xs opacity-70">({ fmt.Sprintf("%d", len(props.Members)) })</span>
				</button>
				<button
					class="button button-nav nav-item"
					data-subtab="invited"
					onclick="switchAccountTab('invited')"
				>
					Invited
					<span class="ml-1 text-xs opacity-70">({ fmt.Sprintf("%d", len(props.Invites)) })</span>
				</button>
			</div>
			<script>
				function switchAccountTab(tab) {
					document.querySelectorAll('[data-subtab]').forEach(function(btn) {
						btn.classList.toggle('active', btn.getAttribute('data-subtab') === tab);
					});
					document.getElementById('tab-members').classList.toggle('hidden', tab !== 'members');
					document.getElementById('tab-invited').classList.toggle('hidden', tab !== 'invited');
				}
			</script>
			<!-- Members Tab -->
			<div id="tab-members">
				if len(props.Members) == 0 {
					<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400">No members yet.</p>
				} else {
					@components.DataTable(membersTableColumns(props.IsOwner)) {
						for _, member := range props.Members {
							<tr
								id={ fmt.Sprintf("member-%s", member.ID) }
								class="border-b border-cool-grey-100 dark:border-dark-grey-700 last:border-b-0 hover:bg-cool-grey-50 dark:hover:bg-dark-grey-800 transition-colors"
							>
								<td class="py-2 pr-3 font-medium text-cool-grey-900 dark:text-white truncate">{ member.User.Name }</td>
								<td class="py-2 pr-3 text-cool-grey-600 dark:text-cool-grey-300 truncate">{ member.User.Email }</td>
								<td class="py-2 pr-3 capitalize text-cool-grey-600 dark:text-cool-grey-300">{ string(member.Role) }</td>
								<td class="py-2 pr-3 text-cool-grey-600 dark:text-cool-grey-400 hide-mobile">{ member.JoinedAt.Format("Jan 2, 2006") }</td>
								if props.IsOwner {
									<td class="py-2 pr-3">
										if member.Role != models.CustomerAccountRoleOwner {
											<button
												onclick={ templ.ComponentScript{Call: fmt.Sprintf("showConfirmModal({ title: 'Transfer Ownership', message: 'Transfer ownership to this member? You will become a regular member.', confirmText: 'Transfer' }).then(function(ok) { if (ok) fetch('/account/members/%s/transfer-ownership', { method: 'POST' }).then(function() { window.location = '/account'; }) })", member.ID)} }
												class="button button-primary text-cool-grey-600 hover:text-cool-grey-800 dark:text-cool-grey-400 dark:hover:text-cool-grey-200 text-sm"
											>
												Transfer Ownership
											</button>
										}
									</td>
									<td class="py-2">
										if member.Role != models.CustomerAccountRoleOwner {
											<button
												onclick={ templ.ComponentScript{Call: fmt.Sprintf("showConfirmModal({ title: 'Remove Member', message: 'Remove this member from the account?', confirmText: 'Remove' }).then(function(ok) { if (ok) fetch('/account/members/%s', { method: 'DELETE' }).then(function(r) { if (r.ok) document.getElementById('member-%s').remove(); }) })", member.ID, member.ID)} }
												class="button button-danger text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 text-sm"
											>
												Remove
											</button>
										}
									</td>
								}
							</tr>
						}
					}
				}
			</div>
			<!-- Invited Tab -->
			<div id="tab-invited" class="hidden">
				if len(props.Invites) == 0 {
					<div class="text-center py-12 text-cool-grey-500 dark:text-cool-grey-400">
						<i class="ph-bold ph-envelope-simple text-[32px] mb-2 block"></i>
						<p class="text-sm">No pending invites.</p>
					</div>
				} else {
					@components.DataTable(invitesTableColumns(props.IsOwner)) {
						for _, invite := range props.Invites {
							<tr
								id={ fmt.Sprintf("invite-%s", invite.ID) }
								class="border-b border-cool-grey-100 dark:border-dark-grey-700 last:border-b-0 hover:bg-cool-grey-50 dark:hover:bg-dark-grey-800 transition-colors"
							>
								<td class="py-2 pr-3 font-medium text-cool-grey-900 dark:text-white truncate">{ invite.Email }</td>
								<td class="py-2 pr-3 text-cool-grey-600 dark:text-cool-grey-300">{ invite.CreatedBy.Name }</td>
								<td class="py-2 pr-3 text-cool-grey-600 dark:text-cool-grey-400 hide-mobile">{ invite.CreatedAt.Format("Jan 2, 2006") }</td>
								if props.IsOwner {
									<td class="py-2">
										<button
											onclick={ templ.ComponentScript{Call: fmt.Sprintf("showConfirmModal({ title: 'Revoke Invite', message: 'Revoke this pending invite?', confirmText: 'Revoke' }).then(function(ok) { if (ok) fetch('/account/invite/%s', { method: 'DELETE' }).then(function(r) { if (r.ok) document.getElementById('invite-%s').remove(); }) })", invite.ID, invite.ID)} }
											class="button button-danger text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 text-sm"
										>
											Revoke
										</button>
									</td>
								}
							</tr>
						}
					}
				}
			</div>
			<!-- Invite Modal -->
			if props.IsOwner {
				@partials.ModalWrapper("invite-modal", "max-w-md") {
					<h3 class="text-lg font-semibold text-cool-grey-900 dark:text-white mb-4">Add members</h3>
					<label class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-2 block">
						Enter email addresses, separated by commas
					</label>
					<textarea
						id="invite-emails"
						rows="3"
						placeholder="e.g. alice@company.com, bob@company.com"
						class="w-full px-3 py-2 text-sm rounded-lg border bg-white dark:bg-cool-grey-800 text-cool-grey-900 dark:text-white placeholder-cool-grey-400"
						style="border-color: var(--theme-border);"
					></textarea>
					<div id="invite-modal-result" class="mt-2 text-sm"></div>
					<div class="flex justify-end gap-3 mt-4">
						<button
							onclick="document.getElementById('invite-modal').classList.add('hidden');document.getElementById('invite-emails').value='';document.getElementById('invite-modal-result').innerHTML='';document.getElementById('invite-submit-btn').disabled=true;"
							class="button button-outline btn-theme-outline px-4 py-2 text-sm"
						>
							Cancel
						</button>
						<button
							id="invite-submit-btn"
							onclick="submitInviteEmails()"
							class="button button-primary btn-theme-primary px-4 py-2 text-sm"
							disabled
						>
							Add members
						</button>
					</div>
					<script>
						(function() {
							var ta = document.getElementById('invite-emails');
							var btn = document.getElementById('invite-submit-btn');
							ta.addEventListener('input', function() {
								btn.disabled = ta.value.trim() === '';
							});
						})();

						function submitInviteEmails() {
							var ta = document.getElementById('invite-emails');
							var resultDiv = document.getElementById('invite-modal-result');
							var btn = document.getElementById('invite-submit-btn');
							var emails = ta.value.split(',').map(function(e) { return e.trim(); }).filter(function(e) { return e !== ''; });
							var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
							var invalid = emails.filter(function(e) { return !emailRegex.test(e); });
							if (invalid.length > 0) {
								resultDiv.innerHTML = '<span class="text-red-500">Invalid email(s): ' + invalid.join(', ') + '</span>';
								return;
							}
							if (emails.length === 0) {
								resultDiv.innerHTML = '<span class="text-red-500">Please enter at least one email address.</span>';
								return;
							}
							btn.disabled = true;
							btn.textContent = 'Adding...';
							resultDiv.innerHTML = '';
							var results = [];
							var done = 0;
							emails.forEach(function(email) {
								fetch('/account/invite', {
									method: 'POST',
									headers: { 'Content-Type': 'application/json' },
									body: JSON.stringify({ email: email })
								}).then(function(r) {
									return r.text().then(function(text) {
										results.push({ email: email, ok: r.ok, message: text });
									});
								}).catch(function() {
									results.push({ email: email, ok: false, message: 'Network error' });
								}).finally(function() {
									done++;
									if (done === emails.length) {
										var errors = results.filter(function(r) { return !r.ok; });
										if (errors.length === 0) {
											window.location.reload();
										} else {
											btn.disabled = false;
											btn.textContent = 'Add members';
											resultDiv.innerHTML = errors.map(function(e) {
												return '<div class="text-red-500">' + e.email + ': failed to invite</div>';
											}).join('');
										}
									}
								});
							});
						}
					</script>
				}
			}
		</div>
	}
}

func membersTableColumns(isOwner bool) components.DataTableProps {
	cols := []components.DataTableColumn{
		{Label: "Name", Width: "25%"},
		{Label: "Email", Width: "30%"},
		{Label: "Role", Width: "10%"},
		{Label: "Joined", Width: "15%", HideMobile: true},
	}
	if isOwner {
		cols[0].Width = "20%"
		cols[1].Width = "25%"
		cols = append(cols,
			components.DataTableColumn{Width: "15%"},
			components.DataTableColumn{Width: "10%"},
		)
	}
	return components.DataTableProps{Columns: cols}
}

func invitesTableColumns(isOwner bool) components.DataTableProps {
	cols := []components.DataTableColumn{
		{Label: "Email", Width: "40%"},
		{Label: "Invited By", Width: "30%"},
		{Label: "Date", Width: "30%", HideMobile: true},
	}
	if isOwner {
		cols[2].Width = "20%"
		cols = append(cols, components.DataTableColumn{Width: "10%"})
	}
	return components.DataTableProps{Columns: cols}
}
