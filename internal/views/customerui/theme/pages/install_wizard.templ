package pages

import (
	"fmt"

	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/partials/wizard"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/partials/workflows"
	"github.com/nuonco/mono/services/customer-dashboard/pkg/nuon"
)

// InstallWizardProps holds all data for the install wizard page.
type InstallWizardProps struct {
	customerui.LayoutProps
	CurrentStep      string // "inputs", "stack", "sandbox", "components"
	AppID            string
	AppName          string
	InstallID        string
	WorkflowID       string
	StepGroups       []nuon.WorkflowStepGroup
	ActiveGroups     []nuon.WorkflowStepGroup
	Platform         string
	StackSetup       workflows.StackSetupData
	PrimaryColor     string
	FormProps        *wizard.ConfigureStepProps // for inputs step
	PlanSummary      *workflows.PlanSummary  // terraform plan summary (sandbox step)
	PolicyReports    []nuon.PolicyReport     // policy reports for the current step (sandbox step)
	WizardTab        string                  // active tab: "policies" or "resources"
	ApplyResources   []nuon.TerraformResource // live workspace resources during apply (sandbox step)
	ApplyOutputs     map[string]string         // terraform outputs from sandbox workspace
	ComponentData    map[string]*wizard.ComponentWizardData // keyed by group ID — per-component plan/apply data
	TargetStatus     map[string]wizard.TargetStatus // keyed by group ID — latest status_v2 entry from each component's step target
}

func (p InstallWizardProps) stepURL(step string) string {
	return p.BasePath + "/apps/" + p.AppID + "/install?step=" + step + "&install_id=" + p.InstallID + "&workflow_id=" + p.WorkflowID
}

func (p InstallWizardProps) wizardTabURL(tab string) string {
	return p.stepURL(p.CurrentStep) + "&partial=poll&wizard_tab=" + tab
}

func (p InstallWizardProps) contentPollURL() string {
	u := p.stepURL(p.CurrentStep) + "&partial=content"
	if p.WizardTab != "" {
		u += "&wizard_tab=" + p.WizardTab
	}
	return u
}

func (p InstallWizardProps) pollURL() string {
	u := p.stepURL(p.CurrentStep) + "&partial=poll"
	if p.WizardTab != "" {
		u += "&wizard_tab=" + p.WizardTab
	}
	return u
}

func (p InstallWizardProps) nextStepURL() string {
	steps := []string{"inputs", "stack", "sandbox", "components"}
	for i, s := range steps {
		if s == p.CurrentStep && i+1 < len(steps) {
			return p.stepURL(steps[i+1])
		}
	}
	return ""
}

func (p InstallWizardProps) stepPartialURL(step string) string {
	return p.stepURL(step) + "&partial=poll"
}

func (p InstallWizardProps) currentStepIdx() int {
	return wizard.StepIdx(p.CurrentStep)
}

func (p InstallWizardProps) overviewURL() string {
	return p.BasePath + "/installs/" + p.InstallID + "/overview"
}

// aggregateStatus returns the overall status across all active groups.
// A group counts as "done" only if its status is explicitly completed/success;
// any other non-terminal status (in-progress, pending, not_started, empty)
// keeps the aggregate in the in-progress bucket.
func (p InstallWizardProps) aggregateStatus() string {
	if len(p.ActiveGroups) == 0 {
		return ""
	}
	hasActive := false
	for _, g := range p.ActiveGroups {
		switch g.Status.Status {
		case "error":
			return "error"
		case "approval-awaiting":
			return "approval-awaiting"
		case "completed", "success":
			// terminal — does not count as active
		default:
			hasActive = true
		}
	}
	if hasActive {
		return "in-progress"
	}
	return "completed"
}

func (p InstallWizardProps) hasApprovalAwaiting() bool {
	for _, g := range p.ActiveGroups {
		for _, s := range g.Steps {
			if s.Approval != nil && s.Approval.Response == nil {
				return true
			}
		}
	}
	return false
}

func (p InstallWizardProps) approveAllURL() string {
	return fmt.Sprintf("%s/installs/%s/workflows/%s/approve-all", p.BasePath, p.InstallID, p.WorkflowID)
}

func (p InstallWizardProps) isStepComplete() bool {
	s := p.aggregateStatus()
	return s == "completed" || s == "success"
}

func (p InstallWizardProps) isStepError() bool {
	return p.aggregateStatus() == "error"
}

func (p InstallWizardProps) isStepActive() bool {
	if p.CurrentStep == "inputs" {
		return false
	}
	if len(p.ActiveGroups) == 0 {
		return true // still loading / waiting for steps
	}
	s := p.aggregateStatus()
	return s == "in-progress" || s == "approval-awaiting" || s == "not_started"
}

func (p InstallWizardProps) nextStepLabel() string {
	switch p.CurrentStep {
	case "stack":
		return "Deploy sandbox"
	case "sandbox":
		return "Deploy components"
	default:
		return "Next"
	}
}

func (p InstallWizardProps) isLastStep() bool {
	return p.CurrentStep == "components"
}

// stepStatus returns the actual status for a wizard step based on workflow data.
func (p InstallWizardProps) stepStatus(stepKey string) string {
	if stepKey == "inputs" {
		// Inputs step is completed once we're past it, or if we're on it with an existing install.
		// While on the (hidden) Confirm/Preparing steps, Configure is still active.
		if p.CurrentStep == "confirm" || p.CurrentStep == "preparing" {
			return "in-progress"
		}
		if p.CurrentStep != "inputs" || p.InstallID != "" {
			return "completed"
		}
		return "in-progress"
	}

	// Look up real status from workflow step groups
	hasGroup := false
	allCompleted := true
	for _, g := range p.StepGroups {
		if wizard.MatchesWizardStep(stepKey, g) {
			hasGroup = true
			switch g.Status.Status {
			case "error":
				return "error"
			case "approval-awaiting":
				return "approval-awaiting"
			case "in-progress":
				return "in-progress"
			case "completed", "success":
				continue
			default:
				allCompleted = false
			}
		}
	}
	if hasGroup && allCompleted {
		return "completed"
	}
	if hasGroup {
		return "in-progress"
	}
	return "upcoming"
}

// isStepAccessible returns true if the step before the given key is completed.
func (p InstallWizardProps) isStepAccessible(stepKey string) bool {
	steps := []string{"inputs", "stack", "sandbox", "components"}
	for i, s := range steps {
		if s == stepKey {
			if i == 0 {
				return true
			}
			prev := p.stepStatus(steps[i-1])
			return prev == "completed" || prev == "success"
		}
	}
	return false
}

// InstallWizardPage renders the full wizard page.
templ InstallWizardPage(props InstallWizardProps) {
	@customerui.Layout(props.LayoutProps) {
		<div id="wizard-content" class="max-w-4xl mx-auto pt-6 pb-6" data-step-index={ fmt.Sprintf("%d", props.currentStepIdx()) }>
			@WizardStepContentWithIndicator(props)
		</div>
		@wizardTransitionScript()
	}
}

// buildStepIndicatorProps adapts page-level InstallWizardProps to the focused
// wizard.StepIndicatorProps the indicator expects.
func buildStepIndicatorProps(p InstallWizardProps) wizard.StepIndicatorProps {
	states := make(map[string]wizard.StepState, len(wizard.StepDefs))
	for _, sd := range wizard.StepDefs {
		states[sd.Key] = wizard.StepState{
			Status:     p.stepStatus(sd.Key),
			Accessible: p.isStepAccessible(sd.Key),
			URL:        p.stepURL(sd.Key),
			PartialURL: p.stepPartialURL(sd.Key),
		}
	}
	return wizard.StepIndicatorProps{States: states}
}

// WizardStepContentWithIndicator renders the step indicator + content (for full page render).
templ WizardStepContentWithIndicator(props InstallWizardProps) {
	@wizard.StepIndicator(buildStepIndicatorProps(props))
	<div id="wizard-step-wrapper" class="mt-6">
		@WizardStepContent(props)
	</div>
}

// buildStackStepProps adapts page-level InstallWizardProps to the focused
// wizard.StackStepProps that wizard.StackStep expects.
func buildStackStepProps(p InstallWizardProps) wizard.StackStepProps {
	return wizard.StackStepProps{
		Platform:           p.Platform,
		StackSetup:         p.StackSetup,
		ActiveGroups:       p.ActiveGroups,
		Status:             p.aggregateStatus(),
		IsStepComplete:     p.isStepComplete(),
		NextStepURL:        p.nextStepURL(),
		NextStepPartialURL: p.stepPartialURL("sandbox"),
		NextStepIndex:      p.currentStepIdx() + 1,
		NextStepLabel:      p.nextStepLabel(),
	}
}

// buildSandboxStepProps adapts page-level InstallWizardProps to the focused
// wizard.SandboxStepProps that wizard.SandboxStep expects.
func buildSandboxStepProps(p InstallWizardProps) wizard.SandboxStepProps {
	return wizard.SandboxStepProps{
		BasePath:            p.BasePath,
		InstallID:           p.InstallID,
		WorkflowID:          p.WorkflowID,
		ActiveGroups:        p.ActiveGroups,
		PolicyReports:       p.PolicyReports,
		ApplyResources:      p.ApplyResources,
		ApplyOutputs:        p.ApplyOutputs,
		PlanSummary:         p.PlanSummary,
		ActiveTab:           p.WizardTab,
		TabURL:              p.wizardTabURL,
		HasApprovalAwaiting: p.hasApprovalAwaiting(),
		IsStepComplete:      p.isStepComplete(),
		ApproveAllURL:       p.approveAllURL(),
		NextStepURL:         p.nextStepURL(),
		NextStepPartialURL:  p.stepPartialURL("components"),
		NextStepIndex:       p.currentStepIdx() + 1,
		NextStepLabel:       p.nextStepLabel(),
	}
}

// buildComponentsStepProps adapts page-level InstallWizardProps to the focused
// wizard.ComponentsStepProps that wizard.ComponentsStep expects.
func buildComponentsStepProps(p InstallWizardProps) wizard.ComponentsStepProps {
	return wizard.ComponentsStepProps{
		BasePath:            p.BasePath,
		InstallID:           p.InstallID,
		WorkflowID:          p.WorkflowID,
		ActiveGroups:        p.ActiveGroups,
		ComponentData:       p.ComponentData,
		TargetStatus:        p.TargetStatus,
		PolicyReports:       p.PolicyReports,
		AggregateStatus:     p.aggregateStatus(),
		HasApprovalAwaiting: p.hasApprovalAwaiting(),
		IsStepComplete:      p.isStepComplete(),
		IsStepError:         p.isStepError(),
		ApproveAllURL:       p.approveAllURL(),
		OverviewURL:         p.overviewURL(),
	}
}

// WizardStepContent renders just the step content area (for HTMX polling and step navigation).
templ WizardStepContent(props InstallWizardProps) {
	<div
		id="wizard-step-content"
		data-step-index={ fmt.Sprintf("%d", props.currentStepIdx()) }
		if props.isStepActive() {
			hx-get={ props.pollURL() }
			hx-trigger="every 3s"
			hx-swap="morph:outerHTML"
		}
	>
		switch props.CurrentStep {
		case "inputs":
			@wizard.ConfigureStep(*props.FormProps)
		case "stack":
			@wizard.StackStep(buildStackStepProps(props))
		case "sandbox":
			@wizard.SandboxStep(buildSandboxStepProps(props))
		case "components":
			@wizard.ComponentsStep(buildComponentsStepProps(props))
		}
	</div>
}

// wizardTransitionScript emits the JS that detects navigation direction and
// applies the slide-fade animation class to #wizard-content.
templ wizardTransitionScript() {
	<script>
	(function() {
		var sw = document.getElementById('wizard-step-wrapper');
		if (!sw) return;
		var navTriggered = false;
		var navTargetIdx = -1;
		var STORAGE_KEY = 'wizard-transition';

		function applyTransition(cls) {
			sw.classList.remove('wizard-transition-forward', 'wizard-transition-backward');
			void sw.offsetWidth; // force reflow to restart animation
			sw.classList.add(cls);
			sw.addEventListener('animationend', function handler() {
				sw.classList.remove(cls);
				sw.removeEventListener('animationend', handler);
			});
		}

		// On page load, check if a full-page navigation (form POST → HX-Redirect)
		// left a transition flag in sessionStorage.
		var pending = sessionStorage.getItem(STORAGE_KEY);
		if (pending !== null) {
			sessionStorage.removeItem(STORAGE_KEY);
			var sc = document.getElementById('wizard-step-content');
			var currentIdx = parseInt((sc || sw).getAttribute('data-step-index') || '0', 10);
			var prevIdx = parseInt(pending, 10);
			if (currentIdx !== prevIdx) {
				applyTransition(currentIdx > prevIdx ? 'wizard-transition-forward' : 'wizard-transition-backward');
			}
		}

		// Flag navigation clicks so we can distinguish them from polling swaps.
		document.addEventListener('htmx:beforeRequest', function(evt) {
			var el = evt.detail.elt;
			if (el && el.getAttribute('data-wizard-nav') === 'true') {
				navTriggered = true;
				navTargetIdx = parseInt(el.getAttribute('data-step-index'), 10);
			}
		});

		// Partial swap transitions (step indicator clicks, Next buttons).
		document.addEventListener('htmx:afterSwap', function(evt) {
			if (evt.detail.target !== sw || !navTriggered) return;
			navTriggered = false;

			var sc = document.getElementById('wizard-step-content');
			var oldIdx = parseInt(sw.getAttribute('data-step-index') || '0', 10);
			var newIdx = navTargetIdx;

			// Update the wrapper's step index from the new content element.
			if (sc) {
				sw.setAttribute('data-step-index', sc.getAttribute('data-step-index') || '0');
			}

			applyTransition(newIdx > oldIdx ? 'wizard-transition-forward' : 'wizard-transition-backward');
		});
	})();
	</script>
}
