package pages

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
)

// CustomerLoginPageProps for the themed customer login page
type CustomerLoginPageProps struct {
	BasePath   string
	AuthURL    string
	Error      string
	Theme      *models.AppTheme // Theme contains LoginTitle and LoginSubtitle
	CSSPath    string
}

// CustomerLoginPage renders the customer login page with vendor theming
templ CustomerLoginPage(props CustomerLoginPageProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ getLoginTitle(props.Theme) }</title>
			<link href={ props.CSSPath } rel="stylesheet"/>
			@customerLoginDarkModeScript()
			@customerLoginFontLinks(props.Theme)
			@customerLoginThemeStyles(props.Theme)
		</head>
		<body class="bg-cool-grey-50 dark:bg-dark-grey-950">
			<div class="flex h-screen w-full">
				<!-- Left Side - Content -->
				<div class="flex flex-col gap-10 justify-center w-full lg:w-[840px] bg-cool-grey-50 dark:bg-dark-grey-950 px-8 md:px-20 py-16">
					<!-- Card -->
					<div class="bg-white dark:bg-dark-grey-800 border border-cool-grey-500/25 dark:border-dark-grey-500 shadow-sm px-8 md:px-[70px] py-12 md:py-16 w-full flex flex-col gap-8" style="border-radius: var(--theme-radius)">
						<!-- Logo -->
						if props.Theme != nil {
							if props.Theme.LogoDarkBase64 != "" {
								<!-- Both logos available - show appropriate one based on dark mode -->
								<img src={ props.Theme.LogoLightBase64 } alt="Logo" class="h-10 w-auto max-w-xs object-contain mx-auto dark:hidden"/>
								<img src={ props.Theme.LogoDarkBase64 } alt="Logo" class="h-10 w-auto max-w-xs object-contain mx-auto hidden dark:block"/>
							} else if props.Theme.LogoLightBase64 != "" {
								<!-- Only light logo available - show in both modes -->
								<img src={ props.Theme.LogoLightBase64 } alt="Logo" class="h-10 w-auto max-w-xs object-contain mx-auto"/>
							}
						}
						<!-- Heading and Subtitle -->
						<div class="flex flex-col gap-6">
							<h1 class="text-[34px] leading-10 tracking-[-0.8px] font-strong font-heading text-cool-grey-900 dark:text-white">
								{ getLoginTitle(props.Theme) }
							</h1>
							<p class="text-lg leading-[27px] tracking-[-0.2px] font-body text-cool-grey-600 dark:text-white/70">
								{ getLoginSubtitle(props.Theme) }
							</p>
						</div>
						<!-- Error message -->
						if props.Error != "" {
							<div class="p-4 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-300" style="border-radius: var(--theme-radius)">
								{ props.Error }
							</div>
						}
						<!-- Sign Up Button (Primary) -->
						<a
							href={ templ.SafeURL(props.AuthURL) }
							class="w-full inline-flex items-center justify-center text-sm h-9 px-3 py-1 leading-[21px] font-strong tracking-tight border border-transparent bg-theme-primary hover:bg-theme-primary-hover text-white transition-colors"
							style="border-radius: var(--theme-radius)"
						>
							Sign up
						</a>
						<!-- Divider -->
						<hr class="border-cool-grey-300 dark:border-dark-grey-500"/>
						<!-- Already have account section -->
						<h2 class="text-2xl leading-[30px] tracking-[-0.8px] font-strong font-heading text-cool-grey-900 dark:text-white">
							Already have an account?
						</h2>
						<!-- Sign In Button (Secondary) -->
						<a
							href={ templ.SafeURL(props.AuthURL) }
							class="w-full inline-flex items-center justify-center text-sm h-9 px-3 py-1 leading-[21px] font-strong tracking-tight border bg-white dark:bg-dark-grey-700 hover:bg-cool-grey-50 dark:hover:bg-dark-grey-500 transition-colors"
							style={ "border-radius: var(--theme-radius); border-color: var(--theme-primary); color: var(--theme-primary)" }
						>
							Sign in
						</a>
					</div>
				</div>
				<!-- Right Side - Themed Background, Gradient, or Image -->
				if props.Theme != nil && props.Theme.GetLoginRightSideImage() != "" {
					<!-- Priority 1: Custom right side image -->
					<div class="hidden lg:flex relative flex-1 overflow-hidden">
						<img
							src={ props.Theme.GetLoginRightSideImage() }
							alt="Login background"
							class="w-full h-full object-cover"
						/>
					</div>
				} else if props.Theme != nil && props.Theme.GetLoginRightSideGradient() != "" {
					<!-- Priority 2: Custom gradient -->
					<div class="hidden lg:flex relative flex-1 overflow-hidden" style={ templ.SafeCSS("background: " + props.Theme.GetLoginRightSideGradient() + ";") }>
						<!-- Optional decorative pattern overlay -->
						<div class="absolute inset-0 opacity-10">
							<svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
								<defs>
									<pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
										<path d="M 10 0 L 0 0 0 10" fill="none" stroke="white" stroke-width="0.5"/>
									</pattern>
								</defs>
								<rect width="100" height="100" fill="url(#grid)"/>
							</svg>
						</div>
					</div>
				} else {
					<!-- Priority 3: Default themed background -->
					<div class="hidden lg:flex relative flex-1 overflow-hidden bg-theme-primary">
						<div class="absolute inset-0 opacity-10">
							<svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
								<defs>
									<pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
										<path d="M 10 0 L 0 0 0 10" fill="none" stroke="white" stroke-width="0.5"/>
									</pattern>
								</defs>
								<rect width="100" height="100" fill="url(#grid)"/>
							</svg>
						</div>
					</div>
				}
			</div>
		</body>
	</html>
}

templ customerLoginDarkModeScript() {
	<script>
		(function() {
			if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
				document.documentElement.classList.add('dark');
			}
			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
				document.documentElement.classList.toggle('dark', e.matches);
			});
		})();
	</script>
}

templ customerLoginFontLinks(theme *models.AppTheme) {
	<link rel="preconnect" href="https://fonts.googleapis.com"/>
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
	if theme != nil && theme.HeadingFontBase64 != "" {
		<style>
			@font-face {
				font-family: 'CustomHeading';
				src: url({ theme.HeadingFontBase64 }) format('woff2');
				font-display: swap;
			}
		</style>
	}
	if theme != nil && theme.BodyFontBase64 != "" {
		<style>
			@font-face {
				font-family: 'CustomBody';
				src: url({ theme.BodyFontBase64 }) format('woff2');
				font-display: swap;
			}
		</style>
	}
	if theme != nil && theme.HeadingFont != "" && theme.HeadingFontBase64 == "" {
		<link href={ "https://fonts.googleapis.com/css2?family=" + theme.HeadingFont + ":wght@400;500;600;700&display=swap" } rel="stylesheet"/>
	}
	if theme != nil && theme.BodyFont != "" && theme.BodyFontBase64 == "" && theme.BodyFont != theme.HeadingFont {
		<link href={ "https://fonts.googleapis.com/css2?family=" + theme.BodyFont + ":wght@400;500;600&display=swap" } rel="stylesheet"/>
	}
}

templ customerLoginThemeStyles(theme *models.AppTheme) {
	@templ.Raw(buildCustomerLoginThemeCSS(theme))
}

func buildCustomerLoginThemeCSS(theme *models.AppTheme) string {
	css := "<style>:root {"

	// Primary color (default to blue if not set)
	if theme != nil && theme.PrimaryColor != "" {
		css += "--theme-primary: " + theme.PrimaryColor + ";"
		css += "--theme-primary-hover: " + theme.PrimaryColor + ";"
	} else {
		css += "--theme-primary: #2563EB;"
		css += "--theme-primary-hover: #1D4ED8;"
	}

	// Secondary color
	if theme != nil && theme.SecondaryColor != "" {
		css += "--theme-secondary: " + theme.SecondaryColor + ";"
	}

	// Heading font
	if theme != nil && theme.HeadingFontBase64 != "" {
		css += "--font-heading: 'CustomHeading', 'Inter', ui-sans-serif, system-ui, sans-serif;"
	} else if theme != nil && theme.HeadingFont != "" {
		css += "--font-heading: '" + theme.HeadingFont + "', 'Inter', ui-sans-serif, system-ui, sans-serif;"
	} else {
		css += "--font-heading: 'Inter', ui-sans-serif, system-ui, sans-serif;"
	}

	// Body font
	if theme != nil && theme.BodyFontBase64 != "" {
		css += "--font-body: 'CustomBody', 'Inter', ui-sans-serif, system-ui, sans-serif;"
	} else if theme != nil && theme.BodyFont != "" {
		css += "--font-body: '" + theme.BodyFont + "', 'Inter', ui-sans-serif, system-ui, sans-serif;"
	} else {
		css += "--font-body: 'Inter', ui-sans-serif, system-ui, sans-serif;"
	}

	// Border radius
	if theme != nil {
		switch theme.BorderRadius {
		case "sharp":
			css += "--theme-radius: 0;"
		case "subtle":
			css += "--theme-radius: 4px;"
		case "very-rounded":
			css += "--theme-radius: 12px;"
		default:
			css += "--theme-radius: 8px;"
		}
	} else {
		css += "--theme-radius: 8px;"
	}

	css += "}</style>"
	return css
}

// getLoginTitle returns the login title from theme or the default
func getLoginTitle(theme *models.AppTheme) string {
	if theme != nil {
		return theme.GetLoginTitle()
	}
	return models.DefaultLoginTitle
}

// getLoginSubtitle returns the login subtitle from theme or the default
func getLoginSubtitle(theme *models.AppTheme) string {
	if theme != nil {
		return theme.GetLoginSubtitle()
	}
	return models.DefaultLoginSubtitle
}
