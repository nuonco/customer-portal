package pages

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/components"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/scripts"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/utils"
)

// CustomerLoginPageProps for the themed customer login page
type CustomerLoginPageProps struct {
	BasePath      string
	AuthURL       string
	Error         string
	Theme         *models.AppTheme // Theme contains LoginTitle and LoginSubtitle
	CSSPath       string
	CustomCSSPath string
	OrgName       string
}

// CustomerLoginPage renders the customer login page with vendor theming
templ CustomerLoginPage(props CustomerLoginPageProps) {
	<!DOCTYPE html>
	<html lang="en" class={ templ.KV("dark", getThemeMode(props.Theme) == "dark"), templ.KV("light", getThemeMode(props.Theme) == "light") }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ getLoginTitle(props.Theme, props.OrgName) }</title>
			if props.Theme != nil && props.Theme.FaviconBase64 != "" {
				<link rel="icon" href={ templ.SafeURL(props.Theme.FaviconBase64) }/>
			}
			<link href={ props.CSSPath } rel="stylesheet"/>
			if props.CustomCSSPath != "" {
				<link href={ props.CustomCSSPath } rel="stylesheet"/>
			}
			@scripts.DarkMode(getThemeMode(props.Theme))
			@customerLoginFontLinks(props.Theme)
			@customerLoginThemeStyles(props.Theme)
		</head>
		<body>
			<div class="flex h-screen w-full">
				<!-- Left Side - Content -->
				<div class="flex flex-col gap-10 justify-center items-center w-full lg:w-1/2 px-8 md:px-20 py-16">
					<!-- Card -->
					@components.Card(components.CardProps{Class: "px-8 md:px-[70px] py-12 md:py-16 w-full max-w-xl flex flex-col gap-8"}) {
						<!-- Logo -->
						if props.Theme != nil {
							if props.Theme.LogoDarkBase64 != "" {
								<!-- Both logos available - show appropriate one based on dark mode -->
								<img src={ props.Theme.LogoLightBase64 } alt="Logo" class="h-10 w-auto max-w-xs object-contain mx-auto dark:hidden"/>
								<img src={ props.Theme.LogoDarkBase64 } alt="Logo" class="h-10 w-auto max-w-xs object-contain mx-auto hidden dark:block"/>
							} else if props.Theme.LogoLightBase64 != "" {
								<!-- Only light logo available - show in both modes -->
								<img src={ props.Theme.LogoLightBase64 } alt="Logo" class="h-10 w-auto max-w-xs object-contain mx-auto"/>
							}
						}
						<!-- Heading and Subtitle -->
						<div class="flex flex-col gap-6">
							<h1 class="text-[34px] leading-10 tracking-[-0.8px] font-strong font-heading text-cool-grey-900 dark:text-white">
								{ getLoginTitle(props.Theme, props.OrgName) }
							</h1>
							<p class="text-lg leading-[27px] tracking-[-0.2px] font-body text-cool-grey-600 dark:text-white/70">
								{ getLoginSubtitle(props.Theme, props.OrgName) }
							</p>
						</div>
						<!-- Error message -->
						if props.Error != "" {
							<div class="alert-error">
								{ props.Error }
							</div>
						}
						<!-- Sign Up Button (Primary) -->
						<a
							href={ templ.SafeURL(props.AuthURL) }
							class="button button-primary w-full btn-theme-primary text-sm h-9 leading-[21px] tracking-tight rounded-theme"
						>
							Sign up
						</a>
						<!-- Divider -->
						<div class="flex items-center gap-3">
							<hr class="hr-divider flex-1"/>
							<span class="text-sm font-medium text-cool-grey-400 dark:text-cool-grey-500">or</span>
							<hr class="hr-divider flex-1"/>
						</div>
						<!-- Log In Button (Secondary) -->
						<a
							href={ templ.SafeURL(props.AuthURL) }
							class="button button-outline w-full inline-flex items-center justify-center text-sm h-9 px-3 py-1 leading-[21px] font-strong tracking-tight border theme-card-bg hover:bg-cool-grey-50 dark:hover:bg-dark-grey-500 transition-colors rounded-theme"
							style={ "border-color: var(--theme-primary); color: var(--theme-primary)" }
						>
							Log in
						</a>
					}
				</div>
				<!-- Right Side - Themed Background, Gradient, or Image -->
				@customerLoginRightPanel(props.Theme)
			</div>
		</body>
	</html>
}

// customerLoginRightPanel renders the right-side panel with light and dark mode support
templ customerLoginRightPanel(theme *models.AppTheme) {
	@templ.Raw(buildLoginRightPanelCSS(theme))
	<div id="login-right-panel" class="hidden lg:flex relative flex-1 overflow-hidden bg-theme-primary">
		if theme == nil || (theme.GetLoginRightSideImage() == "" && theme.GetLoginRightSideImageDark() == "") {
			<div class="absolute inset-0 opacity-10">
				<svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
					<defs>
						<pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
							<path d="M 10 0 L 0 0 0 10" fill="none" stroke="white" stroke-width="0.5"/>
						</pattern>
					</defs>
					<rect width="100" height="100" fill="url(#grid)"/>
				</svg>
			</div>
		}
	</div>
}

func buildLoginRightPanelCSS(theme *models.AppTheme) string {
	if theme == nil {
		return ""
	}

	lightImage := theme.GetLoginRightSideImage()
	lightGradient := theme.GetLoginRightSideGradient()
	darkImage := theme.GetLoginRightSideImageDark()
	darkGradient := theme.GetLoginRightSideGradientDark()

	lightRule := ""
	if lightImage != "" {
		lightRule = "background-image: url(" + lightImage + "); background-size: cover; background-position: center;"
	} else if lightGradient != "" {
		lightRule = "background: " + lightGradient + ";"
	}

	darkRule := ""
	if darkImage != "" {
		darkRule = "background-image: url(" + darkImage + "); background-size: cover; background-position: center; background-color: transparent;"
	} else if darkGradient != "" {
		darkRule = "background: " + darkGradient + ";"
	}

	if lightRule == "" && darkRule == "" {
		return ""
	}

	css := "<style>"
	if lightRule != "" {
		css += "#login-right-panel { " + lightRule + " }"
	}
	if darkRule != "" {
		css += ".dark #login-right-panel { " + darkRule + " }"
	}
	css += "</style>"
	return css
}

func getThemeMode(theme *models.AppTheme) string {
	if theme != nil {
		return theme.GetThemeMode()
	}
	return "auto"
}

templ customerLoginFontLinks(theme *models.AppTheme) {
	<link rel="preconnect" href="https://fonts.googleapis.com"/>
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
	if theme != nil && theme.HeadingFontBase64 != "" {
		<style>
			@font-face {
				font-family: 'CustomHeading';
				src: url({ theme.HeadingFontBase64 }) format('woff2');
				font-display: swap;
			}
		</style>
	}
	if theme != nil && theme.BodyFontBase64 != "" {
		<style>
			@font-face {
				font-family: 'CustomBody';
				src: url({ theme.BodyFontBase64 }) format('woff2');
				font-display: swap;
			}
		</style>
	}
	if theme != nil && theme.HeadingFont != "" && theme.HeadingFontBase64 == "" {
		<link href={ "https://fonts.googleapis.com/css2?family=" + theme.HeadingFont + ":wght@400;500;600;700&display=swap" } rel="stylesheet"/>
	}
	if theme != nil && theme.BodyFont != "" && theme.BodyFontBase64 == "" && theme.BodyFont != theme.HeadingFont {
		<link href={ "https://fonts.googleapis.com/css2?family=" + theme.BodyFont + ":wght@400;500;600&display=swap" } rel="stylesheet"/>
	}
}

templ customerLoginThemeStyles(theme *models.AppTheme) {
	@templ.Raw(utils.BuildLoginThemeCSS(theme))
}

// getLoginTitle returns the login title from theme or an org-aware default
func getLoginTitle(theme *models.AppTheme, orgName string) string {
	if theme != nil && theme.LoginTitle != "" {
		return theme.LoginTitle
	}
	if orgName != "" {
		return orgName + " BYOC"
	}
	return models.DefaultLoginTitle
}

// getLoginSubtitle returns the login subtitle from theme or an org-aware default
func getLoginSubtitle(theme *models.AppTheme, orgName string) string {
	if theme != nil && theme.LoginSubtitle != "" {
		return theme.LoginSubtitle
	}
	if orgName != "" {
		return "Manage your " + orgName + " BYOC installs"
	}
	return models.DefaultLoginSubtitle
}
