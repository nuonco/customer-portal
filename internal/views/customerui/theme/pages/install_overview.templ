package pages

import (
	"fmt"
	"net/url"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/components"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/partials"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/partials/workflows"
	nuonmodels "github.com/nuonco/nuon-go/models"
)

// InstallOverviewPageProps contains all data for the overview page.
type InstallOverviewPageProps struct {
	customerui.LayoutProps
	Install         *models.Install
	AppName         string
	APIDeletedError bool
	// Overview summary data
	StackStatus    string
	StackRegion    string
	StackAccountID string
	SandboxStatus     string
	SandboxRepo       string
	SandboxBranch     string
	SandboxRepoPublic bool
	Components     []partials.ComponentInfo
	// Tabs
	ActiveTab string // "history" (default) or "inputs"
	// History tab data
	RecentWorkflows []*nuonmodels.AppWorkflow
	// Inputs tab data
	InputFields []partials.InputFieldRow
	// Alerts (from redirects after actions)
	AlertType string // "error" or "success"
	AlertMsg  string
	// App config version info
	AppConfigVersion       int64
	AppConfigUpdatedAt     string
	InstallConfigVersion   int64
	InstallConfigUpdatedAt string
	// Branding
	PrimaryColor       string
	AppLogoLightBase64 string
	AppLogoDarkBase64  string
	// Workflow panel (populated when a workflow is selected via URL path)
	SelectedWorkflow *partials.WorkflowDataPanel
	WorkflowOverview *workflows.WorkflowOverviewProps
	Expanded         bool // panel expanded to full width
	HasData          bool // true when overview data has been fetched (false = show shimmer)
}

// --- URL helpers (mirrors debug page pattern) ---

type overviewURLParams struct {
	BasePath   string
	InstallID  string
	WorkflowID string // when set, path includes /workflows/:id
	Tab        string
	Expanded   bool
	Group      int // selected step group index (-1 = omit)
	Partial    string
	AlertType  string
	AlertMsg   string
}

func buildOverviewURL(p overviewURLParams) string {
	path := fmt.Sprintf("%s/installs/%s/overview", p.BasePath, p.InstallID)
	if p.WorkflowID != "" {
		path += "/workflows/" + p.WorkflowID
	}
	sep := "?"
	if p.Tab != "" && p.Tab != "history" {
		path += sep + "tab=" + p.Tab
		sep = "&"
	}
	if p.Expanded {
		path += sep + "expanded=true"
		sep = "&"
	}
	if p.Group >= 0 {
		path += sep + fmt.Sprintf("group=%d", p.Group)
		sep = "&"
	}
	if p.Partial != "" {
		path += sep + "partial=" + p.Partial
		sep = "&"
	}
	if p.AlertType != "" && p.AlertMsg != "" {
		path += sep + "alert_type=" + p.AlertType + "&alert_msg=" + url.QueryEscape(p.AlertMsg)
	}
	return path
}

func overviewBaseParams(props InstallOverviewPageProps) overviewURLParams {
	p := overviewURLParams{
		BasePath:  props.BasePath,
		InstallID: props.Install.ID,
		Tab:       props.ActiveTab,
		Expanded:  props.Expanded,
		Group:     -1,
	}
	if props.SelectedWorkflow != nil {
		p.WorkflowID = props.SelectedWorkflow.ID
	}
	if props.WorkflowOverview != nil && props.WorkflowOverview.SelectedGroup >= 0 {
		p.Group = props.WorkflowOverview.SelectedGroup
	}
	return p
}

func overviewWithPartial(p overviewURLParams, partial string) string {
	p.Partial = partial
	return buildOverviewURL(p)
}

func overviewDismissAlertParams(props InstallOverviewPageProps) overviewURLParams {
	p := overviewBaseParams(props)
	p.AlertType = ""
	p.AlertMsg = ""
	return p
}

func overviewExpandParams(props InstallOverviewPageProps, expanded bool) overviewURLParams {
	p := overviewBaseParams(props)
	p.Expanded = expanded
	return p
}

// overviewCloseParams returns params for closing the workflow panel (no workflow ID).
func overviewCloseParams(props InstallOverviewPageProps) overviewURLParams {
	return overviewURLParams{
		BasePath:  props.BasePath,
		InstallID: props.Install.ID,
		Tab:       props.ActiveTab,
		Group:     -1,
	}
}

// overviewWorkflowRowParams returns params for a workflow row link.
func overviewWorkflowRowParams(props InstallOverviewPageProps, workflowID string) overviewURLParams {
	return overviewURLParams{
		BasePath:   props.BasePath,
		InstallID:  props.Install.ID,
		WorkflowID: workflowID,
		Group:      -1,
	}
}

// --- HTMX targets ---

const overviewContentTarget = "#overview-content"
const overviewPanelWrapperTarget = "#overview-workflow-panel-wrapper"

// --- Page template ---

templ InstallOverviewPage(props InstallOverviewPageProps) {
	@customerui.Layout(props.LayoutProps) {
		@installPageShell(InstallPageProps{
			LayoutProps:     props.LayoutProps,
			Install:         props.Install,
			AppName:         props.AppName,
			APIDeletedError: props.APIDeletedError,
			PageTitle:       "Overview",
			PageIcon:        "house-simple",
		}) {
			if props.HasData {
				@OverviewContent(props)
			} else {
				<div
					id="overview-content"
					class="px-6 pb-6"
					hx-get={ overviewWithPartial(overviewBaseParams(props), "content") }
					hx-trigger="load"
					hx-swap="outerHTML"
				>
					@overviewShimmer(props)
				</div>
			}
			@OverviewWorkflowPanel(props)
		}
	}
}

// OverviewContent renders the main content area (used for both full page and partial responses).
templ OverviewContent(props InstallOverviewPageProps) {
	<div id="overview-content" class="px-6 pb-6">
		// Alert banner
		if props.AlertType != "" && props.AlertMsg != "" {
			<div class="mb-4">
				@components.Alert(components.AlertProps{
					Type:    props.AlertType,
					Message: props.AlertMsg,
				})
				<a
					href={ templ.SafeURL(buildOverviewURL(overviewDismissAlertParams(props))) }
					hx-get={ overviewWithPartial(overviewDismissAlertParams(props), "content") }
					hx-target={ overviewContentTarget }
					hx-swap="outerHTML"
					hx-push-url={ buildOverviewURL(overviewDismissAlertParams(props)) }
					hx-boost="false"
					class="text-xs text-cool-grey-500 hover:text-cool-grey-700 dark:hover:text-cool-grey-300 mt-1 inline-block"
				>
					Dismiss
				</a>
			</div>
		}
		// API Deletion Warning Banner
		if props.APIDeletedError {
			<div class="alert-warning mb-4">
				<div class="flex items-start">
					<div class="flex-shrink-0 mr-3 text-amber-500">
						<i class="ph-bold ph-warning text-xl"></i>
					</div>
					<div class="flex-1">
						<h3 class="text-sm font-medium text-amber-800 dark:text-amber-300 mb-1">Install Deleted from API</h3>
						<p class="text-sm text-amber-700 dark:text-amber-400 mb-3">
							This install was deleted from the Nuon control plane but still exists in your local portal.
							You are viewing cached data only. Live features (health checks, workflows, updates) are unavailable.
						</p>
						<p class="text-sm text-amber-700 dark:text-amber-400 mb-3">
							<strong>Action required:</strong> Contact your vendor to remove this install from the portal.
						</p>
					</div>
				</div>
			</div>
		}
		if !props.APIDeletedError {
			@partials.OverviewSummaryCards(partials.InstallDetailPanelProps{
				Install:           props.Install,
				BasePath:          props.BasePath,
				StackStatus:       props.StackStatus,
				StackRegion:       props.StackRegion,
				StackAccountID:    props.StackAccountID,
				SandboxStatus:     props.SandboxStatus,
				SandboxRepo:       props.SandboxRepo,
				SandboxBranch:     props.SandboxBranch,
				SandboxRepoPublic: props.SandboxRepoPublic,
				Components:        props.Components,
			})
		}
		// Tab bar
		@overviewTabBar(props)
		// Active tab content
		switch props.ActiveTab {
		case "inputs":
			@partials.OverviewConfigurationTab(props.InputFields)
		default:
			@overviewHistoryTab(props)
		}
	</div>
}

// --- Workflow panel ---

func overviewPanelProps(props InstallOverviewPageProps) components.PanelProps {
	p := components.PanelProps{
		Title:         props.SelectedWorkflow.Name,
		TitleBadge:    workflowStatusChip(props.SelectedWorkflow.Status),
		ID:            "overview-workflow-panel",
		Open:          true,
		Expanded:      props.Expanded,
		CloseURL:      buildOverviewURL(overviewCloseParams(props)),
		HxCloseGet:    overviewWithPartial(overviewCloseParams(props), "panel"),
		ExpandURL:     buildOverviewURL(overviewExpandParams(props, true)),
		CollapseURL:   buildOverviewURL(overviewExpandParams(props, false)),
		HxExpandGet:   overviewWithPartial(overviewExpandParams(props, true), "panel"),
		HxCollapseGet: overviewWithPartial(overviewExpandParams(props, false), "panel"),
		HeaderActions: overviewPanelHeaderActions(props),
	}
	// Poll when workflow is still running
	if props.WorkflowOverview != nil && !props.WorkflowOverview.WorkflowFinished {
		bp := overviewBaseParams(props)
		p.HxPollGet = overviewWithPartial(bp, "panel")
		p.HxPollInterval = "every 5s"
	}
	return p
}

// OverviewWorkflowPanel renders the sliding panel (open when a workflow is selected, closed otherwise).
templ OverviewWorkflowPanel(props InstallOverviewPageProps) {
	if props.SelectedWorkflow != nil {
		@components.Panel(overviewPanelProps(props)) {
			if props.WorkflowOverview != nil {
				@workflows.WorkflowOverview(*props.WorkflowOverview)
			}
		}
	} else {
		@components.Panel(components.PanelProps{
			Title: "Workflow Detail",
			ID:    "overview-workflow-panel",
			Open:  false,
		})
	}
}

// OverviewWorkflowPanelShimmer renders an open panel with shimmer placeholders
// and hx-trigger="load" to fetch the real panel content.
templ OverviewWorkflowPanelShimmer(props InstallOverviewPageProps, workflowID string) {
	@components.Panel(components.PanelProps{
		Title:      "Loading...",
		ID:         "overview-workflow-panel",
		Open:       true,
		CloseURL:   buildOverviewURL(overviewCloseParams(props)),
		HxCloseGet: overviewWithPartial(overviewCloseParams(props), "panel"),
	}) {
		<div
			hx-get={ overviewWithPartial(overviewWorkflowRowParams(props, workflowID), "panel") }
			hx-trigger="load"
			hx-target={ overviewPanelWrapperTarget }
			hx-swap="outerHTML"
		>
			@workflowPanelShimmer()
		</div>
	}
}

templ workflowStatusChip(status string) {
	switch status {
	case "completed", "success":
		<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400">
			<i class="ph-bold ph-check-circle text-xs"></i>
			Completed
		</span>
	case "in-progress":
		<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400">
			<i class="ph-bold ph-circle-notch animate-spin text-xs"></i>
			In Progress
		</span>
	case "approval-awaiting":
		<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400">
			<i class="ph-bold ph-clock text-xs"></i>
			Awaiting Approval
		</span>
	case "error":
		<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400">
			<i class="ph-bold ph-x-circle text-xs"></i>
			Failed
		</span>
	case "cancelled":
		<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-cool-grey-100 text-cool-grey-700 dark:bg-cool-grey-800 dark:text-cool-grey-300">
			Cancelled
		</span>
	case "pending":
		<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-cool-grey-100 text-cool-grey-700 dark:bg-cool-grey-800 dark:text-cool-grey-300">
			Pending
		</span>
	}
}

templ overviewPanelHeaderActions(props InstallOverviewPageProps) {
	if props.WorkflowOverview != nil {
		<form method="POST" action={ templ.SafeURL(props.BasePath + "/installs/" + props.Install.ID + "/workflows/" + props.WorkflowOverview.WorkflowID + "/approve-all") } class="inline">
			<button
				type="submit"
				class="button button-primary btn-theme-primary text-xs px-2.5 py-1 disabled:opacity-40 disabled:cursor-not-allowed"
				disabled?={ !props.WorkflowOverview.ShowApproveAll }
			>
				Approve All
			</button>
		</form>
		<form method="POST" action={ templ.SafeURL(props.BasePath + "/installs/" + props.Install.ID + "/workflows/" + props.WorkflowOverview.WorkflowID + "/cancel") } class="inline">
			<button
				type="submit"
				class="button button-neutral btn-theme-outline text-xs px-2.5 py-1 disabled:opacity-40 disabled:cursor-not-allowed"
				disabled?={ props.WorkflowOverview.WorkflowFinished }
			>
				Cancel
			</button>
		</form>
	}
}

// --- History tab with proper links ---

templ overviewHistoryTab(props InstallOverviewPageProps) {
	if len(props.RecentWorkflows) == 0 {
		@components.EmptyState(components.EmptyStateProps{Title: "No workflows", Icon: "ph-clock-clockwise"})
	} else {
		<table class="w-full text-sm table-fixed">
			<colgroup>
				<col class="w-[30%]"/>
				<col class="w-[20%]"/>
				<col class="w-[25%]"/>
				<col class="w-[25%]"/>
			</colgroup>
			<thead>
				<tr class="border-b border-cool-grey-200 dark:border-dark-grey-600">
					<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">Type</th>
					<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">Status</th>
					<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">Date</th>
					<th class="text-left py-2 font-medium text-cool-grey-500 dark:text-cool-grey-400">Duration</th>
				</tr>
			</thead>
			<tbody>
				for _, wf := range props.RecentWorkflows {
					@overviewWorkflowRow(props, wf)
				}
			</tbody>
		</table>
	}
}

templ overviewWorkflowRow(props InstallOverviewPageProps, wf *nuonmodels.AppWorkflow) {
	<tr class="border-b border-cool-grey-100 dark:border-dark-grey-700 last:border-b-0">
		<td colspan="4" class="p-0">
			<a
				href={ templ.SafeURL(buildOverviewURL(overviewWorkflowRowParams(props, wf.ID))) }
				hx-get={ overviewWithPartial(overviewWorkflowRowParams(props, wf.ID), "panel-shimmer") }
				hx-target={ overviewPanelWrapperTarget }
				hx-swap="outerHTML"
				hx-push-url={ buildOverviewURL(overviewWorkflowRowParams(props, wf.ID)) }
				hx-boost="false"
				class="grid grid-cols-4 cursor-pointer hover:bg-cool-grey-50 dark:hover:bg-dark-grey-700"
				style="grid-template-columns: 30% 20% 25% 25%"
			>
				<span class="py-2 pr-3 font-medium text-cool-grey-900 dark:text-white truncate" title={ overviewWorkflowTypeLabel(wf) }>
					{ overviewWorkflowTypeLabel(wf) }
				</span>
				<span class="py-2 pr-3">
					<span class={ "px-2 py-0.5 text-xs font-medium rounded-full", overviewWorkflowStatusClass(wf) }>
						{ overviewWorkflowStatus(wf) }
					</span>
				</span>
				<span class="py-2 pr-3 text-cool-grey-600 dark:text-cool-grey-400 whitespace-nowrap">{ partials.FormatAPITime(wf.CreatedAt) }</span>
				<span class="py-2 text-cool-grey-600 dark:text-cool-grey-400 whitespace-nowrap">{ overviewWorkflowDuration(wf) }</span>
			</a>
		</td>
	</tr>
}

// --- Tab bar ---

func overviewTabHref(props InstallOverviewPageProps, tab string) string {
	p := overviewURLParams{
		BasePath:  props.BasePath,
		InstallID: props.Install.ID,
		Tab:       tab,
		Group:     -1,
	}
	return buildOverviewURL(p)
}

func overviewTabHxGet(props InstallOverviewPageProps, tab string) string {
	p := overviewURLParams{
		BasePath:  props.BasePath,
		InstallID: props.Install.ID,
		Tab:       tab,
		Partial:   "content",
		Group:     -1,
	}
	return buildOverviewURL(p)
}

templ overviewTabBar(props InstallOverviewPageProps) {
	@components.TabBar(components.TabBarProps{
		Tabs: []components.Tab{
			{
				Label:    "History",
				Href:     overviewTabHref(props, "history"),
				HxGet:    overviewTabHxGet(props, "history"),
				HxTarget: overviewContentTarget,
				HxSwap:   "outerHTML",
				Active:   props.ActiveTab == "" || props.ActiveTab == "history",
			},
			{
				Label:    "Inputs",
				Href:     overviewTabHref(props, "inputs"),
				HxGet:    overviewTabHxGet(props, "inputs"),
				HxTarget: overviewContentTarget,
				HxSwap:   "outerHTML",
				Active:   props.ActiveTab == "inputs",
			},
		},
	})
}

// --- Workflow display helpers ---

func overviewWorkflowTypeLabel(wf *nuonmodels.AppWorkflow) string {
	if wf.Type != "" {
		switch wf.Type {
		case "provision":
			return "Provision"
		case "deprovision":
			return "Deprovision"
		case "reprovision":
			return "Reprovision"
		default:
			return string(wf.Type)
		}
	}
	return "Workflow"
}

func overviewWorkflowStatus(wf *nuonmodels.AppWorkflow) string {
	if wf.Status != nil {
		return string(wf.Status.Status)
	}
	return ""
}

func overviewWorkflowStatusClass(wf *nuonmodels.AppWorkflow) string {
	s := overviewWorkflowStatus(wf)
	switch s {
	case "completed", "success":
		return "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200"
	case "error", "failed":
		return "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200"
	case "in-progress", "running":
		return "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200"
	case "cancelled":
		return "bg-cool-grey-100 text-cool-grey-800 dark:bg-cool-grey-800 dark:text-cool-grey-200"
	default:
		return "bg-cool-grey-100 text-cool-grey-800 dark:bg-cool-grey-800 dark:text-cool-grey-200"
	}
}

func overviewWorkflowDuration(wf *nuonmodels.AppWorkflow) string {
	if wf.ExecutionTime > 0 {
		return formatDuration(wf.ExecutionTime)
	}
	if !wf.Finished {
		return "running..."
	}
	return "—"
}

// --- Shimmer skeleton ---

templ overviewShimmer(props InstallOverviewPageProps) {
	// Summary cards (Stack + Sandbox)
	<div class="space-y-4">
		<div class="grid grid-cols-2 gap-4">
			@components.Card(components.CardProps{Header: shimmerCardHeader("ph-stack", "Stack")}) {
				<div class="space-y-3 text-sm">
					@components.ShimmerLines(3)
				</div>
			}
			@components.Card(components.CardProps{Header: shimmerCardHeader("ph-shipping-container", "Sandbox")}) {
				<div class="space-y-3 text-sm">
					@components.ShimmerLines(3)
				</div>
			}
		</div>
		// Components card
		@components.Card(components.CardProps{Header: shimmerCardHeader("ph-cards", "Components")}) {
			<div class="flex flex-wrap gap-2">
				@components.ShimmerBar("h-8", "w-24")
				@components.ShimmerBar("h-8", "w-28")
				@components.ShimmerBar("h-8", "w-20")
				@components.ShimmerBar("h-8", "w-24")
			</div>
		}
	</div>
	// Tab bar
	<div class="flex gap-4 border-b border-cool-grey-200 dark:border-dark-grey-600 mt-4 mb-4 pb-2">
		@components.ShimmerBar("h-5", "w-16")
		@components.ShimmerBar("h-5", "w-16")
	</div>
	// History table rows
	<div class="space-y-0">
		for i := 0; i < 5; i++ {
			<div class="flex gap-4 py-2 border-b border-cool-grey-100 dark:border-dark-grey-700">
				@components.ShimmerBar("h-4", "w-1/4")
				@components.ShimmerBar("h-4", "w-16")
				@components.ShimmerBar("h-4", "w-24")
				@components.ShimmerBar("h-4", "w-20")
			</div>
		}
	</div>
}

templ workflowPanelShimmer() {
	<div class="@container space-y-4">
		// Step group list shimmer
		<div class="flex flex-col @4xl:flex-row gap-4">
			<div class="@4xl:w-3/5 @4xl:order-last">
				<div class="card-base !p-0" style="border-top: 2px solid var(--theme-primary)">
					<div class="px-4 py-3 space-y-3">
						@components.ShimmerBar("h-5", "w-1/3")
						@components.ShimmerLines(4)
					</div>
				</div>
			</div>
			<div class="@4xl:w-2/5">
				<div class="card-base !p-0">
					for i := 0; i < 4; i++ {
						<div class="flex items-center gap-3 px-4 py-3"
							if i > 0 {
								style="border-top: 1px solid var(--theme-border-subtle)"
							}
						>
							@components.ShimmerBar("h-4", "w-4")
							@components.ShimmerBar("h-4", "w-2/3")
						</div>
					}
				</div>
			</div>
		</div>
	</div>
}

templ shimmerCardHeader(icon, title string) {
	<div class="flex items-center gap-2">
		<i class={ "ph-bold text-lg text-cool-grey-500 dark:text-cool-grey-400", icon }></i>
		<h4 class="text-base text-cool-grey-900 dark:text-white">{ title }</h4>
	</div>
}
