package pages

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/components"
)

templ InstallOverviewPage(props InstallPageProps) {
	@customerui.Layout(props.LayoutProps) {
		@installPageShell(props) {
			<div
				id="panel-content-overview"
				class="panel-body"
				hx-get={ props.BasePath + "/installs/" + props.Install.ID + "/panel" }
				hx-trigger="load"
				hx-swap="morph:innerHTML"
			>
				@overviewShimmer()
			</div>
		}
	}
}

templ overviewShimmer() {
	<div class="space-y-4">
		<div class="grid grid-cols-2 gap-4">
			@components.Card(components.CardProps{Header: overviewShimmerCardHeader("ph-stack", "Stack")}) {
				<div class="space-y-3 text-sm">
					@components.ShimmerLines(2)
				</div>
			}
			@components.Card(components.CardProps{Header: overviewShimmerCardHeader("ph-shipping-container", "Sandbox")}) {
				<div class="space-y-3 text-sm">
					@components.ShimmerLines(2)
				</div>
			}
		</div>
		@components.Card(components.CardProps{Header: overviewShimmerCardHeader("ph-cards", "Components")}) {
			<div class="flex flex-wrap gap-2">
				@components.ShimmerBar("h-7", "w-24")
				@components.ShimmerBar("h-7", "w-20")
				@components.ShimmerBar("h-7", "w-28")
			</div>
		}
		<!-- Tab bar shimmer -->
		<div class="flex gap-4 border-b border-cool-grey-200 dark:border-dark-grey-600 pb-2">
			@components.ShimmerBar("h-5", "w-20")
			@components.ShimmerBar("h-5", "w-28")
		</div>
		<!-- Tab content shimmer -->
		@components.ShimmerLines(4)
	</div>
}

templ overviewShimmerCardHeader(icon, title string) {
	<div class="flex items-center gap-2">
		<i class={ "ph-bold text-lg text-cool-grey-500 dark:text-cool-grey-400", icon }></i>
		<h4 class="text-base text-cool-grey-900 dark:text-white">{ title }</h4>
	</div>
}
