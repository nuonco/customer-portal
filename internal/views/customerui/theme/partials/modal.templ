package partials

import "github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/components"

// ConfirmModal renders a confirmation dialog modal.
// Usage from JavaScript:
//   showConfirmModal({
//     title: 'Delete Item',
//     message: 'Are you sure you want to delete this item?',
//     confirmText: 'Delete',
//     cancelText: 'Cancel'
//   }).then(function(confirmed) {
//     if (confirmed) {
//       // User clicked confirm
//     }
//   });
templ confirmModalHeader() {
	<div class="flex items-center justify-between">
		<h3 id="confirm-title" class="text-base font-semibold text-cool-grey-900 dark:text-white"></h3>
		<button type="button" class="text-cool-grey-400 hover:text-cool-grey-600 dark:hover:text-cool-grey-200" onclick="closeModal('confirm-modal')">
			<i class="ph-bold ph-x text-lg"></i>
		</button>
	</div>
}

templ confirmModalFooter() {
	<div class="flex justify-end space-x-3">
		<button id="confirm-cancel" class={ components.ButtonClasses(components.ButtonProps{Size: components.ButtonSizeSm, Variant: components.ButtonOutline}) }>
			Cancel
		</button>
		<button id="confirm-ok" class={ components.ButtonClasses(components.ButtonProps{Size: components.ButtonSizeSm}) }>
			Confirm
		</button>
	</div>
}

templ ConfirmModal() {
	<div
		id="confirm-modal"
		class="fixed inset-0 backdrop-blur-xs bg-black/2 dark:bg-black/10 hidden overflow-y-auto"
		style="z-index: 100"
		{ modalWrapperCloseAttr("confirm-modal")... }
	>
		<div
			class="flex items-center justify-center min-h-full p-4"
			{ modalWrapperCloseAttr("confirm-modal")... }
		>
			<div id="confirm-modal-dialog" class="w-full my-8 max-w-md">
				@components.Card(components.CardProps{
					Size:   components.CardLarge,
					Header: confirmModalHeader(),
					Footer: confirmModalFooter(),
				}) {
					<p id="confirm-message" class="text-sm text-cool-grey-600 dark:text-cool-grey-400"></p>
				}
			</div>
		</div>
	</div>
	<script>
		window.showConfirmModal = function(options) {
			return new Promise(function(resolve) {
				document.getElementById('confirm-title').textContent = options.title || 'Confirm';
				document.getElementById('confirm-message').textContent = options.message || 'Are you sure?';
				document.getElementById('confirm-ok').textContent = options.confirmText || 'Confirm';
				document.getElementById('confirm-cancel').textContent = options.cancelText || 'Cancel';
				openModal('confirm-modal');

				document.getElementById('confirm-ok').onclick = function() {
					closeModal('confirm-modal');
					resolve(true);
				};

				document.getElementById('confirm-cancel').onclick = function() {
					closeModal('confirm-modal');
					resolve(false);
				};
			});
		};
	</script>
}

// PromptModal renders a text input prompt modal.
// Usage from JavaScript:
//   showPromptModal({
//     title: 'Enter Name',
//     message: 'Please enter a name for this item',
//     placeholder: 'Item name',
//     expectedValue: 'DELETE',  // Optional: require exact match
//     validationMessage: 'Please type DELETE to confirm'
//   }).then(function(value) {
//     if (value !== null) {
//       // User entered a value (or null if cancelled)
//     }
//   });
templ PromptModal() {
	@ModalWrapper("prompt-modal", "max-w-md") {
		<h3 id="prompt-title" class="text-lg font-semibold text-cool-grey-900 dark:text-white mb-2"></h3>
		<p id="prompt-message" class="text-cool-grey-600 dark:text-cool-grey-400 mb-4"></p>
		<input
			type="text"
			id="prompt-input"
			class="field-input mb-2"
			placeholder=""
		/>
		<p id="prompt-error" class="text-red-600 dark:text-red-400 text-sm mb-4 hidden"></p>
		<div class="flex justify-end space-x-3">
			<button id="prompt-cancel" class="button button-outline btn-theme-outline">
				Cancel
			</button>
			<button id="prompt-ok" class="button button-primary btn-theme-primary">
				Confirm
			</button>
		</div>
	}
	<script>
		window.showPromptModal = function(options) {
			return new Promise(function(resolve) {
				var modal = document.getElementById('prompt-modal');
				var input = document.getElementById('prompt-input');
				var errorEl = document.getElementById('prompt-error');

				document.getElementById('prompt-title').textContent = options.title || 'Enter Value';
				document.getElementById('prompt-message').textContent = options.message || '';
				input.placeholder = options.placeholder || '';
				input.value = '';
				errorEl.classList.add('hidden');
				document.getElementById('prompt-ok').textContent = options.confirmText || 'Confirm';
				document.getElementById('prompt-cancel').textContent = options.cancelText || 'Cancel';

				openModal('prompt-modal');
				input.focus();

				document.getElementById('prompt-ok').onclick = function() {
					var value = input.value.trim();
					if (options.expectedValue && value !== options.expectedValue) {
						errorEl.textContent = options.validationMessage || 'Value does not match';
						errorEl.classList.remove('hidden');
						return;
					}
					closeModal('prompt-modal');
					resolve(value);
				};

				document.getElementById('prompt-cancel').onclick = function() {
					closeModal('prompt-modal');
					resolve(null);
				};

				// Allow Enter key to submit
				input.onkeydown = function(e) {
					if (e.key === 'Enter') {
						document.getElementById('prompt-ok').click();
					}
				};
			});
		};
	</script>
}
