	default:
		<i class="ph-bold ph-question text-base shrink-0 text-cool-grey-400"></i>
	}
}

templ appInfoInputDetail(input InputDisplay) {
	<div class="px-4 pb-4 grid grid-cols-1 sm:grid-cols-2 gap-8 text-sm">
		<div>
			<dt class="font-medium text-cool-grey-500 dark:text-cool-grey-400 mb-1">Description</dt>
			<dd class="text-cool-grey-600 dark:text-cool-grey-300">
				if input.Description != "" {
					{ input.Description }
				} else {
					<span class="text-cool-grey-400 dark:text-cool-grey-500">—</span>
				}
			</dd>
		</div>
		<dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2">
			<dt class="font-medium text-cool-grey-500 dark:text-cool-grey-400">Required</dt>
			<dd class="text-cool-grey-600 dark:text-cool-grey-300">
				if input.Required {
					Yes
				} else {
					No
				}
			</dd>
			<dt class="font-medium text-cool-grey-500 dark:text-cool-grey-400">Sensitive</dt>
			<dd class="text-cool-grey-600 dark:text-cool-grey-300">
				if input.Sensitive {
					Yes
				} else {
					No
				}
			</dd>
		</dl>
	</div>
}

templ appInfoRoleDetail(role IAMRoleDisplay) {
	<div class="px-4 pb-4">
		if len(role.Policies) > 0 {
			<h5 class="text-xs font-semibold text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wide mb-2">Policies</h5>
			<div class="mb-3">
				<div class="flex w-full text-sm text-left border-b border-cool-grey-200 dark:border-dark-grey-600">
					<span class="w-1/2 py-2 pr-4 font-medium text-cool-grey-500 dark:text-cool-grey-400">Name</span>
					<span class="flex-1 py-2 pr-4 font-medium text-cool-grey-500 dark:text-cool-grey-400">Type</span>
				</div>
				for _, pol := range role.Policies {
					<div class="flex items-center w-full text-sm border-b border-cool-grey-100 dark:border-dark-grey-700">
						<span class="w-1/2 py-2 pr-4 text-cool-grey-900 dark:text-white">{ pol.Name }</span>
						<span class="flex-1 py-2 pr-4 text-cool-grey-600 dark:text-cool-grey-300">
							<span class="chip-sm-neutral">{ pol.Type }</span>
						</span>
					</div>
				}
			</div>
		}
		<h5 class="text-xs font-semibold text-cool-grey-500 dark:text-cool-grey-400 uppercase tracking-wide mb-1">Permission Boundary</h5>
		if role.PermissionsBoundary != "" {
			@components.CodeBlock(role.PermissionsBoundary, "json")
		} else {
			@components.CodeBlock("No permissions boundary defined", "")
		}
	</div>
}

templ appInfoPolicyDetailContent(pol PolicyDisplay) {
	<div class="px-4 pb-4">
		@components.CodeBlock(pol.Contents, policyLang(pol.Engine))
	</div>
}

templ appInfoIAMPolicyDetailContent(pol IAMPolicyDisplay) {
	<div class="px-4 pb-4">
		@components.CodeBlock(pol.Contents, "json")
	</div>
}
