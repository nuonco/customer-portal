package partials

import (
	"strings"

	"github.com/nuonco/customer-portal/internal/views/customerui/theme/components"
)

// ComponentDisplay holds display info for a single app component
type ComponentDisplay struct {
	Name string
	Type string
}

// IAMPolicyDisplay holds display info for a single IAM policy within a role.
type IAMPolicyDisplay struct {
	Name             string
	Type             string
	ManagedPolicyARN string
	Contents         string
}

// IAMRoleDisplay holds display info for a single IAM role.
type IAMRoleDisplay struct {
	Label               string
	Name                string
	Description         string
	Type                string
	Policies            []IAMPolicyDisplay
	PermissionsBoundary string
}

// PolicyDisplay holds display info for a single deployment policy.
type PolicyDisplay struct {
	Name        string
	Type        string
	Engine      string
	Contents    string
	Description string
}

// InputGroupDisplay holds display info for an input group
type InputGroupDisplay struct {
	Name        string
	DisplayName string
	Inputs      []InputDisplay
}

// InputDisplay holds display info for a single input field
type InputDisplay struct {
	Name         string
	DisplayName  string
	Description  string
	Type         string
	Required     bool
	Sensitive    bool
	Default      string
	ConfiguredBy string
}

// SecretDisplay holds display info for a single secret field
type SecretDisplay struct {
	Name         string
	DisplayName  string
	Description  string
	AutoGenerate bool
}

// PublishedAppDisplay holds display info for a published app
type PublishedAppDisplay struct {
	AppID            string
	AppName          string
	Platform         string
	Description      string
	Status           string
	LogoLightBase64  string
	LogoDarkBase64   string
	Components       []ComponentDisplay
	Permissions      []IAMRoleDisplay
	Policies         []PolicyDisplay
	InputGroups      []InputGroupDisplay
	Secrets          []SecretDisplay
	SandboxPlatform     string
	SandboxTFVersion    string
	SandboxDrift        string
	SandboxRepoURL      string
	SandboxRepoBranch   string
	SandboxRepoDir      string
	SandboxRepoIsPublic bool
	ReadmeHTML          string
	APIError            bool // true when app data could not be fetched
}

func FormatPolicyType(t string) string {
	switch t {
	case "kubernetes_cluster":
		return "Kubernetes Cluster"
	case "terraform_module":
		return "Terraform Module"
	case "helm_chart":
		return "Helm Chart"
	case "kubernetes_manifest":
		return "Kubernetes Manifest"
	case "docker_build":
		return "Docker Build"
	case "container_image":
		return "Container Image"
	case "sandbox":
		return "Sandbox"
	default:
		return t
	}
}

func AppInfoHumanize(s string) string {
	s = strings.ReplaceAll(s, "_", " ")
	if len(s) > 0 {
		s = strings.ToUpper(s[:1]) + s[1:]
	}
	return s
}

func appInfoPolicyDetail(pol PolicyDisplay) templ.Component {
	if pol.Contents == "" {
		return nil
	}
	return appInfoPolicyDetailContent(pol)
}

func appInfoIAMPolicyDetail(pol IAMPolicyDisplay) templ.Component {
	if pol.Contents == "" {
		return nil
	}
	return appInfoIAMPolicyDetailContent(pol)
}

templ AppInfoCard(app PublishedAppDisplay, basePath string) {
	if app.APIError {
		@components.EmptyState(components.EmptyStateProps{Title: "No app data", Icon: "ph-app-window"})
	} else {
	@components.Card(components.CardProps{Size: components.CardLarge}) {
		// ── Header ──────────────────────────────────────────────────────────
		<div class="mb-8">
			<div class="flex items-start justify-between">
				<div class="flex items-center gap-3 min-w-0">
					if app.LogoLightBase64 != "" || app.LogoDarkBase64 != "" {
						if app.LogoDarkBase64 != "" {
							<img src={ app.LogoLightBase64 } class="w-10 h-10 rounded object-contain flex-shrink-0 dark:hidden" alt=""/>
							<img src={ app.LogoDarkBase64 } class="w-10 h-10 rounded object-contain flex-shrink-0 hidden dark:block" alt=""/>
						} else {
							<img src={ app.LogoLightBase64 } class="w-10 h-10 rounded object-contain flex-shrink-0" alt=""/>
						}
					}
				</div>
				@components.PlatformChip(app.Platform)
			</div>
			<h2 class="text-2xl font-bold text-cool-grey-900 dark:text-white mt-3">{ app.AppName }</h2>
		</div>
		// ── Tabbed body ─────────────────────────────────────────────────────
		<div class="app-catalog-tabs">
			<div class="tabs-divider flex mb-4">
				<button class="button button-nav nav-item active" onclick={ templ.ComponentScript{Call: "switchAppCatalogTab(this, 'act-" + app.AppID + "-overview')"} }>Overview</button>
				<button class="button button-nav nav-item" onclick={ templ.ComponentScript{Call: "switchAppCatalogTab(this, 'act-" + app.AppID + "-config')"} }>Inputs</button>
				<button class="button button-nav nav-item" onclick={ templ.ComponentScript{Call: "switchAppCatalogTab(this, 'act-" + app.AppID + "-secrets')"} }>Secrets</button>
				<button class="button button-nav nav-item" onclick={ templ.ComponentScript{Call: "switchAppCatalogTab(this, 'act-" + app.AppID + "-sandbox')"} }>Sandbox</button>
				<button class="button button-nav nav-item" onclick={ templ.ComponentScript{Call: "switchAppCatalogTab(this, 'act-" + app.AppID + "-comp')"} }>Components</button>
				<button class="button button-nav nav-item" onclick={ templ.ComponentScript{Call: "switchAppCatalogTab(this, 'act-" + app.AppID + "-perms')"} }>Roles</button>
				<button class="button button-nav nav-item" onclick={ templ.ComponentScript{Call: "switchAppCatalogTab(this, 'act-" + app.AppID + "-pols')"} }>Policies</button>
			</div>
			// Overview pane
			<div id={ "act-" + app.AppID + "-overview" } class="panel-tab-pane active">
				if app.ReadmeHTML != "" {
					<div class="prose">
						@templ.Raw(app.ReadmeHTML)
					</div>
				} else {
					<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400">No description available.</p>
				}
			</div>
			// Configuration pane
			<div id={ "act-" + app.AppID + "-config" } class="panel-tab-pane">
				if len(app.InputGroups) == 0 {
					<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400">No inputs configured.</p>
				} else {
					<div class="divide-y divide-cool-grey-200 dark:divide-dark-grey-600 space-y-6">
						for _, group := range app.InputGroups {
							<div class="pt-6 first:pt-0">
								<h4 class="text-sm font-semibold text-cool-grey-900 dark:text-white mb-2">
									if group.DisplayName != "" {
										{ group.DisplayName }
									} else {
										{ group.Name }
									}
								</h4>
								<div class="flex w-full text-sm text-left border-b border-cool-grey-200 dark:border-dark-grey-600">
									<span class="w-1/3 py-2 pr-4 font-medium text-cool-grey-500 dark:text-cool-grey-400">Name</span>
									<span class="flex-1 py-2 pr-4 font-medium text-cool-grey-500 dark:text-cool-grey-400">Default value</span>
									<span class="w-8 shrink-0"></span>
								</div>
								for _, input := range group.Inputs {
									@components.ExpandableRow(appInfoInputDetail(input)) {
										<span class="w-1/3 py-2 pr-4 text-cool-grey-900 dark:text-white">
											if input.DisplayName != "" {
												{ input.DisplayName }
											} else {
												{ input.Name }
											}
										</span>
										<span class="flex-1 py-2 pr-4 text-cool-grey-600 dark:text-cool-grey-300 truncate">
											if input.Default != "" {
												<code class="text-xs bg-cool-grey-100 dark:bg-dark-grey-700 px-1.5 py-0.5 rounded">{ input.Default }</code>
											} else {
												<span class="text-cool-grey-400 dark:text-cool-grey-500">—</span>
											}
										</span>
									}
								}
							</div>
						}
					</div>
				}
			</div>
			// Secrets pane
			<div id={ "act-" + app.AppID + "-secrets" } class="panel-tab-pane">
				if len(app.Secrets) == 0 {
					<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400">No secrets configured.</p>
				} else {
					<table class="w-full table-fixed text-sm text-left">
						<thead>
							<tr class="border-b border-cool-grey-200 dark:border-dark-grey-600">
								<th class="w-1/4 py-2 pr-4 font-medium text-cool-grey-500 dark:text-cool-grey-400">Name</th>
								<th class="w-1/6 py-2 pr-4 font-medium text-cool-grey-500 dark:text-cool-grey-400">Auto-generate</th>
								<th class="py-2 font-medium text-cool-grey-500 dark:text-cool-grey-400">Description</th>
							</tr>
						</thead>
						<tbody>
							for _, secret := range app.Secrets {
								<tr class="border-b border-cool-grey-100 dark:border-dark-grey-700">
									<td class="py-2 pr-4 text-cool-grey-900 dark:text-white">
										if secret.DisplayName != "" {
											{ secret.DisplayName }
										} else {
											{ secret.Name }
										}
									</td>
									<td class="py-2 pr-4 text-cool-grey-600 dark:text-cool-grey-300">
										if secret.AutoGenerate {
											Yes
										} else {
											No
										}
									</td>
									<td class="py-2 text-cool-grey-600 dark:text-cool-grey-300">{ secret.Description }</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
			// Sandbox pane
			<div id={ "act-" + app.AppID + "-sandbox" } class="panel-tab-pane">
				if app.SandboxPlatform != "" || app.SandboxTFVersion != "" || app.SandboxDrift != "" || app.SandboxRepoIsPublic {
					<dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm max-w-md">
						if app.SandboxPlatform != "" {
							<dt class="text-cool-grey-500 dark:text-cool-grey-400">Cloud</dt>
							<dd class="text-cool-grey-900 dark:text-white font-medium">{ app.SandboxPlatform }</dd>
						}
						if app.SandboxTFVersion != "" {
							<dt class="text-cool-grey-500 dark:text-cool-grey-400">Terraform</dt>
							<dd class="text-cool-grey-900 dark:text-white font-medium">{ app.SandboxTFVersion }</dd>
						}
						if app.SandboxDrift != "" {
							<dt class="text-cool-grey-500 dark:text-cool-grey-400">Drift check</dt>
							<dd class="text-cool-grey-900 dark:text-white font-medium">{ app.SandboxDrift }</dd>
						}
						if app.SandboxRepoIsPublic && app.SandboxRepoURL != "" {
							<dt class="text-cool-grey-500 dark:text-cool-grey-400">Repository</dt>
							<dd class="font-medium break-all">
								<a href={ templ.URL(app.SandboxRepoURL) } target="_blank" rel="noopener noreferrer" class="text-theme-primary hover:underline">{ app.SandboxRepoURL }</a>
							</dd>
						}
						if app.SandboxRepoIsPublic && app.SandboxRepoBranch != "" {
							<dt class="text-cool-grey-500 dark:text-cool-grey-400">Branch</dt>
							<dd class="text-cool-grey-900 dark:text-white font-medium">{ app.SandboxRepoBranch }</dd>
						}
						if app.SandboxRepoIsPublic && app.SandboxRepoDir != "" {
							<dt class="text-cool-grey-500 dark:text-cool-grey-400">Directory</dt>
							<dd class="text-cool-grey-900 dark:text-white font-medium">{ app.SandboxRepoDir }</dd>
						}
					</dl>
				} else {
					<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400">No sandbox information available.</p>
				}
			</div>
			// Components pane
			<div id={ "act-" + app.AppID + "-comp" } class="panel-tab-pane">
				if len(app.Components) == 0 {
					@components.EmptyState(components.EmptyStateProps{Title: "No components", Icon: "ph-cards"})
				} else {
					<table class="w-full table-fixed text-sm text-left">
						<thead>
							<tr class="border-b border-cool-grey-200 dark:border-dark-grey-600">
								<th class="w-1/3 py-2 pr-4 font-medium text-cool-grey-500 dark:text-cool-grey-400">Name</th>
								<th class="w-1/4 py-2 pr-4 font-medium text-cool-grey-500 dark:text-cool-grey-400">Type</th>
							</tr>
						</thead>
						<tbody>
							for _, comp := range app.Components {
								<tr class="border-b border-cool-grey-100 dark:border-dark-grey-700">
									<td class="py-2 pr-4 text-cool-grey-900 dark:text-white">{ comp.Name }</td>
									<td class="py-2 pr-4 text-cool-grey-600 dark:text-cool-grey-300">
									<span class="flex items-center gap-1.5">
										@AppInfoComponentTypeIcon(comp.Type)
										{ AppInfoHumanize(comp.Type) }
									</span>
								</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
			// Roles pane
			<div id={ "act-" + app.AppID + "-perms" } class="panel-tab-pane">
				if len(app.Permissions) == 0 {
					@components.EmptyState(components.EmptyStateProps{Title: "No roles", Icon: "ph-file-lock"})
				} else {
					<div>
						<div class="flex w-full text-sm text-left border-b border-cool-grey-200 dark:border-dark-grey-600">
							<span class="w-1/3 py-2 pr-4 font-medium text-cool-grey-500 dark:text-cool-grey-400">Name</span>
							<span class="flex-1 py-2 pr-4 font-medium text-cool-grey-500 dark:text-cool-grey-400">Description</span>
							<span class="w-8 shrink-0"></span>
						</div>
						for _, role := range app.Permissions {
							@components.ExpandableRow(appInfoRoleDetail(role)) {
								<span class="w-1/3 py-2 pr-4 text-cool-grey-900 dark:text-white">{ role.Name }</span>
								<span class="flex-1 py-2 pr-4 text-cool-grey-600 dark:text-cool-grey-300 truncate">{ role.Description }</span>
							}
						}
					</div>
				}
			</div>
			// Policies pane
			<div id={ "act-" + app.AppID + "-pols" } class="panel-tab-pane">
				if len(app.Policies) == 0 {
					@components.EmptyState(components.EmptyStateProps{Title: "No policies", Icon: "ph-shield-check"})
				} else {
					<div>
						<div class="flex w-full text-sm text-left border-b border-cool-grey-200 dark:border-dark-grey-600">
							<span class="w-1/2 py-2 pr-4 font-medium text-cool-grey-500 dark:text-cool-grey-400">Name</span>
							<span class="w-1/4 py-2 pr-4 font-medium text-cool-grey-500 dark:text-cool-grey-400">Type</span>
							<span class="flex-1 py-2 pr-4 font-medium text-cool-grey-500 dark:text-cool-grey-400">Engine</span>
							<span class="w-8 shrink-0"></span>
						</div>
						for _, pol := range app.Policies {
							@components.ExpandableRow(appInfoPolicyDetail(pol)) {
								<span class="w-1/2 py-2 pr-4 text-cool-grey-900 dark:text-white">{ pol.Name }</span>
								<span class="w-1/4 py-2 pr-4 text-cool-grey-600 dark:text-cool-grey-300">{ FormatPolicyType(pol.Type) }</span>
								<span class="flex-1 py-2 pr-4">
									if pol.Engine != "" {
										<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-cool-grey-100 dark:bg-dark-grey-600 text-cool-grey-700 dark:text-cool-grey-300">{ pol.Engine }</span>
									}
								</span>
							}
						}
					</div>
				}
			</div>
		</div>
		<script>
			if (!window.switchAppCatalogTab) {
				window.switchAppCatalogTab = function(btn, tabId) {
					var container = btn.closest('.app-catalog-tabs');
					container.querySelectorAll('.nav-item').forEach(function(b) { b.classList.remove('active'); });
					container.querySelectorAll('.panel-tab-pane').forEach(function(p) { p.classList.remove('active'); });
					btn.classList.add('active');
					container.querySelector('#' + tabId).classList.add('active');
				};
			}
		</script>
	}
	}
}

templ AppInfoComponentTypeIcon(componentType string) {
	switch componentType {
	case "helm_chart":
		<svg class="w-4 h-4 shrink-0 text-cool-grey-500" viewBox="0 0 24 24" fill="currentColor">
			<path d="M12.337 0c-.475 0-.861 1.016-.861 2.269 0 .527.069 1.011.183 1.396a8.514 8.514 0 0 0-3.961 1.22 5.229 5.229 0 0 0-.595-1.093c-.606-.866-1.34-1.436-1.79-1.43a.381.381 0 0 0-.217.066c-.39.273-.123 1.326.596 2.353.267.381.559.705.84.948a8.683 8.683 0 0 0-1.528 1.716h1.734a7.179 7.179 0 0 1 5.381-2.421 7.18 7.18 0 0 1 5.382 2.42h1.733a8.687 8.687 0 0 0-1.32-1.53c.35-.249.735-.643 1.078-1.133.719-1.027.986-2.08.596-2.353a.382.382 0 0 0-.217-.065c-.45-.007-1.184.563-1.79 1.43a4.897 4.897 0 0 0-.676 1.325 8.52 8.52 0 0 0-3.899-1.42c.12-.39.193-.887.193-1.429 0-1.253-.386-2.269-.862-2.269zM1.624 9.443v5.162h1.358v-1.968h1.64v1.968h1.357V9.443H4.62v1.838H2.98V9.443zm5.912 0v5.162h3.21v-1.108H8.893v-.95h1.64v-1.142h-1.64v-.84h1.853V9.443zm4.698 0v5.162h3.218v-1.362h-1.86v-3.8zm4.706 0v5.162h1.364v-2.643l1.357 1.225 1.35-1.232v2.65h1.365V9.443h-.614l-2.1 1.914-2.109-1.914zm-11.82 7.28a8.688 8.688 0 0 0 1.412 1.548 5.206 5.206 0 0 0-.841.948c-.719 1.027-.985 2.08-.596 2.353.39.273 1.289-.338 2.007-1.364a5.23 5.23 0 0 0 .595-1.092 8.514 8.514 0 0 0 3.961 1.219 5.01 5.01 0 0 0-.183 1.396c0 1.253.386 2.269.861 2.269.476 0 .862-1.016.862-2.269 0-.542-.072-1.04-.193-1.43a8.52 8.52 0 0 0 3.9-1.42c.121.4.352.865.675 1.327.719 1.026 1.617 1.637 2.007 1.364.39-.273.123-1.326-.596-2.353-.343-.49-.727-.885-1.077-1.135a8.69 8.69 0 0 0 1.202-1.36h-1.771a7.174 7.174 0 0 1-5.227 2.252 7.174 7.174 0 0 1-5.226-2.252z"></path>
		</svg>
	case "terraform_module":
		<svg class="w-4 h-4 shrink-0 text-cool-grey-500" viewBox="0 0 24 24" fill="currentColor">
			<path d="M1.44 0v7.575l6.561 3.79V3.787zm21.12 4.227l-6.561 3.791v7.574l6.56-3.787zM8.72 4.23v7.575l6.561 3.787V8.018zm0 8.405v7.575L15.28 24v-7.578z"></path>
		</svg>
	case "docker_build":
		<svg class="w-4 h-4 shrink-0 text-cool-grey-500" viewBox="0 0 24 24" fill="currentColor">
			<path d="M13.983 11.078h2.119a.186.186 0 00.186-.185V9.006a.186.186 0 00-.186-.186h-2.119a.185.185 0 00-.185.185v1.888c0 .102.083.185.185.185m-2.954-5.43h2.118a.186.186 0 00.186-.186V3.574a.186.186 0 00-.186-.185h-2.118a.185.185 0 00-.185.185v1.888c0 .102.082.185.185.185m0 2.716h2.118a.187.187 0 00.186-.186V6.29a.186.186 0 00-.186-.185h-2.118a.185.185 0 00-.185.185v1.887c0 .102.082.185.185.186m-2.93 0h2.12a.186.186 0 00.184-.186V6.29a.185.185 0 00-.185-.185H8.1a.185.185 0 00-.185.185v1.887c0 .102.083.185.185.186m-2.964 0h2.119a.186.186 0 00.185-.186V6.29a.185.185 0 00-.185-.185H5.136a.186.186 0 00-.186.185v1.887c0 .102.084.185.186.186m5.893 2.715h2.118a.186.186 0 00.186-.185V9.006a.186.186 0 00-.186-.186h-2.118a.185.185 0 00-.185.185v1.888c0 .102.082.185.185.185m-2.93 0h2.12a.185.185 0 00.184-.185V9.006a.185.185 0 00-.184-.186h-2.12a.185.185 0 00-.184.185v1.888c0 .102.083.185.185.185m-2.964 0h2.119a.185.185 0 00.185-.185V9.006a.185.185 0 00-.184-.186h-2.12a.186.186 0 00-.186.186v1.887c0 .102.084.185.186.185m-2.92 0h2.12a.185.185 0 00.184-.185V9.006a.185.185 0 00-.184-.186h-2.12a.185.185 0 00-.184.185v1.888c0 .102.082.185.185.185M23.763 9.89c-.065-.051-.672-.51-1.954-.51-.338.001-.676.03-1.01.087-.248-1.7-1.653-2.53-1.716-2.566l-.344-.199-.226.327c-.284.438-.49.922-.612 1.43-.23.97-.09 1.882.403 2.661-.595.332-1.55.413-1.744.42H.751a.751.751 0 00-.75.748 11.376 11.376 0 00.692 4.062c.545 1.428 1.355 2.48 2.41 3.124 1.18.723 3.1 1.137 5.275 1.137.983.003 1.963-.086 2.93-.266a12.248 12.248 0 003.823-1.389c.98-.567 1.86-1.288 2.61-2.136 1.252-1.418 1.998-2.997 2.553-4.4h.221c1.372 0 2.215-.549 2.68-1.009.309-.293.55-.65.707-1.046l.098-.288Z"></path>
		</svg>
	case "external_image":
		<svg class="w-4 h-4 shrink-0 text-cool-grey-500" viewBox="0 0 24 24" fill="currentColor">
			<path d="M3.629 0v24H20.37V0zM17.59 21.208H6.421V10.604h7.812V6.692h3.346v14.516zm-7.823-7.812h4.466v5.02H9.767z"></path>
		</svg>
	case "kubernetes_manifest":
		<svg class="w-4 h-4 shrink-0 text-cool-grey-500" viewBox="0 0 24 24" fill="currentColor">
