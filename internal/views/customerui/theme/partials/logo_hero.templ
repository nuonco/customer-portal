package partials

// LogoHeroProps contains props for the logo hero component
type LogoHeroProps struct {
	LogoLightBase64 string
	LogoDarkBase64  string
}

// LogoHero renders a centered logo hero block. Renders nothing when no logo is set.
templ LogoHero(props LogoHeroProps) {
	if props.LogoLightBase64 != "" || props.LogoDarkBase64 != "" {
		<div class="mx-auto px-6 lg:px-8 py-6 w-full max-w-5xl">
			if props.LogoDarkBase64 != "" {
				<img src={ props.LogoLightBase64 } alt="Logo" class="h-16 w-auto max-w-xs object-contain dark:hidden"/>
				<img src={ props.LogoDarkBase64 } alt="Logo" class="h-16 w-auto max-w-xs object-contain hidden dark:block"/>
			} else {
				<img src={ props.LogoLightBase64 } alt="Logo" class="h-16 w-auto max-w-xs object-contain"/>
			}
		</div>
	}
}
