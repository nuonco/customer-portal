package partials

import (
	"fmt"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
)

// WorkflowGroupPanel represents a group of workflows for a specific date (panel version)
type WorkflowGroupPanel struct {
	Date        string
	DisplayDate string
	Workflows   []WorkflowDataPanel
}

// WorkflowsPanelProps contains data needed for the workflows panel content
type WorkflowsPanelProps struct {
	Install        *models.Install
	WorkflowGroups []WorkflowGroupPanel
	CurrentOffset  int
	Limit          int
	HasNext        bool
	HasPrev        bool
	NextOffset     int
	PrevOffset     int
	BasePath       string
	PrimaryColor   string
}

// WorkflowsPanel renders the workflow history content for the sliding panel
templ WorkflowsPanel(props WorkflowsPanelProps) {
	<div class="w-full">
		<!-- Workflow Groups -->
		if len(props.WorkflowGroups) == 0 {
			<div class="text-center py-12">
				<i class="ph-bold ph-clipboard-text text-[48px] text-cool-grey-400 dark:text-cool-grey-600 mx-auto block"></i>
				<h3 class="mt-4 text-lg font-medium text-cool-grey-900 dark:text-white">No workflows yet</h3>
				<p class="mt-2 text-sm text-cool-grey-600 dark:text-cool-grey-400">Workflow history will appear here once updates are triggered.</p>
			</div>
		} else {
			<div class="space-y-8">
				for _, group := range props.WorkflowGroups {
					<div>
						<h2 class="text-lg font-semibold text-cool-grey-700 dark:text-cool-grey-300 mb-4">{ group.DisplayDate }</h2>
						<div class="space-y-4">
							for _, workflow := range group.Workflows {
								@workflowCardPanel(workflow, props.Install.ID, props.BasePath, props.PrimaryColor)
							}
						</div>
					</div>
				}
			</div>
			<!-- Pagination -->
			if props.HasPrev || props.HasNext {
				<div class="mt-8 flex items-center justify-between">
					<div>
						if props.HasPrev {
							<button
								type="button"
								onclick={ templ.ComponentScript{Call: fmt.Sprintf("loadWorkflowsPage(%d)", props.PrevOffset)} }
								class="pagination-nav-btn"
							>
								<i class="ph-bold ph-caret-left text-base mr-2"></i>
								Previous
							</button>
						}
					</div>
					<div>
						if props.HasNext {
							<button
								type="button"
								onclick={ templ.ComponentScript{Call: fmt.Sprintf("loadWorkflowsPage(%d)", props.NextOffset)} }
								class="pagination-nav-btn"
							>
								Next
								<i class="ph-bold ph-caret-right text-base ml-2"></i>
							</button>
						}
					</div>
				</div>
			}
		}
	</div>
	<!-- Config for JavaScript -->
	<div
		id="workflows-panel-config"
		class="hidden"
		data-base-path={ props.BasePath }
		data-install-id={ props.Install.ID }
	></div>
	@workflowsPanelScripts()
}

templ workflowsPanelScripts() {
	<script>
		(function() {
			var configEl = document.getElementById('workflows-panel-config');
			var basePath = configEl ? configEl.dataset.basePath : '';
			var installId = configEl ? configEl.dataset.installId : '';

			window.loadWorkflowsPage = function(offset) {
				var container = document.getElementById('panel-content-history');
				if (!container) return;

				container.innerHTML = '<div class="panel-loading"><div class="panel-loading-spinner"><\/div><\/div>';

				fetch(basePath + '/installs/' + installId + '/panel/history?offset=' + offset)
					.then(function(response) {
						if (!response.ok) throw new Error('Failed to load');
						return response.text();
					})
					.then(function(html) {
						container.innerHTML = html;
						// Re-run scripts
						var scripts = container.querySelectorAll('script');
						scripts.forEach(function(script) {
							var newScript = document.createElement('script');
							newScript.textContent = script.textContent;
							script.parentNode.replaceChild(newScript, script);
						});
					})
					.catch(function(error) {
						container.innerHTML = '<div class="text-center py-8 text-red-500">Failed to load content.<\/div>';
					});
			};

			window.confirmApproveAll = window.confirmApproveAll || function(btn) {
				showConfirmModal({
					title: 'Approve Installation',
					message: 'This will automatically approve all future approval steps in this workflow. Are you sure?',
					confirmText: 'Approve Installation',
					cancelText: 'Cancel'
				}).then(function(confirmed) {
					if (confirmed) {
						htmx.trigger(btn, 'confirmed');
					}
				});
			};

			window.confirmCancelWorkflow = window.confirmCancelWorkflow || function(btn) {
				var wfName = btn.getAttribute('data-workflow-name') || 'Workflow';
				showConfirmModal({
					title: 'Cancel ' + wfName + '?',
					message: 'Are you sure you want to cancel this ' + wfName.toLowerCase() + '? This action cannot be undone.',
					confirmText: 'Cancel ' + wfName,
					cancelText: 'Keep Running'
				}).then(function(confirmed) {
					if (confirmed) {
						htmx.trigger(btn, 'confirmed');
					}
				});
			};
		})();
	</script>
}
