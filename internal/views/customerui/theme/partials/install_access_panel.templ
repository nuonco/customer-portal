package partials

import (
	"fmt"

	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/components"
)

// AccessRolePolicy holds display info for a single IAM policy within a role.
type AccessRolePolicy struct {
	Name     string
	Type     string // "AWS managed" or "Vendor defined"
	Contents string // Policy body (JSON)
}

type AccessRole struct {
	Name                string
	Description         string
	Active              bool   // Whether the role is provisioned
	Policies            []AccessRolePolicy
	PermissionsBoundary string // Pretty-printed JSON
}

type AccessPanelProps struct {
	Roles     []AccessRole
	BasePath  string
	InstallID string
}

templ AccessPanel(props AccessPanelProps) {
	if len(props.Roles) == 0 {
			<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400">No roles configured for this app.</p>
		} else {
			<table class="w-full text-sm table-fixed">
				<colgroup>
					<col class="w-[25%]"/>
					<col class="w-[50%]"/>
					<col class="w-[25%]"/>
				</colgroup>
				<thead>
					<tr class="border-b border-cool-grey-200 dark:border-dark-grey-600">
						<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">Name</th>
						<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">Description</th>
						<th class="text-left py-2 font-medium text-cool-grey-500 dark:text-cool-grey-400">Status</th>
					</tr>
				</thead>
				<tbody>
					for i, role := range props.Roles {
						<tr
							class="border-b border-cool-grey-100 dark:border-dark-grey-700 last:border-b-0 cursor-pointer hover:bg-cool-grey-50 dark:hover:bg-dark-grey-800 transition-colors"
							data-role-name={ role.Name }
							onclick={ templ.ComponentScript{Call: fmt.Sprintf("openRolePanel(%d)", i)} }
						>
							<td class="py-2 pr-3 font-medium text-cool-grey-900 dark:text-white truncate" title={ role.Name }>{ role.Name }</td>
							<td class="py-2 pr-3 text-cool-grey-600 dark:text-cool-grey-300 truncate" title={ role.Description }>{ role.Description }</td>
							<td class="py-2">
								if role.Active {
									<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400">
										<i class="ph-bold ph-shield-check text-xs"></i>
										Provisioned
									</span>
								} else {
									<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-cool-grey-100 text-cool-grey-500 dark:bg-dark-grey-700 dark:text-cool-grey-400 whitespace-nowrap">
										<i class="ph-bold ph-shield-slash text-xs"></i>
										Not provisioned
									</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	<div id="access-panel-config" class="hidden" data-base-path={ props.BasePath } data-install-id={ props.InstallID }></div>
	@accessPanelScripts()
}

templ accessPanelScripts() {
	<script>
		(function() {
			window.openRolePanel = function(index) {
				var panel = document.getElementById('secondary-panel');
				var title = document.getElementById('secondary-panel-title');
				var content = document.getElementById('secondary-panel-content');
				if (!panel || !title || !content) return;

				var rows = document.querySelectorAll('[data-role-name]');
				var row = rows[index];
				var roleName = row ? row.getAttribute('data-role-name') : 'Role Details';

				title.textContent = roleName;
				content.innerHTML = '<div class="panel-loading"><div class="panel-loading-spinner"></div></div>';
				panel.classList.add('open');
				var overlay = document.getElementById('secondary-panel-overlay');
				if (overlay) overlay.classList.add('open');

				var config = document.getElementById('access-panel-config');
				var basePath = config ? config.getAttribute('data-base-path') : '';
				var installId = config ? config.getAttribute('data-install-id') : '';
				fetch(basePath + '/installs/' + installId + '/panel/role/' + index)
					.then(function(resp) { return resp.text(); })
					.then(function(html) { content.innerHTML = html; })
					.catch(function() {
						content.innerHTML = '<p class="text-sm text-red-500 p-4">Failed to load role details.</p>';
					});
			};
		})();
	</script>
}

templ RoleDetailPanel(role AccessRole) {
	<div class="p-4 space-y-4">
		@jobDetailSection("Details") {
			@jobDetailRow("Name", role.Name)
			@jobDetailRow("Description", role.Description)
			if role.Active {
				@jobDetailRow("Status", "Provisioned")
			} else {
				@jobDetailRow("Status", "Not provisioned")
			}
		}
		if len(role.Policies) > 0 {
			@jobDetailSection("Policies") {
				<div class="space-y-4">
					for _, pol := range role.Policies {
						<div class="space-y-1">
							<div class="flex items-center justify-between">
								<span class="text-sm font-medium text-cool-grey-900 dark:text-white">{ pol.Name }</span>
								<span class="text-xs text-cool-grey-500 dark:text-cool-grey-400">{ pol.Type }</span>
							</div>
							if pol.Contents != "" {
								@components.CodeBlock(pol.Contents, "json")
							} else {
								<p class="text-xs text-cool-grey-400 dark:text-cool-grey-500 italic">No policy document (AWS managed)</p>
							}
						</div>
					}
				</div>
			}
		}
		<div class="space-y-2">
			<h4 class="text-xs font-semibold uppercase tracking-wider text-cool-grey-500 dark:text-cool-grey-400">Permissions Boundary</h4>
			if role.PermissionsBoundary != "" {
				@components.CodeBlock(role.PermissionsBoundary, "json")
			} else {
				@components.CodeBlock("No permissions boundary defined", "")
			}
		</div>
	</div>
}


templ AccessEnableRoleModal() {
	@ModalWrapper("access-enable-role-modal", "max-w-lg") {
		<!-- Header -->
		<div class="flex items-center justify-between mb-5">
			<div class="flex items-center gap-2">
				<i class="ph-bold ph-shield-chevron text-lg text-cool-grey-600 dark:text-cool-grey-400"></i>
				<h3 class="text-lg font-semibold text-cool-grey-900 dark:text-white">How to provision a role</h3>
			</div>
			<button
				class="button button-icon text-cool-grey-400 hover:text-cool-grey-600 dark:hover:text-cool-grey-300"
				onclick="document.getElementById('access-enable-role-modal').classList.add('hidden')"
				aria-label="Close"
			>
				<i class="ph-bold ph-x text-lg"></i>
			</button>
		</div>
		<!-- Warning callout -->
		<div class="access-modal-callout access-modal-callout-warning mb-5">
			<i class="ph-bold ph-warning text-base"></i>
			<p><strong>Manual Action Required:</strong> This role was not created in your account. It must be created before you can use it.</p>
		</div>
		<!-- Instructions -->
		<p class="font-semibold text-sm text-cool-grey-900 dark:text-white mb-3">How to create this role using the Cloudformation stack:</p>
		<ul class="access-modal-list mb-5">
			<li>Navigate to the AWS CloudFormation console in your account.</li>
			<li>Find the stack associated with this install.</li>
			<li>Select the stack and click "Update stack". In the dropdown select "Create a change set".</li>
			<li>Follow the guided flow and execute the changeset.</li>
			<li>Once the change has been applied, this UI will update.</li>
		</ul>
		<!-- Actions -->
		<div class="flex justify-end border-t border-cool-grey-200 dark:border-cool-grey-700 pt-4">
			<button
				class="button button-primary btn-theme-primary"
				onclick="document.getElementById('access-enable-role-modal').classList.add('hidden')"
			>
				Got it
			</button>
		</div>
	}
}
