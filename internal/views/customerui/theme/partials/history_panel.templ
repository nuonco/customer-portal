package partials

import (
	"fmt"
	"strings"
	"time"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	nuonmodels "github.com/nuonco/nuon-go/models"
)

type HistoryPagination struct {
	HasNext    bool
	HasPrev    bool
	NextOffset int
	PrevOffset int
}

type HistoryPanelProps struct {
	Install    *models.Install
	BasePath   string
	Workflows  []*nuonmodels.AppWorkflow
	Pagination HistoryPagination
}

templ HistoryPanel(props HistoryPanelProps) {
	<div class="w-full" id="history-content">
		if len(props.Workflows) == 0 {
			@auditEmptyState("workflows", "ph-clock")
		} else {
			<table class="w-full text-sm table-fixed">
				<colgroup>
					<col class="w-[30%]"/>
					<col class="w-[20%]"/>
					<col class="w-[25%]"/>
					<col class="w-[25%]"/>
				</colgroup>
				<thead>
					<tr class="border-b border-cool-grey-200 dark:border-dark-grey-600">
						<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">Type</th>
						<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">Status</th>
						<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">Date</th>
						<th class="text-left py-2 font-medium text-cool-grey-500 dark:text-cool-grey-400">Duration</th>
					</tr>
				</thead>
				<tbody>
					for _, wf := range props.Workflows {
						<tr
							class="border-b border-cool-grey-100 dark:border-dark-grey-700 last:border-b-0 cursor-pointer hover:bg-cool-grey-50 dark:hover:bg-dark-grey-700"
							onclick={ templ.ComponentScript{Call: fmt.Sprintf("openWorkflowPanel('%s')", wf.ID)} }
						>
							<td class="py-2 pr-3 font-medium text-cool-grey-900 dark:text-white truncate" title={ workflowTypeLabel(wf.Type) }>
								{ workflowTypeLabel(wf.Type) }
							</td>
							<td class="py-2 pr-3">
								<span class={ "px-2 py-0.5 text-xs font-medium rounded-full", workflowStatusClass(wf) }>
									{ workflowStatusLabel(wf) }
								</span>
							</td>
							<td class="py-2 pr-3 text-cool-grey-600 dark:text-cool-grey-400 whitespace-nowrap">{ FormatAPITime(wf.CreatedAt) }</td>
							<td class="py-2 text-cool-grey-600 dark:text-cool-grey-400 whitespace-nowrap">{ formatDuration(wf) }</td>
						</tr>
					}
				</tbody>
			</table>
			@historyPagination(props)
		}
		<div
			id="history-panel-config"
			class="hidden"
			data-base-path={ props.BasePath }
			data-install-id={ props.Install.ID }
		></div>
		@historyPanelScripts()
	</div>
}

func workflowTypeLabel(t nuonmodels.AppWorkflowType) string {
	switch t {
	case "provision":
		return "Provision"
	case "deprovision":
		return "Deprovision"
	case "deprovision_sandbox":
		return "Deprovision Sandbox"
	case "manual_deploy":
		return "Manual Deploy"
	case "input_update":
		return "Input Update"
	case "deploy_components":
		return "Deploy Components"
	case "teardown_component":
		return "Teardown Component"
	default:
		return strings.ReplaceAll(string(t), "_", " ")
	}
}

func workflowStatusLabel(wf *nuonmodels.AppWorkflow) string {
	if wf.Status != nil {
		return string(wf.Status.Status)
	}
	if wf.Finished {
		return "completed"
	}
	return "unknown"
}

func workflowStatusClass(wf *nuonmodels.AppWorkflow) string {
	return auditStatusClass(workflowStatusLabel(wf))
}

func formatDuration(wf *nuonmodels.AppWorkflow) string {
	if wf.ExecutionTime > 0 {
		d := time.Duration(wf.ExecutionTime) * time.Millisecond
		if d < time.Minute {
			return fmt.Sprintf("%ds", int(d.Seconds()))
		}
		if d < time.Hour {
			return fmt.Sprintf("%dm %ds", int(d.Minutes()), int(d.Seconds())%60)
		}
		return fmt.Sprintf("%dh %dm", int(d.Hours()), int(d.Minutes())%60)
	}
	if wf.CreatedAt != "" && wf.FinishedAt != "" {
		start, err1 := time.Parse(time.RFC3339Nano, wf.CreatedAt)
		end, err2 := time.Parse(time.RFC3339Nano, wf.FinishedAt)
		if err1 == nil && err2 == nil {
			d := end.Sub(start)
			if d < time.Minute {
				return fmt.Sprintf("%ds", int(d.Seconds()))
			}
			if d < time.Hour {
				return fmt.Sprintf("%dm %ds", int(d.Minutes()), int(d.Seconds())%60)
			}
			return fmt.Sprintf("%dh %dm", int(d.Hours()), int(d.Minutes())%60)
		}
	}
	if !wf.Finished {
		return "running..."
	}
	return "—"
}

templ historyPagination(props HistoryPanelProps) {
	if props.Pagination.HasPrev || props.Pagination.HasNext {
		<div class="mt-6 flex items-center justify-between">
			<div>
				if props.Pagination.HasPrev {
					<button
						type="button"
						onclick={ templ.ComponentScript{Call: fmt.Sprintf("loadHistoryPage(%d)", props.Pagination.PrevOffset)} }
						class="button button-pagination pagination-nav-btn"
					>
						<i class="ph-bold ph-caret-left text-base mr-2"></i>
						Previous
					</button>
				}
			</div>
			<div>
				if props.Pagination.HasNext {
					<button
						type="button"
						onclick={ templ.ComponentScript{Call: fmt.Sprintf("loadHistoryPage(%d)", props.Pagination.NextOffset)} }
						class="button button-pagination pagination-nav-btn"
					>
						Next
						<i class="ph-bold ph-caret-right text-base ml-2"></i>
					</button>
				}
			</div>
		</div>
	}
}

templ historyPanelScripts() {
	<script>
		(function() {
			window.loadHistoryPage = function(offset) {
				var config = document.getElementById('history-panel-config');
				if (!config) return;
				var basePath = config.getAttribute('data-base-path');
				var installId = config.getAttribute('data-install-id');
				var url = basePath + '/installs/' + installId + '/panel/history?offset=' + offset;
				if (typeof htmx !== 'undefined') {
					htmx.ajax('GET', url, { target: '#panel-content-history', swap: 'innerHTML' });
				}
			};

			window.openWorkflowPanel = function(workflowID) {
				var panel = document.getElementById('secondary-panel');
				var title = document.getElementById('secondary-panel-title');
				var content = document.getElementById('secondary-panel-content');
				if (!panel || !title || !content) return;
				title.textContent = 'Workflow Details';
				content.innerHTML = '<div class="panel-loading"><div class="panel-loading-spinner"></div></div>';
				panel.classList.add('open');
				var overlay = document.getElementById('secondary-panel-overlay');
				if (overlay) overlay.classList.add('open');

				var config = document.getElementById('history-panel-config');
				if (!config) return;
				var basePath = config.getAttribute('data-base-path');
				var installId = config.getAttribute('data-install-id');
				var url = basePath + '/installs/' + installId + '/panel/workflow/' + workflowID;
				if (typeof htmx !== 'undefined') {
					htmx.ajax('GET', url, { target: '#secondary-panel-content', swap: 'innerHTML' });
				}
			};
		})();
	</script>
}
