package partials

import (
	"fmt"
	"strings"
	"time"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
)

// WorkflowDataPanel represents workflow data for the panel (avoids import cycle)
type WorkflowDataPanel struct {
	ID                       string
	Name                     string
	Status                   string
	StatusClass              string
	CreatedAt                time.Time
	FinishedAt               time.Time
	CanApprove               bool
	CanApproveAll            bool
	CanCancel                bool
	HasApprovalSteps         bool
	ApproveDisabledReason    string
	ApproveAllDisabledReason string
	CancelDisabledReason     string
	ApprovalStep             *ApprovalStepDataPanel
	CurrentStepName          string // Name of the currently executing step
	CurrentStepStatus        string // Status of the current step (in-progress, approval-awaiting)
	CurrentStepType          string // Type of current step: "pending", "in-progress", "approval-awaiting", or "initializing"
	CurrentStepNumber        int    // 1-indexed position of current step (1, 2, 3...)
	TotalSteps               int    // Total number of steps in workflow
}

// ApprovalStepDataPanel for workflow approval steps
type ApprovalStepDataPanel struct {
	StepID     string
	ApprovalID string
}

// HealthCheckStatusDataPanel for health check display
type HealthCheckStatusDataPanel struct {
	ActionID      string
	ActionName    string
	Status        string
	StatusClass   string
	StatusMessage string
	LastRunAt     time.Time
}

// platformFromRegion determines cloud platform from a region string
func platformFromRegion(region string) string {
	if strings.Contains(region, "us-") || strings.Contains(region, "eu-") || strings.Contains(region, "ap-") {
		return "aws"
	} else if strings.Contains(region, "eastus") || strings.Contains(region, "westus") || strings.Contains(region, "northeurope") {
		return "azure"
	} else if strings.Contains(region, "us-central") || strings.Contains(region, "us-east") || strings.Contains(region, "europe-") {
		return "gcp"
	}
	return "unknown"
}

// platformLabel returns a display label for a platform string
func platformLabel(platform string) string {
	switch platform {
	case "aws":
		return "AWS"
	case "azure":
		return "Azure"
	case "gcp":
		return "GCP"
	default:
		return "Cloud"
	}
}

// InstallDetailPanelProps for the panel content (no layout wrapper)
type InstallDetailPanelProps struct {
	Install                  *models.Install
	AppName                  string // Fetched from Nuon API at runtime
	APIDeletedError          bool
	HealthCheckStatuses      []HealthCheckStatusDataPanel
	OverallHealthStatus      string
	HasHealthChecks          bool
	HealthChecksPassed       int
	HealthChecksFailed       int
	HealthChecksPending      int
	BasePath                 string
	PrimaryColor             string
	SecondaryColor           string
	AppConfigVersion         int64
	AppConfigUpdatedAt       string
	InstallConfigVersion     int64
	InstallConfigUpdatedAt   string
	ActiveProvisionWorkflow  *WorkflowDataPanel
	InstallReadme            *ReadmeDataPanel
	CloudFormationLink       string
}

// ReadmeDataPanel represents install readme data for the panel
type ReadmeDataPanel struct {
	Readme   string
	Original string
	Warnings []string
}

// InstallDetailPanel renders just the install detail content for the sliding panel
templ InstallDetailPanel(props InstallDetailPanelProps) {
	{{
		platform := platformFromRegion(props.Install.Region)
	}}
	<!-- Hidden Actions Dropdown (will be moved to panel header by JS) -->
	if props.Install.Status != "deprovisioning" && !props.APIDeletedError {
		<div id="panel-actions-source" class="hidden">
			<div class="relative" id="actionsDropdown">
				<button
					type="button"
					onclick="toggleActionsDropdown()"
					class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 bg-white dark:bg-dark-grey-800 border border-cool-grey-300 dark:border-dark-grey-500 hover:bg-cool-grey-50 dark:hover:bg-dark-grey-700"
					style="border-radius: var(--theme-radius)"
				>
					Actions
					<svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
					</svg>
				</button>
				<div
					id="actionsDropdownMenu"
					class="hidden absolute right-0 mt-2 w-48 bg-white dark:bg-dark-grey-800 border border-cool-grey-300 dark:border-dark-grey-500 shadow-lg z-10"
					style="border-radius: var(--theme-radius)"
				>
					<button
						type="button"
						onclick="openEditInputsModal(); toggleActionsDropdown();"
						class="block w-full text-left px-4 py-2 text-sm text-cool-grey-700 dark:text-cool-grey-300 hover:bg-cool-grey-100 dark:hover:bg-dark-grey-700"
					>
						Edit Inputs
					</button>
					<button
						type="button"
						onclick="confirmDeprovision(); toggleActionsDropdown();"
						class="block w-full text-left px-4 py-2 text-sm text-cool-grey-700 dark:text-cool-grey-300 hover:bg-cool-grey-100 dark:hover:bg-dark-grey-700"
					>
						Deprovision
					</button>
					<button
						type="button"
						onclick="forgetInstall(); toggleActionsDropdown();"
						class="block w-full text-left px-4 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-cool-grey-100 dark:hover:bg-dark-grey-700"
					>
						Forget
					</button>
				</div>
			</div>
		</div>
	}
	<div class="space-y-4 mt-4">
		<!-- API Deletion Warning Banner -->
		if props.APIDeletedError {
			<div class="p-4 border bg-amber-50 dark:bg-amber-900/30 border-amber-200 dark:border-amber-800" style="border-radius: var(--theme-radius)">
				<div class="flex items-start">
					<div class="flex-shrink-0 mr-3 text-amber-500">
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
						</svg>
					</div>
					<div class="flex-1">
						<h3 class="text-sm font-medium text-amber-800 dark:text-amber-300 mb-1">Install Deleted from API</h3>
						<p class="text-sm text-amber-700 dark:text-amber-400 mb-3">
							This install was deleted from the Nuon control plane but still exists in your local portal.
							You are viewing cached data only. Live features (health checks, workflows, updates) are unavailable.
						</p>
						<p class="text-sm text-amber-700 dark:text-amber-400 mb-3">
							<strong>Action required:</strong> Use the "Forget" button to remove this install from your portal.
						</p>
						<button
							type="button"
							onclick="forgetInstall()"
							class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-amber-900 dark:text-amber-100 bg-amber-100 dark:bg-amber-800 hover:bg-amber-200 dark:hover:bg-amber-700 border border-amber-300 dark:border-amber-600"
							style="border-radius: var(--theme-radius)"
						>
							<svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
							</svg>
							Forget Install
						</button>
					</div>
				</div>
			</div>
		}
		<!-- Active Provision Banner (polls and shows when workflow is active) -->
		if !props.APIDeletedError {
			@ActiveProvisionBanner(props.ActiveProvisionWorkflow, props.CloudFormationLink, props.Install.ID, props.BasePath, props.PrimaryColor)
		}
		<!-- App Config + Platform (side by side) -->
		<div class="grid grid-cols-2 gap-4">
			@appConfigCard(props)
			@platformCard(platform, props.Install.Region)
		</div>
		<!-- Health Status (full width) -->
		if props.HasHealthChecks && !props.APIDeletedError {
			<div class="bg-white dark:bg-dark-grey-800 p-6 shadow-md border border-cool-grey-300 dark:border-dark-grey-500" style="border-radius: var(--theme-radius)">
				@healthStatusPanel(props)
			</div>
		}
		<!-- App Readme Card (polls and shows when NO active workflow) -->
		if !props.APIDeletedError {
			@AppReadmeCard(props.InstallReadme, props.Install.ID, props.BasePath)
		}
	</div>
	<!-- Edit Inputs Modal -->
	@editInputsModalPanel()
	<!-- Config data for JavaScript -->
	<div
		id="install-detail-config"
		class="hidden"
		data-base-path={ props.BasePath }
		data-install-id={ props.Install.ID }
		data-install-name={ props.Install.Name }
		data-nuon-install-id={ props.Install.NuonInstallID }
	></div>
	<!-- JavaScript for actions -->
	@installDetailPanelScripts()
}

// overviewPlatformChip renders a platform chip inline (avoids import cycle with components)
templ overviewPlatformChip(platform string) {
	switch platform {
	case "aws":
		<span class="platform-chip platform-chip-aws">AWS</span>
	case "azure":
		<span class="platform-chip platform-chip-azure">Azure</span>
	case "gcp":
		<span class="platform-chip platform-chip-gcp">GCP</span>
	default:
		<span class="platform-chip platform-chip-unknown">Cloud</span>
	}
}

// platformCard renders the platform information card
templ platformCard(platform string, region string) {
	<div class="bg-white dark:bg-dark-grey-800 p-6 shadow-md border border-cool-grey-300 dark:border-dark-grey-500" style="border-radius: var(--theme-radius)">
		<h3 class="text-lg font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-3">Platform</h3>
		<div class="space-y-3 text-sm">
			<div>
				<span class="text-cool-grey-500 dark:text-cool-grey-400">Name</span>
				<p class="font-medium text-cool-grey-800 dark:text-cool-grey-200">{ platformLabel(platform) }</p>
			</div>
			if region != "" {
				<div>
					<span class="text-cool-grey-500 dark:text-cool-grey-400">Region</span>
					<p class="font-medium text-cool-grey-800 dark:text-cool-grey-200">{ region }</p>
				</div>
			}
		</div>
	</div>
}

// ActiveProvisionBanner renders a banner for an active provision workflow at the top of the overview
templ ActiveProvisionBanner(workflow *WorkflowDataPanel, cloudFormationLink string, installID string, basePath string, primaryColor string) {
	<div
		id="active-provision-banner"
		hx-get={ basePath + "/installs/" + installID + "/workflow-status" }
		hx-trigger="every 5s"
		hx-swap="outerHTML"
		if workflow != nil {
			data-workflow-status={ workflow.Status }
		}
	>
		if workflow != nil && workflow.ID != "" {
			<div class="space-y-4">
				@workflowCardPanel(*workflow, installID, basePath, primaryColor)
				if cloudFormationLink != "" {
					<div class="p-4" style={ "border-radius: var(--theme-radius); background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border: 1px solid color-mix(in srgb, var(--theme-primary) 30%, transparent)" }>
						<div class="flex items-center justify-between">
							<div>
								<h3 class="text-sm font-medium" style="color: var(--theme-primary)">AWS CloudFormation</h3>
								<p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-primary) 80%, black)">Complete your infrastructure setup in AWS Console</p>
							</div>
							<a
								href={ templ.SafeURL(cloudFormationLink) }
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-theme-primary hover:bg-theme-primary-hover"
								style="border-radius: var(--theme-radius)"
							>
								Open in AWS
								<svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
								</svg>
							</a>
						</div>
					</div>
				}
			</div>
		}
	</div>
}

// AppReadmeCard renders the app readme when no active provision workflow
// Includes HTMX polling to automatically show/hide as workflows start/complete
templ AppReadmeCard(readme *ReadmeDataPanel, installID string, basePath string) {
	<div
		id="readme-card-container"
		hx-get={ basePath + "/installs/" + installID + "/readme-status" }
		hx-trigger="every 5s"
		hx-swap="outerHTML"
	>
		if readme != nil && readme.Readme != "" {
			<div class="bg-white dark:bg-dark-grey-800 p-6 shadow-md border border-cool-grey-300 dark:border-dark-grey-500" style="border-radius: var(--theme-radius)">
				<div class="flex items-center justify-between mb-4">
					<h3 class="text-lg font-medium text-cool-grey-700 dark:text-cool-grey-300">Getting Started</h3>
				</div>
				<div class="prose prose-sm dark:prose-invert max-w-none text-cool-grey-600 dark:text-cool-grey-400 overflow-x-auto">
					@templ.Raw(readme.Readme)
				</div>
				if len(readme.Warnings) > 0 {
					<div class="mt-4 space-y-2">
						for _, warning := range readme.Warnings {
							<div class="flex items-start gap-2 p-3 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800" style="border-radius: var(--theme-radius)">
								<svg class="w-5 h-5 text-amber-600 dark:text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
								</svg>
								<p class="text-sm text-amber-800 dark:text-amber-300">{ warning }</p>
							</div>
						}
					</div>
				}
			</div>
		}
	</div>
}

// appConfigCard renders the app configuration card
templ appConfigCard(props InstallDetailPanelProps) {
	<div class="bg-white dark:bg-dark-grey-800 p-6 shadow-md border border-cool-grey-300 dark:border-dark-grey-500" style="border-radius: var(--theme-radius)">
		<div class="flex items-center gap-2 mb-3">
			<h3 class="text-lg font-medium text-cool-grey-700 dark:text-cool-grey-300">{ props.AppName }</h3>
			if props.AppConfigVersion > 0 {
				if props.InstallConfigVersion < props.AppConfigVersion {
					<span class="inline-flex items-center rounded-full font-medium px-2 py-0.5 text-xs bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-300">update available</span>
				} else {
					<span class="inline-flex items-center rounded-full font-medium px-2 py-0.5 text-xs bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300">up to date</span>
				}
			}
		</div>
		<div class="grid grid-cols-2 gap-6 text-sm">
			<!-- First column: Installed Version -->
			<div class="space-y-2">
				if props.InstallConfigVersion > 0 {
					<div>
						<span class="text-cool-grey-500 dark:text-cool-grey-400">Installed Version</span>
						if props.AppConfigVersion > 0 && props.InstallConfigVersion < props.AppConfigVersion {
							<p class="font-medium text-amber-600 dark:text-amber-400">{ fmt.Sprintf("v%d", props.InstallConfigVersion) }</p>
						} else {
							<p class="font-medium text-cool-grey-800 dark:text-cool-grey-200">{ fmt.Sprintf("v%d", props.InstallConfigVersion) }</p>
						}
					</div>
					if props.InstallConfigUpdatedAt != "" {
						<div>
							<span class="text-cool-grey-500 dark:text-cool-grey-400">Last Updated</span>
							<p class="font-medium text-cool-grey-800 dark:text-cool-grey-200">{ formatConfigDate(props.InstallConfigUpdatedAt) }</p>
						</div>
					}
				} else {
					<div>
						<span class="text-cool-grey-500 dark:text-cool-grey-400">Installed Version</span>
						<p class="font-medium text-cool-grey-400 dark:text-cool-grey-500">—</p>
					</div>
				}
			</div>
			<!-- Second column: Latest Version + Published -->
			<div class="space-y-2">
				if props.AppConfigVersion > 0 {
					<div>
						<span class="text-cool-grey-500 dark:text-cool-grey-400">Latest Version</span>
						<p class="font-medium text-cool-grey-800 dark:text-cool-grey-200">{ fmt.Sprintf("v%d", props.AppConfigVersion) }</p>
					</div>
				}
				if props.AppConfigUpdatedAt != "" {
					<div>
						<span class="text-cool-grey-500 dark:text-cool-grey-400">Published</span>
						<p class="font-medium text-cool-grey-800 dark:text-cool-grey-200">{ formatConfigDate(props.AppConfigUpdatedAt) }</p>
					</div>
				}
			</div>
		</div>
	</div>
}

func formatConfigDate(dateStr string) string {
	for _, layout := range []string{time.RFC3339, time.RFC3339Nano, "2006-01-02T15:04:05Z", "2006-01-02T15:04:05"} {
		if t, err := time.Parse(layout, dateStr); err == nil {
			return t.Format("Jan 2, 2006")
		}
	}
	return dateStr
}

// healthStatusPanel renders health status for the panel
templ healthStatusPanel(props InstallDetailPanelProps) {
	<div id={ "health-status-" + props.Install.ID }>
		<div class="flex items-center justify-between mb-3">
			<h3 class="text-lg font-medium text-cool-grey-700 dark:text-cool-grey-300">Health Status</h3>
			if props.HasHealthChecks {
				<button
					type="button"
					hx-post={ props.BasePath + "/installs/" + props.Install.ID + "/health-checks/run" }
					hx-target={ "#health-status-" + props.Install.ID }
					hx-swap="innerHTML"
					class="text-sm text-theme-primary hover:text-theme-primary-hover"
				>
					Run Checks
				</button>
			}
		</div>
		if !props.HasHealthChecks {
			<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400">No health checks configured</p>
		} else if len(props.HealthCheckStatuses) == 0 {
			<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400">No health check results yet</p>
		} else {
			<div class="space-y-2">
				for _, status := range props.HealthCheckStatuses {
					<div class="flex items-center justify-between p-2 bg-cool-grey-50 dark:bg-dark-grey-700 rounded">
						<span class="text-sm text-cool-grey-700 dark:text-cool-grey-300">{ status.ActionName }</span>
						<span class={ "text-xs px-2 py-1 rounded", healthStatusClass(status.Status) }>
							{ status.Status }
						</span>
					</div>
				}
			</div>
		}
	</div>
}

func healthStatusClass(status string) string {
	switch status {
	case "Passing":
		return "bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300"
	case "Failing":
		return "bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300"
	default:
		return "bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-300"
	}
}

// workflowCardPanel renders a workflow card for the panel
templ workflowCardPanel(workflow WorkflowDataPanel, installID, basePath, primaryColor string) {
	<div
		id={ "workflow-" + workflow.ID }
		class="bg-white dark:bg-dark-grey-800 p-4 shadow-sm border border-cool-grey-200 dark:border-dark-grey-600 mb-4"
		style="border-radius: var(--theme-radius)"
	>
		<!-- Wrapper for status display - this is the HTMX target -->
		<div id="workflow-status-display">
			<div class="flex items-center justify-between mb-2">
				<div class="flex-1">
					<h4 class="font-medium text-cool-grey-900 dark:text-white">{ workflow.Name }</h4>
					<!-- Show spinner if workflow is active OR if step name exists -->
					if workflow.CurrentStepName != "" || workflow.Status == "in-progress" || workflow.Status == "pending" || workflow.Status == "approval-awaiting" {
						<div class="flex items-center gap-2 mt-1 text-sm text-cool-grey-600 dark:text-cool-grey-400">
							<!-- Animated loading spinner -->
							<svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
								<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
								<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
							</svg>
							<span>
								if workflow.TotalSteps > 0 {
									<span class="font-medium">Step { fmt.Sprintf("%d", workflow.CurrentStepNumber) } of { fmt.Sprintf("%d", workflow.TotalSteps) }:</span>
									{ " " }
								}
								if workflow.CurrentStepName != "" {
									if workflow.CurrentStepType == "pending" {
										Waiting to start: { workflow.CurrentStepName }
									} else if workflow.CurrentStepType == "approval-awaiting" {
										Awaiting approval: { workflow.CurrentStepName }
									} else if workflow.CurrentStepType == "initializing" {
										{ workflow.CurrentStepName }
									} else {
										{ workflow.CurrentStepName }
									}
								} else {
									<!-- Fallback message if no step data available -->
									Workflow starting...
								}
							</span>
						</div>
					}
				</div>
				<span class={ "text-xs px-2 py-1 rounded", workflow.StatusClass }>
					{ workflow.Status }
				</span>
			</div>
			<!-- Progress bar (only show when we have step data) -->
			if workflow.TotalSteps > 0 && workflow.CurrentStepNumber > 0 {
				@templ.Raw(fmt.Sprintf(`<div class="mb-2">
					<div class="w-full h-1 bg-cool-grey-300 dark:bg-cool-grey-700 rounded-sm overflow-hidden border border-cool-grey-400 dark:border-cool-grey-600">
						<div class="h-full bg-blue-600 dark:bg-blue-500 rounded-sm transition-all duration-300 ease-in-out" style="width: %d%%;"></div>
					</div>
				</div>`, (workflow.CurrentStepNumber * 100) / workflow.TotalSteps))
			}
			<div class="text-sm text-cool-grey-500 dark:text-cool-grey-400 mb-3">
				{ workflow.CreatedAt.Format("Jan 2, 2006 3:04 PM") }
			</div>
		</div>
		<!-- Action buttons -->
		if workflow.HasApprovalSteps || workflow.CanCancel {
			<div class="flex gap-2">
				if workflow.HasApprovalSteps {
					if workflow.CanApproveAll {
						<button
							type="button"
							class="workflow-approve-all-btn px-3 py-1 text-sm font-medium text-white bg-theme-primary hover:bg-theme-primary-hover rounded"
							data-endpoint={ basePath + "/installs/" + installID + "/workflows/" + workflow.ID + "/approve-all" }
						>
							Approve Installation
						</button>
					} else {
						<button
							type="button"
							disabled
							class="px-3 py-1 text-sm font-medium text-cool-grey-400 dark:text-cool-grey-500 bg-cool-grey-200 dark:bg-dark-grey-700 rounded cursor-not-allowed"
							title={ workflow.ApproveAllDisabledReason }
						>
							Approve Installation
						</button>
					}
				}
				if workflow.CanCancel {
					<button
						type="button"
						class="workflow-cancel-btn px-3 py-1 text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 bg-cool-grey-100 dark:bg-dark-grey-700 hover:bg-cool-grey-200 dark:hover:bg-dark-grey-600 rounded"
						data-endpoint={ basePath + "/installs/" + installID + "/workflows/" + workflow.ID + "/cancel" }
					>
						Cancel
					</button>
				}
			</div>
		}
	</div>
}

templ installDetailPanelScripts() {
	<script>
		(function() {
			// Get config from data attributes
			var configEl = document.getElementById('install-detail-config');
			var basePath = configEl.dataset.basePath;
			var installID = configEl.dataset.installId;
			var installName = configEl.dataset.installName;
			var nuonInstallID = configEl.dataset.nuonInstallId;

			// Set the install ID in the panel header
			var installIdEl = document.getElementById('panel-install-id');
			if (installIdEl && nuonInstallID) {
				installIdEl.textContent = nuonInstallID;
			}

			// Move actions dropdown into panel header
			var actionsSource = document.getElementById('panel-actions-source');
			var actionsContainer = document.getElementById('panel-actions-container');
			if (actionsSource && actionsContainer) {
				actionsContainer.innerHTML = actionsSource.innerHTML;
			}

			// Actions dropdown toggle
			window.toggleActionsDropdown = function() {
				var menu = document.getElementById('actionsDropdownMenu');
				if (menu) {
					menu.classList.toggle('hidden');
				}
			};

			// Close dropdown when clicking outside
			document.addEventListener('click', function(event) {
				var dropdown = document.getElementById('actionsDropdown');
				var menu = document.getElementById('actionsDropdownMenu');
				if (dropdown && menu && !dropdown.contains(event.target)) {
					menu.classList.add('hidden');
				}
			});

			// Deprovision install with custom modal confirmation
			window.confirmDeprovision = async function() {
				var confirmed = await showConfirmModal({
					title: 'Deprovision Installation?',
					message: 'Are you sure you want to deprovision this installation? This action cannot be undone and will destroy all data associated with this installation.',
					variant: 'danger',
					confirmText: 'Deprovision',
					cancelText: 'Cancel'
				});

				if (!confirmed) {
					return;
				}

				try {
					var response = await fetch(basePath + '/installs/' + installID + '/', {
						method: 'DELETE'
					});

					if (response.ok) {
						showToast('Deprovision initiated. Refreshing...', 'success');
						setTimeout(function() { window.location.reload(); }, 1500);
					} else {
						showToast('Failed to deprovision installation', 'error');
					}
				} catch (error) {
					showToast('Network error. Please try again.', 'error');
				}
			};

			// Forget install uses custom modals for better UX
			window.forgetInstall = async function() {
				var confirmed = await showConfirmModal({
					title: 'Important Warning',
					message: 'Only use "Forget" after you have successfully deprovisioned the install and removed the CloudFormation stack.\n\n"Forget" only removes this install from your list - it does NOT deprovision any infrastructure.\n\nAre you sure you want to forget this installation?',
					variant: 'warning',
					confirmText: 'Continue',
					cancelText: 'Cancel'
				});

				if (!confirmed) {
					return;
				}

				var confirmName = await showPromptModal({
					title: 'Confirm Action',
					message: 'To confirm, please type the install name: ' + installName,
					placeholder: 'Enter install name',
					expectedValue: installName,
					validationMessage: 'Install name does not match. Please try again.',
					confirmText: 'Forget Install',
					variant: 'danger'
				});

				if (confirmName === null) {
					return;
				}

				try {
					var response = await fetch(basePath + '/installs/' + installID + '/forget', {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
						}
					});

					if (response.ok) {
						showToast('Install forgotten successfully. Redirecting...', 'success');
						setTimeout(function() {
							window.location.href = basePath + '/installs';
						}, 1500);
					} else {
						var data = await response.json();
						showToast(data.error || 'Failed to forget installation', 'error');
					}
				} catch (error) {
					showToast('Network error. Please try again.', 'error');
				}
			};

			// Workflow action modal - dynamically sets HTMX attributes on modal's Confirm button
			window.showWorkflowActionModal = function(options) {
				var confirmBtn = document.getElementById('confirm-ok');
				var cancelBtn = document.getElementById('confirm-cancel');
				var modal = document.getElementById('confirm-modal');

				// Set modal content
				document.getElementById('confirm-title').textContent = options.title || 'Confirm Action';
				document.getElementById('confirm-message').textContent = options.message || 'Are you sure?';
				confirmBtn.textContent = options.confirmText || 'Confirm';
				cancelBtn.textContent = options.cancelText || 'Cancel';

				// Set HTMX attributes on the Confirm button
				confirmBtn.setAttribute('hx-post', options.endpoint);
				confirmBtn.setAttribute('hx-target', options.target || '#workflow-status-display');
				confirmBtn.setAttribute('hx-swap', options.swap || 'innerHTML');

				// Initialize HTMX on the button (processes the new attributes)
				htmx.process(confirmBtn);

				// Show modal
				modal.classList.remove('hidden');

				// Cancel button just closes modal
				cancelBtn.onclick = function() {
					modal.classList.add('hidden');
					// Clean up HTMX attributes to prevent accidental reuse
					confirmBtn.removeAttribute('hx-post');
					confirmBtn.removeAttribute('hx-target');
					confirmBtn.removeAttribute('hx-swap');
				};

				// Also handle modal close via backdrop or ESC key
				modal.onclick = function(e) {
					if (e.target === modal) {
						cancelBtn.click();
					}
				};
			};

			// Handle HTMX response - close modal after successful request
			document.body.addEventListener('htmx:afterRequest', function(evt) {
				// Close modal if the request came from the confirm button
				if (evt.detail.elt.id === 'confirm-ok') {
					var modal = document.getElementById('confirm-modal');
					modal.classList.add('hidden');

					// Clean up HTMX attributes
					evt.detail.elt.removeAttribute('hx-post');
					evt.detail.elt.removeAttribute('hx-target');
					evt.detail.elt.removeAttribute('hx-swap');
				}
			});

			// Attach event listeners to workflow action buttons using event delegation
			document.body.addEventListener('click', function(e) {
				// Handle Approve Installation button
				if (e.target.classList.contains('workflow-approve-all-btn')) {
					var endpoint = e.target.getAttribute('data-endpoint');
					showWorkflowActionModal({
						endpoint: endpoint,
						target: '#workflow-status-display',
						swap: 'innerHTML',
						title: 'Approve Update?',
						message: 'Are you sure you want to approve this update? This will automatically approve all steps.',
						confirmText: 'Approve',
						cancelText: 'Cancel'
					});
				}
				// Handle Cancel button
				else if (e.target.classList.contains('workflow-cancel-btn')) {
					var endpoint = e.target.getAttribute('data-endpoint');
					showWorkflowActionModal({
						endpoint: endpoint,
						target: '#workflow-status-display',
						swap: 'innerHTML',
						title: 'Cancel Update?',
						message: 'Are you sure you want to cancel this update? This may leave your application in an incomplete state.',
						confirmText: 'Cancel Update',
						cancelText: 'Keep Running'
					});
				}
			});

			// Handle HTMX response errors
			document.body.addEventListener('htmx:responseError', function(evt) {
				showToast('An error occurred. Please try again.', 'error');
			});

			// Edit Inputs Modal functionality
			window.openEditInputsModal = async function() {
				var modal = document.getElementById('editInputsModal');
				var loading = document.getElementById('editInputsLoading');
				var form = document.getElementById('editInputsForm');
				var fieldsContainer = document.getElementById('editInputsFields');
				var errorDiv = document.getElementById('editInputsError');

				modal.classList.remove('hidden');
				loading.classList.remove('hidden');
				form.classList.add('hidden');
				errorDiv.classList.add('hidden');
				document.getElementById('editInputsErrorActions').classList.add('hidden');

				try {
					var response = await fetch(basePath + '/installs/' + installID + '/inputs');
					if (!response.ok) {
						var data = await response.json();
						throw new Error(data.error || 'Failed to fetch inputs');
					}

					var data = await response.json();
					renderEditInputFields(data.input_config, data.inputs);

					loading.classList.add('hidden');
					form.classList.remove('hidden');
				} catch (error) {
					loading.classList.add('hidden');
					// Check if it's a 404 - likely means no inputs configured
					if (error.message && error.message.includes('404')) {
						errorDiv.textContent = 'No inputs are configured for this install.';
					} else {
						errorDiv.textContent = error.message || 'Failed to load inputs';
					}
					errorDiv.classList.remove('hidden');
					document.getElementById('editInputsErrorActions').classList.remove('hidden');
				}
			};

			window.closeEditInputsModal = function() {
				document.getElementById('editInputsModal').classList.add('hidden');
				document.getElementById('editInputsForm').reset();
				document.getElementById('editInputsError').classList.add('hidden');
				document.getElementById('editInputsErrorActions').classList.add('hidden');
			};

			function renderEditInputFields(inputConfig, currentInputs) {
				var container = document.getElementById('editInputsFields');
				currentInputs = currentInputs || {};

				if (!inputConfig || !inputConfig.input_groups) {
					container.innerHTML = '<p class="text-green-600 dark:text-green-400 text-sm">No additional configuration required<\/p>';
					return;
				}

				var html = '';
				var hasInputs = false;

				inputConfig.input_groups.forEach(function(group) {
					var groupInputs = group.app_inputs || group.inputs || [];
					if (groupInputs && groupInputs.length > 0) {
						hasInputs = true;
						html += renderEditInputGroup(group, groupInputs, currentInputs);
					}
				});

				if (!hasInputs) {
					container.innerHTML = '<p class="text-green-600 dark:text-green-400 text-sm">No additional configuration required<\/p>';
				} else {
					container.innerHTML = html;
				}
			}

			function renderEditInputGroup(group, inputs, currentInputs) {
				var html = '<div class="mb-6">';
				html += '<h5 class="text-md font-semibold text-cool-grey-800 dark:text-cool-grey-200 mb-2">' + (group.display_name || group.name || 'Configuration') + '<\/h5>';
				if (group.description) {
					html += '<p class="text-sm text-cool-grey-600 dark:text-cool-grey-400 mb-4">' + group.description + '<\/p>';
				}
				html += '<div class="space-y-4">';

				inputs.sort(function(a, b) { return (a.index || 0) - (b.index || 0); });
				inputs.forEach(function(input) {
					var currentValue = currentInputs[input.name];
					html += renderEditSingleInput(input, currentValue);
				});

				html += '<\/div><\/div>';
				return html;
			}

			function renderEditSingleInput(input, currentValue) {
				var inputName = input.name;
				var isRequired = input.required ? ' *' : '';
				var requiredAttr = input.required ? ' required' : '';
				var value = (currentValue !== undefined && currentValue !== null && currentValue !== '') ? currentValue : (input.default || '');

				if (input.type === 'bool' || input.default === 'true' || input.default === 'false') {
					var isChecked = value === 'true';
					var html = '<div class="flex items-start space-x-3">';
					html += '<input type="hidden" name="' + inputName + '" value="false" \/>';
					html += '<input type="checkbox" id="' + input.name + '" name="' + inputName + '" value="true"';
					if (isChecked) html += ' checked';
					html += ' class="mt-1 h-4 w-4 text-primary-600 border-cool-grey-300 dark:border-dark-grey-500 rounded focus:ring-primary-400" \/>';
					html += '<div class="flex-1">';
					html += '<label for="' + input.name + '" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300">' + (input.display_name || input.name) + isRequired + '<\/label>';
					if (input.description) {
						html += '<p class="text-xs text-cool-grey-500 dark:text-cool-grey-400 mt-1">' + input.description + '<\/p>';
					}
					html += '<\/div><\/div>';
					return html;
				}

				if (input.type === 'json') {
					var html = '<div>';
					html += '<label for="' + input.name + '" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">' + (input.display_name || input.name) + isRequired + '<\/label>';
					html += '<textarea id="' + input.name + '" name="' + inputName + '" rows="4" placeholder="' + (input.default || '') + '"' + requiredAttr;
					html += ' class="block w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-800 dark:text-white rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600">';
					html += value + '<\/textarea>';
					if (input.description) {
						html += '<p class="text-xs text-cool-grey-500 dark:text-cool-grey-400 mt-1">' + input.description + '<\/p>';
					}
					html += '<\/div>';
					return html;
				}

				var inputType = 'text';
				if (input.type === 'number') {
					inputType = 'number';
				} else if (input.sensitive) {
					inputType = 'password';
				}

				var html = '<div>';
				html += '<label for="' + input.name + '" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">' + (input.display_name || input.name) + isRequired + '<\/label>';
				html += '<input type="' + inputType + '" id="' + input.name + '" name="' + inputName + '" placeholder="' + (input.default || '') + '" value="' + value + '"' + requiredAttr;
				if (inputType === 'password') html += ' autocomplete="off"';
				html += ' class="block w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-800 dark:text-white rounded-md focus:ring-2 focus:ring-primary-400 focus:border-primary-600" \/>';
				if (input.description) {
					html += '<p class="text-xs text-cool-grey-500 dark:text-cool-grey-400 mt-1">' + input.description + '<\/p>';
				}
				html += '<\/div>';
				return html;
			}

			document.getElementById('editInputsForm').addEventListener('submit', async function(e) {
				e.preventDefault();

				var errorDiv = document.getElementById('editInputsError');
				errorDiv.classList.add('hidden');

				var inputs = {};
				var formInputs = document.querySelectorAll('#editInputsFields input');
				formInputs.forEach(function(input) {
					if (!input.name) return;
					if (input.type === 'checkbox') {
						if (input.checked) {
							inputs[input.name] = 'true';
						}
					} else if (input.type === 'hidden') {
						if (inputs[input.name] === undefined) {
							inputs[input.name] = input.value;
						}
					} else {
						if (input.value) {
							inputs[input.name] = input.value;
						}
					}
				});

				var textareas = document.querySelectorAll('#editInputsFields textarea');
				textareas.forEach(function(textarea) {
					if (textarea.name && textarea.value) {
						inputs[textarea.name] = textarea.value;
					}
				});

				try {
					var response = await fetch(basePath + '/installs/' + installID + '/inputs', {
						method: 'PUT',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ inputs: inputs })
					});

					var data = await response.json();

					if (response.ok) {
						showToast('Inputs updated. A workflow has been triggered to apply changes.', 'success');
						closeEditInputsModal();
						setTimeout(function() { window.location.reload(); }, 1500);
					} else {
						errorDiv.textContent = data.error || 'Failed to update inputs';
						errorDiv.classList.remove('hidden');
					}
				} catch (error) {
					errorDiv.textContent = error.message || 'Network error. Please try again.';
					errorDiv.classList.remove('hidden');
				}
			});
		})();

		// Handle HTMX authentication errors
		document.body.addEventListener('auth-error', function(event) {
			console.warn('Authentication expired during HTMX polling, redirecting to login...');

			// Show a toast notification (if toast functionality exists)
			if (typeof showToast === 'function') {
				showToast('Your session has expired. Redirecting to login...', 'warning');
			}

			// Redirect to login after a short delay
			setTimeout(function() {
				const currentPath = window.location.pathname;
				window.location.href = '/login?redirect=' + encodeURIComponent(currentPath);
			}, 2000);
		});

		// Optional: Log HTMX errors for debugging
		document.body.addEventListener('htmx:responseError', function(event) {
			console.error('HTMX request failed:', {
				url: event.detail.pathInfo.requestPath,
				status: event.detail.xhr.status,
				statusText: event.detail.xhr.statusText
			});
		});

		// Optional: Log successful HTMX swaps for debugging
		document.body.addEventListener('htmx:afterSwap', function(event) {
			if (event.detail.target.id === 'active-provision-banner') {
				console.log('Workflow status banner updated via HTMX');
			}
		});
	</script>
}

templ editInputsModalPanel() {
	<div
		id="editInputsModal"
		class="fixed inset-0 bg-dark-grey-900/50 hidden overflow-y-auto"
		style="z-index: 100"
		onclick="if (event.target === this) closeEditInputsModal();"
	>
		<div class="flex items-center justify-center min-h-full p-4">
			<div class="bg-white dark:bg-dark-grey-800 p-6 rounded-lg shadow-lg border border-cool-grey-300 dark:border-dark-grey-500 w-full max-w-2xl my-8">
				<div class="mb-4">
					<h3 class="text-lg font-semibold text-cool-grey-900 dark:text-white">Edit Inputs</h3>
				</div>
				<div id="editInputsLoading" class="py-8 text-center">
					<div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-primary-600"></div>
					<p class="mt-2 text-cool-grey-500 dark:text-cool-grey-400">Loading inputs...</p>
				</div>
				<form id="editInputsForm" class="hidden space-y-4">
					<div id="editInputsFields" class="space-y-4"></div>
					<div class="flex space-x-3 pt-4 border-t border-cool-grey-200 dark:border-dark-grey-600">
						<button
							type="submit"
							class="flex-1 bg-theme-primary text-white py-2 px-4 rounded-md hover:bg-theme-primary-hover focus:ring-2 focus:ring-primary-400 font-medium"
						>
							Update Inputs
						</button>
						<button
							type="button"
							onclick="closeEditInputsModal()"
							class="flex-1 bg-cool-grey-300 text-cool-grey-700 dark:bg-dark-grey-600 dark:text-cool-grey-300 py-2 px-4 rounded-md hover:bg-cool-grey-400 dark:hover:bg-dark-grey-500 focus:ring-2 focus:ring-cool-grey-400 font-medium"
						>
							Cancel
						</button>
					</div>
				</form>
				<div
					id="editInputsError"
					class="mt-4 p-3 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-400 rounded hidden"
				></div>
				<div id="editInputsErrorActions" class="hidden mt-4 flex justify-end">
					<button
						type="button"
						onclick="closeEditInputsModal()"
						class="bg-cool-grey-300 text-cool-grey-700 dark:bg-dark-grey-600 dark:text-cool-grey-300 py-2 px-4 rounded-md hover:bg-cool-grey-400 dark:hover:bg-dark-grey-500 font-medium"
					>
						Cancel
					</button>
				</div>
			</div>
		</div>
	</div>
}
