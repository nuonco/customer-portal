package partials

import (
	"encoding/json"
	"fmt"
	"strings"
	"time"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/components"
	nuonmodels "github.com/nuonco/nuon/sdks/nuon-go/models"
	"github.com/nuonco/mono/services/customer-dashboard/pkg/nuon"
)

// AuditTabPagination holds pagination state for one audit sub-tab.
type AuditTabPagination struct {
	Total      int
	HasNext    bool
	HasPrev    bool
	NextOffset int
	PrevOffset int
}

// RolePolicy holds display info for one IAM policy within a role.
type RolePolicy struct {
	Name              string
	ManagedPolicyName string
	Contents          string
}

// StackInfoRole holds display info for one IAM role shown in the stack info view.
type StackInfoRole struct {
	Name                string // e.g. "Default Provision"
	Type                string // e.g. "Runner Provision", "Breakglass", "Custom"
	Arn                 string // The provisioned ARN from stack outputs
	Active              bool   // true = active, false = pending
	PermissionsBoundary string
	Policies            []RolePolicy
}

// StackInfo holds the stack detail fields for the Info sub-tab.
type StackInfo struct {
	ID        string
	Status    string
	Region    string
	AccountID string
	VPC       string
	CreatedAt string
	UpdatedAt string
	Roles     []StackInfoRole
	Outputs   map[string]string
}

// SandboxInfo holds the sandbox detail fields for the Info sub-tab.
type SandboxInfo struct {
	ID         string
	Status     string
	CreatedAt  string
	UpdatedAt  string
	Repo       string
	Directory  string
	Branch     string
	RepoPublic bool
	Outputs    map[string]string
	// AWS fields extracted from nested output maps
	AccountID  string
	Region     string
	VPCID      string
	VPCARN     string
	ECRID      string
	ECRARN     string
	ClusterARN string
}

// AuditPanelProps contains data needed for the audit panel with sub-tabs.
type AuditPanelProps struct {
	Install           *models.Install
	StackRuns         []nuon.StackRun
	SandboxRuns       []*nuonmodels.AppInstallSandboxRun
	Deploys           []*nuonmodels.AppInstallDeploy
	BasePath          string
	ActiveTab         string // "stack", "sandbox", or "components"
	StackSubTab       string // "info" or "history" (only used when ActiveTab == "stack")
	SandboxSubTab     string // "info" or "history" (only used when ActiveTab == "sandbox")
	StackInfo         *StackInfo
	SandboxInfo       *SandboxInfo
	SandboxResources        []nuon.TerraformResource
	SandboxPolicyReports    []nuon.PolicyReport
	ActiveStackRun          *nuon.StackRun
	ActiveSandboxRun        *nuonmodels.AppInstallSandboxRun
	Components              []*nuonmodels.AppInstallComponent
	ComponentInfos          []ComponentInfo
	ComponentsPolicyReports []nuon.PolicyReport
	ComponentsSubTab        string // "info", "history", or "policies" (only used when ActiveTab == "components")
	Workflows               []*nuonmodels.AppWorkflow
	ActionWorkflows         []*nuonmodels.AppWorkflow
	StackPagination         AuditTabPagination
	SandboxPagination       AuditTabPagination
	DeploysPagination       AuditTabPagination
	WorkflowsPagination     AuditTabPagination
	ActionsPagination       AuditTabPagination
	AuditSubTab             string // "workflows", "stack", "sandbox", "components", "actions" (only used when ActiveTab == "audit")
}

templ AuditPanel(props AuditPanelProps) {
	<div class="w-full" id={ "audit-content-" + props.ActiveTab }>
		if props.ActiveTab == "stack" {
			@stackPanel(props)
		} else if props.ActiveTab == "sandbox" {
			@sandboxPanel(props)
		} else if props.ActiveTab == "components" {
			@componentsPanel(props)
		} else if props.ActiveTab == "roles" {
			@stackRolesView(props.StackInfo)
			@rolesScripts()
		} else if props.ActiveTab == "audit" {
			@auditJobsPanel(props)
		}
	</div>
	<div
		id="audit-panel-config"
		class="hidden"
		data-base-path={ props.BasePath }
		data-install-id={ props.Install.ID }
	></div>
	@auditPanelScripts()
}

templ stackPanel(props AuditPanelProps) {
	<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
		@stackDetailsCard(props.StackInfo, "Status")
		@activeStackRunCard(props.ActiveStackRun, props.BasePath, props.Install.ID)
	</div>
	<!-- Sub-tab headers -->
	<div class="audit-sub-tabs flex border-b border-cool-grey-200 dark:border-dark-grey-600 mb-4 mt-4">
		<button
			class={ "button button-nav nav-item px-4 py-2 text-sm font-medium", templ.KV("active", props.StackSubTab == "outputs") }
			data-subtab="outputs"
			onclick="switchStackSubTab('outputs')"
		>
			Outputs
		</button>
		<button
			class={ "button button-nav nav-item px-4 py-2 text-sm font-medium", templ.KV("active", props.StackSubTab == "history") }
			data-subtab="history"
			onclick="switchStackSubTab('history')"
		>
			History
		</button>
	</div>
	<div id="stack-sub-outputs" class={ "audit-sub-pane", templ.KV("active", props.StackSubTab == "outputs") }>
		@stackOutputsView(props.StackInfo)
	</div>
	<div id="stack-sub-history" class={ "audit-sub-pane", templ.KV("active", props.StackSubTab == "history") }>
		@auditStackList(props.StackRuns)
		@auditPagination("stack", props.StackPagination)
	</div>
}

templ sandboxPanel(props AuditPanelProps) {
	<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
		@sandboxDetailsCard(props.SandboxInfo, "Status")
		@activeSandboxRunCard(props.ActiveSandboxRun, props.SandboxInfo)
	</div>
	<!-- Sub-tab headers -->
	<div class="audit-sub-tabs flex border-b border-cool-grey-200 dark:border-dark-grey-600 mb-4 mt-4">
		<button
			class={ "button button-nav nav-item px-4 py-2 text-sm font-medium", templ.KV("active", props.SandboxSubTab == "outputs") }
			data-subtab="outputs"
			onclick="switchSandboxSubTab('outputs')"
		>
			Outputs
		</button>
		<button
			class={ "button button-nav nav-item px-4 py-2 text-sm font-medium", templ.KV("active", props.SandboxSubTab == "resources") }
			data-subtab="resources"
			onclick="switchSandboxSubTab('resources')"
		>
			Resources
		</button>
		<button
			class={ "button button-nav nav-item px-4 py-2 text-sm font-medium", templ.KV("active", props.SandboxSubTab == "policies") }
			data-subtab="policies"
			onclick="switchSandboxSubTab('policies')"
		>
			Policy Reports
		</button>
		<button
			class={ "button button-nav nav-item px-4 py-2 text-sm font-medium", templ.KV("active", props.SandboxSubTab == "history") }
			data-subtab="history"
			onclick="switchSandboxSubTab('history')"
		>
			History
		</button>
	</div>
	<div id="sandbox-sub-history" class={ "audit-sub-pane", templ.KV("active", props.SandboxSubTab == "history") }>
		@auditSandboxList(props.SandboxRuns)
		@auditPagination("sandbox", props.SandboxPagination)
	</div>
	<div id="sandbox-sub-outputs" class={ "audit-sub-pane", templ.KV("active", props.SandboxSubTab == "outputs") }>
		@sandboxOutputsView(props.SandboxInfo)
	</div>
	<div id="sandbox-sub-resources" class={ "audit-sub-pane", templ.KV("active", props.SandboxSubTab == "resources") }>
		@components.ResourceList(components.ResourceListProps{Resources: props.SandboxResources})
	</div>
	<div id="sandbox-sub-policies" class={ "audit-sub-pane", templ.KV("active", props.SandboxSubTab == "policies") }>
		@sandboxPolicyReportList(props.SandboxPolicyReports, "policy reports")
	</div>
}

templ componentsPanel(props AuditPanelProps) {
	<!-- Sub-tab headers -->
	<div class="audit-sub-tabs flex border-b border-cool-grey-200 dark:border-dark-grey-600 mb-4">
		<button
			class={ "button button-nav nav-item px-4 py-2 text-sm font-medium", templ.KV("active", props.ComponentsSubTab == "components") }
			data-subtab="components"
			onclick="switchComponentsSubTab('components')"
		>
			Components
		</button>
		<button
			class={ "button button-nav nav-item px-4 py-2 text-sm font-medium", templ.KV("active", props.ComponentsSubTab == "policies") }
			data-subtab="policies"
			onclick="switchComponentsSubTab('policies')"
		>
			Policy Reports
		</button>
		<button
			class={ "button button-nav nav-item px-4 py-2 text-sm font-medium", templ.KV("active", props.ComponentsSubTab == "history") }
			data-subtab="history"
			onclick="switchComponentsSubTab('history')"
		>
			History
		</button>
	</div>
	<div id="components-sub-components" class={ "audit-sub-pane", templ.KV("active", props.ComponentsSubTab == "components") }>
		@componentsInfoView(props.Components, props.ComponentInfos)
	</div>
	<div id="components-sub-policies" class={ "audit-sub-pane", templ.KV("active", props.ComponentsSubTab == "policies") }>
		@componentsPolicyReportList(props.ComponentsPolicyReports, "policy reports")
	</div>
	<div id="components-sub-history" class={ "audit-sub-pane", templ.KV("active", props.ComponentsSubTab == "history") }>
		@auditDeployList(props.Deploys)
		@auditPagination("components", props.DeploysPagination)
	</div>
}

func componentTypeLabel(t string) string {
	switch t {
	case "terraform_module":
		return "Terraform"
	case "helm_chart":
		return "Helm"
	case "docker_build":
		return "Docker"
	case "external_image":
		return "Image"
	case "job":
		return "Job"
	case "kubernetes_manifest":
		return "K8s Manifest"
	default:
		return t
	}
}

templ componentsInfoView(comps []*nuonmodels.AppInstallComponent, infos []ComponentInfo) {
	if len(comps) == 0 {
		@components.EmptyState(components.EmptyStateProps{Title: "No components", Icon: "ph-cards"})
	} else {
		<table class="w-full text-sm table-fixed">
			<colgroup>
				<col class="w-[20%]"/>
				<col class="w-[15%]"/>
				<col class="w-[15%]"/>
				<col class="w-[25%]"/>
				<col class="w-[25%]"/>
			</colgroup>
			<thead>
				<tr class="border-b border-cool-grey-200 dark:border-dark-grey-600">
					<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">Name</th>
					<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">Status</th>
					<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">Type</th>
					<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">Repo</th>
					<th class="text-left py-2 font-medium text-cool-grey-500 dark:text-cool-grey-400">Git ref</th>
				</tr>
			</thead>
			<tbody>
				for i, comp := range comps {
					<tr
						class="border-b border-cool-grey-100 dark:border-dark-grey-700 last:border-b-0 cursor-pointer hover:bg-cool-grey-50 dark:hover:bg-dark-grey-800 transition-colors"
						onclick={ templ.ComponentScript{Call: fmt.Sprintf("openComponentPanel('%s', '%s')", comp.ComponentID, componentName(comp))} }
					>
						<td class="py-2 pr-3 font-medium text-cool-grey-900 dark:text-white truncate" title={ componentName(comp) }>{ componentName(comp) }</td>
						<td class="py-2 pr-3">
							if i < len(infos) && infos[i].Status != "" {
								<span class={ "px-2 py-0.5 text-xs font-medium rounded-full", auditStatusClass(infos[i].Status) }>
									{ infos[i].Status }
								</span>
							}
						</td>
						<td class="py-2 pr-3 text-cool-grey-600 dark:text-cool-grey-400">
							<div class="flex items-center gap-1.5">
								@auditComponentTypeIcon(componentType(comp))
								<span class="truncate">{ componentTypeLabel(componentType(comp)) }</span>
							</div>
						</td>
						<td class="py-2 pr-3 text-cool-grey-600 dark:text-cool-grey-400 truncate">
							if i < len(infos) && infos[i].Repo != "" {
								if infos[i].RepoPublic {
									<a href={ templ.SafeURL(repoURL(infos[i].Repo)) } target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-theme-primary hover:underline" onclick="event.stopPropagation()" title={ infos[i].Repo }><span class="truncate">{ infos[i].Repo }</span><i class="ph-bold ph-arrow-square-out text-xs flex-shrink-0"></i></a>
								} else {
									<span class="truncate" title={ infos[i].Repo }>{ infos[i].Repo }</span>
								}
							}
						</td>
						<td class="py-2 text-cool-grey-600 dark:text-cool-grey-400 truncate">
							if i < len(infos) && infos[i].Branch != "" {
								if infos[i].RepoPublic {
									<a href={ templ.SafeURL(repoURL(infos[i].Repo) + "/tree/" + infos[i].Branch) } target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-theme-primary hover:underline" onclick="event.stopPropagation()" title={ infos[i].Branch }><span class="truncate">{ infos[i].Branch }</span><i class="ph-bold ph-arrow-square-out text-xs flex-shrink-0"></i></a>
								} else {
									<span class="truncate" title={ infos[i].Branch }>{ infos[i].Branch }</span>
								}
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

func componentName(comp *nuonmodels.AppInstallComponent) string {
	if comp.Component != nil && comp.Component.Name != "" {
		return comp.Component.Name
	}
	return "Component"
}

func componentStatus(comp *nuonmodels.AppInstallComponent) string {
	if comp.StatusV2 != nil && comp.StatusV2.Status != "" {
		return string(comp.StatusV2.Status)
	}
	if comp.Status != "" {
		return comp.Status
	}
	if len(comp.InstallDeploys) > 0 {
		latest := comp.InstallDeploys[0]
		if latest.StatusV2 != nil && latest.StatusV2.Status != "" {
			return string(latest.StatusV2.Status)
		}
		return latest.Status
	}
	return ""
}

func componentType(comp *nuonmodels.AppInstallComponent) string {
	if comp.Component != nil {
		return string(comp.Component.Type)
	}
	return ""
}

templ sandboxDetailsCard(info *SandboxInfo, title string) {
	if info == nil {
		@components.Card(components.CardProps{Header: stackCardHeader(title, "")}) {
			@components.EmptyState(components.EmptyStateProps{Title: "No sandbox data", Icon: "ph-shipping-container", Compact: true})
		}
	} else {
		@components.Card(components.CardProps{Header: stackCardHeader(title, info.Status), AccentColor: statusAccentColor(info.Status)}) {
			<div class="space-y-3 text-sm">
				if info.AccountID != "" {
					@infoRowLink("Account", info.AccountID, "https://console.aws.amazon.com/console/home")
				}
				if info.Region != "" {
					@infoRowLink("Region", info.Region, "https://console.aws.amazon.com/console/home?region="+info.Region)
				}
				if info.VPCARN != "" {
					@infoRowLink("VPC", info.VPCARN, "https://console.aws.amazon.com/go/view?arn="+info.VPCARN)
				} else if info.VPCID != "" {
					@infoRowLink("VPC", info.VPCID, "https://"+info.Region+".console.aws.amazon.com/vpcconsole/home?region="+info.Region+"#VpcDetails:VpcId="+info.VPCID)
				}
				if info.ECRARN != "" {
					@infoRowLink("ECR", info.ECRARN, "https://console.aws.amazon.com/go/view?arn="+info.ECRARN)
				} else if info.ECRID != "" {
					@infoRowLink("ECR", info.ECRID, "https://"+info.Region+".console.aws.amazon.com/ecr/repositories?region="+info.Region)
				}
				if info.ClusterARN != "" {
					@infoRowLink("Cluster", info.ClusterARN, "https://console.aws.amazon.com/go/view?arn="+info.ClusterARN)
				}
			</div>
		}
	}
}

templ sandboxOutputsView(info *SandboxInfo) {
	if info == nil || len(info.Outputs) == 0 {
		@components.EmptyState(components.EmptyStateProps{Title: "No outputs", Icon: "ph-code-block"})
	} else {
		<div class="space-y-3">
			for key, value := range info.Outputs {
				<div class="border-b border-cool-grey-100 dark:border-dark-grey-700 last:border-b-0 pb-3 last:pb-0">
					<div class="text-sm font-medium text-cool-grey-900 dark:text-white mb-1">{ key }</div>
					@components.CodeBlock(value, outputLang(value))
				</div>
			}
		</div>
	}
}


// formatJSON pretty-prints a value as indented JSON.
func formatJSON(v interface{}) string {
	b, err := json.MarshalIndent(v, "", "  ")
	if err != nil {
		return fmt.Sprintf("%v", v)
	}
	return string(b)
}

templ stackCardHeader(title string, status string) {
	<div class="flex items-center gap-2">
		if title != "" {
			<h4 class="text-base text-cool-grey-900 dark:text-white">{ title }</h4>
		}
		if status != "" {
			<span class={ "px-2 py-0.5 text-xs font-medium rounded-full", auditStatusClass(status) }>
				{ status }
			</span>
		}
	</div>
}

templ stackDetailsCard(info *StackInfo, title string) {
	if info == nil {
		@components.Card(components.CardProps{Header: stackCardHeader(title, "")}) {
			@components.EmptyState(components.EmptyStateProps{Title: "No stack data", Icon: "ph-stack", Compact: true})
		}
	} else {
		@components.Card(components.CardProps{Header: stackCardHeader(title, info.Status), AccentColor: statusAccentColor(info.Status)}) {
			if info.AccountID != "" || info.Region != "" || info.VPC != "" {
				<div class="space-y-3 text-sm">
					@infoRowLink("Account ID", info.AccountID, "https://console.aws.amazon.com/console/home")
					@infoRowLink("Region", info.Region, "https://console.aws.amazon.com/console/home?region="+info.Region)
					@infoRowLink("VPC", info.VPC, "https://"+info.Region+".console.aws.amazon.com/vpcconsole/home?region="+info.Region+"#VpcDetails:VpcId="+info.VPC)
				</div>
			} else {
				@components.EmptyState(components.EmptyStateProps{Title: "No stack data", Icon: "ph-stack", Compact: true})
			}
		}
	}
}

templ stackOutputsView(info *StackInfo) {
	if info == nil || len(info.Outputs) == 0 {
		@components.EmptyState(components.EmptyStateProps{Title: "No outputs", Icon: "ph-code-block"})
	} else {
		<div class="space-y-3">
			for key, value := range info.Outputs {
				<div class="border-b border-cool-grey-100 dark:border-dark-grey-700 last:border-b-0 pb-3 last:pb-0">
					<div class="text-sm font-medium text-cool-grey-900 dark:text-white mb-1">{ key }</div>
					@components.CodeBlock(value, outputLang(value))
				</div>
			}
		</div>
	}
}

templ activeStackRunCard(run *nuon.StackRun, basePath string, installID string) {
	if run == nil {
		@components.Card(components.CardProps{Header: activeRunCardHeader("Active stack run", "")}) {
			@components.EmptyState(components.EmptyStateProps{Title: "No active stack run", Icon: "ph-stack", Compact: true})
		}
	} else {
		@components.Card(components.CardProps{Header: activeRunCardHeader("Active stack run", "")}) {
			<div class="space-y-3 text-sm">
				@infoRow("Ran on", FormatAPITime(run.CreatedAt))
				if run.TemplateURL != "" {
					@infoRowLink("Template", run.TemplateURL, run.TemplateURL)
				}
			</div>
		}
	}
}

templ activeRunCardHeader(title string, status string) {
	<div class="flex items-center gap-2">
		<h4 class="text-base text-cool-grey-900 dark:text-white">{ title }</h4>
		if status != "" {
			<span class={ "px-2 py-0.5 text-xs font-medium rounded-full", auditStatusClass(status) }>
				{ status }
			</span>
		}
	</div>
}

templ activeSandboxRunCard(run *nuonmodels.AppInstallSandboxRun, info *SandboxInfo) {
	if run == nil {
		@components.Card(components.CardProps{Header: activeRunCardHeader("Active sandbox run", "")}) {
			@components.EmptyState(components.EmptyStateProps{Title: "No active sandbox run", Icon: "ph-shipping-container", Compact: true})
		}
	} else {
		@components.Card(components.CardProps{Header: activeRunCardHeader("Active sandbox run", "")}) {
			<div class="space-y-3 text-sm">
				@infoRow("Ran on", FormatAPITime(run.CreatedAt))
				if info != nil {
					if info.Repo != "" {
						if info.RepoPublic {
							@infoRowLink("Repo", info.Repo, repoURL(info.Repo))
						} else {
							@infoRow("Repo", info.Repo)
						}
					}
					if info.Branch != "" {
						if info.RepoPublic {
							@infoRowLink("Git ref", info.Branch, repoURL(info.Repo)+"/tree/"+info.Branch)
						} else {
							@infoRow("Git ref", info.Branch)
						}
					}
					}
			</div>
		}
	}
}

templ stackRolesView(info *StackInfo) {
	if info == nil || len(info.Roles) == 0 {
		@components.EmptyState(components.EmptyStateProps{Title: "No roles", Icon: "ph-file-lock"})
	} else {
		<table class="w-full text-sm table-fixed">
			<colgroup>
				<col class="w-[25%]"/>
				<col class="w-[20%]"/>
				<col class="w-[40%]"/>
				<col class="w-[15%]"/>
			</colgroup>
			<thead>
				<tr class="border-b border-cool-grey-200 dark:border-dark-grey-600">
					<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">Name</th>
					<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">Type</th>
					<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">ARN</th>
					<th class="text-left py-2 font-medium text-cool-grey-500 dark:text-cool-grey-400">Status</th>
				</tr>
			</thead>
			<tbody>
				for i, role := range info.Roles {
					<tr
						class="border-b border-cool-grey-100 dark:border-dark-grey-700 last:border-b-0 cursor-pointer hover:bg-cool-grey-50 dark:hover:bg-dark-grey-700"
						data-role-name={ role.Name }
						onclick={ templ.ComponentScript{Call: fmt.Sprintf("openRolePanel(%d)", i)} }
					>
						<td class="py-2 pr-3 font-medium text-cool-grey-900 dark:text-white truncate" title={ role.Name }>{ role.Name }</td>
						<td class="py-2 pr-3 text-cool-grey-600 dark:text-cool-grey-400 truncate" title={ role.Type }>{ role.Type }</td>
						<td class="py-2 pr-3 text-cool-grey-600 dark:text-cool-grey-400 font-mono truncate" title={ role.Arn }>{ role.Arn }</td>
						<td class="py-2">
							if role.Active {
								<span class="text-xs px-2 py-0.5 rounded-full bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400 whitespace-nowrap">
									Provisioned
								</span>
							} else {
								<span class="text-xs px-2 py-0.5 rounded-full bg-cool-grey-100 text-cool-grey-500 dark:bg-dark-grey-700 dark:text-cool-grey-400 whitespace-nowrap">
									Not provisioned
								</span>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ rolesScripts() {
	<script>
		(function() {
			window.openRolePanel = function(index) {
				var rows = document.querySelectorAll('[data-role-name]');
				var row = rows[index];
				var name = row ? row.getAttribute('data-role-name') : 'Role Details';
				var panel = document.getElementById('secondary-panel');
				var title = document.getElementById('secondary-panel-title');
				var content = document.getElementById('secondary-panel-content');
				if (!panel || !title || !content) return;
				title.textContent = name;
				content.innerHTML = `
					<div class="p-4 space-y-4 text-sm">
						<div class="space-y-1">
							<div class="shimmer h-3 w-16"></div>
							<div class="shimmer h-4 w-1/2"></div>
						</div>
						<div class="space-y-1">
							<div class="shimmer h-3 w-8"></div>
							<div class="shimmer h-4 w-full"></div>
						</div>
						<div class="space-y-1">
							<div class="shimmer h-3 w-16"></div>
							<div class="shimmer h-5 w-24"></div>
						</div>
						<div class="pt-2 border-t border-cool-grey-200 dark:border-dark-grey-600 space-y-3">
							<div class="shimmer h-4 w-20"></div>
							<div class="shimmer h-24 w-full"></div>
						</div>
					</div>`;
				panel.classList.add('open');
				var overlay = document.getElementById('secondary-panel-overlay');
				if (overlay) overlay.classList.add('open');
				var config = document.getElementById('audit-panel-config');
				var basePath = config ? config.getAttribute('data-base-path') : '';
				var installId = config ? config.getAttribute('data-install-id') : '';
				fetch(basePath + '/installs/' + installId + '/panel/audit/role/' + index)
					.then(function(resp) { return resp.text(); })
					.then(function(html) { content.innerHTML = html; })
					.catch(function() {
						content.innerHTML = '<p class="text-sm text-red-500 p-4">Failed to load role details.</p>';
					});
			};
		})();
	</script>
}

templ AuditRoleDetailContent(role StackInfoRole) {
	<div class="space-y-4 text-sm">
		<div>
			<span class="text-cool-grey-500 dark:text-cool-grey-400">Type</span>
			<p class="font-medium text-cool-grey-800 dark:text-cool-grey-200">{ role.Type }</p>
		</div>
		<div>
			<span class="text-cool-grey-500 dark:text-cool-grey-400">ARN</span>
			<p class="font-medium text-cool-grey-800 dark:text-cool-grey-200 font-mono break-all">{ role.Arn }</p>
		</div>
		<div>
			<span class="text-cool-grey-500 dark:text-cool-grey-400">Status</span>
			<div class="mt-1">
				if role.Active {
					<span class="text-xs px-2 py-0.5 rounded-full bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400">Provisioned</span>
				} else {
					<span class="text-xs px-2 py-0.5 rounded-full bg-cool-grey-100 text-cool-grey-500 dark:bg-dark-grey-700 dark:text-cool-grey-400">Not provisioned</span>
				}
			</div>
		</div>
		if len(role.Policies) > 0 {
			<div class="pt-2 border-t border-cool-grey-200 dark:border-dark-grey-600">
				<h4 class="font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-3">Policies</h4>
				for _, pol := range role.Policies {
					<div class="mb-3">
						<p class="font-medium text-cool-grey-800 dark:text-cool-grey-200 mb-1">
							if pol.Name != "" {
								{ pol.Name }
							} else if pol.ManagedPolicyName != "" {
								{ pol.ManagedPolicyName }
							} else {
								Policy
							}
						</p>
						if pol.ManagedPolicyName != "" {
							<p class="text-xs text-cool-grey-500 dark:text-cool-grey-400 mb-1">Managed: { pol.ManagedPolicyName }</p>
						}
						if pol.Contents != "" {
							@components.CodeBlock(pol.Contents, "json")
						}
					</div>
				}
			</div>
		}
		if role.PermissionsBoundary != "" {
			<div class="pt-2 border-t border-cool-grey-200 dark:border-dark-grey-600">
				<h4 class="font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-3">Permissions Boundary</h4>
				@components.CodeBlock(role.PermissionsBoundary, "json")
			</div>
		}
	</div>
}

templ infoRow(label, value string) {
	<div>
