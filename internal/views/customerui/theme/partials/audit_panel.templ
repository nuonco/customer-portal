func policyReportPolicyName(report nuon.PolicyReport) string {
	if report.PolicyName != "" {
		return report.PolicyName
	}
	return "Policy evaluation"
}

templ policyReportCountCells(report nuon.PolicyReport) {
	<td class="py-2 pr-3">
		if report.DenyCount > 0 {
			<span class="px-2 py-0.5 text-xs font-medium rounded-full bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-300">
				{ fmt.Sprintf("%d", report.DenyCount) }
			</span>
		} else {
			<span class="text-cool-grey-400 dark:text-cool-grey-500">0</span>
		}
	</td>
	<td class="py-2 pr-3">
		if report.WarnCount > 0 {
			<span class="px-2 py-0.5 text-xs font-medium rounded-full bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-300">
				{ fmt.Sprintf("%d", report.WarnCount) }
			</span>
		} else {
			<span class="text-cool-grey-400 dark:text-cool-grey-500">0</span>
		}
	</td>
	<td class="py-2 pr-3">
		if report.PassCount > 0 {
			<span class="px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300">
				{ fmt.Sprintf("%d", report.PassCount) }
			</span>
		} else {
			<span class="text-cool-grey-400 dark:text-cool-grey-500">0</span>
		}
	</td>
	<td class="py-2 text-cool-grey-600 dark:text-cool-grey-400 whitespace-nowrap">{ FormatAPITime(report.EvaluatedAt) }</td>
}

