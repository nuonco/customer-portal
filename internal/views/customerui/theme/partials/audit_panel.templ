				var content = document.getElementById('secondary-panel-content');
				if (!panel || !title || !content) return;
				title.textContent = 'Stack ' + runType;
				content.innerHTML = `
					<div class="p-4 space-y-4">
						<div class="card-base p-4 space-y-3">
							<div class="flex justify-between items-center">
								<div class="shimmer h-4 w-1/3"></div>
								<div class="shimmer h-5 w-20"></div>
							</div>
							<div class="grid grid-cols-2 gap-3">
								<div class="space-y-3">
									<div class="shimmer h-4 w-3/4"></div>
									<div class="shimmer h-4 w-2/3"></div>
									<div class="shimmer h-4 w-3/4"></div>
								</div>
								<div class="space-y-3">
									<div class="shimmer h-4 w-3/4"></div>
									<div class="shimmer h-4 w-1/2"></div>
								</div>
							</div>
						</div>
						<div class="flex gap-4 border-b border-cool-grey-200 dark:border-dark-grey-600 pb-2">
							<div class="shimmer h-5 w-20"></div>
						</div>
						<div class="space-y-3">
							<div class="shimmer h-4 w-3/4"></div>
							<div class="shimmer h-4 w-1/2"></div>
							<div class="shimmer h-4 w-2/3"></div>
						</div>
					</div>`;
				panel.classList.add('open');
				var overlay = document.getElementById('secondary-panel-overlay');
				if (overlay) overlay.classList.add('open');

				var config = document.getElementById('audit-panel-config');
				var basePath = config ? config.getAttribute('data-base-path') : '';
				var installId = config ? config.getAttribute('data-install-id') : '';
				fetch(basePath + '/installs/' + installId + '/panel/stack-run/' + runID)
					.then(function(resp) { return resp.text(); })
					.then(function(html) { content.innerHTML = html; })
					.catch(function() {
						content.innerHTML = '<p class="text-sm text-red-500 p-4">Failed to load stack run details.</p>';
					});
			};

