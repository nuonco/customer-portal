				fetch(basePath + '/installs/' + installId + '/panel/sandbox-run/' + runID)
					.then(function(resp) { return resp.text(); })
					.then(function(html) { content.innerHTML = html; })
					.catch(function() {
						content.innerHTML = '<p class="text-sm text-red-500 p-4">Failed to load sandbox run details.</p>';
