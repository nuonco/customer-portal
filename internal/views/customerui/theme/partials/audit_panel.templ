					<tr
						class="border-b border-cool-grey-100 dark:border-dark-grey-700 last:border-b-0 cursor-pointer hover:bg-cool-grey-50 dark:hover:bg-dark-grey-700"
						onclick={ templ.ComponentScript{Call: fmt.Sprintf("openJobPanel('action', '%s', '%s')", wf.ID, wf.Name)} }
					>
						<td class="py-2 pr-3 font-medium text-cool-grey-900 dark:text-white truncate" title={ wf.Name }>{ wf.Name }</td>
						<td class="py-2 pr-3">
							<span class={ "px-2 py-0.5 text-xs font-medium rounded-full", auditStatusClass(workflowStatus(wf)) }>
								{ workflowStatus(wf) }
							</span>
						</td>
						<td class="py-2 pr-3 text-cool-grey-600 dark:text-cool-grey-400 truncate">{ workflowType(wf) }</td>
						<td class="py-2 text-cool-grey-600 dark:text-cool-grey-400 whitespace-nowrap">{ FormatAPITime(wf.CreatedAt) }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}


func auditStatusClass(status string) string {
	switch status {
	case "active", "succeeded", "success", "completed":
		return "bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300"
	case "failed", "error":
		return "bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-300"
	case "in-progress", "running", "deploying":
		return "bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300"
	case "pending", "queued":
		return "bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-300"
	case "cancelled":
		return "bg-cool-grey-100 dark:bg-cool-grey-800 text-cool-grey-700 dark:text-cool-grey-300"
	default:
		return "bg-cool-grey-100 dark:bg-cool-grey-800 text-cool-grey-700 dark:text-cool-grey-300"
	}
}

func statusAccentColor(status string) string {
	switch status {
	case "active", "succeeded", "success", "completed":
		return "#16a34a"
	case "failed", "error":
		return "#dc2626"
	case "in-progress", "running", "deploying":
		return "#2563eb"
	case "pending", "queued":
		return "#ca8a04"
	default:
		return "#9ca3af"
	}
}

func repoURL(repo string) string {
	if strings.HasPrefix(repo, "https://") || strings.HasPrefix(repo, "http://") {
		return repo
	}
	// Bare org/repo slug — assume GitHub
	if strings.Contains(repo, "/") && !strings.Contains(repo, ".") {
		return "https://github.com/" + repo
	}
	return "https://" + repo
}

func FormatAPITime(ts string) string {
	t, err := time.Parse(time.RFC3339Nano, ts)
	if err != nil {
		t, err = time.Parse(time.RFC3339, ts)
		if err != nil {
			return ts
		}
	}
	return t.Format("Jan 2, 2006 3:04 PM")
}

templ auditPagination(tab string, p AuditTabPagination) {
	if p.HasPrev || p.HasNext {
		<div class="mt-6 flex items-center justify-between">
			<div>
				if p.HasPrev {
					<button
						type="button"
						onclick={ templ.ComponentScript{Call: fmt.Sprintf("loadAuditPage('%s', %d)", tab, p.PrevOffset)} }
						class="button button-pagination pagination-nav-btn"
					>
						<i class="ph-bold ph-caret-left text-base mr-2"></i>
						Previous
					</button>
				}
			</div>
			<div>
				if p.HasNext {
					<button
						type="button"
						onclick={ templ.ComponentScript{Call: fmt.Sprintf("loadAuditPage('%s', %d)", tab, p.NextOffset)} }
						class="button button-pagination pagination-nav-btn"
					>
						Next
						<i class="ph-bold ph-caret-right text-base ml-2"></i>
					</button>
				}
			</div>
		</div>
	}
}

