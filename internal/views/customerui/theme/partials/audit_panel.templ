			window.openComponentPanel = function(componentID, componentName) {
					var panel = document.getElementById('secondary-panel');
					var title = document.getElementById('secondary-panel-title');
					var content = document.getElementById('secondary-panel-content');
					if (!panel || !title || !content) return;
					title.textContent = componentName || 'Component Details';
					content.innerHTML = `
						<div class="p-4 space-y-4">
							<div class="card-base p-4 space-y-3">
								<div class="flex justify-between items-center">
									<div class="shimmer h-4 w-1/3"></div>
									<div class="shimmer h-5 w-20"></div>
								</div>
								<div class="grid grid-cols-2 gap-2">
									<div class="shimmer h-4 w-full"></div>
									<div class="shimmer h-4 w-full"></div>
									<div class="shimmer h-4 w-full"></div>
									<div class="shimmer h-4 w-full"></div>
								</div>
							</div>
							<div class="flex gap-4 border-b border-cool-grey-200 dark:border-dark-grey-600 pb-2">
								<div class="shimmer h-5 w-20"></div>
								<div class="shimmer h-5 w-24"></div>
								<div class="shimmer h-5 w-20"></div>
							</div>
							<div class="space-y-3">
								<div class="shimmer h-4 w-3/4"></div>
								<div class="shimmer h-4 w-1/2"></div>
								<div class="shimmer h-4 w-2/3"></div>
								<div class="shimmer h-4 w-3/4"></div>
							</div>
						</div>`;
					panel.classList.add('open');
					var overlay = document.getElementById('secondary-panel-overlay');
					if (overlay) overlay.classList.add('open');

					var config = document.getElementById('audit-panel-config');
					var basePath = config ? config.getAttribute('data-base-path') : '';
					var installId = config ? config.getAttribute('data-install-id') : '';
					fetch(basePath + '/installs/' + installId + '/panel/component/' + componentID)
						.then(function(resp) { return resp.text(); })
						.then(function(html) { content.innerHTML = html; })
						.catch(function() {
							content.innerHTML = '<p class="text-sm text-red-500 p-4">Failed to load component details.</p>';
						});
				};

				window.openWorkflowPanel = function(workflowID, workflowName) {
				var panel = document.getElementById('secondary-panel');
				var title = document.getElementById('secondary-panel-title');
				var content = document.getElementById('secondary-panel-content');
				if (!panel || !title || !content) return;
				title.textContent = workflowName || 'Workflow';
				content.innerHTML = `
					<div class="space-y-4">
						<div class="card-base p-4 space-y-3">
							<div class="shimmer h-4 w-1/3"></div>
							<div class="shimmer h-4 w-2/3"></div>
							<div class="shimmer h-4 w-1/2"></div>
						</div>
						<div class="space-y-2">
							<div class="shimmer h-8 w-full"></div>
							<div class="pl-4 space-y-2 py-1">
								<div class="shimmer h-4 w-3/4"></div>
								<div class="shimmer h-4 w-1/2"></div>
								<div class="shimmer h-4 w-2/3"></div>
							</div>
							<div class="shimmer h-8 w-full"></div>
							<div class="shimmer h-8 w-full"></div>
						</div>
					</div>`;
				panel.classList.add('open');
				var overlay = document.getElementById('secondary-panel-overlay');
				if (overlay) overlay.classList.add('open');

				var config = document.getElementById('audit-panel-config');
				var basePath = config ? config.getAttribute('data-base-path') : '';
				var installId = config ? config.getAttribute('data-install-id') : '';
				fetch(basePath + '/installs/' + installId + '/panel/workflow/' + workflowID)
					.then(function(resp) { return resp.text(); })
					.then(function(html) {
						content.innerHTML = html;
						var scripts = content.querySelectorAll('script');
						scripts.forEach(function(s) {
							var ns = document.createElement('script');
							ns.textContent = s.textContent;
							s.parentNode.replaceChild(ns, s);
						});
						if (typeof htmx !== 'undefined') {
							htmx.process(content);
						}
					})
					.catch(function() {
						content.innerHTML = '<p class="text-sm text-red-500">Failed to load workflow details.</p>';
					});
			};
		})();
	</script>
}
