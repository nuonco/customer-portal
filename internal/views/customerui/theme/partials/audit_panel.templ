}

templ auditJobsPagination(subTab string, p AuditTabPagination) {
	if p.HasPrev || p.HasNext {
		<div class="mt-6 flex items-center justify-between">
			<div>
				if p.HasPrev {
					<button
						type="button"
						onclick={ templ.ComponentScript{Call: fmt.Sprintf("loadAuditJobsPage('%s', %d)", subTab, p.PrevOffset)} }
						class="button button-pagination pagination-nav-btn"
					>
						<i class="ph-bold ph-caret-left text-base mr-2"></i>
						Previous
					</button>
				}
			</div>
			<div>
				if p.HasNext {
					<button
						type="button"
						onclick={ templ.ComponentScript{Call: fmt.Sprintf("loadAuditJobsPage('%s', %d)", subTab, p.NextOffset)} }
						class="button button-pagination pagination-nav-btn"
					>
						Next
						<i class="ph-bold ph-caret-right text-base ml-2"></i>
					</button>
				}
			</div>
		</div>
	}
}

templ auditJobsPanel(props AuditPanelProps) {
	<div class="audit-sub-tabs flex border-b border-cool-grey-200 dark:border-dark-grey-600 mb-4">
		<button
			class={ "button button-nav nav-item px-4 py-2 text-sm font-medium", templ.KV("active", props.AuditSubTab == "workflows") }
			data-subtab="workflows"
			onclick="switchAuditSubTab('workflows')"
		>
			Workflows
		</button>
		<button
			class={ "button button-nav nav-item px-4 py-2 text-sm font-medium", templ.KV("active", props.AuditSubTab == "stack") }
			data-subtab="stack"
			onclick="switchAuditSubTab('stack')"
		>
			Stack
		</button>
		<button
			class={ "button button-nav nav-item px-4 py-2 text-sm font-medium", templ.KV("active", props.AuditSubTab == "sandbox") }
			data-subtab="sandbox"
			onclick="switchAuditSubTab('sandbox')"
		>
			Sandbox
		</button>
		<button
			class={ "button button-nav nav-item px-4 py-2 text-sm font-medium", templ.KV("active", props.AuditSubTab == "components") }
			data-subtab="components"
			onclick="switchAuditSubTab('components')"
		>
			Components
		</button>
		<button
			class={ "button button-nav nav-item px-4 py-2 text-sm font-medium", templ.KV("active", props.AuditSubTab == "actions") }
			data-subtab="actions"
			onclick="switchAuditSubTab('actions')"
		>
			Actions
		</button>
	</div>
	<div id="audit-sub-workflows" class={ "audit-sub-pane", templ.KV("active", props.AuditSubTab == "workflows") }>
		@allWorkflowsList(props.Workflows)
		@auditJobsPagination("workflows", props.WorkflowsPagination)
	</div>
	<div id="audit-sub-stack" class={ "audit-sub-pane", templ.KV("active", props.AuditSubTab == "stack") }>
		@auditStackList(props.StackRuns)
		@auditJobsPagination("stack", props.StackPagination)
	</div>
	<div id="audit-sub-sandbox" class={ "audit-sub-pane", templ.KV("active", props.AuditSubTab == "sandbox") }>
		@auditSandboxList(props.SandboxRuns)
		@auditJobsPagination("sandbox", props.SandboxPagination)
	</div>
	<div id="audit-sub-components" class={ "audit-sub-pane", templ.KV("active", props.AuditSubTab == "components") }>
		@auditDeployList(props.Deploys)
		@auditJobsPagination("components", props.DeploysPagination)
	</div>
	<div id="audit-sub-actions" class={ "audit-sub-pane", templ.KV("active", props.AuditSubTab == "actions") }>
		@auditWorkflowList(props.ActionWorkflows)
		@auditJobsPagination("actions", props.ActionsPagination)
	</div>
}

templ auditPanelScripts() {
	<script>
		(function() {
			window.loadAuditPage = function(tab, offset) {
				var config = document.getElementById('audit-panel-config');
				if (!config) return;
				var basePath = config.getAttribute('data-base-path');
				var installId = config.getAttribute('data-install-id');
				var url = basePath + '/installs/' + installId + '/panel/audit?tab=' + tab + '&' + tab + '_offset=' + offset;
				if (typeof htmx !== 'undefined') {
					htmx.ajax('GET', url, { target: '#panel-content-' + tab, swap: 'innerHTML' });
				}
			};

			function switchSubTab(prefix, subTab) {
				var container = document.getElementById('audit-content-' + prefix);
				if (!container) return;
				container.querySelectorAll('.audit-sub-tabs .nav-item').forEach(function(b) {
					b.classList.remove('active');
				});
				container.querySelectorAll('.audit-sub-pane').forEach(function(p) {
					p.classList.remove('active');
				});
				var btn = container.querySelector('.audit-sub-tabs .nav-item[data-subtab="' + subTab + '"]');
				if (btn) btn.classList.add('active');
				var pane = container.querySelector('#' + prefix + '-sub-' + subTab);
				if (pane) pane.classList.add('active');
			}

			window.switchStackSubTab = function(subTab) {
				switchSubTab('stack', subTab);
			};
			window.switchSandboxSubTab = function(subTab) {
				switchSubTab('sandbox', subTab);
			};
			window.switchComponentsSubTab = function(subTab) {
				switchSubTab('components', subTab);
			};
			window.loadAuditJobsPage = function(subTab, offset) {
				var config = document.getElementById('audit-panel-config');
				if (!config) return;
				var basePath = config.getAttribute('data-base-path');
				var installId = config.getAttribute('data-install-id');
				var url = basePath + '/installs/' + installId + '/panel/audit?tab=audit&audit_sub=' + subTab + '&audit_offset=' + offset;
				if (typeof htmx !== 'undefined') {
					htmx.ajax('GET', url, { target: '#audit-content-audit', swap: 'innerHTML' });
				}
			};
			window.switchAuditSubTab = function(subTab) {
				var config = document.getElementById('audit-panel-config');
				if (!config) return;
				var basePath = config.getAttribute('data-base-path');
				var installId = config.getAttribute('data-install-id');
				var url = basePath + '/installs/' + installId + '/panel/audit?tab=audit&audit_sub=' + subTab;
				if (typeof htmx !== 'undefined') {
					htmx.ajax('GET', url, { target: '#audit-content-audit', swap: 'innerHTML' });
				}
			};

			window.openPolicyReportPanel = function(reportID, reportName) {
				var panel = document.getElementById('secondary-panel');
				var title = document.getElementById('secondary-panel-title');
				var content = document.getElementById('secondary-panel-content');
				if (!panel || !title || !content) return;
				title.textContent = reportName || 'Policy Report';
				content.innerHTML = `
					<div class="p-4 space-y-4">
						<div class="space-y-3">
							<div class="shimmer h-3 w-20"></div>
							<div class="space-y-2">
								<div class="shimmer h-4 w-3/4"></div>
								<div class="shimmer h-4 w-1/2"></div>
								<div class="shimmer h-4 w-2/3"></div>
