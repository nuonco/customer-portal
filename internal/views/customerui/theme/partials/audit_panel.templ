func allWorkflowsTypeLabel(t nuonmodels.AppWorkflowType) string {
	switch t {
	case "provision":
		return "Provision"
	case "deprovision":
		return "Deprovision"
	case "deprovision_sandbox":
		return "Deprovision Sandbox"
	case "manual_deploy":
		return "Manual Deploy"
	case "input_update":
		return "Input Update"
	case "deploy_components":
		return "Deploy Components"
	case "teardown_component":
		return "Teardown Component"
	default:
		return strings.ReplaceAll(string(t), "_", " ")
	}
}

func allWorkflowsDuration(wf *nuonmodels.AppWorkflow) string {
	if wf.ExecutionTime > 0 {
		d := time.Duration(wf.ExecutionTime)
		if d < time.Minute {
			return fmt.Sprintf("%ds", int(d.Seconds()))
		}
		if d < time.Hour {
			return fmt.Sprintf("%dm %ds", int(d.Minutes()), int(d.Seconds())%60)
		}
		return fmt.Sprintf("%dh %dm", int(d.Hours()), int(d.Minutes())%60)
	}
	if wf.CreatedAt != "" && wf.FinishedAt != "" {
		start, err1 := time.Parse(time.RFC3339Nano, wf.CreatedAt)
		end, err2 := time.Parse(time.RFC3339Nano, wf.FinishedAt)
		if err1 == nil && err2 == nil {
			d := end.Sub(start)
			if d < time.Minute {
				return fmt.Sprintf("%ds", int(d.Seconds()))
			}
			if d < time.Hour {
				return fmt.Sprintf("%dm %ds", int(d.Minutes()), int(d.Seconds())%60)
			}
			return fmt.Sprintf("%dh %dm", int(d.Hours()), int(d.Minutes())%60)
		}
	}
	if !wf.Finished {
		return "running..."
	}
	return "—"
}

templ allWorkflowsList(workflows []*nuonmodels.AppWorkflow) {
	if len(workflows) == 0 {
		@components.EmptyState(components.EmptyStateProps{Title: "No workflows", Icon: "ph-clock-clockwise"})
	} else {
		<table class="w-full text-sm table-fixed">
			<colgroup>
				<col class="w-[30%]"/>
				<col class="w-[20%]"/>
				<col class="w-[25%]"/>
				<col class="w-[25%]"/>
			</colgroup>
			<thead>
				<tr class="border-b border-cool-grey-200 dark:border-dark-grey-600">
					<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">Type</th>
					<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">Status</th>
					<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">Date</th>
					<th class="text-left py-2 font-medium text-cool-grey-500 dark:text-cool-grey-400">Duration</th>
				</tr>
			</thead>
			<tbody>
				for _, wf := range workflows {
					<tr
						class="border-b border-cool-grey-100 dark:border-dark-grey-700 last:border-b-0 cursor-pointer hover:bg-cool-grey-50 dark:hover:bg-dark-grey-700"
						onclick={ templ.ComponentScript{Call: fmt.Sprintf("openWorkflowPanel('%s', '%s')", wf.ID, allWorkflowsTypeLabel(wf.Type))} }
					>
						<td class="py-2 pr-3 font-medium text-cool-grey-900 dark:text-white truncate" title={ allWorkflowsTypeLabel(wf.Type) }>
							{ allWorkflowsTypeLabel(wf.Type) }
						</td>
						<td class="py-2 pr-3">
							<span class={ "px-2 py-0.5 text-xs font-medium rounded-full", auditStatusClass(workflowStatus(wf)) }>
								{ workflowStatus(wf) }
							</span>
						</td>
						<td class="py-2 pr-3 text-cool-grey-600 dark:text-cool-grey-400 whitespace-nowrap">{ FormatAPITime(wf.CreatedAt) }</td>
						<td class="py-2 text-cool-grey-600 dark:text-cool-grey-400 whitespace-nowrap">{ allWorkflowsDuration(wf) }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

func workflowStatus(wf *nuonmodels.AppWorkflow) string {
	if wf.Status != nil {
		return string(wf.Status.Status)
	}
	return ""
}

func workflowType(wf *nuonmodels.AppWorkflow) string {
	if wf.Type != "" {
		return string(wf.Type)
	}
	return ""
}

