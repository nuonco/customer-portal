templ auditStackList(runs []nuon.StackRun) {
	if len(runs) == 0 {
		@components.EmptyState(components.EmptyStateProps{Title: "No stack runs", Icon: "ph-stack"})
	} else {
		<table class="w-full text-sm table-fixed">
			<colgroup>
				<col class="w-[35%]"/>
				<col class="w-[25%]"/>
				<col class="w-[40%]"/>
			</colgroup>
			<thead>
				<tr class="border-b border-cool-grey-200 dark:border-dark-grey-600">
					<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">Operation</th>
					<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">Status</th>
					<th class="text-left py-2 font-medium text-cool-grey-500 dark:text-cool-grey-400">Date</th>
				</tr>
			</thead>
			<tbody>
				for _, run := range runs {
					<tr
						class="border-b border-cool-grey-100 dark:border-dark-grey-700 last:border-b-0 cursor-pointer hover:bg-cool-grey-50 dark:hover:bg-dark-grey-700"
						onclick={ templ.ComponentScript{Call: fmt.Sprintf("openStackRunPanel('%s', '%s')", run.ID, stackRunType(run))} }
					>
						<td class="py-2 pr-3 font-medium text-cool-grey-900 dark:text-white truncate" title={ stackRunType(run) }>{ stackRunType(run) }</td>
						<td class="py-2 pr-3">
							<span class={ "px-2 py-0.5 text-xs font-medium rounded-full", auditStatusClass(run.VersionStatus) }>
								{ run.VersionStatus }
							</span>
						</td>
						<td class="py-2 text-cool-grey-600 dark:text-cool-grey-400 whitespace-nowrap">{ FormatAPITime(run.CreatedAt) }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

func stackRunType(run nuon.StackRun) string {
	if run.Data != nil && run.Data.RequestType != "" {
		return run.Data.RequestType
	}
	return "Run"
}

