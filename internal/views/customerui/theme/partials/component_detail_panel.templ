}

// TerraformComponentDetailPanel renders the component detail panel for terraform_module components.
templ TerraformComponentDetailPanel(props TerraformComponentDetailProps) {
	<div class="p-4 space-y-4 component-detail-root">
		@components.Card(components.CardProps{
			Header:      stackCardHeader("Active deploy", componentStatus(props.Component)),
			AccentColor: statusAccentColor(componentStatus(props.Component)),
		}) {
			<div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
				if len(props.Component.InstallDeploys) > 0 {
					@infoRow("Created", FormatAPITime(props.Component.InstallDeploys[0].CreatedAt))
				} else {
					@infoRow("Created", FormatAPITime(props.Component.CreatedAt))
				}
				<div class="space-y-3">
					@infoRow("Repository", props.Info.Repo)
					@infoRow("Directory", props.Info.Directory)
					@infoRow("Git Ref", props.Info.Branch)
				</div>
			</div>
		}
		@componentDetailTabBar([]componentDetailTab{
			{Label: "Outputs", Target: "outputs", Active: true},
			{Label: "Resources", Target: "resources"},
			{Label: "Variables", Target: "variables"},
		})
		<div class="component-sub-pane" data-tab="outputs">
			@componentOutputsPane(props.Outputs)
		</div>
		<div class="component-sub-pane hidden" data-tab="resources">
			@components.ResourceList(components.ResourceListProps{Resources: props.Resources})
		</div>
		<div class="component-sub-pane hidden" data-tab="variables">
			@componentKeyValuePane(props.Variables, "ph-code", "No variables", "No variables are defined for this component.")
		</div>
	</div>
}

// HelmComponentDetailPanel renders the component detail panel for helm_chart components.
templ HelmComponentDetailPanel(props HelmComponentDetailProps) {
	<div class="p-4 space-y-4 component-detail-root">
		@components.Card(components.CardProps{
			Header:      stackCardHeader("Active deploy", componentStatus(props.Component)),
			AccentColor: statusAccentColor(componentStatus(props.Component)),
		}) {
			<div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
				if len(props.Component.InstallDeploys) > 0 {
					@infoRow("Created", FormatAPITime(props.Component.InstallDeploys[0].CreatedAt))
				} else {
					@infoRow("Created", FormatAPITime(props.Component.CreatedAt))
				}
				<div class="space-y-3">
					@infoRow("Chart", props.ChartName)
					@infoRow("Namespace", props.Namespace)
					@infoRow("Repository", props.Info.Repo)
					@infoRow("Git Ref", props.Info.Branch)
				</div>
			</div>
		}
		@componentDetailTabBar([]componentDetailTab{
			{Label: "Outputs", Target: "outputs", Active: true},
			{Label: "Values", Target: "values"},
			{Label: "Values Files", Target: "valuesfiles"},
		})
		<div class="component-sub-pane" data-tab="outputs">
			@componentOutputsPane(props.Outputs)
		</div>
		<div class="component-sub-pane hidden" data-tab="values">
			@componentKeyValuePane(props.Values, "ph-sliders", "No values", "No values are defined for this component.")
		</div>
		<div class="component-sub-pane hidden" data-tab="valuesfiles">
			if len(props.ValuesFiles) > 0 {
				<div class="space-y-4">
					for _, f := range props.ValuesFiles {
						@components.CodeBlock(f, "yaml")
					}
				</div>
			} else {
				<div class="text-center py-12">
					<i class="ph-bold ph-file-code text-[48px] text-cool-grey-400 dark:text-cool-grey-600 mx-auto block"></i>
					<h3 class="mt-4 text-lg font-medium text-cool-grey-900 dark:text-white">No values files</h3>
					<p class="mt-2 text-sm text-cool-grey-600 dark:text-cool-grey-400">No values files are defined for this component.</p>
				</div>
			}
		</div>
	</div>
}

