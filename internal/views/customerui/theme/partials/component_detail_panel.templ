// KubernetesComponentDetailPanel renders the component detail panel for kubernetes_manifest components.
templ KubernetesComponentDetailPanel(props KubernetesComponentDetailProps) {
	<div class="p-4 space-y-4 component-detail-root">
		@components.Card(components.CardProps{
			Header:      stackCardHeader("Active deploy", componentStatus(props.Component)),
			AccentColor: statusAccentColor(componentStatus(props.Component)),
		}) {
			<div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
				if len(props.Component.InstallDeploys) > 0 {
					@infoRow("Created", FormatAPITime(props.Component.InstallDeploys[0].CreatedAt))
				} else {
					@infoRow("Created", FormatAPITime(props.Component.CreatedAt))
				}
				<div class="space-y-3">
					@infoRow("Repository", props.Info.Repo)
					@infoRow("Directory", props.Info.Directory)
					@infoRow("Git Ref", props.Info.Branch)
				</div>
			</div>
		}
		@componentDetailTabBar([]componentDetailTab{
			{Label: "Outputs", Target: "outputs", Active: true},
			{Label: "Manifest", Target: "manifest"},
		})
		<div class="component-sub-pane" data-tab="outputs">
			@componentOutputsPane(props.Outputs)
		</div>
		<div class="component-sub-pane hidden" data-tab="manifest">
			if props.Manifest != "" {
				@components.CodeBlock(props.Manifest, "yaml")
			} else {
				<div class="text-center py-12">
					<i class="ph-bold ph-file-code text-[48px] text-cool-grey-400 dark:text-cool-grey-600 mx-auto block"></i>
					<h3 class="mt-4 text-lg font-medium text-cool-grey-900 dark:text-white">No manifest</h3>
					<p class="mt-2 text-sm text-cool-grey-600 dark:text-cool-grey-400">No manifest is defined for this component.</p>
				</div>
			}
		</div>
	</div>
}

// componentDetailTab describes a single tab button.
type componentDetailTab struct {
	Label  string
	Target string
	Active bool
}

templ componentDetailTabBar(tabs []componentDetailTab) {
	<div class="flex border-b border-cool-grey-200 dark:border-dark-grey-600">
		for _, tab := range tabs {
			<button
				class={ "button button-nav nav-item component-detail-tabs-btn", templ.KV("active", tab.Active) }
				{ templ.Attributes{"onclick": componentTabOnclick(tab.Target)}... }
			>{ tab.Label }</button>
		}
	</div>
}

templ componentOutputsPane(outputs map[string]string) {
	if len(outputs) > 0 {
		<div class="space-y-3">
			for key, val := range outputs {
				<div class="border-b border-cool-grey-100 dark:border-dark-grey-700 last:border-b-0 pb-3 last:pb-0">
					<div class="text-sm font-medium text-cool-grey-900 dark:text-white mb-1">{ key }</div>
					@components.CodeBlock(val, outputLang(val))
				</div>
			}
		</div>
	} else {
		<div class="text-center py-12">
			<i class="ph-bold ph-terminal text-[48px] text-cool-grey-400 dark:text-cool-grey-600 mx-auto block"></i>
			<h3 class="mt-4 text-lg font-medium text-cool-grey-900 dark:text-white">No outputs</h3>
			<p class="mt-2 text-sm text-cool-grey-600 dark:text-cool-grey-400">No outputs are available for this component.</p>
		</div>
	}
}

templ componentKeyValuePane(data map[string]string, icon string, emptyTitle string, emptyMsg string) {
	if len(data) > 0 {
		<div class="divide-y divide-cool-grey-100 dark:divide-dark-grey-700">
			for key, val := range data {
				<div class="grid grid-cols-2 gap-4 py-2 text-sm">
					<span class="font-mono text-cool-grey-700 dark:text-cool-grey-300 truncate">{ key }</span>
					<span class="font-mono text-cool-grey-900 dark:text-white break-all">{ val }</span>
				</div>
			}
		</div>
	} else {
		<div class="text-center py-12">
			<i class={ "ph-bold text-[48px] text-cool-grey-400 dark:text-cool-grey-600 mx-auto block", icon }></i>
			<h3 class="mt-4 text-lg font-medium text-cool-grey-900 dark:text-white">{ emptyTitle }</h3>
			<p class="mt-2 text-sm text-cool-grey-600 dark:text-cool-grey-400">{ emptyMsg }</p>
		</div>
	}
}
