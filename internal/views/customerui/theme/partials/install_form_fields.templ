			<option value="australiaeast">Australia East - australiaeast</option>
			<option value="southeastasia">Southeast Asia - southeastasia</option>
			<option value="eastasia">East Asia - eastasia</option>
			<option value="northeurope">North Europe - northeurope</option>
			<option value="westeurope">West Europe - westeurope</option>
			<option value="swedencentral">Sweden Central - swedencentral</option>
			<option value="uksouth">UK South - uksouth</option>
			<option value="francecentral">France Central - francecentral</option>
			<option value="germanywestcentral">Germany West Central - germanywestcentral</option>
			<option value="italynorth">Italy North - italynorth</option>
			<option value="norwayeast">Norway East - norwayeast</option>
			<option value="polandcentral">Poland Central - polandcentral</option>
			<option value="spaincentral">Spain Central - spaincentral</option>
			<option value="switzerlandnorth">Switzerland North - switzerlandnorth</option>
			<option value="southafricanorth">South Africa North - southafricanorth</option>
			<option value="centralindia">Central India - centralindia</option>
			<option value="japaneast">Japan East - japaneast</option>
			<option value="koreacentral">Korea Central - koreacentral</option>
			<option value="canadacentral">Canada Central - canadacentral</option>
			<option value="mexicocentral">Mexico Central - mexicocentral</option>
			<option value="uaenorth">UAE North - uaenorth</option>
