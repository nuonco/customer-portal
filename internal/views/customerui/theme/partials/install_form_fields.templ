package partials

import (
	"fmt"
	"strings"
)

// isAzurePlatform returns true for any Azure runner type.
func isAzurePlatform(platform string) bool {
	return platform == "azure-aks" || platform == "azure-acs" || platform == "azure"
}

// isGCPPlatform returns true for GCP runner types.
func isGCPPlatform(platform string) bool {
	return platform == "gcp"
}

// InstallFormConfig holds the parsed app config data for rendering form fields
type InstallFormConfig struct {
	Platform        string
	InputGroups     []InstallFormInputGroup
	CollapsedGroups map[string]bool
}

// InstallFormInputGroup represents a group of inputs
type InstallFormInputGroup struct {
	Name        string
	DisplayName string
	Description string
	AppInputs   []InstallFormInput
}

// InstallFormInput represents a single input field
type InstallFormInput struct {
	Name        string
	DisplayName string
	Description string
	Type        string
	Default     string
	Required    bool
	Sensitive   bool
	Index       int
}

// groupID returns a sanitized ID for use in HTML element IDs
func groupID(name string) string {
	if name == "" {
		name = "default"
	}
	result := strings.Map(func(r rune) rune {
		if (r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z') || (r >= '0' && r <= '9') {
			return r
		}
		return '-'
	}, name)
	return "group-" + strings.ToLower(result)
}

// RegionSelector renders the region or location select field based on platform.
// GCP apps do not use a region selector.
templ RegionSelector(platform string) {
	if isAzurePlatform(platform) {
		<select id="azureLocation" name="location" required class="field-input">
			<option value="eastus">East US - eastus</option>
			<option value="eastus2">East US 2 - eastus2</option>
			<option value="southcentralus">South Central US - southcentralus</option>
			<option value="westus2">West US 2 - westus2</option>
			<option value="westus3">West US 3 - westus3</option>
			<option value="centralus">Central US - centralus</option>
			<option value="australiaeast">Australia East - australiaeast</option>
			<option value="southeastasia">Southeast Asia - southeastasia</option>
			<option value="eastasia">East Asia - eastasia</option>
			<option value="northeurope">North Europe - northeurope</option>
			<option value="westeurope">West Europe - westeurope</option>
			<option value="swedencentral">Sweden Central - swedencentral</option>
			<option value="uksouth">UK South - uksouth</option>
			<option value="francecentral">France Central - francecentral</option>
			<option value="germanywestcentral">Germany West Central - germanywestcentral</option>
			<option value="italynorth">Italy North - italynorth</option>
			<option value="norwayeast">Norway East - norwayeast</option>
			<option value="polandcentral">Poland Central - polandcentral</option>
			<option value="spaincentral">Spain Central - spaincentral</option>
			<option value="switzerlandnorth">Switzerland North - switzerlandnorth</option>
			<option value="southafricanorth">South Africa North - southafricanorth</option>
			<option value="centralindia">Central India - centralindia</option>
			<option value="japaneast">Japan East - japaneast</option>
			<option value="koreacentral">Korea Central - koreacentral</option>
			<option value="canadacentral">Canada Central - canadacentral</option>
			<option value="mexicocentral">Mexico Central - mexicocentral</option>
			<option value="uaenorth">UAE North - uaenorth</option>
			<option value="brazilsouth">Brazil South - brazilsouth</option>
			<option value="israelcentral">Israel Central - israelcentral</option>
			<option value="qatarcentral">Qatar Central - qatarcentral</option>
		</select>
	} else if !isGCPPlatform(platform) {
		<select id="awsRegion" name="region" required class="field-input">
			<option value="us-east-1">US East (N. Virginia) - us-east-1</option>
			<option value="us-east-2">US East (Ohio) - us-east-2</option>
			<option value="us-west-1">US West (N. California) - us-west-1</option>
			<option value="us-west-2">US West (Oregon) - us-west-2</option>
			<option value="af-south-1">Africa (Cape Town) - af-south-1</option>
			<option value="ap-east-1">Asia Pacific (Hong Kong) - ap-east-1</option>
			<option value="ap-south-1">Asia Pacific (Mumbai) - ap-south-1</option>
			<option value="ap-south-2">Asia Pacific (Hyderabad) - ap-south-2</option>
			<option value="ap-southeast-1">Asia Pacific (Singapore) - ap-southeast-1</option>
			<option value="ap-southeast-2">Asia Pacific (Sydney) - ap-southeast-2</option>
			<option value="ap-southeast-3">Asia Pacific (Jakarta) - ap-southeast-3</option>
			<option value="ap-southeast-4">Asia Pacific (Melbourne) - ap-southeast-4</option>
			<option value="ap-northeast-1">Asia Pacific (Tokyo) - ap-northeast-1</option>
			<option value="ap-northeast-2">Asia Pacific (Seoul) - ap-northeast-2</option>
			<option value="ap-northeast-3">Asia Pacific (Osaka) - ap-northeast-3</option>
			<option value="ca-central-1">Canada (Central) - ca-central-1</option>
			<option value="ca-west-1">Canada (Calgary) - ca-west-1</option>
			<option value="eu-central-1">Europe (Frankfurt) - eu-central-1</option>
			<option value="eu-central-2">Europe (Zurich) - eu-central-2</option>
			<option value="eu-west-1">Europe (Ireland) - eu-west-1</option>
			<option value="eu-west-2">Europe (London) - eu-west-2</option>
			<option value="eu-west-3">Europe (Paris) - eu-west-3</option>
			<option value="eu-south-1">Europe (Milan) - eu-south-1</option>
			<option value="eu-south-2">Europe (Spain) - eu-south-2</option>
			<option value="eu-north-1">Europe (Stockholm) - eu-north-1</option>
			<option value="il-central-1">Israel (Tel Aviv) - il-central-1</option>
