package partials

import (
	"fmt"
	"strings"
	"time"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/components"
	nuonmodels "github.com/nuonco/nuon-go/models"
)

// ProvisionPhase represents a logical grouping of workflow steps
type ProvisionPhase struct {
	Name           string
	Status         string // "not_started", "in_progress", "completed", "failed"
	Steps          []PhaseStep
	ActiveStepName string // name of in-progress step within this phase
	StepProgress   string // e.g. "Step 2 of 3"
}

// PhaseStep represents a single step within a provision phase
type PhaseStep struct {
	Name      string
	Status    string
	ID        string // step ID for retry endpoint
	Retryable bool
}

// WorkflowDataPanel represents workflow data for the panel (avoids import cycle)
type WorkflowDataPanel struct {
	ID                       string
	Name                     string
	Status                   string
	StatusClass              string
	CreatedAt                time.Time
	FinishedAt               time.Time
	CanApprove               bool
	CanApproveAll            bool
	CanCancel                bool
	HasApprovalSteps         bool
	ApproveDisabledReason    string
	ApproveAllDisabledReason string
	CancelDisabledReason     string
	ApprovalStep             *ApprovalStepDataPanel
	CurrentStepName          string // Name of the currently executing step
	CurrentStepStatus        string // Status of the current step (in-progress, approval-awaiting)
	CurrentStepType          string // Type of current step: "pending", "in-progress", "approval-awaiting", or "initializing"
	CurrentStepNumber        int    // 1-indexed position of current step (1, 2, 3...)
	TotalSteps               int    // Total number of steps in workflow
	FailedStepID             string // ID of the failed step (for retry)
	FailedStepName           string // Name of the failed step (for display)
	FailedStepRetryable      bool   // Whether the failed step can be retried
	CurrentStepRole          string              // IAM role used by the current step target
	IsReprovision            bool                // Whether this is a reprovision workflow
	DenyViolations           []PolicyViolation   // Policy deny violations for current step
	WarnViolations           []PolicyViolation   // Policy warn violations for current step
	HasPolicyData            bool                // Whether the current step has any policy evaluation data
	DisablePolling           bool                // When true, disables HTMX polling (e.g. secondary panel views)
}

// PolicyViolation represents a single policy evaluation violation.
type PolicyViolation struct {
	PolicyID string
	Message  string
	Severity string // "deny" or "warn"
}

// ApprovalStepDataPanel for workflow approval steps
type ApprovalStepDataPanel struct {
	StepID     string
	ApprovalID string
}

func policyPluralize(count int, singular, plural string) string {
	if count == 1 {
		return singular
	}
	return plural
}

func policyViolationMsg(v PolicyViolation) string {
	if v.Message != "" {
		return v.Message
	}
	return "Policy check failed"
}

// platformFromRegion determines cloud platform from a region string
func isTerminalWorkflowStatus(status string) bool {
	return status == "completed" || status == "success" || status == "error" || status == "cancelled"
}

func platformFromRegion(region string) string {
	if strings.Contains(region, "us-") || strings.Contains(region, "eu-") || strings.Contains(region, "ap-") {
		return "aws"
	} else if strings.Contains(region, "eastus") || strings.Contains(region, "westus") || strings.Contains(region, "northeurope") {
		return "azure"
	} else if strings.Contains(region, "us-central") || strings.Contains(region, "us-east") || strings.Contains(region, "europe-") {
		return "gcp"
	}
	return "unknown"
}

// platformLabel returns a display label for a platform string
func platformLabel(platform string) string {
	switch platform {
	case "aws":
		return "AWS"
	case "azure":
		return "Azure"
	case "gcp":
		return "GCP"
	default:
		return "Cloud"
	}
}

// StackSetupData carries platform-specific data for the "await install stack" step.
type StackSetupData struct {
	Platform           string // "aws", "gcp", etc.
	CloudFormationLink string // AWS only
	TfvarsContent      string // GCP only
	NuonInstallID      string // GCP only (for backend snippet)
}

// ComponentInfo holds display data for a component card on the overview.
type ComponentInfo struct {
	Name       string
	Type       string
	Status     string
	Repo       string
	Directory  string
	Branch     string
	RepoPublic bool
}

// InputFieldRow holds display data for a single configured input field.
type InputFieldRow struct {
	Name        string
	DisplayName string
	Value       string
	Sensitive   bool
}

// InstallDetailPanelProps for the panel content (no layout wrapper)
type InstallDetailPanelProps struct {
	Install                *models.Install
	AppName                string // Fetched from Nuon API at runtime
	AppLogoLightBase64     string
	AppLogoDarkBase64      string
	APIDeletedError        bool
	BasePath               string
	PrimaryColor           string
	AppConfigVersion       int64
	AppConfigUpdatedAt     string
	InstallConfigVersion   int64
	InstallConfigUpdatedAt string
	// Overview summary card data
	StackStatus    string
	StackRegion    string
	StackAccountID string
	SandboxStatus     string
	SandboxRepo       string
	SandboxBranch     string
	SandboxRepoPublic bool
	Components     []ComponentInfo
	NuonAPIError   string // Error message when API calls fail
	RecentWorkflows []*nuonmodels.AppWorkflow
	InputFields     []InputFieldRow
}

// InstallDetailPanel renders just the install detail content for the sliding panel
templ InstallDetailPanel(props InstallDetailPanelProps) {
	<div>
		<!-- API Deletion Warning Banner -->
		if props.APIDeletedError {
			<div class="alert-warning mb-4">
				<div class="flex items-start">
					<div class="flex-shrink-0 mr-3 text-amber-500">
						<i class="ph-bold ph-warning text-xl"></i>
					</div>
					<div class="flex-1">
						<h3 class="text-sm font-medium text-amber-800 dark:text-amber-300 mb-1">Install Deleted from API</h3>
						<p class="text-sm text-amber-700 dark:text-amber-400 mb-3">
							This install was deleted from the Nuon control plane but still exists in your local portal.
							You are viewing cached data only. Live features (health checks, workflows, updates) are unavailable.
						</p>
						<p class="text-sm text-amber-700 dark:text-amber-400 mb-3">
							<strong>Action required:</strong> Contact your vendor to remove this install from the portal.
						</p>
					</div>
				</div>
			</div>
		}
		if !props.APIDeletedError {
			@overviewSummaryCards(props)
		}
		<!-- Overview Tabs -->
		<div class="flex border-b border-cool-grey-200 dark:border-dark-grey-600 mt-4 mb-4" id="overview-tabs">
			<button
				class="button button-nav nav-item active"
				data-subtab="updates"
				onclick="switchOverviewTab('updates')"
			>History</button>
			<button
				class="button button-nav nav-item"
				data-subtab="configuration"
				onclick="switchOverviewTab('configuration')"
			>Inputs</button>
		</div>
		<script>
			function switchOverviewTab(tab) {
				document.querySelectorAll('#overview-tabs [data-subtab]').forEach(function(btn) {
					btn.classList.toggle('active', btn.getAttribute('data-subtab') === tab);
				});
				document.getElementById('overview-tab-updates').classList.toggle('hidden', tab !== 'updates');
				document.getElementById('overview-tab-configuration').classList.toggle('hidden', tab !== 'configuration');
			}
		</script>
		<!-- Updates tab -->
		<div id="overview-tab-updates">
			@allWorkflowsList(props.RecentWorkflows)
		</div>
		<!-- Configuration tab -->
		<div id="overview-tab-configuration" class="hidden">
			@overviewConfigurationTab(props.InputFields)
		</div>
	</div>
	<!-- Config data for JavaScript -->
	<div
		id="install-detail-config"
		class="hidden"
		data-base-path={ props.BasePath }
		data-install-id={ props.Install.ID }
		data-install-name={ props.Install.Name }
		data-nuon-install-id={ props.Install.NuonInstallID }
	></div>
	<!-- JavaScript for actions -->
	@installDetailPanelScripts()
}

// overviewConfigurationTab renders the Configuration tab content showing current input values.
templ overviewConfigurationTab(fields []InputFieldRow) {
	if len(fields) == 0 {
		@components.EmptyState(components.EmptyStateProps{
			Title:   "No inputs",
			Icon:    "ph-list-checks",
		})
	} else {
		<table class="w-full text-sm table-fixed">
			<colgroup>
				<col class="w-[40%]"/>
				<col class="w-[60%]"/>
			</colgroup>
			<thead>
				<tr class="border-b border-cool-grey-200 dark:border-dark-grey-600">
					<th class="text-left py-2 pr-3 font-medium text-cool-grey-500 dark:text-cool-grey-400">Field</th>
					<th class="text-left py-2 font-medium text-cool-grey-500 dark:text-cool-grey-400">Value</th>
				</tr>
			</thead>
			<tbody>
				for _, f := range fields {
					<tr class="border-b border-cool-grey-100 dark:border-dark-grey-700 last:border-b-0">
						<td class="py-2 pr-3 font-medium text-cool-grey-900 dark:text-white truncate">
							if f.DisplayName != "" {
								{ f.DisplayName }
							} else {
								{ f.Name }
							}
						</td>
						<td class="py-2 text-cool-grey-600 dark:text-cool-grey-300 font-mono text-xs break-all">
							if f.Sensitive {
								<span class="tracking-widest">••••••••</span>
							} else if f.Value == "" {
								<span class="text-cool-grey-400 dark:text-cool-grey-500 italic not-italic font-sans text-sm">not set</span>
							} else {
								{ f.Value }
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// componentStatusDot returns a Tailwind color class for a status indicator dot.
type statusCount struct {
	Status string
	Count  int
}

func componentStatusCounts(components []ComponentInfo) []statusCount {
	counts := make(map[string]int)
	for _, c := range components {
		s := c.Status
		if s == "" {
			s = "unknown"
		}
		counts[s]++
	}
	// Priority order: errors first, then active, then in-progress, then pending, then rest
	priority := []string{"failed", "error", "active", "succeeded", "success", "completed", "in-progress", "running", "deploying", "pending", "queued"}
	var result []statusCount
	seen := make(map[string]bool)
	for _, s := range priority {
		if n, ok := counts[s]; ok {
			result = append(result, statusCount{Status: s, Count: n})
			seen[s] = true
		}
	}
	for s, n := range counts {
		if !seen[s] {
			result = append(result, statusCount{Status: s, Count: n})
		}
	}
	return result
}

func componentsAccentColor(components []ComponentInfo) string {
	if len(components) == 0 {
		return "#9ca3af"
	}
	hasError := false
	allActive := true
	for _, c := range components {
		switch c.Status {
		case "failed", "error":
			hasError = true
		case "active", "succeeded", "success", "completed":
			// ok
		default:
			allActive = false
		}
	}
	if hasError {
		return "#dc2626"
	}
	if allActive {
		return "#16a34a"
	}
	return "#9ca3af"
}

func componentStatusDot(status string) string {
	switch status {
	case "active", "succeeded", "success", "completed":
		return "bg-green-500"
	case "failed", "error":
		return "bg-red-500"
	case "in-progress", "running", "deploying":
		return "bg-blue-500"
	case "pending", "queued":
		return "bg-yellow-500"
	default:
		return "bg-cool-grey-400"
	}
}

templ overviewCardDetailsLink(href string) {
	<a href={ templ.SafeURL(href) } class="inline-flex items-center gap-0.5 text-xs font-medium text-theme-primary hover:underline ml-auto flex-shrink-0">
		Details
		<i class="ph-bold ph-caret-right text-[10px]"></i>
	</a>
}

templ overviewStackCardHeader(status, href string) {
	<div class="flex items-center gap-2">
		<i class="ph-bold ph-stack text-lg text-cool-grey-500 dark:text-cool-grey-400"></i>
		<h4 class="text-base text-cool-grey-900 dark:text-white">Stack</h4>
		if status != "" {
			<span class={ "px-2 py-0.5 text-xs font-medium rounded-full", auditStatusClass(status) }>
				{ status }
			</span>
		}
		@overviewCardDetailsLink(href)
	</div>
}

templ overviewSandboxCardHeader(status, href string) {
	<div class="flex items-center gap-2">
		<i class="ph-bold ph-shipping-container text-lg text-cool-grey-500 dark:text-cool-grey-400"></i>
		<h4 class="text-base text-cool-grey-900 dark:text-white">Sandbox</h4>
		if status != "" {
			<span class={ "px-2 py-0.5 text-xs font-medium rounded-full", auditStatusClass(status) }>
				{ status }
			</span>
		}
		@overviewCardDetailsLink(href)
	</div>
}

templ overviewComponentsCardHeader(components []ComponentInfo, href string) {
	<div class="flex items-center gap-2">
		<i class="ph-bold ph-cards text-lg text-cool-grey-500 dark:text-cool-grey-400"></i>
		<h4 class="text-base text-cool-grey-900 dark:text-white">Components</h4>
		for _, sc := range componentStatusCounts(components) {
			<span class={ "px-2 py-0.5 text-xs font-medium rounded-full", auditStatusClass(sc.Status) }>
				{ fmt.Sprintf("%d %s", sc.Count, sc.Status) }
			</span>
		}
		@overviewCardDetailsLink(href)
	</div>
}

func overviewRepoURL(repo string) string {
	if strings.HasPrefix(repo, "https://") || strings.HasPrefix(repo, "http://") {
		return repo
	}
	if strings.Contains(repo, "/") && !strings.Contains(repo, ".") {
		return "https://github.com/" + repo
	}
	return "https://" + repo
}

templ overviewInfoRow(label, value string) {
	<div>
		<span class="text-cool-grey-500 dark:text-cool-grey-400">{ label }</span>
		<p class="font-medium text-cool-grey-800 dark:text-cool-grey-200">{ value }</p>
	</div>
}

templ overviewInfoRowLink(label, value, href string) {
	<div>
		<span class="text-cool-grey-500 dark:text-cool-grey-400">{ label }</span>
		<p class="font-medium">
			<a href={ templ.SafeURL(href) } target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-theme-primary hover:underline">
				{ value }
				<i class="ph-bold ph-arrow-square-out text-xs"></i>
			</a>
		</p>
	</div>
}

templ overviewSummaryCards(props InstallDetailPanelProps) {
	<div class="space-y-4">
		<!-- Stack + Sandbox row -->
		<div class="grid grid-cols-2 gap-4">
			@components.Card(components.CardProps{Header: overviewStackCardHeader(props.StackStatus, props.BasePath+"/installs/"+props.Install.ID+"/stack"), AccentColor: statusAccentColor(props.StackStatus)}) {
				if props.StackAccountID != "" || props.StackRegion != "" {
					<div class="space-y-3 text-sm">
						if props.StackAccountID != "" {
							@overviewInfoRowLink("Account ID", props.StackAccountID, "https://console.aws.amazon.com/console/home")
						}
						if props.StackRegion != "" {
							@overviewInfoRowLink("Region", props.StackRegion, "https://console.aws.amazon.com/console/home?region="+props.StackRegion)
						}
					</div>
				} else {
					@components.EmptyState(components.EmptyStateProps{
						Title:   "No stack data",
						Icon:    "ph-stack",
						Compact: true,
					})
				}
			}
			@components.Card(components.CardProps{Header: overviewSandboxCardHeader(props.SandboxStatus, props.BasePath+"/installs/"+props.Install.ID+"/sandbox"), AccentColor: statusAccentColor(props.SandboxStatus)}) {
				if props.SandboxRepo != "" || props.SandboxBranch != "" {
					<div class="space-y-3 text-sm">
						if props.SandboxRepo != "" {
							if props.SandboxRepoPublic {
								@overviewInfoRowLink("Repo", props.SandboxRepo, overviewRepoURL(props.SandboxRepo))
							} else {
								@overviewInfoRow("Repo", props.SandboxRepo)
							}
						}
						if props.SandboxBranch != "" {
							if props.SandboxRepoPublic {
								@overviewInfoRowLink("Git Ref", props.SandboxBranch, overviewRepoURL(props.SandboxRepo)+"/tree/"+props.SandboxBranch)
							} else {
								@overviewInfoRow("Git Ref", props.SandboxBranch)
							}
						}
					</div>
				} else {
					@components.EmptyState(components.EmptyStateProps{
						Title:   "No sandbox data",
						Icon:    "ph-shipping-container",
						Compact: true,
					})
				}
			}
		</div>
		<!-- Components card -->
		@components.Card(components.CardProps{Header: overviewComponentsCardHeader(props.Components, props.BasePath+"/installs/"+props.Install.ID+"/components"), AccentColor: componentsAccentColor(props.Components)}) {
			if len(props.Components) > 0 {
				<div class="flex flex-wrap gap-2">
					for _, comp := range props.Components {
						<div class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-md bg-cool-grey-50 dark:bg-dark-grey-700 text-xs">
							<span class={ "w-1.5 h-1.5 rounded-full flex-shrink-0", componentStatusDot(comp.Status) }></span>
							@auditComponentTypeIcon(comp.Type)
							<span class="font-medium text-cool-grey-700 dark:text-cool-grey-300">{ comp.Name }</span>
						</div>
					}
				</div>
			} else {
				@components.EmptyState(components.EmptyStateProps{
					Title:   "No components",
					Icon:    "ph-cards",
					Compact: true,
				})
			}
		}
	</div>
}

// overviewPlatformChip renders a platform logo inline (avoids import cycle with components)
templ overviewPlatformChip(platform string) {
	switch platform {
	case "aws":
		<img src="/static/images/logos/aws.svg" class="platform-logo dark:hidden" alt="AWS"/>
		<img src="/static/images/logos/aws.svg" class="platform-logo hidden dark:block dark:invert" alt="AWS"/>
	case "azure":
		<img src="/static/images/logos/azure.svg" class="platform-logo" alt="Azure"/>
	case "gcp":
		<img src="/static/images/logos/google.svg" class="platform-logo" alt="GCP"/>
	default:
		<i class="ph-bold ph-cloud platform-logo text-cool-grey-400 dark:text-cool-grey-500"></i>
	}
}

// platformCard renders the platform information card
templ platformCard(platform string, region string) {
	<div class="card-base">
		<h3 class="text-lg font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-3">Platform</h3>
		<div class="space-y-3 text-sm">
			<div>
				<span class="text-cool-grey-500 dark:text-cool-grey-400">Name</span>
				<p class="font-medium text-cool-grey-800 dark:text-cool-grey-200">{ platformLabel(platform) }</p>
			</div>
			if region != "" {
				<div>
					<span class="text-cool-grey-500 dark:text-cool-grey-400">Region</span>
					<p class="font-medium text-cool-grey-800 dark:text-cool-grey-200">{ region }</p>
				</div>
			}
		</div>
	</div>
}

// ProvisionAccordion renders the phased provision progress view
templ ProvisionAccordion(phases []ProvisionPhase, workflow *WorkflowDataPanel, stackSetup StackSetupData, installID string, basePath string, primaryColor string) {
	<div
		id="active-provision-banner"
		class="@container"
		if workflow != nil {
			data-workflow-status={ workflow.Status }
		}
	>
		<div class="flex flex-col @5xl:flex-row gap-4">
		<div class="@5xl:w-1/2">
		<div id="step-detail-card">
		<!-- Status card: exactly one renders (failed > CF > GCP > initializing > current step) -->
		if workflow != nil && workflow.Status == "error" && workflow.FailedStepID != "" {
			<div class="card-base !p-0 mb-3" style="border-top: 2px solid #ef4444">
				<!-- Header -->
				<div class="flex items-center justify-between px-4 py-3" style="border-bottom: 1px solid var(--theme-border-subtle)">
					<h4 class="text-sm font-medium text-red-700 dark:text-red-400">Failed Step</h4>
				</div>
				<!-- Body -->
				<div class="px-4 py-3">
					<p class="text-xs text-[var(--theme-text-muted)]">Step name</p>
					<p class="text-sm font-medium mt-1">{ workflow.FailedStepName }</p>
				</div>
				<!-- Footer -->
				<div class="flex items-center justify-between px-4 py-3" style="border-top: 1px solid var(--theme-border-subtle)">
					if workflow.FailedStepRetryable {
						<p class="text-xs text-[var(--theme-text-muted)]">You can retry this step.</p>
						<button
							type="button"
							class="button button-danger inline-flex items-center gap-2 text-sm font-medium rounded px-3 py-1.5"
							style="background-color: #ef4444; border: 1px solid #dc2626"
							data-endpoint={ basePath + "/installs/" + installID + "/workflows/" + workflow.ID + "/step/" + workflow.FailedStepID + "/retry" }
							onclick="retryFailedStep(this)"
						>
							Retry Step
							<i class="ph-bold ph-arrow-clockwise text-base"></i>
						</button>
					} else {
						<p class="text-xs text-red-600 dark:text-red-300">This step cannot be retried. Please reprovision the install.</p>
						<button
							type="button"
							class="button button-danger inline-flex items-center gap-2 text-sm font-medium rounded px-3 py-1.5"
							style="background-color: #ef4444; border: 1px solid #dc2626"
							onclick="confirmReprovision()"
						>
							Reprovision
							<i class="ph-bold ph-arrow-clockwise text-base"></i>
						</button>
					}
				</div>
			</div>
		} else if stackSetup.CloudFormationLink != "" {
			<div class="card-base !p-0 mb-3" style="border-top: 2px solid var(--theme-primary)">
				<!-- Header -->
				<div class="flex items-center justify-between px-4 py-3" style="border-bottom: 1px solid var(--theme-border-subtle)">
					<h4 class="text-sm font-medium" style="color: var(--theme-primary)">AWS CloudFormation</h4>
				</div>
				<!-- Body -->
				<div class="px-4 py-3">
					<p class="text-xs text-[var(--theme-text-muted)]">Status</p>
					<p class="text-sm font-medium mt-1">Complete setup in AWS Console</p>
				</div>
				<!-- Footer -->
				<div class="flex items-center justify-end gap-2 px-4 py-3" style="border-top: 1px solid var(--theme-border-subtle)">
					if workflow != nil && workflow.CanCancel {
						<button
							type="button"
							class="button button-neutral workflow-cancel-btn btn-theme-outline text-sm"
							data-endpoint={ basePath + "/installs/" + installID + "/workflows/" + workflow.ID + "/cancel" }
							data-workflow-name={ workflow.Name }
						>
							Cancel
						</button>
					}
					<a
						href={ templ.SafeURL(stackSetup.CloudFormationLink) }
						target="_blank"
						rel="noopener noreferrer"
						class="button button-primary btn-theme-primary inline-flex items-center gap-2 text-sm"
					>
						Open in AWS
						<i class="ph-bold ph-arrow-square-out text-base"></i>
					</a>
				</div>
			</div>
		} else if stackSetup.Platform == "gcp" {
			@gcpStackSetup(stackSetup, workflow, installID, basePath)
		} else if workflow != nil && workflow.CurrentStepType == "initializing" {
			<div class="card-base !p-0 mb-3" style="border-top: 2px solid var(--theme-primary)">
				<div class="flex items-center gap-3 px-4 py-3">
					<i class="ph-bold ph-circle-notch animate-spin text-base" style="color: var(--theme-primary)"></i>
					<div>
						<h4 class="text-sm font-medium">{ workflow.CurrentStepName }</h4>
						<p class="text-xs text-[var(--theme-text-muted)] mt-0.5">Your install is being set up. This may take a moment.</p>
					</div>
				</div>
			</div>
		} else if workflow != nil && (workflow.HasApprovalSteps || workflow.CanCancel) {
			<div class="card-base !p-0 mb-3" style="border-top: 2px solid var(--theme-primary)">
				<!-- Header -->
				<div class="flex items-center justify-between px-4 py-3" style="border-bottom: 1px solid var(--theme-border-subtle)">
					<div class="flex items-center gap-2">
						<h4 class="text-sm font-medium" style="color: var(--theme-primary)">{ workflow.CurrentStepName }</h4>
						if workflow.CurrentStepRole != "" {
							<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400">
								<i class="ph-bold ph-shield-check text-xs"></i>
								{ workflow.CurrentStepRole }
							</span>
						}
					</div>
					if workflow.CurrentStepType == "approval-awaiting" {
						<span class="badge-warning text-xs px-2 py-0.5 rounded-full">Awaiting Approval</span>
					} else if workflow.CurrentStepType == "in-progress" {
						<span class="badge-info inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full">
							<i class="ph-bold ph-circle-notch animate-spin text-xs"></i>
							In Progress
						</span>
					} else if workflow.CurrentStepType == "error" {
						<span class="badge-error text-xs px-2 py-0.5 rounded-full">Failed</span>
					} else {
						<span class="badge-neutral text-xs px-2 py-0.5 rounded-full">Pending</span>
					}
				</div>
				<!-- Body -->
				<div class="px-4 py-3" style="border-bottom: 1px solid var(--theme-border-subtle)">
					if workflow.CurrentStepType == "approval-awaiting" {
						<p class="text-sm mt-1">This step requires your approval to continue.</p>
					} else if workflow.CurrentStepType == "in-progress" {
						<p class="text-sm mt-1">This step is currently running.</p>
					} else {
						<p class="text-sm mt-1">Waiting to start.</p>
					}
				</div>
				<!-- Policy Reports -->
				if workflow.HasPolicyData {
					<div style="border-bottom: 1px solid var(--theme-border-subtle)">
						<div class="flex items-center justify-between px-4 py-3">
							<span class="text-sm font-medium" style="color: var(--theme-text)">Policy Reports</span>
							<div class="flex items-center gap-2">
								if len(workflow.DenyViolations) > 0 {
									<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400">
										<i class="ph-bold ph-x-circle text-xs"></i>
										{ fmt.Sprintf("%d", len(workflow.DenyViolations)) } { policyPluralize(len(workflow.DenyViolations), "Deny", "Denies") }
									</span>
								}
								if len(workflow.WarnViolations) > 0 {
									<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400">
										<i class="ph-bold ph-warning text-xs"></i>
										{ fmt.Sprintf("%d", len(workflow.WarnViolations)) } { policyPluralize(len(workflow.WarnViolations), "Warning", "Warnings") }
									</span>
								}
								if len(workflow.DenyViolations) == 0 && len(workflow.WarnViolations) == 0 {
									<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400">
										<i class="ph-bold ph-check-circle text-xs"></i>
										Passed
									</span>
								}
							</div>
						</div>
						if len(workflow.DenyViolations) > 0 {
							<details class="group policy-eval-details" data-policy-section="deny" style="border-top: 1px solid var(--theme-border-subtle)">
								<summary class="flex items-center gap-2 px-4 py-2.5 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
									<i class="ph-bold ph-caret-right text-xs transition-transform group-open:rotate-90" style="color: var(--theme-text-muted)"></i>
									<i class="ph-bold ph-x-circle text-sm text-red-600 dark:text-red-500"></i>
									<span class="text-sm font-medium" style="color: var(--theme-text)">
										{ fmt.Sprintf("%d", len(workflow.DenyViolations)) } Policy { policyPluralize(len(workflow.DenyViolations), "Violation", "Violations") }
									</span>
								</summary>
								<ul class="px-4 pb-3 space-y-1.5">
									for _, v := range workflow.DenyViolations {
										<li class="flex items-start gap-2 text-red-700 dark:text-red-400">
											<i class="ph-bold ph-caret-right text-xs mt-1 shrink-0"></i>
											<span class="text-xs">{ policyViolationMsg(v) }</span>
										</li>
									}
								</ul>
							</details>
						}
						if len(workflow.WarnViolations) > 0 {
							<details class="group policy-eval-details" data-policy-section="warn" style="border-top: 1px solid var(--theme-border-subtle)">
								<summary class="flex items-center gap-2 px-4 py-2.5 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
									<i class="ph-bold ph-caret-right text-xs transition-transform group-open:rotate-90" style="color: var(--theme-text-muted)"></i>
									<i class="ph-bold ph-warning text-sm text-orange-600 dark:text-orange-500"></i>
									<span class="text-sm font-medium" style="color: var(--theme-text)">
										{ fmt.Sprintf("%d", len(workflow.WarnViolations)) } Policy { policyPluralize(len(workflow.WarnViolations), "Warning", "Warnings") }
									</span>
								</summary>
								<ul class="px-4 pb-3 space-y-1.5">
									for _, v := range workflow.WarnViolations {
										<li class="flex items-start gap-2 text-orange-700 dark:text-orange-400">
											<i class="ph-bold ph-caret-right text-xs mt-1 shrink-0"></i>
											<span class="text-xs">{ policyViolationMsg(v) }</span>
										</li>
									}
								</ul>
							</details>
						}
					</div>
				}
				<!-- Footer -->
				<div class="flex items-center justify-end gap-2 px-4 py-3">
					if workflow.HasApprovalSteps && workflow.CanApproveAll {
						<button
							type="button"
							class="button button-primary workflow-approve-all-btn btn-theme-primary inline-flex items-center gap-2 text-sm px-3 py-1.5"
							data-endpoint={ basePath + "/installs/" + installID + "/workflows/" + workflow.ID + "/approve-all" }
						>
							Approve
						</button>
					}
					if workflow.CanCancel {
						<button
							type="button"
							class="button button-neutral workflow-cancel-btn btn-theme-outline text-sm"
							data-endpoint={ basePath + "/installs/" + installID + "/workflows/" + workflow.ID + "/cancel" }
							data-workflow-name={ workflow.Name }
						>
							Cancel
						</button>
					}
				</div>
			</div>
		} else if workflow != nil && isTerminalWorkflowStatus(workflow.Status) {
			<div class="card-base !p-0 mb-3" style="border-top: 2px solid var(--theme-primary)">
				<div class="flex items-center justify-between px-4 py-3">
					<h4 class="text-sm font-medium" style="color: var(--theme-primary)">{ workflow.Name }</h4>
					if workflow.Status == "completed" || workflow.Status == "success" {
						<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400">
							<i class="ph-bold ph-check-circle text-xs"></i>
							Completed
						</span>
					} else if workflow.Status == "cancelled" {
						<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-cool-grey-100 text-cool-grey-700 dark:bg-cool-grey-800 dark:text-cool-grey-300">
							Cancelled
						</span>
					}
				</div>
			</div>
		}
		</div>
		</div>
		<div class="@5xl:w-1/2">
		<div
			id="provision-phases"
			class="space-y-2 provision-accordion"
			if workflow != nil && !workflow.DisablePolling && !isTerminalWorkflowStatus(workflow.Status) {
				hx-get={ basePath + "/installs/" + installID + "/panel/workflow/" + workflow.ID }
				hx-trigger="every 5s"
				hx-select="#provision-phases"
				hx-target="this"
				hx-ext="morph"
				hx-swap="morph:outerHTML"
			}
		>
			for i, phase := range phases {
				@provisionPhaseAccordion(phase, i+1) {
					<div class="space-y-1">
						if len(phase.Steps) == 0 {
							<div class="flex items-center gap-2 py-1 text-sm">
								<i class="ph-bold ph-circle text-cool-grey-300 dark:text-cool-grey-600 text-sm"></i>
								<span class="text-cool-grey-500 dark:text-cool-grey-400 italic">Waiting to start</span>
							</div>
						}
						for _, step := range phase.Steps {
							<div
								class="flex items-center gap-2 py-1 text-sm cursor-pointer hover:bg-cool-grey-50 dark:hover:bg-dark-grey-700 rounded px-1 -mx-1"
								if workflow != nil {
									data-step-url={ basePath + "/installs/" + installID + "/panel/workflow/" + workflow.ID + "/step/" + step.ID }
									onclick="loadStepDetail(this.getAttribute('data-step-url'), this)"
								}
							>
								switch step.Status {
								case "completed", "success", "approved":
									<i class="ph-bold ph-check-circle text-green-500 dark:text-green-400 text-sm"></i>
								case "in-progress":
									<i class="ph-bold ph-circle-notch animate-spin text-blue-500 dark:text-blue-400 text-sm"></i>
								case "approval-awaiting":
									<i class="ph-bold ph-clock text-amber-500 dark:text-amber-400 text-sm"></i>
								case "error":
									<i class="ph-bold ph-x-circle text-red-500 dark:text-red-400 text-sm"></i>
								default:
									<i class="ph-bold ph-circle text-cool-grey-300 dark:text-cool-grey-600 text-sm"></i>
								}
								<span class={
									"text-cool-grey-700 dark:text-cool-grey-300",
									templ.KV("font-medium", step.Status == "in-progress" || step.Status == "approval-awaiting"),
								}>{ step.Name }</span>
							</div>
						}
					</div>
				}
			}
		</div>
		</div>
		</div>
		<!-- Open active/failed phase on first load; one-at-a-time toggle -->
		<script>
		(function(){
			window.loadStepDetail = function(url, clickedEl) {
				// Update selected state
				var container = clickedEl ? clickedEl.closest('.provision-accordion') : document.querySelector('.provision-accordion');
				if (container) {
					container.querySelectorAll('[data-step-url]').forEach(function(el) {
						el.classList.remove('step-selected');
					});
				}
				if (clickedEl) {
					clickedEl.classList.add('step-selected');
				}
				var target = document.querySelector('#secondary-panel-content #step-detail-card')
					|| document.getElementById('step-detail-card');
				if (!target) return;
				fetch(url)
					.then(function(resp) { return resp.text(); })
					.then(function(html) { target.innerHTML = html; })
					.catch(function() { target.innerHTML = '<p class="text-sm text-red-500 p-4">Failed to load step details.</p>'; });
			};

			// Preserve <details> open state across idiomorph morph swaps
			if(!window._apsMorphBound){
				window._apsMorphBound = true;
				var _apsOpenPhases = [];
				var _apsPhaseStatuses = {};
				var _apsOpenPolicySections = [];
				document.body.addEventListener('htmx:beforeSwap', function(evt){
					var el = evt.detail.target || evt.detail.elt;
					if(!el || el.id !== 'active-provision-banner') return;
					_apsOpenPhases = [];
					_apsPhaseStatuses = {};
					el.querySelectorAll('details.provision-phase').forEach(function(d){
						var idx = d.getAttribute('data-phase-index');
						if(d.open) _apsOpenPhases.push(idx);
						_apsPhaseStatuses[idx] = d.getAttribute('data-phase-status');
					});
					_apsOpenPolicySections = [];
					el.querySelectorAll('details.policy-eval-details').forEach(function(d){
						if(d.open) _apsOpenPolicySections.push(d.getAttribute('data-policy-section'));
					});
				});
				document.body.addEventListener('htmx:afterSwap', function(evt){
					var el = evt.detail.target || evt.detail.elt;
					if(!el || el.id !== 'active-provision-banner') return;
					var transitionTarget = null;
					el.querySelectorAll('details.provision-phase').forEach(function(d){
						var idx = d.getAttribute('data-phase-index');
						var newStatus = d.getAttribute('data-phase-status');
						var oldStatus = _apsPhaseStatuses[idx];
						if(oldStatus && oldStatus !== newStatus &&
						   (newStatus === 'in_progress' || newStatus === 'failed')){
							transitionTarget = idx;
						}
					});
					if(transitionTarget){
						el.querySelectorAll('details.provision-phase').forEach(function(d){
							if(d.getAttribute('data-phase-index') === transitionTarget){
								d.setAttribute('open','');
							} else {
								d.removeAttribute('open');
							}
						});
					} else {
						el.querySelectorAll('details.provision-phase').forEach(function(d){
							if(_apsOpenPhases.indexOf(d.getAttribute('data-phase-index')) >= 0){
								d.setAttribute('open','');
							}
						});
					}
					el.querySelectorAll('details.policy-eval-details').forEach(function(d){
						if(_apsOpenPolicySections.indexOf(d.getAttribute('data-policy-section')) >= 0){
							d.setAttribute('open','');
						}
					});
				});
			}

			// First-load: open the active or failed phase (only once)
			if(!window._apsInit){
				window._apsInit = true;
				var phases = document.querySelectorAll('#active-provision-banner details.provision-phase');
				phases.forEach(function(d){
					var s = d.getAttribute('data-phase-status');
					if(s === 'in_progress' || s === 'failed') d.setAttribute('open','');
				});
			}

			// Take full control of accordion open/close to prevent double-open flicker.
			document.querySelectorAll('.provision-accordion').forEach(function(acc){
				acc.querySelectorAll('details.provision-phase > summary').forEach(function(sum){
					sum.addEventListener('click', function(e){
						e.preventDefault();
						var details = sum.parentElement;
						if(details.open){
							details.removeAttribute('open');
							return;
						}
						acc.querySelectorAll('details.provision-phase[open]').forEach(function(d){
							d.removeAttribute('open');
						});
						details.setAttribute('open','');
					});
				});
			});
		})();
		</script>
	</div>
}

// gcpStackSetup renders the 4-step GCP install stack setup guide.
templ gcpStackSetup(stackSetup StackSetupData, workflow *WorkflowDataPanel, installID string, basePath string) {
	<div class="card-base !p-0 mb-3" style="border-top: 2px solid var(--theme-primary)">
		<!-- Header -->
		<div class="flex items-center justify-between px-4 py-3" style="border-bottom: 1px solid var(--theme-border-subtle)">
			<h4 class="text-sm font-medium" style="color: var(--theme-primary)">GCP Stack Setup</h4>
			if workflow != nil && workflow.HasApprovalSteps && workflow.CanApproveAll {
				<button
					type="button"
					class="button button-primary workflow-approve-all-btn btn-theme-primary inline-flex items-center gap-2 text-sm px-3 py-1.5"
					data-endpoint={ basePath + "/installs/" + installID + "/workflows/" + workflow.ID + "/approve-all" }
				>
					Approve
				</button>
			}
		</div>
		<!-- Body: 4-step guide -->
		<div class="px-4 py-3 space-y-4">
			<!-- Step 1: Clone -->
			<div>
				<p class="text-sm font-medium mb-1">1. Clone the install stack module</p>
				@components.CodeBlock("git clone https://github.com/nuonco/install-stacks.git\ncd install-stacks/gcp", "bash")
			</div>
			<!-- Step 2: Configure remote state -->
			<div>
				<p class="text-sm font-medium mb-1">2. Configure remote state (recommended)</p>
				<p class="text-xs text-[var(--theme-text-muted)] mb-2">Create a <code class="text-xs">backend.tf</code> file to store Terraform state in GCS</p>
				@components.CodeBlock(gcpBackendSnippet(stackSetup.NuonInstallID), "hcl")
			</div>
			<!-- Step 3: Save install configuration -->
			if stackSetup.TfvarsContent != "" {
				<div>
					<p class="text-sm font-medium mb-1">3. Save the install configuration</p>
					<p class="text-xs text-[var(--theme-text-muted)] mb-2">Save this as <code class="text-xs">install.tfvars</code></p>
					@components.CodeBlock(stackSetup.TfvarsContent, "hcl")
				</div>
			}
			<!-- Step 4: Apply with Terraform -->
			<div>
				<p class="text-sm font-medium mb-1">4. Apply with Terraform</p>
				<p class="text-xs text-[var(--theme-text-muted)] mb-2">Initialize and apply the Terraform configuration.</p>
				@components.CodeBlock(gcpApplyCmd(), "bash")
			</div>
		</div>
		<!-- Footer -->
		if workflow != nil && workflow.CanCancel {
			<div class="flex items-center justify-end gap-2 px-4 py-3" style="border-top: 1px solid var(--theme-border-subtle)">
				<button
					type="button"
					class="button button-neutral workflow-cancel-btn btn-theme-outline text-sm"
					data-endpoint={ basePath + "/installs/" + installID + "/workflows/" + workflow.ID + "/cancel" }
					data-workflow-name={ workflow.Name }
				>
					Cancel
				</button>
			</div>
		}
	</div>
}

func gcpBackendSnippet(installID string) string {
	return fmt.Sprintf(`terraform {
  backend "gcs" {
    bucket = "<your-state-bucket>"
    prefix = "nuon/%s"
  }
}`, installID)
}

func gcpApplyCmd() string {
	return `terraform init && terraform apply -var-file=install.tfvars`
}

script copyToClipboard(text string) {
	navigator.clipboard.writeText(text);
}

// provisionPhaseAccordion renders a single phase as a details/summary accordion
templ provisionPhaseAccordion(phase ProvisionPhase, stepNumber int) {
	<details
		class="provision-phase"
		data-phase-index={ fmt.Sprintf("%d", stepNumber) }
		data-phase-status={ phase.Status }
		if stepNumber == 1 {
			open
		}
	>
		<summary class="provision-phase-summary list-none [&::-webkit-details-marker]:hidden">
			<div class="flex items-center gap-3 flex-1 min-w-0">
				<!-- Step number circle with status icon -->
				switch phase.Status {
				case "completed":
					<div class="provision-phase-circle provision-phase-completed">
						<i class="ph-bold ph-check text-xs"></i>
					</div>
				case "in_progress":
					<div class="provision-phase-circle provision-phase-in-progress">
						<span class="text-xs font-semibold">{ fmt.Sprintf("%d", stepNumber) }</span>
					</div>
				case "failed":
					<div class="provision-phase-circle provision-phase-failed">
						<i class="ph-bold ph-x text-xs"></i>
					</div>
				default:
					<div class="provision-phase-circle provision-phase-not-started">
						<span class="text-xs font-semibold">{ fmt.Sprintf("%d", stepNumber) }</span>
					</div>
				}
				<!-- Title and status -->
				<div class="flex-1 min-w-0">
					<span class="text-sm font-medium text-cool-grey-900 dark:text-white">{ phase.Name }</span>
				</div>
				<!-- Status badge -->
				switch phase.Status {
				case "completed":
					<span class="badge-success text-xs">Completed</span>
				case "in_progress":
					<span class="badge-info text-xs">
						<i class="ph-bold ph-circle-notch animate-spin text-xs mr-1"></i>
						In Progress
					</span>
				case "failed":
					<span class="badge-error text-xs">Failed</span>
				default:
					<span class="badge-neutral text-xs">Pending</span>
				}
			</div>
			<i class="ph-bold ph-caret-down text-sm text-cool-grey-400 dark:text-cool-grey-500 provision-phase-chevron ml-2"></i>
		</summary>
		<div class="provision-phase-content">
			{ children... }
		</div>
	</details>
}

templ overviewComponentsGrid(compInfos []ComponentInfo) {
	if len(compInfos) > 0 {
		<div>
			<h3 class="text-lg font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-3">Components</h3>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				for _, comp := range compInfos {
					@components.Card(components.CardProps{Header: componentCardHeader(comp), AccentColor: statusAccentColor(comp.Status)}) {
						<div class="space-y-2 text-sm">
							@infoRow("Type", componentTypeLabel(comp.Type))
							if comp.Repo != "" {
								if comp.RepoPublic {
									@infoRowLink("Repo", comp.Repo, repoURL(comp.Repo))
								} else {
									@infoRow("Repo", comp.Repo)
								}
							}
							if comp.Directory != "" {
								if comp.RepoPublic && comp.Branch != "" {
									@infoRowLink("Directory", comp.Directory, repoURL(comp.Repo)+"/tree/"+comp.Branch+"/"+comp.Directory)
								} else {
									@infoRow("Directory", comp.Directory)
								}
							}
							if comp.Branch != "" {
								if comp.RepoPublic {
									@infoRowLink("Branch", comp.Branch, repoURL(comp.Repo)+"/tree/"+comp.Branch)
								} else {
									@infoRow("Branch", comp.Branch)
								}
							}
						</div>
					}
				}
			</div>
		</div>
	}
}

templ componentCardHeader(comp ComponentInfo) {
	<div class="flex items-center gap-2">
		@auditComponentTypeIcon(comp.Type)
		<span class="text-base text-cool-grey-900 dark:text-white truncate">{ comp.Name }</span>
		if comp.Status != "" {
			<span class={ "px-2 py-0.5 text-xs font-medium rounded-full", auditStatusClass(comp.Status) }>
				{ comp.Status }
			</span>
		}
	</div>
}

templ appConfigCard(props InstallDetailPanelProps) {
	<div class="card-base">
		<div class="flex items-center gap-2 mb-3">
			if props.AppLogoLightBase64 != "" && props.AppLogoDarkBase64 != "" {
				<img src={ props.AppLogoLightBase64 } class="h-6 dark:hidden" alt=""/>
				<img src={ props.AppLogoDarkBase64 } class="h-6 hidden dark:block" alt=""/>
			} else if props.AppLogoLightBase64 != "" {
				<img src={ props.AppLogoLightBase64 } class="h-6" alt=""/>
			}
			<h3 class="text-lg font-medium text-cool-grey-700 dark:text-cool-grey-300">{ props.AppName }</h3>
			if props.AppConfigVersion > 0 && props.InstallConfigVersion < props.AppConfigVersion {
				<span class="chip-sm-warning">update available</span>
			}
		</div>
	</div>
}

func formatConfigDate(dateStr string) string {
	for _, layout := range []string{time.RFC3339, time.RFC3339Nano, "2006-01-02T15:04:05Z", "2006-01-02T15:04:05"} {
		if t, err := time.Parse(layout, dateStr); err == nil {
			return t.Format("Jan 2, 2006")
		}
	}
	return dateStr
}

// workflowCardPanel renders a workflow card for the panel (used by workflow history)
templ workflowCardPanel(workflow WorkflowDataPanel, installID, basePath, primaryColor string) {
	<div
		id={ "workflow-" + workflow.ID }
		class="card-base mb-4"
	>
		<!-- Wrapper for status display - this is the HTMX target -->
		<div id="workflow-status-display">
			<div class="flex items-center justify-between mb-2">
				<div class="flex-1">
					<h4 class="font-medium text-cool-grey-900 dark:text-white">{ workflow.Name }</h4>
					<!-- Status subtitle with appropriate icon -->
					if workflow.Status == "completed" || workflow.Status == "success" {
						<div class="flex items-center gap-2 mt-1 text-sm text-green-600 dark:text-green-400">
							<i class="ph-bold ph-check-circle text-base"></i>
							<span>Completed</span>
						</div>
					} else if workflow.Status == "error" {
						<div class="flex items-center gap-2 mt-1 text-sm text-red-600 dark:text-red-400">
							<i class="ph-bold ph-x-circle text-base"></i>
							<span>
								if workflow.CurrentStepName != "" {
									Failed at: { workflow.CurrentStepName }
								} else {
									Failed
								}
							</span>
						</div>
					} else if workflow.Status == "cancelled" {
						<div class="flex items-center gap-2 mt-1 text-sm text-cool-grey-500 dark:text-cool-grey-400">
							<i class="ph-bold ph-prohibit text-base"></i>
							<span>Cancelled</span>
						</div>
					} else if workflow.CurrentStepName != "" || workflow.Status == "in-progress" || workflow.Status == "pending" || workflow.Status == "approval-awaiting" {
						<div class="flex items-center gap-2 mt-1 text-sm text-cool-grey-600 dark:text-cool-grey-400">
							<i class="ph-bold ph-circle-notch animate-spin text-base"></i>
							<span>
								if workflow.CurrentStepName != "" {
									if workflow.CurrentStepType == "pending" {
										Waiting to start: { workflow.CurrentStepName }
									} else if workflow.CurrentStepType == "approval-awaiting" {
										Awaiting approval: { workflow.CurrentStepName }
									} else if workflow.CurrentStepType == "initializing" {
										{ workflow.CurrentStepName }
									} else {
										{ workflow.CurrentStepName }
									}
								} else {
									Workflow starting...
								}
							</span>
						</div>
					}
				</div>
				<span class={ "text-xs px-2 py-1 rounded", workflow.StatusClass }>
					{ workflow.Status }
				</span>
			</div>
			<!-- Progress bar -->
			if workflow.Status == "completed" || workflow.Status == "success" {
				<div class="mb-2">
					<div class="w-full h-1 bg-cool-grey-300 dark:bg-cool-grey-700 rounded-sm overflow-hidden border border-green-400 dark:border-green-600">
						<div class="h-full bg-green-500 dark:bg-green-400 rounded-sm" style="width: 100%;"></div>
					</div>
				</div>
			} else if workflow.Status == "error" && workflow.TotalSteps > 0 && workflow.CurrentStepNumber > 0 {
				@templ.Raw(fmt.Sprintf(`<div class="mb-2">
					<div class="w-full h-1 bg-cool-grey-300 dark:bg-cool-grey-700 rounded-sm overflow-hidden border border-red-400 dark:border-red-600">
						<div class="h-full bg-red-500 dark:bg-red-400 rounded-sm" style="width: %d%%;"></div>
					</div>
				</div>`, (workflow.CurrentStepNumber * 100) / workflow.TotalSteps))
			} else if workflow.TotalSteps > 0 && workflow.CurrentStepNumber > 0 {
				@templ.Raw(fmt.Sprintf(`<div class="mb-2">
					<div class="w-full h-1 bg-cool-grey-300 dark:bg-cool-grey-700 rounded-sm overflow-hidden border border-cool-grey-400 dark:border-cool-grey-600">
						<div class="h-full bg-blue-600 dark:bg-blue-500 rounded-sm transition-all duration-300 ease-in-out" style="width: %d%%;"></div>
					</div>
				</div>`, (workflow.CurrentStepNumber * 100) / workflow.TotalSteps))
			}
			<div class="text-sm text-cool-grey-500 dark:text-cool-grey-400 mb-3">
				{ workflow.CreatedAt.Format("Jan 2, 2006 3:04 PM") }
			</div>
		</div>
		<!-- Action buttons -->
		if workflow.HasApprovalSteps || workflow.CanCancel {
			<div class="flex gap-2">
				if workflow.HasApprovalSteps {
					if workflow.CanApproveAll {
						<button
							type="button"
							class="button button-primary workflow-approve-all-btn btn-theme-primary px-3 py-1 text-sm"
							data-endpoint={ basePath + "/installs/" + installID + "/workflows/" + workflow.ID + "/approve-all" }
						>
							Approve
						</button>
					} else {
						<button
							type="button"
							disabled
							class="button button-primary px-3 py-1 text-sm font-medium text-cool-grey-400 dark:text-cool-grey-500 bg-cool-grey-200 dark:bg-dark-grey-700 rounded cursor-not-allowed"
							title={ workflow.ApproveAllDisabledReason }
						>
							Approve
						</button>
					}
				}
				if workflow.CanCancel {
					<button
						type="button"
						class="button button-neutral workflow-cancel-btn px-3 py-1 text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 bg-cool-grey-100 dark:bg-dark-grey-700 hover:bg-cool-grey-200 dark:hover:bg-dark-grey-600 rounded"
						data-endpoint={ basePath + "/installs/" + installID + "/workflows/" + workflow.ID + "/cancel" }
						data-workflow-name={ workflow.Name }
					>
						Cancel
					</button>
				}
			</div>
		}
	</div>
}

templ installDetailPanelScripts() {
	<script>
		(function() {
			// Get config from data attributes
			var configEl = document.getElementById('install-detail-config');
			var basePath = configEl.dataset.basePath;
			var installID = configEl.dataset.installId;
			var installName = configEl.dataset.installName;
			var nuonInstallID = configEl.dataset.nuonInstallId;

			// Set the install ID in the panel header
			var installIdEl = document.getElementById('panel-install-id');
			if (installIdEl && nuonInstallID) {
				installIdEl.textContent = nuonInstallID;
			}

			// Retry failed workflow step
			window.retryFailedStep = async function(btn) {
				var endpoint = btn.getAttribute('data-endpoint');
				btn.disabled = true;
				btn.textContent = 'Retrying...';
				try {
					var response = await fetch(endpoint, { method: 'POST' });
					if (!response.ok) {
						btn.disabled = false;
						btn.innerHTML = 'Retry Step <i class="ph-bold ph-arrow-clockwise text-base"></i>';
					}
				} catch (error) {
					console.error('Retry failed:', error);
					btn.disabled = false;
					btn.innerHTML = 'Retry Step <i class="ph-bold ph-arrow-clockwise text-base"></i>';
				}
			};

			// Workflow action modal - dynamically sets HTMX attributes on modal's Confirm button
			window.showWorkflowActionModal = function(options) {
				var confirmBtn = document.getElementById('confirm-ok');
				var cancelBtn = document.getElementById('confirm-cancel');
				var modal = document.getElementById('confirm-modal');

				// Set modal content
				document.getElementById('confirm-title').textContent = options.title || 'Confirm Action';
				document.getElementById('confirm-message').textContent = options.message || 'Are you sure?';
				confirmBtn.textContent = options.confirmText || 'Confirm';
				cancelBtn.textContent = options.cancelText || 'Cancel';

				// Set HTMX attributes on the Confirm button
				confirmBtn.setAttribute('hx-post', options.endpoint);
				confirmBtn.setAttribute('hx-target', options.target || '#workflow-status-display');
				confirmBtn.setAttribute('hx-swap', options.swap || 'innerHTML');

				// Initialize HTMX on the button (processes the new attributes)
				htmx.process(confirmBtn);

				// Show modal
				modal.classList.remove('hidden');

				// Cancel button just closes modal
				cancelBtn.onclick = function() {
					modal.classList.add('hidden');
					// Clean up HTMX attributes to prevent accidental reuse
					confirmBtn.removeAttribute('hx-post');
					confirmBtn.removeAttribute('hx-target');
					confirmBtn.removeAttribute('hx-swap');
				};

				// Also handle modal close via backdrop or ESC key
				modal.onclick = function(e) {
					if (e.target === modal) {
						cancelBtn.click();
					}
				};
			};

			// Handle HTMX response - close modal after successful request
			document.body.addEventListener('htmx:afterRequest', function(evt) {
				// Close modal if the request came from the confirm button
				if (evt.detail.elt.id === 'confirm-ok') {
					var modal = document.getElementById('confirm-modal');
					modal.classList.add('hidden');

					// Clean up HTMX attributes
					evt.detail.elt.removeAttribute('hx-post');
					evt.detail.elt.removeAttribute('hx-target');
					evt.detail.elt.removeAttribute('hx-swap');
				}
			});

			// Attach event listeners to workflow action buttons using event delegation
			document.body.addEventListener('click', function(e) {
				// Handle Approve button — no confirmation needed
				if (e.target.classList.contains('workflow-approve-all-btn')) {
					var btn = e.target;
					var endpoint = btn.getAttribute('data-endpoint');
					btn.setAttribute('aria-disabled', 'true');
					btn.style.pointerEvents = 'none';
					btn.style.opacity = '0.5';
					btn.textContent = 'Approving...';
					fetch(endpoint, { method: 'POST' }).catch(function(err) {
						console.error('Approve failed:', err);
					});
				}
				// Handle Cancel button
				else if (e.target.classList.contains('workflow-cancel-btn')) {
					var endpoint = e.target.getAttribute('data-endpoint');
					var wfName = e.target.getAttribute('data-workflow-name') || 'Workflow';
					showWorkflowActionModal({
						endpoint: endpoint,
						target: '#workflow-status-display',
						swap: 'innerHTML',
						title: 'Cancel ' + wfName + '?',
						message: 'Are you sure you want to cancel this ' + wfName.toLowerCase() + '? This may leave your application in an incomplete state.',
						confirmText: 'Cancel ' + wfName,
						cancelText: 'Keep Running'
					});
				}
			});

		})();

		// Handle HTMX authentication errors
		document.body.addEventListener('auth-error', function(event) {
			console.warn('Authentication expired during HTMX polling, redirecting to login...');
			const currentPath = window.location.pathname;
			window.location.href = '/login?redirect=' + encodeURIComponent(currentPath);
		});

		// Open workflow detail in secondary panel (used by Updates tab on overview page)
		window.openWorkflowPanel = function(workflowID, workflowName) {
			var panel = document.getElementById('secondary-panel');
			var title = document.getElementById('secondary-panel-title');
			var content = document.getElementById('secondary-panel-content');
			if (!panel || !title || !content) return;
			title.textContent = workflowName || 'Workflow';
			content.innerHTML = `
				<div class="space-y-4">
					<div class="card-base p-4 space-y-3">
						<div class="shimmer h-4 w-1/3"></div>
						<div class="shimmer h-4 w-2/3"></div>
						<div class="shimmer h-4 w-1/2"></div>
					</div>
					<div class="space-y-2">
						<div class="shimmer h-8 w-full"></div>
						<div class="pl-4 space-y-2 py-1">
							<div class="shimmer h-4 w-3/4"></div>
							<div class="shimmer h-4 w-1/2"></div>
							<div class="shimmer h-4 w-2/3"></div>
						</div>
						<div class="shimmer h-8 w-full"></div>
						<div class="shimmer h-8 w-full"></div>
					</div>
				</div>`;
			panel.classList.add('open');
			var overlay = document.getElementById('secondary-panel-overlay');
			if (overlay) overlay.classList.add('open');
			var configEl = document.getElementById('install-detail-config');
			var bp = configEl ? configEl.dataset.basePath : '';
			var iid = configEl ? configEl.dataset.installId : '';
			fetch(bp + '/installs/' + iid + '/panel/workflow/' + workflowID)
				.then(function(resp) { return resp.text(); })
				.then(function(html) {
					content.innerHTML = html;
					var scripts = content.querySelectorAll('script');
					scripts.forEach(function(s) {
						var ns = document.createElement('script');
						ns.textContent = s.textContent;
						s.parentNode.replaceChild(ns, s);
					});
					if (typeof htmx !== 'undefined') {
						htmx.process(content);
					}
					var firstPhase = content.querySelector('details.provision-phase');
					if (firstPhase) {
						firstPhase.setAttribute('open', '');
					}
					// Auto-load first step only if the inline step-detail-card is empty
					// (e.g. CF link card or failed step card already rendered server-side)
					var stepCard = content.querySelector('#step-detail-card');
					if (!stepCard || !stepCard.children.length) {
						var firstStep = content.querySelector('[data-step-url]');
						if (firstStep && typeof loadStepDetail === 'function') {
							loadStepDetail(firstStep.getAttribute('data-step-url'), firstStep);
						}
					}
				})
				.catch(function() {
					content.innerHTML = '<p class="text-sm text-red-500">Failed to load workflow details.</p>';
				});
		};

		// Optional: Log HTMX errors for debugging
		document.body.addEventListener('htmx:responseError', function(event) {
			console.error('HTMX request failed:', {
				url: event.detail.pathInfo.requestPath,
				status: event.detail.xhr.status,
				statusText: event.detail.xhr.statusText
			});
		});

		// Auto-open the first workflow panel when redirected from install creation
		(function() {
			var container = document.getElementById('panel-content-overview');
			if (!container || container.getAttribute('data-auto-open-workflow') !== 'true') return;
			container.removeAttribute('data-auto-open-workflow');
			var firstRow = document.querySelector('#overview-tab-updates tbody tr');
			if (firstRow) firstRow.click();
		})();

	</script>
}

templ EditInputsModalPanel() {
	@ModalWrapper("editInputsModal", "max-w-2xl") {
		<div class="mb-4">
			<h3 class="text-lg font-semibold text-cool-grey-900 dark:text-white">Edit Inputs</h3>
		</div>
		<div id="editInputsLoading" class="py-8 text-center">
			<div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-primary-600"></div>
			<p class="mt-2 text-cool-grey-500 dark:text-cool-grey-400">Loading inputs...</p>
		</div>
		<form id="editInputsForm" class="hidden space-y-4">
			<div id="editInputsFields" class="space-y-4"></div>
			<div class="card-section-divider flex justify-end space-x-3">
				<button
					type="button"
					onclick="closeEditInputsModal()"
					class="button button-outline btn-theme-outline"
				>
					Cancel
				</button>
				<button
					type="submit"
					class="button button-primary btn-theme-primary"
				>
					Update Inputs
				</button>
			</div>
		</form>
		<div
			id="editInputsError"
			class="mt-4 p-3 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-400 rounded hidden"
		></div>
		<div id="editInputsErrorActions" class="hidden mt-4 flex justify-end">
			<button
				type="button"
				onclick="closeEditInputsModal()"
				class="button button-outline btn-theme-outline"
			>
				Cancel
			</button>
		</div>
	}
}
