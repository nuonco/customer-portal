package partials

import (
	"fmt"
	"time"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
)

// AuditLogEntryPanel represents an audit log entry for the panel
type AuditLogEntryPanel struct {
	LogLine   string
	TimeStamp time.Time
	Type      string
}

// AuditLogsPanelProps contains data needed for the audit logs panel content
type AuditLogsPanelProps struct {
	Install   *models.Install
	Entries   []AuditLogEntryPanel
	StartTime time.Time
	EndTime   time.Time
	RangeType string // "past-hour", "past-day", "past-week", or "custom"
	BasePath  string
}

// AuditLogsPanel renders the audit logs content for the sliding panel
templ AuditLogsPanel(props AuditLogsPanelProps) {
	<div class="w-full" id="audit-content">
		@auditLogsPanelContent(props)
	</div>
	@auditLogsPanelScripts()
}

// auditLogsPanelContent renders the time range selector and log entries
templ auditLogsPanelContent(props AuditLogsPanelProps) {
	<!-- Time Range Selector -->
	<div class="customer-card mb-6">
		<!-- Preset Buttons -->
		<div class="flex flex-wrap items-center gap-2 mb-4">
			@auditRangePresetButtonPanel(props, "past-hour", "Past Hour")
			@auditRangePresetButtonPanel(props, "past-day", "Past Day")
			@auditRangePresetButtonPanel(props, "past-week", "Past Week")
		</div>

		<!-- Custom Range Form -->
		<form id="custom-range-form" class="flex flex-wrap items-end gap-4">
			<div class="flex-1 min-w-[200px]">
				<label for="start-time" class="field-label">From</label>
				<input
					type="datetime-local"
					id="start-time"
					name="start"
					value={ props.StartTime.Format("2006-01-02T15:04") }
					class="field-input"
				/>
			</div>
			<div class="flex-1 min-w-[200px]">
				<label for="end-time" class="field-label">To</label>
				<input
					type="datetime-local"
					id="end-time"
					name="end"
					value={ props.EndTime.Format("2006-01-02T15:04") }
					class="field-input"
				/>
			</div>
			<button
				type="button"
				onclick="applyCustomAuditRange()"
				class="button button-primary btn-theme-primary"
			>
				Apply
			</button>
		</form>

		<!-- Current Range Display -->
		<div class="card-section-divider flex items-center justify-between mt-4">
			<div class="text-sm text-cool-grey-600 dark:text-cool-grey-400">
				<span class="font-medium">Showing:</span>
				{ props.StartTime.Format("Jan 2, 2006 3:04 PM") } — { props.EndTime.Format("Jan 2, 2006 3:04 PM") }
			</div>
			<div class="text-sm text-cool-grey-500 dark:text-cool-grey-400">
				{ fmt.Sprintf("%d entries", len(props.Entries)) }
			</div>
		</div>
	</div>

	<!-- Audit Log Entries -->
	if len(props.Entries) == 0 {
		<div class="customer-card text-center py-12">
			<svg class="mx-auto h-12 w-12 text-cool-grey-400 dark:text-cool-grey-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
			</svg>
			<h3 class="mt-4 text-lg font-medium text-cool-grey-900 dark:text-white">No audit logs for this time range</h3>
			<p class="mt-2 text-sm text-cool-grey-600 dark:text-cool-grey-400">Try selecting a different time range to view audit logs.</p>
		</div>
	} else {
		<div class="space-y-2">
			for _, entry := range props.Entries {
				@auditLogEntryPanel(entry)
			}
		</div>
	}

	<!-- Hidden data for JavaScript -->
	<div
		id="audit-panel-config"
		class="hidden"
		data-base-path={ props.BasePath }
		data-install-id={ props.Install.ID }
	></div>
}

// auditRangePresetButtonPanel renders a preset time range button for the panel
templ auditRangePresetButtonPanel(props AuditLogsPanelProps, rangeType, label string) {
	{{
		isActive := props.RangeType == rangeType
		baseClasses := "px-3 py-1.5 text-sm font-medium transition-colors cursor-pointer rounded-theme"
		activeClasses := "button button-primary bg-theme-primary text-white"
		inactiveClasses := "button button-neutral btn-neutral"
	}}
	<button
		type="button"
		onclick={ templ.ComponentScript{Call: fmt.Sprintf("selectAuditRangePanel('%s')", rangeType)} }
		class={ baseClasses, templ.KV(activeClasses, isActive), templ.KV(inactiveClasses, !isActive) }
	>
		{ label }
	</button>
}

// auditLogEntryPanel renders a single audit log entry
templ auditLogEntryPanel(entry AuditLogEntryPanel) {
	<div class="customer-card">
		<div class="flex items-start gap-3">
			<!-- Type Badge -->
			@auditTypeBadgePanel(entry.Type)

			<!-- Log Content -->
			<div class="flex-1 min-w-0">
				<div class="flex items-center justify-between mb-1">
					<span class="text-xs text-cool-grey-500 dark:text-cool-grey-400">
						{ entry.TimeStamp.Format("Jan 2, 2006 3:04:05 PM") }
					</span>
				</div>
				<pre class="text-sm text-cool-grey-900 dark:text-cool-grey-100 font-mono whitespace-pre-wrap break-words overflow-x-auto">{ entry.LogLine }</pre>
			</div>
		</div>
	</div>
}

// auditTypeBadgePanel renders a colored badge based on the entry type
templ auditTypeBadgePanel(entryType string) {
	switch entryType {
	case "error":
		<span class="inline-flex items-center px-2 py-1 text-xs font-medium rounded bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-300">
			<svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
			</svg>
			Error
		</span>
	case "warning":
		<span class="inline-flex items-center px-2 py-1 text-xs font-medium rounded bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-300">
			<svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
			</svg>
			Warning
		</span>
	case "success":
		<span class="inline-flex items-center px-2 py-1 text-xs font-medium rounded bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300">
			<svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
			</svg>
			Success
		</span>
	default:
		<span class="inline-flex items-center px-2 py-1 text-xs font-medium rounded bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300">
			<svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
			</svg>
			Info
		</span>
	}
}

// auditLogsPanelScripts contains the JavaScript for time range selection in the panel
templ auditLogsPanelScripts() {
	<style>
		/* Make datetime picker icon visible in dark mode */
		@media (prefers-color-scheme: dark) {
			input[type="datetime-local"]::-webkit-calendar-picker-indicator {
				filter: invert(1);
			}
		}
		.dark input[type="datetime-local"]::-webkit-calendar-picker-indicator {
			filter: invert(1);
		}
	</style>
	<script>
		(function() {
			var configEl = document.getElementById('audit-panel-config');
			var basePath = configEl ? configEl.dataset.basePath : '';
			var installId = configEl ? configEl.dataset.installId : '';

			// Select a preset time range
			window.selectAuditRangePanel = function(rangeType) {
				var url = basePath + '/installs/' + installId + '/panel/audit?range=' + rangeType;
				loadAuditPanelContent(url);
			};

			// Apply custom time range
			window.applyCustomAuditRange = function() {
				var startInput = document.getElementById('start-time');
				var endInput = document.getElementById('end-time');

				if (!startInput.value || !endInput.value) {
					alert('Please select both start and end times');
					return;
				}

				// Convert datetime-local to RFC3339 format
				var startTime = new Date(startInput.value).toISOString();
				var endTime = new Date(endInput.value).toISOString();

				// Build URL with custom range
				var url = basePath + '/installs/' + installId + '/panel/audit?start=' + encodeURIComponent(startTime) + '&end=' + encodeURIComponent(endTime);
				loadAuditPanelContent(url);
			};

			// Load audit content via fetch
			function loadAuditPanelContent(url) {
				var container = document.getElementById('panel-content-audit');
				if (!container) return;

				// Show loading state
				container.innerHTML = '<div class="panel-loading"><div class="panel-loading-spinner"><\/div><\/div>';

				fetch(url)
					.then(function(response) {
						if (!response.ok) throw new Error('Failed to load');
						return response.text();
					})
					.then(function(html) {
						container.innerHTML = html;

						// Re-run any scripts that were in the content
						var scripts = container.querySelectorAll('script');
						scripts.forEach(function(script) {
							var newScript = document.createElement('script');
							newScript.textContent = script.textContent;
							script.parentNode.replaceChild(newScript, script);
						});
					})
					.catch(function(error) {
						container.innerHTML = '<div class="text-center py-8 text-red-500">Failed to load audit logs. <button onclick="location.reload()" class="underline">Retry<\/button><\/div>';
					});
			}
		})();
	</script>
}
