package partials

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
)

// UserMenuProps contains props for the customer user menu dropdown
type UserMenuProps struct {
	User          *models.User
	BasePath      string
	ActiveNav     string
	ActiveAccount *models.CustomerAccount
	OtherAccounts []models.CustomerAccount
}

// UserMenu renders the customer user menu dropdown with avatar and logout option
templ UserMenu(props UserMenuProps) {
	<div class="relative" id="customerUserMenuContainer">
		<button
			type="button"
			onclick="toggleCustomerUserMenu()"
			class="button button-nav nav-item active flex items-center gap-2"
			id="customerUserMenuButton"
		>
			<!-- Account name or email -->
			<span class="font-body">
				if props.ActiveAccount != nil {
					{ props.ActiveAccount.Name }
				} else if props.User != nil {
					{ props.User.Email }
				} else {
					Not logged in
				}
			</span>
			<!-- Caret down icon -->
			<i class="ph-bold ph-caret-down text-base flex-shrink-0"></i>
		</button>
		<!-- Dropdown Menu -->
		<div id="customerUserDropdown" class="dropdown-menu py-1 z-50 hidden w-full min-w-48">
			if props.User != nil {
				<!-- Switch Accounts sub-dropdown trigger -->
				<div class="relative">
					<button
						type="button"
						onclick="toggleAccountSubmenu()"
						class="button button-dropdown-item w-full flex items-center justify-between px-3 py-2 text-sm hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors cursor-pointer"
					>
						<span>Switch Accounts</span>
						<i class="ph-bold ph-caret-left text-base"></i>
					</button>
					<!-- Sub-dropdown (opens left) -->
					<div id="accountSubmenu" class="dropdown-menu py-1 z-50 hidden top-0 min-w-48" style="right: 100%;">
						if len(props.OtherAccounts) > 0 {
							for _, account := range props.OtherAccounts {
								<form method="post" action={ templ.SafeURL(props.BasePath + "/account/switch") } hx-post={ props.BasePath + "/account/switch" } hx-swap="none">
									<input type="hidden" name="account_id" value={ account.ID }/>
									<button
										type="submit"
										class="button button-dropdown-item w-full flex items-center justify-between px-3 py-2 text-sm hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors cursor-pointer"
									>
										<span>{ account.Name }</span>
										<i class="ph-bold ph-swap text-base"></i>
									</button>
								</form>
							}
							<div class="border-t border-gray-200 dark:border-gray-700 my-1"></div>
						}
						<!-- Create New Account -->
						<a
							href={ templ.SafeURL(props.BasePath + "/account/new") }
							class="button button-dropdown-item w-full flex items-center justify-between px-3 py-2 text-sm hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
						>
							<span>Create New</span>
							<i class="ph-bold ph-plus text-base"></i>
						</a>
					</div>
				</div>
				<div class="border-t border-gray-200 dark:border-gray-700 my-1"></div>
				<!-- My Account Link -->
				<a
					href={ templ.SafeURL(props.BasePath + "/account") }
					class="button button-dropdown-item w-full flex items-center justify-between px-3 py-2 text-sm hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
				>
					<span>Account Settings</span>
					<i class="ph-bold ph-user-circle text-base"></i>
				</a>
				<!-- Log out Button -->
				<button
					type="button"
					onclick="logout()"
					class="w-full flex items-center justify-between px-3 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors cursor-pointer"
				>
					<span>Log out</span>
					<!-- Arrow right icon -->
					<i class="ph-bold ph-arrow-right text-base"></i>
				</button>
			} else {
				<!-- Log in Link -->
				<a
					href={ templ.SafeURL(props.BasePath + "/login") }
					class="w-full flex items-center justify-between px-3 py-2 text-sm hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
				>
					<span>Log in</span>
					<!-- Arrow right icon -->
					<i class="ph-bold ph-arrow-right text-base"></i>
				</a>
			}
		</div>
	</div>
	@userMenuScript()
}

templ userMenuScript() {
	<script>
		function toggleCustomerUserMenu() {
			const dropdown = document.getElementById('customerUserDropdown');
			const submenu = document.getElementById('accountSubmenu');
			dropdown.classList.toggle('hidden');
			// Close submenu when main dropdown is toggled
			if (submenu) submenu.classList.add('hidden');
		}

		function toggleAccountSubmenu() {
			const submenu = document.getElementById('accountSubmenu');
			if (submenu) submenu.classList.toggle('hidden');
		}

		// Close all dropdowns when clicking outside
		document.addEventListener('click', function(event) {
			const container = document.getElementById('customerUserMenuContainer');
			const dropdown = document.getElementById('customerUserDropdown');
			const submenu = document.getElementById('accountSubmenu');
			if (container && !container.contains(event.target)) {
				if (dropdown) dropdown.classList.add('hidden');
				if (submenu) submenu.classList.add('hidden');
			}
		});
	</script>
}
