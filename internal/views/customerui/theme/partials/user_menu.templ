package partials

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
)

// UserMenuProps contains props for the customer user menu dropdown
type UserMenuProps struct {
	User     *models.User
	BasePath string
}

// UserMenu renders the customer user menu dropdown with avatar and logout option
templ UserMenu(props UserMenuProps) {
	<div class="relative" id="customerUserMenuContainer">
		<button
			type="button"
			onclick="toggleCustomerUserMenu()"
			class="button button-nav nav-item active flex items-center gap-2"
			id="customerUserMenuButton"
		>
			<!-- Email -->
			<span class="font-body">
				if props.User != nil {
					{ props.User.Email }
				} else {
					Not logged in
				}
			</span>
			<!-- Caret down icon -->
			<i class="ph-bold ph-caret-down text-base flex-shrink-0"></i>
		</button>
		<!-- Dropdown Menu -->
		<div id="customerUserDropdown" class="dropdown-menu py-1 z-50 hidden w-full">
			if props.User != nil {
				<!-- Log out Button -->
				<button
					type="button"
					onclick="logout()"
					class="w-full flex items-center justify-between px-3 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors cursor-pointer"
				>
					<span>Log out</span>
					<!-- Arrow right icon -->
					<i class="ph-bold ph-arrow-right text-base"></i>
				</button>
			} else {
				<!-- Log in Link -->
				<a
					href={ templ.SafeURL(props.BasePath + "/login") }
					class="w-full flex items-center justify-between px-3 py-2 text-sm hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
				>
					<span>Log in</span>
					<!-- Arrow right icon -->
					<i class="ph-bold ph-arrow-right text-base"></i>
				</a>
			}
		</div>
	</div>
	@userMenuScript()
}

templ userMenuScript() {
	<script>
		function toggleCustomerUserMenu() {
			const dropdown = document.getElementById('customerUserDropdown');
			dropdown.classList.toggle('hidden');
		}

		// Close dropdown when clicking outside
		document.addEventListener('click', function(event) {
			const container = document.getElementById('customerUserMenuContainer');
			const dropdown = document.getElementById('customerUserDropdown');
			if (container && dropdown && !container.contains(event.target)) {
				dropdown.classList.add('hidden');
			}
		});
	</script>
}
