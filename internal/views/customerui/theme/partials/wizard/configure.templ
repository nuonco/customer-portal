package wizard

import (
	"github.com/nuonco/customer-portal/internal/models"
	"github.com/nuonco/customer-portal/internal/views/customerui"
	"github.com/nuonco/customer-portal/internal/views/customerui/theme/components"
	"github.com/nuonco/customer-portal/internal/views/customerui/theme/scripts"
	"github.com/nuonco/customer-portal/pkg/nuon"
)

// ConfigureStepProps holds data for the wizard's Configure (inputs) step,
// shared by both the install-link standalone page and the published-app wizard flow.
type ConfigureStepProps struct {
	customerui.LayoutProps
	AppID           string
	AppName         string
	OrgName         string
	LogoLightBase64 string
	LogoDarkBase64  string
	LoggedInUser    *models.User
	AuthURL         string
	SHA             string // Non-empty = install-link mode
	// Wizard context (set when returning to inputs step from wizard)
	InstallID   string
	InstallName string
	WorkflowID  string
	StepGroups  []nuon.WorkflowStepGroup
}

func (p ConfigureStepProps) formFieldsURL() string {
	if p.SHA != "" {
		return p.BasePath + "/install-form-fields?sha=" + p.SHA
	}
	u := p.BasePath + "/install-form-fields?app_id=" + p.AppID
	if p.InstallID != "" {
		u += "&install_id=" + p.InstallID
	}
	return u
}

func (p ConfigureStepProps) isExistingInstall() bool {
	return p.InstallID != ""
}

func (p ConfigureStepProps) isUnauthenticated() bool {
	return p.SHA == "" && p.LoggedInUser == nil
}

func (p ConfigureStepProps) stackStepURL() string {
	return p.BasePath + "/apps/" + p.AppID + "/install?step=stack&install_id=" + p.InstallID + "&workflow_id=" + p.WorkflowID
}

func (p ConfigureStepProps) stackStepPartialURL() string {
	return p.stackStepURL() + "&partial=poll"
}

func (p ConfigureStepProps) formAction() string {
	if p.SHA != "" {
		return p.BasePath + "/install-link"
	}
	return p.BasePath + "/apps/" + p.AppID + "/install"
}

// ConfigureStep renders the install form (no step indicator). Used by the
// wizard's inputs step and by the install-link standalone page.
templ ConfigureStep(props ConfigureStepProps) {
	if props.NuonAPIError != "" {
		<div class="max-w-4xl mx-auto mb-4">
			@components.Alert(components.AlertProps{
				Type:    "error",
				Message: props.NuonAPIError,
			})
		</div>
	}
	<form
		id="installForm"
		class="max-w-4xl mx-auto space-y-6 pb-6"
		hx-boost="false"
		hx-post={ props.formAction() }
		hx-ext="json-enc"
		hx-target="#error"
		hx-swap="innerHTML"
		data-wizard-nav="true"
		data-step-index="1"
	>
		if props.SHA != "" {
			@scripts.FormPersist(props.SHA)
		} else {
			@scripts.FormPersist(props.AppID)
		}
		if !props.isExistingInstall() && !props.isUnauthenticated() {
			@scripts.FormValidate("installForm", "submit-btn")
		}
		if props.SHA != "" {
			<input type="hidden" name="sha" value={ props.SHA }/>
		}
		<!-- App Header (above cards) -->
		<div class="flex items-center gap-3 mb-6">
			if props.LogoLightBase64 != "" {
				if props.LogoDarkBase64 != "" {
					<img src={ props.LogoLightBase64 } alt={ props.AppName } class="w-8 h-8 rounded object-contain dark:hidden"/>
					<img src={ props.LogoDarkBase64 } alt={ props.AppName } class="w-8 h-8 rounded object-contain hidden dark:block"/>
				} else {
					<img src={ props.LogoLightBase64 } alt={ props.AppName } class="w-8 h-8 rounded object-contain"/>
				}
			}
			<h3 class="text-base font-semibold text-cool-grey-800 dark:text-cool-grey-200">{ props.AppName }</h3>
			<div class="ml-auto flex items-center gap-3">
				if !props.isExistingInstall() {
					<a
						href={ templ.SafeURL(props.BasePath + "/apps/" + props.AppID) }
						class={
							"button button-outline btn-theme-outline inline-flex items-center gap-2 text-sm",
							templ.KV("opacity-40 pointer-events-none", props.isUnauthenticated()),
						}
					>
						<i class="ph-bold ph-caret-left"></i>
						Cancel
					</a>
				}
				if props.isExistingInstall() {
					<a
						href={ templ.SafeURL(props.stackStepURL()) }
						hx-get={ props.stackStepPartialURL() }
						hx-target="#wizard-step-wrapper"
						hx-swap="innerHTML show:none"
						hx-push-url={ props.stackStepURL() }
						hx-boost="false"
						data-step-index="1"
						data-wizard-nav="true"
						class={
							"button button-primary btn-theme-primary inline-flex items-center gap-2 text-sm",
							templ.KV("opacity-40 pointer-events-none", props.isUnauthenticated()),
						}
					>
						Deploy stack
						<i class="ph-bold ph-caret-right"></i>
					</a>
				} else {
					<button
						id="submit-btn"
						type="submit"
						disabled
						class="button button-primary btn-theme-primary inline-flex items-center gap-2 text-sm opacity-40 pointer-events-none"
					>
						<span class="btn-label">Submit</span>
						<i class="ph-bold ph-caret-right"></i>
					</button>
				}
			</div>
		</div>
		if props.SHA != "" {
			<p class="text-cool-grey-600 dark:text-cool-grey-400 text-sm mb-6">
				You've been invited to install this application. Please provide your details below.
			</p>
		}
		if props.SHA == "" && props.LoggedInUser == nil {
			<!-- Sign up / Log in (app install mode, unauthenticated) -->
			@components.Card(components.CardProps{}) {
				<p class="text-sm font-medium text-cool-grey-600 dark:text-cool-grey-400 mb-4">Sign up or log in to continue</p>
				<a href={ templ.SafeURL(props.AuthURL) } class="button button-primary w-full btn-theme-primary">Sign up</a>
				<div class="flex items-center gap-3 my-3">
					<div class="flex-1 border-t border-cool-grey-200 dark:border-dark-grey-600"></div>
					<span class="text-xs text-cool-grey-400 dark:text-cool-grey-500">or</span>
					<div class="flex-1 border-t border-cool-grey-200 dark:border-dark-grey-600"></div>
				</div>
				<a href={ templ.SafeURL(props.AuthURL) } class="button button-outline w-full btn-theme-outline">Log in</a>
			}
		}
		<!-- Install Details -->
		<fieldset
			if props.SHA == "" && props.LoggedInUser == nil {
				disabled
			}
			class="space-y-6"
			if props.SHA == "" && props.LoggedInUser == nil {
				style="opacity: 0.5; pointer-events: none;"
			}
		>
			if props.SHA != "" && props.LoggedInUser != nil {
				<!-- Account Info - install link mode -->
				@components.Card(components.CardProps{}) {
					<h4 class="text-sm font-medium mb-3 text-cool-grey-800 dark:text-cool-grey-200">Your Group</h4>
					<div class="flex items-center justify-between">
						<div>
							<p class="text-sm text-cool-grey-700 dark:text-cool-grey-300">
								Installing as <strong class="font-semibold">{ props.LoggedInUser.Email }</strong>
							</p>
							if props.LoggedInUser.Name != "" {
								<p class="text-xs text-cool-grey-500 dark:text-cool-grey-400 mt-1">{ props.LoggedInUser.Name }</p>
							}
						</div>
						<a href={ templ.SafeURL(props.BasePath + "/login") } class="text-xs hover:underline" style="color: var(--theme-primary)">
							Switch account
						</a>
					</div>
				}
			}
			if props.SHA == "" {
				<!-- Install Name (app install mode only) -->
				@components.Card(components.CardProps{Title: "Install Name"}) {
					<input
						type="text"
						id="installName"
						name="name"
						required
						placeholder="my-install"
						value={ props.InstallName }
						if props.isExistingInstall() {
							readonly
						}
						class="field-input"
					/>
				}
			}
			<!-- Region + inputs loaded via HTMX into this section -->
			<div
				id="installFormFields"
				hx-get={ props.formFieldsURL() }
				hx-trigger="load"
				hx-swap="innerHTML"
				hx-target="this"
			>
				@components.Card(components.CardProps{}) {
					@components.ShimmerBar("h-4", "w-1/3")
					<div class="mt-3">
						@components.ShimmerBar("h-10", "w-full")
					</div>
				}
			</div>
			<!-- Input Group Cards (populated via OOB swap from install-form-fields response) -->
			<div id="installInputGroups" class="space-y-6"></div>
			<div id="error" class="mt-4"></div>
		</fieldset>
	</form>
	<script>
	// Set a flag before the install form POST so the wizard page can play
	// a forward transition when it loads after the HX-Redirect.
	(function() {
		var form = document.getElementById('installForm');
		if (!form) return;
		form.addEventListener('htmx:beforeRequest', function() {
			sessionStorage.setItem('wizard-transition', '0');
		});
	})();
	</script>
}
