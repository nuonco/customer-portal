package workflows

import "github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/components"

// StackGroupCard renders the detail card for a stack step group.
// Shows platform-specific setup content (AWS CloudFormation, GCP Terraform, Azure ARM).
templ StackGroupCard(props WorkflowOverviewProps) {
	{{ group := props.StepGroups[props.SelectedGroup] }}
	<div class="card-base !p-0" style="border-top: 2px solid var(--theme-primary)">
		if group.Status == "not_started" {
			<div class="flex items-center gap-3 px-4 py-3">
				<i class="ph-bold ph-circle text-cool-grey-300 dark:text-cool-grey-600 text-base"></i>
				<span class="text-sm text-cool-grey-500 dark:text-cool-grey-400 italic">Waiting to start</span>
			</div>
		} else {
			switch props.Platform {
			case "gcp":
				@stackGroupGCP(props, group)
			case "azure":
				@stackGroupAzure(props, group)
			default:
				@stackGroupAWS(props, group)
			}
		}
	</div>
}

templ stackGroupAWS(props WorkflowOverviewProps, group StepGroup) {
	<div class="flex items-center justify-between px-4 py-3" style="border-bottom: 1px solid var(--theme-border-subtle)">
		<h4 class="text-sm font-medium" style="color: var(--theme-primary)">AWS CloudFormation</h4>
		@groupStatusBadge(group.Status)
	</div>
	<div class="px-4 py-3">
		if props.StackSetup.CloudFormationLink != "" {
			<p class="text-sm">Complete setup in AWS Console</p>
		} else {
			<p class="text-sm text-[var(--theme-text-muted)] italic">Preparing CloudFormation stack...</p>
		}
	</div>
	<div class="flex items-center justify-end gap-2 px-4 py-3" style="border-top: 1px solid var(--theme-border-subtle)">
		if props.StackSetup.CloudFormationLink != "" {
			<a
				href={ templ.SafeURL(props.StackSetup.CloudFormationLink) }
				target="_blank"
				rel="noopener noreferrer"
				class="button button-primary btn-theme-primary inline-flex items-center gap-2 text-sm"
			>
				Open in AWS
				<i class="ph-bold ph-arrow-square-out text-base"></i>
			</a>
		}
		@groupActionButtons(props, group)
	</div>
}

templ stackGroupGCP(props WorkflowOverviewProps, group StepGroup) {
	<div class="flex items-center justify-between px-4 py-3" style="border-bottom: 1px solid var(--theme-border-subtle)">
		<h4 class="text-sm font-medium" style="color: var(--theme-primary)">GCP Stack Setup</h4>
		@groupStatusBadge(group.Status)
	</div>
	<div class="px-4 py-3 space-y-4">
		<div>
			<p class="text-sm font-medium mb-1">1. Clone the install stack module</p>
			@components.CodeBlock("git clone https://github.com/nuonco/install-stacks.git\ncd install-stacks/gcp", "bash")
		</div>
		<div>
			<p class="text-sm font-medium mb-1">2. Configure remote state (recommended)</p>
			<p class="text-xs text-[var(--theme-text-muted)] mb-2">Create a <code class="text-xs">backend.tf</code> file to store Terraform state in GCS</p>
			@components.CodeBlock(GcpBackendSnippet(props.StackSetup.NuonInstallID), "hcl")
		</div>
		if props.StackSetup.TfvarsContent != "" {
			<div>
				<p class="text-sm font-medium mb-1">3. Save the install configuration</p>
				<p class="text-xs text-[var(--theme-text-muted)] mb-2">Save this as <code class="text-xs">install.tfvars</code></p>
				@components.CodeBlock(props.StackSetup.TfvarsContent, "hcl")
			</div>
		}
		<div>
			<p class="text-sm font-medium mb-1">4. Apply with Terraform</p>
			@components.CodeBlock(GcpApplyCmd(), "bash")
		</div>
	</div>
	@groupCardFooter(props, group)
}

templ stackGroupAzure(props WorkflowOverviewProps, group StepGroup) {
	<div class="flex items-center justify-between px-4 py-3" style="border-bottom: 1px solid var(--theme-border-subtle)">
		<h4 class="text-sm font-medium" style="color: var(--theme-primary)">Azure Stack Setup</h4>
		@groupStatusBadge(group.Status)
	</div>
	<div class="px-4 py-3 space-y-4">
		<div>
			<p class="text-sm font-medium mb-1">1. Login to Azure</p>
			@components.CodeBlock("az login", "bash")
		</div>
		if props.StackSetup.NuonInstallID != "" && props.StackSetup.AzureLocation != "" {
			<div>
				<p class="text-sm font-medium mb-1">2. Create resource group</p>
				@components.CodeBlock("az group create --name " + props.StackSetup.NuonInstallID + "-rg --location " + props.StackSetup.AzureLocation, "bash")
			</div>
		}
		if props.StackSetup.AzureTemplateURL != "" {
			<div>
				<p class="text-sm font-medium mb-1">3. Deploy stack</p>
				@components.CodeBlock("az stack group create --name " + props.StackSetup.NuonInstallID + "-stack --resource-group " + props.StackSetup.NuonInstallID + "-rg --template-uri " + props.StackSetup.AzureTemplateURL + " --deny-settings-mode \"denyDelete\" --aou deleteAll", "bash")
			</div>
			<div class="flex items-center gap-3 text-xs text-[var(--theme-text-muted)]">
				<div class="flex-1" style="border-top: 1px solid var(--theme-border-subtle)"></div>
				<span>— or —</span>
				<div class="flex-1" style="border-top: 1px solid var(--theme-border-subtle)"></div>
			</div>
			<div>
				<p class="text-sm font-medium mb-1">Download install template</p>
				<a
					href={ templ.SafeURL(props.StackSetup.AzureTemplateURL) }
					target="_blank"
					rel="noopener noreferrer"
					class="button button-outline btn-theme-outline inline-flex items-center gap-2 text-sm mt-1"
				>
					Download install template
					<i class="ph-bold ph-download-simple text-base"></i>
				</a>
			</div>
		}
	</div>
	@groupCardFooter(props, group)
}
