package steps

import (
	"fmt"

	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/partials/workflows"
)

func pluralize(count int, singular, plural string) string {
	if count == 1 {
		return singular
	}
	return plural
}

func violationMessage(v workflows.PolicyViolation) string {
	if v.Message != "" {
		return v.Message
	}
	return "Policy check failed"
}

// CurrentStep renders the current step card with approval/cancel buttons
templ CurrentStep(workflow *workflows.WorkflowDataPanel, installID string, basePath string, primaryColor string) {
	<div class="card-base !p-0 mb-3" style={ "border-top: 2px solid " + templ.SafeCSS(primaryColor) }>
		<!-- Header -->
		<div class="flex items-center justify-between px-4 py-3" style="border-bottom: 1px solid var(--theme-border-subtle)">
			<div class="flex items-center gap-2">
				<h4 class="text-sm font-medium" style="color: var(--theme-primary)">{ workflow.CurrentStepName }</h4>
				if workflow.CurrentStepRole != "" {
					<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400">
						<i class="ph-bold ph-shield-check text-xs"></i>
						{ workflow.CurrentStepRole }
					</span>
				}
			</div>
			if workflow.CurrentStepType == "approval-awaiting" {
				<span class="badge-warning text-xs px-2 py-0.5 rounded-full">Awaiting Approval</span>
			} else if workflow.CurrentStepType == "in-progress" {
				<span class="badge-info inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full">
					<i class="ph-bold ph-circle-notch animate-spin text-xs"></i>
					In Progress
				</span>
			} else if workflow.CurrentStepType == "completed" || workflow.CurrentStepType == "success" || workflow.CurrentStepType == "approved" {
				<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400">
					<i class="ph-bold ph-check-circle text-xs"></i>
					Completed
				</span>
			} else if workflow.CurrentStepType == "error" {
				<span class="badge-error text-xs px-2 py-0.5 rounded-full">Failed</span>
			} else {
				<span class="badge-neutral text-xs px-2 py-0.5 rounded-full">Pending</span>
			}
		</div>
		<!-- Body -->
		<div class="px-4 py-3" style="border-bottom: 1px solid var(--theme-border-subtle)">
			if workflow.CurrentStepType == "approval-awaiting" {
				<p class="text-sm mt-1">This step requires your approval to continue.</p>
			} else if workflow.CurrentStepType == "in-progress" {
				<p class="text-sm mt-1">This step is currently running.</p>
			} else if workflow.CurrentStepType == "completed" || workflow.CurrentStepType == "success" || workflow.CurrentStepType == "approved" {
				<p class="text-sm mt-1">This step completed successfully.</p>
			} else if workflow.CurrentStepType == "error" {
				<p class="text-sm mt-1">This step failed.</p>
			} else {
				<p class="text-sm mt-1">This step is pending.</p>
			}
		</div>
		<!-- Policy Evaluation -->
		if workflow.HasPolicyData {
			<div style="border-bottom: 1px solid var(--theme-border-subtle)">
				<!-- Policy header -->
				<div class="flex items-center justify-between px-4 py-3">
					<span class="text-sm font-medium" style="color: var(--theme-text)">Policy Evaluations</span>
					<div class="flex items-center gap-2">
						if len(workflow.DenyViolations) > 0 {
							<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400">
								<i class="ph-bold ph-x-circle text-xs"></i>
								{ fmt.Sprintf("%d", len(workflow.DenyViolations)) } { pluralize(len(workflow.DenyViolations), "Deny", "Denies") }
							</span>
						}
						if len(workflow.WarnViolations) > 0 {
							<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400">
								<i class="ph-bold ph-warning text-xs"></i>
								{ fmt.Sprintf("%d", len(workflow.WarnViolations)) } { pluralize(len(workflow.WarnViolations), "Warning", "Warnings") }
							</span>
						}
						if len(workflow.DenyViolations) == 0 && len(workflow.WarnViolations) == 0 {
							<span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400">
								<i class="ph-bold ph-check-circle text-xs"></i>
								Passed
							</span>
						}
					</div>
				</div>
				<!-- Violations -->
				if len(workflow.DenyViolations) > 0 {
					<details class="group" style="border-top: 1px solid var(--theme-border-subtle)">
						<summary class="flex items-center gap-2 px-4 py-2.5 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
							<i class="ph-bold ph-caret-right text-xs transition-transform group-open:rotate-90" style="color: var(--theme-text-muted)"></i>
							<i class="ph-bold ph-x-circle text-sm text-red-600 dark:text-red-500"></i>
							<span class="text-sm font-medium" style="color: var(--theme-text)">
								{ fmt.Sprintf("%d", len(workflow.DenyViolations)) } Policy { pluralize(len(workflow.DenyViolations), "Violation", "Violations") }
							</span>
						</summary>
						<ul class="px-4 pb-3 space-y-1.5">
							for _, v := range workflow.DenyViolations {
								<li class="flex items-start gap-2 text-red-700 dark:text-red-400">
									<i class="ph-bold ph-caret-right text-xs mt-1 shrink-0"></i>
									<span class="text-xs">{ violationMessage(v) }</span>
								</li>
							}
						</ul>
					</details>
				}
				if len(workflow.WarnViolations) > 0 {
					<details class="group" style="border-top: 1px solid var(--theme-border-subtle)">
						<summary class="flex items-center gap-2 px-4 py-2.5 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
							<i class="ph-bold ph-caret-right text-xs transition-transform group-open:rotate-90" style="color: var(--theme-text-muted)"></i>
							<i class="ph-bold ph-warning text-sm text-orange-600 dark:text-orange-500"></i>
							<span class="text-sm font-medium" style="color: var(--theme-text)">
								{ fmt.Sprintf("%d", len(workflow.WarnViolations)) } Policy { pluralize(len(workflow.WarnViolations), "Warning", "Warnings") }
							</span>
						</summary>
						<ul class="px-4 pb-3 space-y-1.5">
							for _, v := range workflow.WarnViolations {
								<li class="flex items-start gap-2 text-orange-700 dark:text-orange-400">
									<i class="ph-bold ph-caret-right text-xs mt-1 shrink-0"></i>
									<span class="text-xs">{ violationMessage(v) }</span>
								</li>
							}
						</ul>
					</details>
				}
			</div>
		}
		<!-- Footer -->
		<div class="flex items-center justify-end gap-2 px-4 py-3">
			if workflow.HasApprovalSteps && workflow.CanApproveAll {
				<button
					type="button"
					class="button button-primary workflow-approve-all-btn inline-flex items-center gap-2 text-sm font-medium text-white bg-theme-primary hover:bg-theme-primary-hover rounded px-3 py-1.5"
					data-endpoint={ basePath + "/installs/" + installID + "/workflows/" + workflow.ID + "/approve-all" }
				>
					Approve
				</button>
			}
			if workflow.CanCancel {
				<button
					type="button"
					class="button button-neutral workflow-cancel-btn btn-theme-outline text-sm"
					data-endpoint={ basePath + "/installs/" + installID + "/workflows/" + workflow.ID + "/cancel" }
					data-workflow-name={ workflow.Name }
				>
					Cancel
				</button>
			}
		</div>
	</div>
}
