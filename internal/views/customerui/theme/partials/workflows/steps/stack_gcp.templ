package steps

import "github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/partials/workflows"

// StackGCP renders the 4-step GCP install stack setup guide.
templ StackGCP(stackSetup workflows.StackSetupData, workflow *workflows.WorkflowDataPanel, installID string, basePath string) {
	<div class="card-base !p-0 mb-3" style="border-top: 2px solid var(--theme-primary)">
		<!-- Header -->
		<div class="flex items-center justify-between px-4 py-3" style="border-bottom: 1px solid var(--theme-border-subtle)">
			<h4 class="text-sm font-medium" style="color: var(--theme-primary)">GCP Stack Setup</h4>
			if workflow != nil && workflow.HasApprovalSteps && workflow.CanApproveAll {
				<button
					type="button"
					class="button button-primary workflow-approve-all-btn inline-flex items-center gap-2 text-sm font-medium text-white bg-theme-primary hover:bg-theme-primary-hover rounded px-3 py-1.5"
					data-endpoint={ basePath + "/installs/" + installID + "/workflows/" + workflow.ID + "/approve-all" }
				>
					Approve Installation
				</button>
			}
		</div>
		<!-- Body: 4-step guide -->
		<div class="px-4 py-3 space-y-4">
			<!-- Step 1: Clone -->
			<div>
				<p class="text-sm font-medium mb-1">1. Clone the install stack module</p>
				<div class="gcp-setup-code-block">
					<pre class="text-xs overflow-x-auto"><code>git clone https://github.com/nuonco/install-stacks.git
cd install-stacks/gcp</code></pre>
					<button type="button" class="gcp-copy-btn" onclick={ copyToClipboard("git clone https://github.com/nuonco/install-stacks.git\ncd install-stacks/gcp") }>
						<i class="ph-bold ph-copy text-sm"></i>
					</button>
				</div>
			</div>
			<!-- Step 2: Configure remote state -->
			<div>
				<p class="text-sm font-medium mb-1">2. Configure remote state (recommended)</p>
				<p class="text-xs text-[var(--theme-text-muted)] mb-2">Create a <code class="text-xs">backend.tf</code> file to store Terraform state in GCS</p>
				<div class="gcp-setup-code-block">
					<pre class="text-xs overflow-x-auto"><code>{ workflows.GcpBackendSnippet(stackSetup.NuonInstallID) }</code></pre>
					<button type="button" class="gcp-copy-btn" onclick={ copyToClipboard(workflows.GcpBackendSnippet(stackSetup.NuonInstallID)) }>
						<i class="ph-bold ph-copy text-sm"></i>
					</button>
				</div>
			</div>
			<!-- Step 3: Save install configuration -->
			if stackSetup.TfvarsContent != "" {
				<div>
					<p class="text-sm font-medium mb-1">3. Save the install configuration</p>
					<p class="text-xs text-[var(--theme-text-muted)] mb-2">Save this as <code class="text-xs">install.tfvars</code></p>
					<div class="gcp-setup-code-block">
						<pre class="text-xs overflow-x-auto"><code>{ stackSetup.TfvarsContent }</code></pre>
						<button type="button" class="gcp-copy-btn" onclick={ copyToClipboard(stackSetup.TfvarsContent) }>
							<i class="ph-bold ph-copy text-sm"></i>
						</button>
					</div>
				</div>
			}
			<!-- Step 4: Apply with Terraform -->
			<div>
				<p class="text-sm font-medium mb-1">4. Apply with Terraform</p>
				<p class="text-xs text-[var(--theme-text-muted)] mb-2">Initialize and apply the Terraform configuration.</p>
				<div class="gcp-setup-code-block">
					<pre class="text-xs overflow-x-auto"><code>{ workflows.GcpApplyCmd() }</code></pre>
					<button type="button" class="gcp-copy-btn" onclick={ copyToClipboard(workflows.GcpApplyCmd()) }>
						<i class="ph-bold ph-copy text-sm"></i>
					</button>
				</div>
			</div>
		</div>
		<!-- Footer -->
		if workflow != nil && workflow.CanCancel {
			<div class="flex items-center justify-end gap-2 px-4 py-3" style="border-top: 1px solid var(--theme-border-subtle)">
				<button
					type="button"
					class="button button-neutral workflow-cancel-btn btn-theme-outline text-sm"
					data-endpoint={ basePath + "/installs/" + installID + "/workflows/" + workflow.ID + "/cancel" }
					data-workflow-name={ workflow.Name }
				>
					Cancel
				</button>
			</div>
		}
	</div>
}

script copyToClipboard(text string) {
	navigator.clipboard.writeText(text).then(function() {
		if (typeof showToast === 'function') showToast('Copied to clipboard', 'success');
	});
}
