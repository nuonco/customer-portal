package steps

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/components"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/partials/workflows"
)

// StackAzure renders the Azure stack setup guide.
templ StackAzure(stackSetup workflows.StackSetupData, workflow *workflows.WorkflowDataPanel, installID string, basePath string) {
	<div class="card-base !p-0 mb-3" style="border-top: 2px solid var(--theme-primary)">
		<!-- Header -->
		<div class="flex items-center justify-between px-4 py-3" style="border-bottom: 1px solid var(--theme-border-subtle)">
			<h4 class="text-sm font-medium" style="color: var(--theme-primary)">Azure Stack Setup</h4>
			if workflow != nil && workflow.HasApprovalSteps && workflow.CanApproveAll {
				<button
					type="button"
					class="button button-primary workflow-approve-all-btn btn-theme-primary inline-flex items-center gap-2 text-sm px-3 py-1.5"
					data-endpoint={ basePath + "/installs/" + installID + "/workflows/" + workflow.ID + "/approve-all" }
				>
					Approve
				</button>
			}
		</div>
		<!-- Body: Azure CLI steps -->
		<div class="px-4 py-3 space-y-4">
			<!-- Step 1: Login -->
			<div>
				<p class="text-sm font-medium mb-1">1. Login to Azure</p>
				@components.CodeBlock("az login", "bash")
			</div>
			<!-- Step 2: Create resource group -->
			<div>
				<p class="text-sm font-medium mb-1">2. Create resource group</p>
				@components.CodeBlock("az group create --name " + stackSetup.NuonInstallID + "-rg --location " + stackSetup.AzureLocation, "bash")
			</div>
			<!-- Step 3: Deploy stack -->
			<div>
				<p class="text-sm font-medium mb-1">3. Deploy stack</p>
				@components.CodeBlock("az stack group create --name " + stackSetup.NuonInstallID + "-stack --resource-group " + stackSetup.NuonInstallID + "-rg --template-uri " + stackSetup.AzureTemplateURL + " --deny-settings-mode \"denyDelete\" --aou deleteAll", "bash")
			</div>
			<!-- Divider -->
			<div class="flex items-center gap-3 text-xs text-[var(--theme-text-muted)]">
				<div class="flex-1" style="border-top: 1px solid var(--theme-border-subtle)"></div>
				<span>— or —</span>
				<div class="flex-1" style="border-top: 1px solid var(--theme-border-subtle)"></div>
			</div>
			<!-- Template download -->
			<div>
				<p class="text-sm font-medium mb-1">Download install template</p>
				@components.CodeBlock(stackSetup.AzureTemplateURL, "")
				<a
					href={ templ.SafeURL(stackSetup.AzureTemplateURL) }
					target="_blank"
					rel="noopener noreferrer"
					class="button button-outline btn-theme-outline inline-flex items-center gap-2 text-sm mt-2"
				>
					Download install template
					<i class="ph-bold ph-download-simple text-base"></i>
				</a>
			</div>
		</div>
		<!-- Footer -->
		if workflow != nil && workflow.CanCancel {
			<div class="flex items-center justify-end gap-2 px-4 py-3" style="border-top: 1px solid var(--theme-border-subtle)">
				<button
					type="button"
					class="button button-neutral workflow-cancel-btn btn-theme-outline text-sm"
					data-endpoint={ basePath + "/installs/" + installID + "/workflows/" + workflow.ID + "/cancel" }
					data-workflow-name={ workflow.Name }
				>
					Cancel
				</button>
			</div>
		}
	</div>
}
