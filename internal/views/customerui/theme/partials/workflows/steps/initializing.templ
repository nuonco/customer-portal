package steps

import "github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/partials/workflows"

// Initializing renders the initializing spinner card
templ Initializing(workflow *workflows.WorkflowDataPanel, primaryColor string) {
	<div class="card-base !p-0 mb-3" style={ "border-top: 2px solid " + templ.SafeCSS(primaryColor) }>
		<div class="flex items-center gap-3 px-4 py-3">
			<i class="ph-bold ph-circle-notch animate-spin text-base" style="color: var(--theme-primary)"></i>
			<div>
				<h4 class="text-sm font-medium">{ workflow.CurrentStepName }</h4>
				<p class="text-xs text-[var(--theme-text-muted)] mt-0.5">Your install is being set up. This may take a moment.</p>
			</div>
		</div>
	</div>
}
