package pages

import (
	"fmt"

	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/components"
)

// WorkflowGroup represents a group of workflows for a specific date
type WorkflowGroup struct {
	Date        string
	DisplayDate string
	Workflows   []customerui.WorkflowData
}

// WorkflowsPageProps contains all data needed for the workflows page
type WorkflowsPageProps struct {
	LayoutProps        customerui.LayoutProps
	Install            *models.Install
	WorkflowGroups     []WorkflowGroup
	CloudFormationLink string
	CurrentOffset      int
	Limit              int
	HasNext            bool
	HasPrev            bool
	NextOffset         int
	PrevOffset         int
}

// WorkflowsPage renders the workflow history page for an install
templ WorkflowsPage(props WorkflowsPageProps) {
	@customerui.Layout(props.LayoutProps) {
		<div class="max-w-5xl mx-auto px-4 py-8">
			<!-- Header with back button -->
			<div class="mb-8">
				<a href={ templ.SafeURL(props.LayoutProps.BasePath + "/installs/" + props.Install.ID) } class="inline-flex items-center text-sm text-cool-grey-600 dark:text-cool-grey-400 hover:text-cool-grey-900 dark:hover:text-white mb-4">
					<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
					</svg>
					Back to Install
				</a>
				<h1 class="text-3xl font-heading font-bold text-cool-grey-900 dark:text-white">Workflow History</h1>
				<p class="text-cool-grey-600 dark:text-cool-grey-400 mt-2">{ props.Install.Name }</p>
			</div>
			<!-- CloudFormation Link if available -->
			if props.CloudFormationLink != "" {
				<div class="mb-6 p-4 bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-800" style="border-radius: var(--theme-radius)">
					<div class="flex items-center justify-between">
						<div>
							<h3 class="text-sm font-medium text-blue-800 dark:text-blue-300">AWS CloudFormation</h3>
							<p class="text-sm text-blue-600 dark:text-blue-400 mt-1">View and manage your infrastructure in AWS Console</p>
						</div>
						<a
							href={ templ.SafeURL(props.CloudFormationLink) }
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700"
							style="border-radius: var(--theme-radius)"
						>
							Open in AWS
							<svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
							</svg>
						</a>
					</div>
				</div>
			}
			<!-- Workflow Groups -->
			if len(props.WorkflowGroups) == 0 {
				<div class="text-center py-12">
					<svg class="mx-auto h-12 w-12 text-cool-grey-400 dark:text-cool-grey-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
					</svg>
					<h3 class="mt-4 text-lg font-medium text-cool-grey-900 dark:text-white">No workflows yet</h3>
					<p class="mt-2 text-sm text-cool-grey-600 dark:text-cool-grey-400">Workflow history will appear here once updates are triggered.</p>
				</div>
			} else {
				<div class="space-y-8">
					for _, group := range props.WorkflowGroups {
						<div>
							<h2 class="text-lg font-semibold text-cool-grey-700 dark:text-cool-grey-300 mb-4">{ group.DisplayDate }</h2>
							<div class="space-y-4">
								for _, workflow := range group.Workflows {
									@components.WorkflowCard(components.WorkflowCardProps{
										Workflow:     workflow,
										InstallID:    props.Install.ID,
										BasePath:     props.LayoutProps.BasePath,
										PrimaryColor: props.LayoutProps.PrimaryColor,
									})
								}
							</div>
						</div>
					}
				</div>
				<!-- Pagination -->
				if props.HasPrev || props.HasNext {
					<div class="mt-8 flex items-center justify-between">
						<div>
							if props.HasPrev {
								<a
									href={ templ.SafeURL(fmt.Sprintf("%s/installs/%s/workflows?offset=%d", props.LayoutProps.BasePath, props.Install.ID, props.PrevOffset)) }
									class="inline-flex items-center px-4 py-2 text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 bg-white dark:bg-dark-grey-800 border border-cool-grey-300 dark:border-dark-grey-600 hover:bg-cool-grey-50 dark:hover:bg-dark-grey-700"
									style="border-radius: var(--theme-radius)"
								>
									<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
									</svg>
									Previous
								</a>
							}
						</div>
						<div>
							if props.HasNext {
								<a
									href={ templ.SafeURL(fmt.Sprintf("%s/installs/%s/workflows?offset=%d", props.LayoutProps.BasePath, props.Install.ID, props.NextOffset)) }
									class="inline-flex items-center px-4 py-2 text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 bg-white dark:bg-dark-grey-800 border border-cool-grey-300 dark:border-dark-grey-600 hover:bg-cool-grey-50 dark:hover:bg-dark-grey-700"
									style="border-radius: var(--theme-radius)"
								>
									Next
									<svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
									</svg>
								</a>
							}
						</div>
					</div>
				}
			}
		</div>
		@workflowScripts()
	}
}

templ workflowScripts() {
	<script>
		function confirmApproveAll(btn) {
			showConfirmModal({
				title: 'Approve All Steps',
				message: 'This will automatically approve all future approval steps in this workflow. Are you sure?',
				confirmText: 'Approve All',
				cancelText: 'Cancel'
			}).then(function(confirmed) {
				if (confirmed) {
					htmx.trigger(btn, 'confirmed');
				}
			});
		}

		function confirmCancelWorkflow(btn) {
			showConfirmModal({
				title: 'Cancel Workflow',
				message: 'This will cancel the workflow. This action cannot be undone. Are you sure?',
				confirmText: 'Cancel Workflow',
				cancelText: 'Keep Running'
			}).then(function(confirmed) {
				if (confirmed) {
					htmx.trigger(btn, 'confirmed');
				}
			});
		}
	</script>
}
