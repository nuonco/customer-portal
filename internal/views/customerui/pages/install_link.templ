package pages

import (
	"github.com/powertoolsdev/mono/exp/installer/app/internal/models"
	"github.com/powertoolsdev/mono/exp/installer/app/internal/views/customerui"
)

// InstallLinkPageProps for the install link acceptance page
type InstallLinkPageProps struct {
	customerui.LayoutProps
	Link *models.InstallLink
}

// InstallLinkPage renders the install link acceptance page
templ InstallLinkPage(props InstallLinkPageProps) {
	@customerui.Layout(props.LayoutProps) {
		<div class="max-w-lg mx-auto mt-10">
			<div class="bg-white dark:bg-dark-grey-900 p-8 shadow-md border border-cool-grey-300 dark:border-dark-grey-500 text-center rounded-lg">
				<div class="mb-6">
					<h3 class="text-xl text-cool-grey-800 dark:text-cool-grey-200">{ props.Link.AppName }</h3>
					<p class="text-cool-grey-600 dark:text-cool-grey-400">provided by { props.Link.NuonOrg.Name }</p>
				</div>
				<p class="text-cool-grey-700 dark:text-cool-grey-300 mb-6">
					You've been invited to install this application. Please provide your email to create an account and proceed with the installation.
				</p>
				<form id="installForm" class="space-y-4">
					<input type="hidden" id="sha" value={ props.Link.SHA }/>
					<div>
						<label for="email" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300 mb-1">Email Address</label>
						<input
							type="email"
							id="email"
							required
							class={ "w-full px-4 py-2 border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-800 dark:text-white focus:outline-none focus:ring-2 focus:border-primary-600 rounded-lg",
								templ.KV("focus:ring-theme-primary", props.PrimaryColor != ""),
								templ.KV("focus:ring-primary-400", props.PrimaryColor == "") }
							placeholder="Enter your email"
						/>
					</div>
					<div class="bg-cool-grey-50 dark:bg-dark-grey-800 border border-cool-grey-200 dark:border-dark-grey-600 p-3 rounded-lg">
						<p class="text-sm text-cool-grey-800 dark:text-cool-grey-200">
							<strong>Deployment Region:</strong> { props.Link.Install.Region }
						</p>
						<p class="text-xs text-cool-grey-600 dark:text-cool-grey-400 mt-1">
							This region was pre-configured by the vendor when creating the install link.
						</p>
					</div>
					<button
						type="submit"
						class={ "w-full text-white py-3 px-4 focus:outline-none focus:ring-2 focus:ring-primary-400 font-semibold rounded-lg",
							templ.KV("bg-theme-primary hover:bg-theme-primary-hover", props.PrimaryColor != ""),
							templ.KV("bg-primary-600 hover:bg-primary-700", props.PrimaryColor == "") }
					>
						Create Install
					</button>
				</form>
				<div id="error" class="mt-4 p-3 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-300 hidden rounded-lg"></div>
				<div id="success" class="mt-4 p-3 bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-800 text-green-700 dark:text-green-300 hidden rounded-lg"></div>
			</div>
			<div class="mt-8 bg-cool-grey-100 dark:bg-dark-grey-800 p-6 rounded-lg">
				<h4 class="mb-2 text-cool-grey-900 dark:text-white">What happens next?</h4>
				<ul class="text-sm text-cool-grey-700 dark:text-cool-grey-300 space-y-1">
					<li>• We'll create a customer account for you</li>
					<li>• Your application will be deployed to your chosen region</li>
					<li>• You'll receive a login token to manage your installation</li>
					<li>• The installation process typically takes 5-10 minutes</li>
				</ul>
			</div>
		</div>
		<!-- Config data for JavaScript -->
		<div id="install-link-config" class="hidden" data-base-path={ props.BasePath }></div>
		@installLinkScript()
	}
}

templ installLinkScript() {
	<script>
		document.getElementById('installForm').addEventListener('submit', async function(e) {
			e.preventDefault();

			var config = document.getElementById('install-link-config');
			var basePath = config.dataset.basePath;

			var formData = {
				sha: document.getElementById('sha').value,
				email: document.getElementById('email').value
			};

			var errorDiv = document.getElementById('error');
			var successDiv = document.getElementById('success');
			var submitButton = e.target.querySelector('button[type="submit"]');

			// Hide previous messages
			errorDiv.classList.add('hidden');
			successDiv.classList.add('hidden');

			// Show loading state
			submitButton.textContent = 'Creating Install...';
			submitButton.disabled = true;

			try {
				var response = await fetch(basePath + '/install-link', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
					},
					body: JSON.stringify(formData)
				});

				var data = await response.json();

				if (response.ok) {
					// Store the JWT token as a cookie (replaces any existing session)
					document.cookie = 'jwt=' + data.token + '; path=/; max-age=' + (60 * 60 * 24); // 24 hours

					successDiv.innerHTML = '<p class="font-semibold">Installation created successfully!</p><p class="text-sm mt-2">You will be redirected to your dashboard in 3 seconds...</p>';
					successDiv.classList.remove('hidden');

					// Redirect after 3 seconds
					setTimeout(function() {
						window.location.href = basePath + '/installs';
					}, 3000);
				} else {
					errorDiv.textContent = data.error || 'Failed to create installation';
					errorDiv.classList.remove('hidden');
				}
			} catch (error) {
				errorDiv.textContent = 'Network error. Please try again.';
				errorDiv.classList.remove('hidden');
			} finally {
				// Reset button
				submitButton.textContent = 'Create Install';
				submitButton.disabled = false;
			}
		});
	</script>
}
