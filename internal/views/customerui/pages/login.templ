package pages

import (
	"github.com/powertoolsdev/mono/exp/installer/app/internal/models"
)

// LoginPageProps for the customer login page
type LoginPageProps struct {
	Title       string
	ButtonText  string
	HelpText    string
	BasePath    string
	RedirectURL string
	Theme       *models.AppTheme
}

// LoginPage renders the customer login page
templ LoginPage(props LoginPageProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.Title }</title>
			<link href="/static/css/customer.css" rel="stylesheet"/>
			@loginDarkModeScript()
			@loginFontLinks(props.Theme)
			<script src="https://unpkg.com/htmx.org@1.9.10"></script>
			@loginThemeStyles(props.Theme)
		</head>
		<body class="bg-cool-grey-50 dark:bg-dark-grey-950 dark:text-white">
			<nav class="bg-theme-primary text-white p-4">
				<div class="container mx-auto flex justify-between items-center">
					<div class="flex items-center space-x-3">
						if props.Theme != nil && props.Theme.LogoBase64 != "" {
							<img src={ props.Theme.LogoBase64 } alt="Logo" class="h-8 w-auto max-w-xs object-contain"/>
						}
						<h1 class="text-xl font-heading font-semibold">{ props.Title }</h1>
					</div>
				</div>
			</nav>
			<main class="container mx-auto p-4">
				<div class="max-w-md mx-auto bg-white dark:bg-dark-grey-900 shadow-md border border-cool-grey-300 dark:border-dark-grey-500 p-6 mt-10" style="border-radius: var(--theme-radius)">
					<h2 class="text-2xl font-bold mb-6 text-center text-cool-grey-900 dark:text-white">{ props.Title }</h2>
					<form id="loginForm" class="space-y-4">
						<div>
							<label for="email" class="block text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300">
								Email
							</label>
							<input
								type="email"
								id="email"
								name="email"
								required
								class="mt-1 block w-full px-3 py-2 border border-cool-grey-300 dark:border-dark-grey-500 dark:bg-dark-grey-800 dark:text-white shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-400 focus:border-primary-600"
								style="border-radius: var(--theme-radius)"
								placeholder="Enter your email"
							/>
						</div>
						<button
							type="submit"
							class="w-full bg-theme-primary hover:bg-theme-primary-hover text-white py-2 px-4 focus:outline-none focus:ring-2 focus:ring-primary-500"
							style="border-radius: var(--theme-radius)"
						>
							{ props.ButtonText }
						</button>
					</form>
					if props.HelpText != "" {
						<p class="mt-4 text-sm text-cool-grey-600 dark:text-cool-grey-400 text-center">
							{ props.HelpText }
						</p>
					}
					<div
						id="error"
						class="mt-4 p-3 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-800 text-red-700 dark:text-red-300 hidden"
						style="border-radius: var(--theme-radius)"
					></div>
				</div>
			</main>
			<!-- Config data for JavaScript -->
			<div id="login-config" class="hidden" data-login-url={ props.BasePath + "/login/" } data-redirect-url={ props.RedirectURL }></div>
			@customerLoginScript()
		</body>
	</html>
}

templ loginDarkModeScript() {
	<script>
		(function() {
			if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
				document.documentElement.classList.add('dark');
			}
			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
				document.documentElement.classList.toggle('dark', e.matches);
			});
		})();
	</script>
}

templ loginFontLinks(theme *models.AppTheme) {
	<link rel="preconnect" href="https://fonts.googleapis.com"/>
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
	if theme != nil && theme.HeadingFontBase64 != "" {
		<style>
			@font-face {
				font-family: 'CustomHeading';
				src: url({ theme.HeadingFontBase64 }) format('woff2');
				font-display: swap;
			}
		</style>
	}
	if theme != nil && theme.BodyFontBase64 != "" {
		<style>
			@font-face {
				font-family: 'CustomBody';
				src: url({ theme.BodyFontBase64 }) format('woff2');
				font-display: swap;
			}
		</style>
	}
}

templ loginThemeStyles(theme *models.AppTheme) {
	if theme != nil {
		@templ.Raw(buildCustomerLoginThemeCSS(theme))
	}
}

func buildCustomerLoginThemeCSS(theme *models.AppTheme) string {
	if theme == nil {
		return ""
	}
	css := "<style>:root {"
	if theme.PrimaryColor != "" {
		css += "--theme-primary: " + theme.PrimaryColor + ";"
		// Darken for hover (simple approximation)
		css += "--theme-primary-hover: " + theme.PrimaryColor + ";"
	}
	if theme.SecondaryColor != "" {
		css += "--theme-secondary: " + theme.SecondaryColor + ";"
	}
	if theme.HeadingFontBase64 != "" {
		css += "--font-heading: 'CustomHeading', 'Inter', ui-sans-serif, system-ui, sans-serif;"
	} else if theme.HeadingFont != "" {
		css += "--font-heading: '" + theme.HeadingFont + "', 'Inter', ui-sans-serif, system-ui, sans-serif;"
	}
	if theme.BodyFontBase64 != "" {
		css += "--font-body: 'CustomBody', 'Inter', ui-sans-serif, system-ui, sans-serif;"
	} else if theme.BodyFont != "" {
		css += "--font-body: '" + theme.BodyFont + "', 'Inter', ui-sans-serif, system-ui, sans-serif;"
	}
	// Border radius
	switch theme.BorderRadius {
	case "sharp":
		css += "--theme-radius: 0;"
	case "subtle":
		css += "--theme-radius: 4px;"
	case "very-rounded":
		css += "--theme-radius: 12px;"
	default:
		css += "--theme-radius: 8px;"
	}
	css += "}</style>"
	return css
}

templ customerLoginScript() {
	<script>
		(function() {
			var config = document.getElementById("login-config");
			var loginURL = config.dataset.loginUrl;
			var redirectTo = config.dataset.redirectUrl;

			document.getElementById("loginForm").addEventListener("submit", async function(e) {
				e.preventDefault();

				var email = document.getElementById("email").value;
				var errorDiv = document.getElementById("error");

				try {
					var response = await fetch(loginURL, {
						method: "POST",
						headers: {
							"Content-Type": "application/json"
						},
						body: JSON.stringify({ email: email })
					});

					var data = await response.json();

					if (response.ok) {
						document.cookie = "jwt=" + encodeURIComponent(data.token) + "; path=/";
						window.location.href = redirectTo;
					} else {
						errorDiv.textContent = data.message || "Login failed";
						errorDiv.classList.remove("hidden");
					}
				} catch (error) {
					errorDiv.textContent = "Network error. Please try again.";
					errorDiv.classList.remove("hidden");
				}
			});
		})();
	</script>
}
