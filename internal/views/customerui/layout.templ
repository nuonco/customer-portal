package customerui

import (
	"github.com/nuonco/mono/services/customer-dashboard/internal/models"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/partials"
	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui/theme/scripts"
)

// NOTE: LayoutProps is defined in customerui/types.go

// Layout renders the customer layout with header, content area, and footer
templ Layout(props LayoutProps) {
	<!DOCTYPE html>
	<html lang="en" class={ "h-full", templ.KV("dark", props.ThemeMode == "dark"), templ.KV("light", props.ThemeMode == "light") } data-theme-mode={ props.ThemeMode }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.Title }</title>
			if props.FaviconBase64 != "" {
				<link rel="icon" href={ templ.SafeURL(props.FaviconBase64) }/>
			}

			<!-- Customer CSS -->
			<link href={ props.CSSPath } rel="stylesheet"/>
			if props.CustomCSSPath != "" {
				<link href={ props.CustomCSSPath } rel="stylesheet"/>
			}

			<!-- Phosphor icon font (Bold weight) -->
			<link href="/static/css/phosphor-bold.css" rel="stylesheet"/>

			<!-- Dark mode detection -->
			@scripts.DarkMode(props.ThemeMode)

			<!-- Font loading -->
			@fontLinks(props)

			<!-- Theme CSS variables -->
			@themeStyles(props)

			<!-- HTMX for dynamic interactions -->
			<script src="https://unpkg.com/htmx.org@1.9.10"></script>
		</head>
		<body class={ "bg-cool-grey-50 dark:bg-dark-grey-950 dark:text-white min-h-screen flex flex-col", props.RadiusClass, templ.KV("pt-10", props.User != nil && props.User.Role == models.RoleVendor), templ.KV("has-vendor-bar", props.User != nil && props.User.Role == models.RoleVendor) }>
			<!-- Auth helpers -->
			@scripts.Auth(props.BasePath)

			<!-- Vendor admin bar (visible only when a vendor previews the customer portal) -->
			if props.User != nil && props.User.Role == models.RoleVendor {
				@partials.VendorAdminBar(partials.VendorAdminBarProps{
					User:         props.User,
					AdminURL:     props.AdminURL,
					OrgName:      props.OrgName,
					PortalDomain: props.PortalDomain,
				})
			}

			<!-- Header -->
			@partials.Header(partials.HeaderProps{
				Theme:            convertPropsToTheme(props),
				User:             props.User,
				BasePath:         props.BasePath,
				HasPublishedApps: props.HasPublishedApps,
				ActiveNav:        props.ActiveNav,
				HeaderTitle:      props.HeaderTitle,
			})

			<!-- Main wrapper for panel support -->
			<div id="main-wrapper" class="main-wrapper">
				<!-- Main content -->
				<main class="mx-auto px-6 lg:px-8 pt-6 flex-1 w-full max-w-5xl">
					{ children... }
				</main>

				<!-- Footer -->
				@partials.Footer(partials.FooterProps{
					Theme: convertPropsToTheme(props),
				})
			</div>

			<!-- Toast notifications -->
			@partials.Toast()

			<!-- Modals -->
			@partials.ConfirmModal()
			@partials.PromptModal()
		</body>
	</html>
}

// fontLinks generates font loading links
templ fontLinks(props LayoutProps) {
	<!-- Inter font (default) -->
	<link rel="preconnect" href="https://fonts.googleapis.com"/>
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>

	<!-- Custom font @font-face declarations are emitted by themeStyles() via buildThemeCSS() -->

	<!-- Google Fonts -->
	if (props.HeadingFont != "" && props.HeadingFontBase64 == "") || (props.BodyFont != "" && props.BodyFontBase64 == "") {
		if props.HeadingFont != "" && props.HeadingFontBase64 == "" && props.BodyFont != "" && props.BodyFontBase64 == "" && props.HeadingFont != props.BodyFont {
			<link href={ "https://fonts.googleapis.com/css2?family=" + props.HeadingFont + ":wght@500;600;700&family=" + props.BodyFont + ":wght@400;500;600&display=swap" } rel="stylesheet"/>
		} else if props.HeadingFont != "" && props.HeadingFontBase64 == "" {
			<link href={ "https://fonts.googleapis.com/css2?family=" + props.HeadingFont + ":wght@400;500;600;700&display=swap" } rel="stylesheet"/>
		} else if props.BodyFont != "" && props.BodyFontBase64 == "" {
			<link href={ "https://fonts.googleapis.com/css2?family=" + props.BodyFont + ":wght@400;500;600;700&display=swap" } rel="stylesheet"/>
		}
	}
}

// themeStyles generates theme CSS variables
templ themeStyles(props LayoutProps) {
	@templ.Raw(buildThemeCSS(props))
}

// buildThemeCSS builds the theme CSS from LayoutProps
func buildThemeCSS(props LayoutProps) string {
	// Build @font-face for custom uploaded fonts using Go string concatenation.
	// This cannot be done in a templ <style> block because templ does not
	// interpolate { expr } expressions inside style element content.
	fontFaceCSS := ""
	if props.HeadingFontBase64 != "" {
		fontFaceCSS += "@font-face{font-family:'CustomHeading';src:url(" + props.HeadingFontBase64 + ") format('woff2');font-display:swap;}"
	}
	if props.BodyFontBase64 != "" {
		fontFaceCSS += "@font-face{font-family:'CustomBody';src:url(" + props.BodyFontBase64 + ") format('woff2');font-display:swap;}"
	}

	css := ""
	if props.PrimaryColor != "" {
		css += "--theme-primary: " + props.PrimaryColor + ";"
		css += "--theme-primary-hover: " + props.PrimaryColorDark + ";"
	}
	if props.SecondaryColor != "" {
		css += "--theme-secondary: " + props.SecondaryColor + ";"
		css += "--theme-secondary-hover: " + props.SecondaryColorDark + ";"
	}
	if props.WhiteColor != "" {
		css += "--theme-white: " + props.WhiteColor + ";"
	}
	blackForRoot := props.BlackColor
	if props.BlackColorLight != "" {
		blackForRoot = props.BlackColorLight
	}
	if blackForRoot != "" {
		css += "--theme-black: " + blackForRoot + ";"
	}
	if props.HeadingFontBase64 != "" {
		css += "--font-heading: 'CustomHeading', 'Inter', ui-sans-serif, system-ui, sans-serif;"
	} else if props.HeadingFont != "" {
		css += "--font-heading: '" + props.HeadingFont + "', 'Inter', ui-sans-serif, system-ui, sans-serif;"
	}
	if props.BodyFontBase64 != "" {
		css += "--font-body: 'CustomBody', 'Inter', ui-sans-serif, system-ui, sans-serif;"
	} else if props.BodyFont != "" {
		css += "--font-body: '" + props.BodyFont + "', 'Inter', ui-sans-serif, system-ui, sans-serif;"
	}
	darkCSS := ""
	if props.PrimaryColorDarkMode != "" {
		darkCSS += "--theme-primary: " + props.PrimaryColorDarkMode + ";"
	}
	if props.SecondaryColorDarkMode != "" {
		darkCSS += "--theme-secondary: " + props.SecondaryColorDarkMode + ";"
	}
	if props.WhiteColorDark != "" {
		darkCSS += "--theme-white: " + props.WhiteColorDark + ";"
	}
	if props.BlackColor != "" {
		darkCSS += "--theme-black: " + props.BlackColor + ";"
	} else {
		darkCSS += "--theme-black: #121212;"
	}
	result := "<style>" + fontFaceCSS
	if css != "" {
		result += ":root{" + css + "}"
	}
	result += ".dark{" + darkCSS + "}</style>"
	return result
}

// convertPropsToTheme converts LayoutProps to a minimal AppTheme for components
func convertPropsToTheme(props LayoutProps) *models.AppTheme {
	return &models.AppTheme{
		LogoLightBase64: props.LogoBase64,
		LogoDarkBase64:  props.LogoDarkBase64,
	}
}
