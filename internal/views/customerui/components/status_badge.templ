package components

// StatusBadgeProps for status indicator badges
type StatusBadgeProps struct {
	Status   string
	Variant  string // "install" | "workflow" | "health"
	Size     string // "sm" | "md"
	ShowIcon bool
}

// StatusBadge renders a status indicator badge
templ StatusBadge(props StatusBadgeProps) {
	{{
		// Determine colors based on status and variant
		bgClass := "bg-cool-grey-100 dark:bg-dark-grey-700"
		textClass := "text-cool-grey-600 dark:text-cool-grey-400"

		switch props.Status {
		case "active", "healthy", "provisioned", "succeeded", "passing":
			bgClass = "bg-green-100 dark:bg-green-900/30"
			textClass = "text-green-800 dark:text-green-300"
		case "pending", "in_progress", "running", "queued":
			bgClass = "bg-blue-100 dark:bg-blue-900/30"
			textClass = "text-blue-800 dark:text-blue-300"
		case "failed", "error", "failing":
			bgClass = "bg-red-100 dark:bg-red-900/30"
			textClass = "text-red-800 dark:text-red-300"
		case "cancelled", "deprovisioned":
			bgClass = "bg-cool-grey-100 dark:bg-dark-grey-700"
			textClass = "text-cool-grey-600 dark:text-cool-grey-400"
		case "needs_approval", "needs_attention":
			bgClass = "bg-orange-100 dark:bg-orange-900/30"
			textClass = "text-orange-800 dark:text-orange-300"
		}

		sizeClass := "px-2 py-0.5 text-xs"
		if props.Size == "md" {
			sizeClass = "px-2.5 py-1 text-sm"
		}
	}}
	<span class={ "inline-flex items-center rounded-full font-medium", bgClass, textClass, sizeClass }>
		{ props.Status }
	</span>
}
