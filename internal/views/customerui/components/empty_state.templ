package components

// EmptyStateProps for empty state display
type EmptyStateProps struct {
	Title   string
	Message string
	Icon    string // "inbox" | "check-circle" | "refresh"
	Compact bool   // Use smaller padding
	Class   string // Additional CSS classes
}

// EmptyState renders an empty state display
templ EmptyState(props EmptyStateProps) {
	<div class={ "text-center", templ.KV("py-12", !props.Compact), templ.KV("py-6", props.Compact), props.Class } style="border-radius: var(--theme-radius)">
		<div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-cool-grey-100 dark:bg-dark-grey-800 mb-4">
			if props.Icon == "check-circle" {
				<svg class="w-8 h-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				</svg>
			} else if props.Icon == "refresh" {
				<svg class="w-8 h-8 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
				</svg>
			} else {
				<svg class="w-8 h-8 text-cool-grey-400 dark:text-cool-grey-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
				</svg>
			}
		</div>
		<h3 class="text-lg font-medium text-cool-grey-900 dark:text-white mb-2">{ props.Title }</h3>
		<p class="text-cool-grey-500 dark:text-cool-grey-400">{ props.Message }</p>
	</div>
}
