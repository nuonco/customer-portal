package components

import (
	"fmt"

	"github.com/nuonco/mono/services/customer-dashboard/internal/views/customerui"
)

// HealthStatusProps defines properties for the HealthStatus component
type HealthStatusProps struct {
	InstallID           string
	HasHealthChecks     bool
	HealthCheckStatuses []customerui.HealthCheckStatusData
	OverallHealthStatus string // "passing", "pending", "failing", ""
	BasePath            string
}

// HealthStatus renders the health check status section with run button
templ HealthStatus(props HealthStatusProps) {
	<div id="health-status">
		if props.HasHealthChecks {
			<div class="mb-4">
				<div class="flex items-center justify-between mb-2">
					<h3 class="text-lg text-cool-grey-700 dark:text-cool-grey-300">Health Status</h3>
					@healthStatusBadge(props.OverallHealthStatus)
				</div>
				if len(props.HealthCheckStatuses) > 0 {
					<details class="bg-cool-grey-50 dark:bg-dark-grey-800" style="border-radius: var(--theme-radius)">
						<summary class="px-3 py-2 cursor-pointer text-sm text-cool-grey-600 dark:text-cool-grey-400 hover:bg-cool-grey-100 dark:hover:bg-dark-grey-700" style="border-radius: var(--theme-radius)">
							View health check details ({ fmt.Sprintf("%d", len(props.HealthCheckStatuses)) } check{ pluralize(len(props.HealthCheckStatuses)) })
						</summary>
						<div class="px-3 pb-3 space-y-2">
							for _, hc := range props.HealthCheckStatuses {
								@healthCheckItem(hc)
							}
						</div>
					</details>
				}
				<!-- Run Health Checks Button with HTMX -->
				<div class="mt-3">
					<button
						hx-post={ props.BasePath + "/installs/" + props.InstallID + "/health-checks/run" }
						hx-target="#health-status"
						hx-swap="outerHTML"
						hx-indicator="this"
						class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-primary-600 bg-primary-50 dark:bg-primary-900/30 border border-primary-200 dark:border-primary-800 hover:bg-primary-100 dark:hover:bg-primary-900/50"
						style="border-radius: var(--theme-radius)"
					>
						<span class="htmx-indicator">
							<svg class="animate-spin h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
								<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
								<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
							</svg>
						</span>
						<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
						</svg>
						Run Health Checks
					</button>
				</div>
			</div>
		} else {
			<div class="mb-4">
				<h3 class="text-lg text-cool-grey-700 dark:text-cool-grey-300">Health Status</h3>
				<p class="text-sm text-cool-grey-500 dark:text-cool-grey-400 mt-2">No health checks configured for this application.</p>
			</div>
		}
	</div>
}

func pluralize(count int) string {
	if count != 1 {
		return "s"
	}
	return ""
}

templ healthStatusBadge(status string) {
	if status == "passing" {
		<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300">
			<svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
			</svg>
			Passing
		</span>
	} else if status == "pending" {
		<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300">
			<div class="animate-spin rounded-full h-3 w-3 border-b-2 border-blue-800 dark:border-blue-300 mr-2"></div>
			Pending
		</span>
	} else if status == "failing" {
		<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-300">
			<svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
			</svg>
			Failing
		</span>
	} else {
		<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-cool-grey-100 dark:bg-dark-grey-700 text-cool-grey-800 dark:text-cool-grey-300">
			<svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
			</svg>
			Pending
		</span>
	}
}

templ healthCheckItem(hc customerui.HealthCheckStatusData) {
	<div class="flex items-center justify-between py-2 border-b border-cool-grey-200 dark:border-dark-grey-600 last:border-0">
		<div class="flex items-center">
			if hc.Status == "Passing" {
				<svg class="w-5 h-5 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
					<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
				</svg>
			} else if hc.Status == "Pending" {
				<div class="animate-spin rounded-full h-4 w-4 border-b-2 border-primary-600 mr-2"></div>
			} else if hc.Status == "Failing" {
				<svg class="w-5 h-5 text-red-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
					<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
				</svg>
			} else {
				<svg class="w-5 h-5 text-cool-grey-400 dark:text-cool-grey-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
					<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
				</svg>
			}
			<span class="text-sm font-medium text-cool-grey-700 dark:text-cool-grey-300">
				if hc.ActionName != "" {
					{ hc.ActionName }
				} else {
					Health Check
				}
			</span>
		</div>
		<span class={ "px-2 py-0.5 text-xs rounded", hc.StatusClass }>{ hc.Status }</span>
	</div>
}
