{
  "name": "customer-dashboard-client",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "dev:all": "bun run --parallel dev dev:ladle",
    "build": "tsc --noEmit && vite build",
    "generate-api-types": "bun scripts/generate-api-types.js",
    "preview": "vite preview --host localhost --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "bunx --bun oxlint .",
    "lint:fix": "bunx --bun oxlint . --fix",
    "dev:ladle": "bunx --bun ladle dev --host localhost --port 61001",
    "build:ladle": "ladle build"
  },
  "dependencies": {
    "@andypf/json-viewer": "^2.4.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/view": "^6.43.0",
    "@dagrejs/dagre": "^3.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-codemirror": "^4.25.10",
    "@xyflow/react": "^12.10.2",
    "cronstrue": "^3.14.0",
    "luxon": "^3.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.16.0",
    "react-syntax-highlighter": "^16.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@ladle/react": "^5.0.3",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.5.0",
    "oxlint": "^1.67.0",
    "openapi-typescript": "^6.7.6",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.2",
    "vite": "^5.4.19"
  }
}
