{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "target": "ES2017",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./client/*"],
      "@test/*": ["./test/*"]
    },
    "types": ["vite/client", "@testing-library/jest-dom", "@types/bun"]
  },
  "include": ["./client/**/*.ts", "./client/**/*.tsx", "./vite.config.ts", "./bun-test-setup.ts"]
}
